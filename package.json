{
  "name": "signresize",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/prepare-portrait-assets.mjs",
    "prebuild": "node scripts/prepare-portrait-assets.mjs",
    "dev": "astro dev",
    "build": "astro build && node scripts/copy-sitemap.mjs",
    "verify:indexing": "node scripts/verify-indexing.mjs",
    "verify:exam-guidance": "node scripts/verify-exam-guidance.mjs",
    "verify:background": "node scripts/verify-paper-background.mjs && node scripts/verify-portrait-background.mjs && node scripts/verify-upload-checks.mjs && node scripts/verify-background-pages.mjs && node scripts/check-background-types.mjs",
    "verify:toolkit": "node scripts/verify-exam-day-tools.mjs",
    "verify:feedback": "node scripts/verify-feedback.mjs",
    "check:feedback": "tsc -p tsconfig.feedback.json && tsc -p tsconfig.feedback-client.json",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "npm run build && wrangler pages deploy dist --project-name signresize --branch=main --commit-dirty=true",
    "daily-article": "node scripts/publish-daily-article.mjs --status",
    "generate-article": "node scripts/generate-daily-article.mjs",
    "publish-daily": "node scripts/generate-daily-article.mjs && npm run build",
    "share:facebook": "node scripts/post-to-facebook.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.4",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@mediapipe/tasks-vision": "0.10.32",
    "@tailwindcss/vite": "^4.3.3",
    "@types/jszip": "^3.4.0",
    "astro": "^7.3.7",
    "jszip": "^3.10.1",
    "lucide-react": "^1.38.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "^7.0.2",
    "wrangler": "^4.127.1"
  }
}
