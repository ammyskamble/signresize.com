---
const issues = [
  { title: 'File size', problem: 'The portal says the file is too small or too large.', fix: 'Select the correct exam preset, check both KB limits, and reprocess. Review the exact byte size in Export file checks before downloading.' },
  { title: 'Blur or cropping', problem: 'The signature is stretched, blurry, or missing strokes.', fix: 'Use a clearer original, lock the correct aspect ratio and adjust the crop to include all strokes. Enlarging a tiny image cannot recover lost detail.' },
  { title: 'File format', problem: 'The portal rejects the image type.', fix: 'Export in the format required by the notice, usually JPG. Renaming a PNG, WebP or PDF file does not convert it.' },
  { title: 'Background & ink', problem: 'The paper has shadows, or the ink does not follow the notice.', fix: 'Try Clean White Paper for a signature scan and inspect the output. Retake photos on the required background. Check ink colour and handwriting yourself.' },
];
const icons = ['M8 3H4v18h16V3h-4M8 3v4h8V3H8Zm0 10h8m-8 4h5', 'M3 8V3h5m8 0h5v5m0 8v5h-5m-8 0H3v-5M8 8h8v8H8z', 'M14 2H5v20h14V7l-5-5Zm0 0v6h5M8 13h8m-8 4h6', 'M12 3c-2 4-7 8-7 12a7 7 0 0 0 14 0c0-4-5-8-7-12Zm-3 12a3 3 0 0 0 3 3'];
---
<section id="troubleshooting" class="rounded-xl border border-border bg-card p-4 space-y-3">
  <h2 class="text-lg font-bold">Portal upload diagnostics</h2>
  <div role="tablist" aria-label="Upload problems" class="flex flex-wrap gap-2">{issues.map((issue, index) => <button type="button" id={`diagnostic-tab-${index}`} role="tab" aria-selected={index === 0} aria-controls={`diagnostic-panel-${index}`} tabindex={index === 0 ? 0 : -1} data-diagnostic-tab={index} class="min-h-[44px] min-w-[44px] inline-flex items-center rounded-lg border border-border p-2.5 text-xs font-semibold"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons[index]} /></svg>{issue.title}</button>)}</div>
  {issues.map((issue, index) => <div id={`diagnostic-panel-${index}`} role="tabpanel" aria-labelledby={`diagnostic-tab-${index}`} hidden={index !== 0} class="rounded-lg bg-muted/40 p-3 space-y-2"><h3 class="text-sm font-semibold">{issue.problem}</h3><p class="text-xs text-muted-foreground">{issue.fix}</p></div>)}
</section>
<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-diagnostic-tab]'));
  function selectTab(index: number) {
    tabs.forEach((tab, i) => { tab.setAttribute('aria-selected', String(i === index)); tab.tabIndex = i === index ? 0 : -1; const panel = document.getElementById(`diagnostic-panel-${i}`); if (panel) panel.hidden = i !== index; });
  }
  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => selectTab(i));
    tab.addEventListener('keydown', event => { let next = i; if (event.key === 'ArrowRight') next = (i + 1) % tabs.length; else if (event.key === 'ArrowLeft') next = (i + tabs.length - 1) % tabs.length; else if (event.key === 'Home') next = 0; else if (event.key === 'End') next = tabs.length - 1; else return; event.preventDefault(); selectTab(next); tabs[next].focus(); });
  });
</script>
