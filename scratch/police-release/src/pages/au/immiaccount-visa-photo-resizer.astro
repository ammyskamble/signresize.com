---
// src/pages/au/immiaccount-visa-photo-resizer.astro
import '../../styles/global.css';
import Header from '../../components/Header.astro';
import { SignatureTool } from '../../components/SignatureTool';
import FaqSection from '../../components/FaqSection.astro';
import Footer from '../../components/Footer.astro';
import GoogleAnalytics from '../../components/GoogleAnalytics.astro';
import GoogleFonts from '../../components/GoogleFonts.astro';
import ThemeScript from '../../components/ThemeScript.astro';
import AUToolSwitcher from '../../components/AUToolSwitcher.astro';

const pageTitle = "ImmiAccount Australia Visa Photo Resizer (600x750 Pixels) - SignResize";
const pageDescription = "Free online ImmiAccount Australia digital visa photo resizer. Crop and convert photos to 600x750 pixels, 35x45 mm ratio, 50 KB to 5 MB JPEG for Student, Skilled, and Tourist visas.";
const canonicalUrl = "https://signresize.in/au/immiaccount-visa-photo-resizer/";
const ogImageUrl = "https://signresize.in/og-image.png";
const keywordsContent = "immiaccount visa photo resizer, australia student visa 500 photo size, skilled migration 189 190 photo crop, homeaffairs photo upload size 600x750, australia visa photo converter free";

const immiFaqs = [
  {
    q: "What are the exact pixel dimensions required for ImmiAccount visa photo uploads?",
    a: "Digital visa photos for Australian ImmiAccount must measure at least 600 pixels wide by 750 pixels tall (35mm x 45mm vertical aspect ratio) in JPEG format."
  },
  {
    q: "What file size range is allowed for ImmiAccount visa applications?",
    a: "The digital photo file size must be between 50 KB (minimum) and 5 MB (maximum) in JPEG format."
  },
  {
    q: "Which visa subclasses follow this photo specification?",
    a: "This photo standard applies to Student Visa (Subclass 500), General Skilled Migration (Subclass 189 & 190), Visitor Visa (Subclass 600), Temporary Skill Shortage (Subclass 482), and Graduate Visa (Subclass 485)."
  },
  {
    q: "Can I wear glasses in my ImmiAccount visa photo?",
    a: "While glasses without tint or reflections are technically permitted by Home Affairs, removing glasses is strongly recommended to avoid automated portal upload errors."
  }
];
---

<!doctype html>
<html lang="en-AU" class="scroll-smooth">
  <head>
    <ThemeScript />
    <GoogleAnalytics />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={keywordsContent} />
    <meta name="author" content="SignResize.in" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph (OG) Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="SignResize" />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Web Fonts & Favicons -->
    <GoogleFonts />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <meta name="theme-color" content="#d97706" />

    <!-- Schema.org WebApplication JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "ImmiAccount Australia Visa Photo Resizer",
      "url": canonicalUrl,
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "description": pageDescription,
      "featureList": [
        "600x750 px Aspect Ratio Crop",
        "50 KB to 5 MB JPEG Compression",
        "Client-Side Zero Server Upload Privacy"
      ]
    })} />
  </head>

  <body class="min-h-screen bg-background text-foreground flex flex-col font-sans antialiased">
    <Header />

    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-8">
      <!-- Tool Page Header with Selector Dropdown -->
      <section class="space-y-4">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div class="space-y-2">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20">
              <span>🦘 Australian Home Affairs ImmiAccount Standard</span>
            </div>
            <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-foreground">
              ImmiAccount Visa Photo Resizer <span class="text-primary">(600×750 px)</span>
            </h1>
            <p class="text-sm text-muted-foreground max-w-3xl">
              Format your digital photo to Department of Home Affairs standards (600×750 pixels, 35×45 mm aspect ratio, 50 KB to 5 MB JPEG) for ImmiAccount Student, Skilled Migration, Visitor, and Work visa portals.
            </p>
          </div>

          <!-- Dropdown Switcher to Other AU Tools -->
          <AUToolSwitcher currentTool="immi" />
        </div>
      </section>

      <!-- Resizer Studio Tool Workspace initialized with ImmiAccount Preset -->
      <section id="tool-workspace" class="scroll-mt-20">
        <SignatureTool client:idle initialPresetId="au-immi" />
      </section>

      <!-- Technical Guidelines & Interlinking Section -->
      <section class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="md:col-span-2 space-y-4 bg-card border border-border p-6 rounded-2xl">
          <h2 class="text-xl font-bold text-foreground">
            Official ImmiAccount Digital Visa Photo Guidelines
          </h2>
          <ul class="space-y-2.5 text-xs sm:text-sm text-muted-foreground">
            <li class="flex items-start gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span><strong>Dimensions:</strong> Minimum 600 × 750 pixels (35×45 mm vertical ratio).</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span><strong>File Weight:</strong> 50 KB to 5 MB in JPEG format.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span><strong>Background:</strong> Plain light gray or off-white background with uniform lighting.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span><strong>Expression:</strong> Neutral facial expression with mouth closed and eyes fully open.</span>
            </li>
          </ul>
        </div>

        <!-- Cross Interlinking Box -->
        <div class="space-y-4 bg-primary/5 border border-primary/20 p-6 rounded-2xl">
          <h3 class="text-base font-bold text-foreground">Related Australia Tools</h3>
          <div class="space-y-2 text-xs">
            <a href="/au/australian-passport-photo-resizer/" class="block p-2.5 rounded-xl bg-card border border-border hover:border-primary transition font-medium text-foreground">
              🛂 Australian Passport Photo Resizer (35×45 mm) →
            </a>
            <a href="/au/" class="block p-2.5 rounded-xl bg-primary text-primary-foreground text-center font-bold hover:opacity-90 transition mt-2">
              Back to Australia Tools Hub →
            </a>
          </div>
        </div>
      </section>

      <!-- FAQ Section -->
      <section class="space-y-6">
        <FaqSection faqs={immiFaqs} title="ImmiAccount Visa Photo Resizer FAQs" />
      </section>
    </main>

    <Footer />
  </body>
</html>
