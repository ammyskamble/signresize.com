---
// src/pages/photo-resizer.astro
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import GoogleFonts from '../components/GoogleFonts.astro';
import { SignatureTool } from '../components/SignatureTool';

const pageTitle = "Photo Resizer in KB & Pixels (20–50 KB Size Reducer) | SignResize";
const pageDescription = "Free photo resizer in KB and pixels. Resize, crop, and reduce photo size to 20–50 KB or under 100 KB, or increase small JPGs to minimum KB in your browser.";
const canonicalUrl = "https://signresize.in/photo-resizer/";
const ogImageUrl = "https://signresize.in/og-image.png";
const keywordsContent = "photo resizer in kb, photo size reducer, photo resize 20 to 50 kb, passport photo resizer, photo size increase in kb, photo size should be maximum 100kb, photo ka size kaise kam kare, photo ka size kaise badhaye, 3.5x4.5 cm photo resize";

const photoFaqs = [
  {
    "q": "How do I use this photo resizer in KB (20 to 50 KB or maximum 100 KB)?",
    "a": "Upload your photo, set your application's pixel or centimeter dimensions, and enter the minimum and maximum KB bounds (for example 20–50 KB, or 10–100 KB when a form says 'photo size should be maximum 100kb'). Inspect the clarity and actual file size before downloading JPG."
  },
  {
    "q": "Can this Photo Size Reducer also increase photo size in KB (photo ka size badhaye)?",
    "a": "Yes. If your form shows a minimum size error such as 'file size should be at least 20kb', set Min KB to the required floor (for instance 20 KB or 30 KB) and export as JPG. SignResize increases the JPG byte size without stretching pixel dimensions. If the original photo is too blurry or low-resolution, capture a clearer photo first. To adjust KB without cropping pixels, try the Photo Size Reducer & KB Increaser tool."
  },
  {
    "q": "How do I fix 'photo size should be maximum 100kb' (meaning in hindi) and reduce photo size?",
    "a": "This error means your uploaded image exceeds the 100 KB portal ceiling (Hindi meaning: आपकी फोटो की फाइल साइज 100 KB से अधिक है, इसे 100 KB या कम रखें). Set Max KB to 95–100 KB in SignResize, export JPG, and recheck file properties before uploading."
  },
  {
    "q": "Is 20–50 KB correct for every application?",
    "a": "No. Read your application’s photo instructions and set its minimum and maximum file sizes. The general photo preset is a starting point, not a rule for every exam."
  },
  {
    "q": "Do centimeters specify the pixel dimensions?",
    "a": "Only with a resolution value. Use the exact pixel dimensions when supplied. Do not equate different aspect ratios, such as 200 × 230 px and 3.5 × 4.5 cm."
  },
  {
    "q": "Should I add my name and the photo date?",
    "a": "Add a strip only when your current application explicitly requires it. It must not cover the face or replace a required live photo capture."
  },
  {
    "q": "Can this replace live photo capture?",
    "a": "No. If the application requires a live photograph, complete that step inside the official application."
  },
  {
    "q": "Are my photographs uploaded for processing?",
    "a": "Resizing and compression run in your browser. Your uploaded images are not sent to our server for processing."
  }
];
---

<!doctype html>
<html lang="en-IN" class="scroll-smooth">
  <head>
    <GoogleAnalytics />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={keywordsContent} />
    <meta name="author" content="SignResize.in" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph (OG) Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="SignResize" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- PWA & Mobile Meta Tags -->
    <meta name="theme-color" content="#4f46e5" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="SignResize Photo" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />

    <GoogleFonts />

    <!-- SoftwareApplication & WebApplication Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": ["SoftwareApplication", "WebApplication"],
      "name": "Photo Resizer",
      "url": canonicalUrl,
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "All",
      "description": pageDescription,
      "featureList": ["Photo resizer in KB (20 to 50 KB, under 100 KB, custom limits)", "Custom pixel and centimeter dimensions", "Minimum KB floor padding and Photo Size Reducer", "Optional name and date strip", "Local browser processing"]
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": photoFaqs.map(f => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } })) })} />
  </head>

  <body class="bg-background text-foreground min-h-screen flex flex-col">
    <Header />
    <main class="flex-1 w-full max-w-[1480px] mx-auto px-3 sm:px-6 lg:px-8 py-5 space-y-6">
      <section class="rounded-2xl border border-border bg-card p-5 space-y-3">
        <h1 class="text-2xl sm:text-4xl font-bold">Photo Resizer in KB &amp; Pixels (Size Reducer &amp; Increaser)</h1>
        <p>Upload your photo, choose a crop, and resize or reduce photo size in KB (such as <strong>20 KB to 50 KB</strong> or <strong>under 100 KB</strong>). Need to fix a minimum file-size warning? Set <strong>Min KB</strong> to safely increase tiny JPGs without stretching pixels.</p>
        <p class="text-sm text-muted-foreground">A general preset is a starting point, not a universal passport or exam rule. Check your notice's pixel/cm size and live capture rules; need KB-only reduction or increase without cropping? Use the <a class="text-primary underline font-semibold" href="/compress-image-to-kb/">Photo Size Reducer &amp; KB Tool</a>.</p>
        <div class="flex flex-wrap items-center gap-3 pt-1">
          <a href="#crop-workspace" class="inline-flex min-h-11 items-center justify-center rounded-xl bg-primary px-5 py-2.5 text-sm font-bold text-primary-foreground hover:opacity-90 transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">Open photo canvas ↓</a>
          <a href="#tool-workspace" class="inline-flex min-h-11 items-center rounded-xl border border-border bg-muted/40 px-4 py-2 text-sm font-semibold text-foreground hover:bg-muted transition">Choose exam preset</a>
        </div>
      </section>
      <section id="tool-workspace" aria-label="Photo resizing workspace" class="scroll-mt-20 bg-card border border-border rounded-2xl p-3 sm:p-5 min-h-[680px]">
        <SignatureTool client:idle initialMode="photo" initialPresetId="passport-general-photo" />
      </section>
      <section class="rounded-2xl border border-border bg-card p-5 space-y-3">
        <h2 class="text-xl font-bold">Before you upload the photo</h2>
        <ul class="list-disc pl-5 space-y-2"><li>Read the current notice for format, dimensions, file size, background and photo age.</li><li>Keep the face clear and crop without stretching. Compression cannot restore a blurred original.</li><li>Add a name or date strip only if your application asks for one.</li><li>Reopen the exported JPG, check its properties and inspect the application preview.</li></ul>
        <nav class="flex flex-wrap gap-4" aria-label="Photo application guidance"><a class="text-primary underline" href="/nda-photo-resize/">NDA I 2027 photo resize</a><a class="text-primary underline" href="/cds-photo-resize/">CDS I 2027 photo resize</a><a class="text-primary underline" href="/ssc-cgl-signature-resize/">SSC CGL live photo guidance</a><a class="text-primary underline" href="/iit-jam-photo-resize/">IIT JAM photo requirements</a><a class="text-primary underline" href="/wbpsc-photo-resize/">WBPSC photo preparation</a><a class="text-primary underline" href="/">Signature resizer</a></nav>
      </section>
      <section class="space-y-4"><h2 class="text-xl font-bold">Photo resizing questions</h2>{photoFaqs.map(faq => <details class="rounded-xl border border-border bg-card p-4"><summary class="font-semibold cursor-pointer">{faq.q}</summary><p class="pt-3 text-sm">{faq.a}</p></details>)}</section>
    </main>
    <Footer />
  </body>
</html>
