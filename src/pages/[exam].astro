---
// src/pages/[exam].astro
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import GoogleFonts from '../components/GoogleFonts.astro';
import ThemeScript from '../components/ThemeScript.astro';
import SignatureCropExamples from '../components/SignatureCropExamples.astro';
import ExamRequirements from '../components/ExamRequirements.astro';
import { EXAM_GUIDANCE } from '../data/examGuidance';
import { SignatureTool } from '../components/SignatureTool';
import { EXAM_PAGES_DATA, type ExamPageInfo } from '../data/examPagesData';
import { BLOG_POSTS } from '../data/blogPostsData';

export async function getStaticPaths() {
  const INTERNATIONAL_COUNTRY_SLUGS = [
    'prc-photo-signature-resize-philippines',
    'lok-sewa-photo-resize-nepal',
    'ppsc-signature-resize',
    'fpsc-photo-resize'
  ];
  return EXAM_PAGES_DATA
    .filter((page) => !INTERNATIONAL_COUNTRY_SLUGS.includes(page.slug))
    .map((page) => ({
      params: { exam: page.slug },
      props: { examData: page }
    }));
}

const { examData, canonicalUrl: propCanonicalUrl } = Astro.props as { examData: ExamPageInfo; canonicalUrl?: string };
const examGuidance = EXAM_GUIDANCE[examData.slug];

const canonicalUrl = propCanonicalUrl || `https://signresize.in/${examData.slug}/`;
const ogImageUrl = 'https://signresize.in/og-image.png';
const currentYear = 2026;
const otherExams = EXAM_PAGES_DATA.filter((p) => p.slug !== examData.slug);
const isJam = examData.slug.includes('iit-jam');
const isGate = examData.slug.includes('gate');
const isSarathi = examData.slug.includes('sarathi');
const isPan = examData.slug.includes('pan-card');
const isIbAcio = examData.slug.includes('ib-acio');
const isGds = examData.slug.includes('india-post-gds');
const isSscMts = examData.slug === 'ssc-mts-signature-resize' && !examGuidance;
const isCuet = examData.slug.includes('cuet');
const isUpsssc = examData.slug.includes('upsssc');
const isBssc = examData.slug.includes('bssc');
const isDsssb = examData.slug.includes('dsssb');
const isKeralaPsc = examData.slug.includes('kerala-psc');
const isCtet = examData.slug.includes('ctet') && !examGuidance;
const isRrb = examData.slug === 'rrb-signature-resize' || examData.slug === 'rrb-photo-resize';
const isCoastGuard = examData.slug.includes('coast-guard');
const isWbpsc = examData.slug.includes('wbpsc') || examData.slug.includes('wbcs');
const hasDocumentSuite = isJam || isGate || isSarathi || isPan || isIbAcio || isGds || isSscMts || isCuet || isUpsssc || isBssc || isDsssb || isKeralaPsc || isCtet || isRrb || isWbpsc;
const relatedTools = (examData.relatedTools || [])
  .filter(slug => slug !== examData.slug)
  .map(slug => {
    if (slug === 'photo-resizer') {
      return { slug, label: 'Passport Photo Resizer' };
    }
    const target = EXAM_PAGES_DATA.find(page => page.slug === slug);
    let label = target?.h1 || slug;
    label = label.replace(/\s*\(.*?\)\s*/g, ' ').replace(/\s*Online\s*-\s*SignResize\s*/gi, '').replace(/–\s*GOAPS Resizer.*$/i, '').trim();
    return { slug, label };
  });

// Find relevant blog posts for this specific exam tool
const relevantBlogPosts = BLOG_POSTS.map(post => {
  let score = 0;
  const examSlugLower = examData.slug.toLowerCase();
  const examKey = examSlugLower.split('-')[0]; // 'ssc', 'rrb', 'upsc', 'bpsc', etc.
  
  if (post.relatedExamPreset && (post.relatedExamPreset === examData.presetId || examData.slug.includes(post.relatedExamPreset))) {
    score += 10;
  }
  if (post.slug.includes(examKey) || post.title.toLowerCase().includes(examKey)) {
    score += 8;
  }
  if (post.tags && post.tags.some(t => examData.keywords.toLowerCase().includes(t.toLowerCase()) || examData.targetExams.toLowerCase().includes(t.toLowerCase()))) {
    score += 4;
  }
  if (examData.slug.includes('psc') && (post.slug.includes('psc') || post.slug.includes('otr'))) {
    score += 5;
  }
  if (examData.slug.includes('police') && post.slug.includes('police')) {
    score += 6;
  }
  if (post.slug === 'top-5-mistakes-photo-signature-rejection-govt-exams') {
    score += 2;
  }
  return { post, score };
}).filter(item => !examData.sources || item.score >= 2).sort((a, b) => b.score - a.score)
  .slice(0, 2)
  .map(s => s.post);
---

<!doctype html>
<html lang="en-IN" class="scroll-smooth">
  <head>
    <ThemeScript />
    <!-- Google tag (gtag.js) -->
    <GoogleAnalytics />

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{examData.pageTitle}</title>
    <meta name="description" content={examData.metaDescription} />
    <meta name="keywords" content={examData.keywords} />
    <meta name="author" content="SignResize.in" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang={examData.slug.includes('teletalk') ? 'en-BD' : examData.slug.includes('ppsc') || examData.slug.includes('fpsc') ? 'en-PK' : examData.slug.includes('philippines') ? 'en-PH' : examData.slug.includes('nepal') ? 'en-NP' : 'en'} href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph (OG) Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={examData.pageTitle} />
    <meta property="og:description" content={examData.metaDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="SignResize" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={examData.pageTitle} />
    <meta name="twitter:description" content={examData.metaDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- PWA & Mobile Meta Tags -->
    <meta name="theme-color" content="#4f46e5" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="SignResize" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Favicons -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Async Google Fonts -->
    <GoogleFonts />

    <!-- SoftwareApplication & WebApplication Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": ["SoftwareApplication", "WebApplication"],
      "name": examData.h1,
      "url": canonicalUrl,
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "All (Android, iOS, Windows, macOS, Linux)",
      "browserRequirements": "Requires JavaScript. Requires HTML5 Canvas support.",
      "description": examData.metaDescription,
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "INR"
      },
      "featureList": [
        `${examData.widthPx}x${examData.heightPx} px exact dimensions`,
        `${examData.minKb} KB to ${examData.maxKb} KB target file size`,
        "Clean White Paper background shadow removal",
        "100% private in-browser client-side execution"
      ]
    })} />

    <!-- BreadcrumbList Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://signresize.in/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": examData.h1,
          "item": canonicalUrl
        }
      ]
    })} />

    <!-- FAQPage Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": examData.faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": f.a
        }
      }))
    })} />

    <!-- HowTo Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "HowTo",
      "name": `How to resize signature for ${examData.authority}`,
      "description": `Step-by-step instructions to crop, resize, and compress signature to ${examData.minKb}–${examData.maxKb} KB for ${examData.authority} portals.`,
      "step": [
        {
          "@type": "HowToStep",
          "name": "Sign on Clean White Paper",
          "text": `Sign in running handwriting using ${examData.ink} on spotless white paper.`,
          "position": 1
        },
        {
          "@type": "HowToStep",
          "name": "Upload to SignResize",
          "text": "Upload your camera photo or scan to the online workspace.",
          "position": 2
        },
        {
          "@type": "HowToStep",
          "name": "Verify Preset Bounds",
          "text": `Preset automatically enforces ${examData.widthPx}x${examData.heightPx} px and ${examData.minKb}–${examData.maxKb} KB bounds.`,
          "position": 3
        },
        {
          "@type": "HowToStep",
          "name": "Clean Background & Download",
          "text": "Activate Clean White Paper to whiten shadows, verify file size, and download portal-ready JPG.",
          "position": 4
        }
      ]
    })} />
  </head>

  <body class="bg-background text-foreground selection:bg-primary/20 selection:text-primary min-h-screen flex flex-col antialiased">
    <Header />

    <main class="flex-1 w-full max-w-[1480px] mx-auto px-3 sm:px-6 lg:px-8 py-5 sm:py-6 space-y-5 sm:space-y-6">
      
      <!-- Breadcrumb Bar -->
      <nav class="flex items-center gap-2 text-xs text-muted-foreground" aria-label="Breadcrumb">
        <a href="/" class="hover:text-primary transition">Home</a>
        <span>/</span>
        <span class="text-foreground font-medium">{examData.authority} Resizer</span>
      </nav>

      <!-- Hero Header Banner with Exam Badges -->
      <section class="rounded-2xl border border-primary/20 bg-gradient-to-r from-card via-card/90 to-primary/5 p-4 sm:p-6 shadow-sm backdrop-blur">
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
          <div class="space-y-2">
            <div class="flex items-center gap-2 flex-wrap">
              <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-primary/10 text-primary border border-primary/20">
                <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
                {examData.guidanceLabel || `Official ${currentYear} Guidelines`}
              </span>
              <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md text-[11px] font-mono text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 border border-emerald-500/20">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                100% Client-Side Private
              </span>
              <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[11px] font-mono text-amber-600 dark:text-amber-400 bg-amber-500/10 border border-amber-500/20">
                {examData.authority}
              </span>
              {examData.sources && examData.sources[0] && (
                <a
                  href={examData.sources[0].url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[11px] font-mono text-primary bg-primary/10 border border-primary/20 hover:bg-primary/20 transition"
                  title={`Official authority reference: ${examData.sources[0].label}`}
                >
                  <span>Official Source ↗</span>
                </a>
              )}
            </div>

            <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-foreground leading-[1.15]">
              {examData.h1}
            </h1>
            <p class="text-xs sm:text-sm text-muted-foreground max-w-3xl leading-relaxed">
              {examData.subheading} Applicable for <strong>{examData.targetExams}</strong>.
            </p>
              {examData.slug === 'lsat-india-signature-resize' && <aside class="mt-4 rounded-xl border border-amber-500/30 bg-amber-500/10 p-4 text-sm space-y-2" aria-label="Legacy exam notice"><strong class="text-amber-800 dark:text-amber-200">Legacy LSAT—India preset</strong><p>LSAT—India has been discontinued. This page preserves the historical preset; it is not a current registration guide. Check your law school’s current admission route.</p><div class="flex flex-wrap gap-4 font-semibold text-primary"><a href="/clat-signature-resize/">CLAT signature tool →</a><a href="/ailet-signature-resize/">AILET signature tool →</a><a href="https://www.chitkara.edu.in/blogs/law-entrance-exams-after-12th-clat-lsat-cuet/" target="_blank" rel="noopener noreferrer">University admission guidance ↗</a></div></aside>}
          </div>

          <!-- Quick Matrix Badges -->
          <div class="flex items-center gap-2 flex-wrap shrink-0">
            <div class="px-3.5 py-2 rounded-xl bg-card border border-border text-center shadow-xs">
              <div class="text-[9px] uppercase font-bold text-muted-foreground">{examData.pixelNote ? 'Tool canvas' : 'Dimensions'}</div>
              <div class="text-xs font-bold text-foreground font-mono">{examData.widthPx} × {examData.heightPx} PX</div>
            </div>
            <div class="px-3.5 py-2 rounded-xl bg-card border border-border text-center shadow-xs">
              <div class="text-[9px] uppercase font-bold text-muted-foreground">Size Range</div>
              <div class="text-xs font-bold text-primary font-mono">{examData.minKb} – {examData.maxKb} KB</div>
            </div>
            {!examData.hidePhysicalSize && <div class="px-3.5 py-2 rounded-xl bg-card border border-border text-center shadow-xs">
              <div class="text-[9px] uppercase font-bold text-muted-foreground">Centimeters</div>
              <div class="text-xs font-bold text-foreground font-mono">{examData.widthCm} × {examData.heightCm} CM</div>
            </div>}
          </div>
        </div>

        <!-- Strict Warning Alert -->
        {!hasDocumentSuite && !examGuidance && (
          <div class="mt-4 p-3 rounded-xl bg-amber-500/10 border border-amber-500/20 text-xs text-amber-900 dark:text-amber-200 flex items-start gap-2.5">
            <span class="text-base leading-none">⚠️</span>
            <div>
              <strong>Rejection Warning:</strong> {examData.strictNotice}
            </div>
          </div>
        )}
      </section>

      {examGuidance && <ExamRequirements guidance={examGuidance} sources={examData.sources || []} />}

      {relatedTools.length > 0 && !hasDocumentSuite && !examGuidance && (
        <nav class="flex flex-wrap gap-2 text-xs" aria-label="Related signature tools">
          {relatedTools.map(tool => (
            <a href={`/${tool.slug}/`} class="px-3 py-2 rounded-xl bg-card border border-border text-primary hover:bg-primary/10 transition">
              {tool.label} →
            </a>
          ))}
        </nav>
      )}

      {examData.slug.includes('iit-jam') && (
        <aside class="rounded-2xl border-2 border-primary/30 bg-gradient-to-r from-primary/10 via-card to-card p-4 sm:p-5 shadow-sm space-y-3" aria-label="IIT JAM Document Suite">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div class="space-y-1">
              <div class="flex items-center gap-2">
                <span class="text-lg">🎓</span>
                <span class="font-bold text-sm sm:text-base text-foreground">IIT JAM 2027 (JOAPS) Document Suite</span>
                <span class="px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-[10px] font-bold uppercase tracking-wider border border-emerald-500/20">Official JOAPS Specs</span>
              </div>
              <p class="text-xs text-muted-foreground leading-relaxed">
                JOAPS requires both documents to be uploaded. Select the tool below to calibrate exact dimensions and avoid rejection.
              </p>
            </div>
            <div class="flex items-center gap-2 flex-wrap shrink-0">
              <a
                href="/iit-jam-signature-resize/"
                class={`px-3.5 py-2 rounded-xl text-xs font-bold transition inline-flex items-center gap-1.5 border ${examData.slug === 'iit-jam-signature-resize' ? 'bg-primary text-primary-foreground border-primary shadow-xs' : 'bg-card text-foreground border-border hover:border-primary/50'}`}
              >
                <span>✍️</span>
                <span>Signature (50–150 KB)</span>
              </a>
              <a
                href="/iit-jam-photo-resize/"
                class={`px-3.5 py-2 rounded-xl text-xs font-bold transition inline-flex items-center gap-1.5 border ${examData.slug === 'iit-jam-photo-resize' ? 'bg-primary text-primary-foreground border-primary shadow-xs' : 'bg-card text-foreground border-border hover:border-primary/50'}`}
              >
                <span>📸</span>
                <span>Photo (20–200 KB)</span>
              </a>
              <a
                href="/gate-signature-resize/"
                class="px-3 py-2 rounded-xl text-xs font-semibold text-muted-foreground hover:text-primary transition bg-muted/40 border border-transparent hover:border-border"
              >
                GATE 2027 Resizer →
              </a>
            </div>
          </div>
          {examData.slug === 'iit-jam-signature-resize' ? (
            <div class="p-2.5 rounded-xl bg-amber-500/10 border border-amber-500/25 text-[11px] text-amber-900 dark:text-amber-200 flex items-center gap-2">
              <span>🛡️</span>
              <span><strong>Anti-Rejection Floor:</strong> JOAPS strictly rejects signatures below 50 KB. SignResize automatically applies lossless padding so your file remains within 50–150 KB without quality loss.</span>
            </div>
          ) : (
            <div class="p-2.5 rounded-xl bg-emerald-500/10 border border-emerald-500/25 text-[11px] text-emerald-900 dark:text-emerald-200 flex items-center gap-2">
              <span>📸</span>
              <span><strong>JOAPS Photo Compliance:</strong> Official 480×640 px (3.5×4.5 cm), 20 KB to 200 KB JPG on plain light/white background with 50–70% face coverage.</span>
            </div>
          )}
        </aside>
      )}

      {examData.slug.includes('gate') && (
        <aside class="rounded-2xl border-2 border-primary/30 bg-gradient-to-r from-primary/10 via-card to-card p-4 sm:p-5 shadow-sm space-y-3" aria-label="GATE Document Suite">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div class="space-y-1">
              <div class="flex items-center gap-2">
                <span class="text-lg">⚙️</span>
                <span class="font-bold text-sm sm:text-base text-foreground">GATE 2027 (GOAPS) Document Suite</span>
                <span class="px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-[10px] font-bold uppercase tracking-wider border border-emerald-500/20">IIT Madras Standards</span>
              </div>
              <p class="text-xs text-muted-foreground leading-relaxed">
                GOAPS requires Signature (3–300 KB, 480×160 px) and Candidate Photograph (5–200 KB, 480×640 px). For M.Sc. admissions, use the separate JAM tool.
              </p>
            </div>
            <div class="flex items-center gap-2 flex-wrap shrink-0">
              <a
                href="/gate-signature-resize/"
                class={`px-3.5 py-2 rounded-xl text-xs font-bold transition inline-flex items-center gap-1.5 border ${examData.slug === 'gate-signature-resize' ? 'bg-primary text-primary-foreground border-primary shadow-xs' : 'bg-card text-foreground border-border hover:border-primary/50'}`}
              >
                <span>✍️</span>
                <span>Signature (3–300 KB)</span>
              </a>
              <a
                href="/gate-photo-resize/"
                class={`px-3.5 py-2 rounded-xl text-xs font-bold transition inline-flex items-center gap-1.5 border ${examData.slug === 'gate-photo-resize' ? 'bg-primary text-primary-foreground border-primary shadow-xs' : 'bg-card text-foreground border-border hover:border-primary/50'}`}
              >
                <span>📸</span>
                <span>Photo (5–200 KB)</span>
              </a>
              <a
                href="/iit-jam-signature-resize/"
                class="px-3 py-2 rounded-xl text-xs font-semibold text-muted-foreground hover:text-primary transition bg-muted/40 border border-transparent hover:border-border"
              >
                IIT JAM Resizer →
              </a>
            </div>
          </div>
        </aside>
      )}

      {isSarathi && (
        <aside class="rounded-2xl border-2 border-primary/30 bg-gradient-to-r from-primary/10 via-card to-card p-4 sm:p-5 shadow-sm space-y-3" aria-label="Sarathi Parivahan Document Suite">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div class="space-y-1">
              <div class="flex items-center gap-2">
                <span class="text-lg">🚗</span>
                <span class="font-bold text-sm sm:text-base text-foreground">Sarathi Parivahan Document Suite (MoRTH)</span>
                <span class="px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-[10px] font-bold uppercase tracking-wider border border-emerald-500/20">10–20 KB Dual Boundary</span>
              </div>
              <p class="text-xs text-muted-foreground leading-relaxed">
                Parivahan Sewa strictly mandates both documents to be sized between 10 KB and 20 KB. Switch between tools below:
              </p>
            </div>
            <div class="flex items-center gap-2 flex-wrap shrink-0">
              <a
                href="/sarathi-dl-signature-resize/"
                class={`px-3.5 py-2 rounded-xl text-xs font-bold transition inline-flex items-center gap-1.5 border ${examData.slug === 'sarathi-dl-signature-resize' ? 'bg-primary text-primary-foreground border-primary shadow-xs' : 'bg-card text-foreground border-border hover:border-primary/50'}`}
              >
                <span>✍️</span>
                <span>Signature (10–20 KB)</span>
              </a>
              <a
                href="/sarathi-dl-photo-resize/"
                class={`px-3.5 py-2 rounded-xl text-xs font-bold transition inline-flex items-center gap-1.5 border ${examData.slug === 'sarathi-dl-photo-resize' ? 'bg-primary text-primary-foreground border-primary shadow-xs' : 'bg-card text-foreground border-border hover:border-primary/50'}`}
              >
                <span>📸</span>
                <span>Photo (10–20 KB)</span>
              </a>
            </div>
          </div>
        </aside>
      )}

      {isPan && (
        <aside class="rounded-2xl border-2 border-primary/30 bg-gradient-to-r from-primary/10 via-card to-card p-4 sm:p-5 shadow-sm space-y-3" aria-label="PAN Card Document Suite">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div class="space-y-1">
