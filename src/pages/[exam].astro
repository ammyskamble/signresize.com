                <span class="text-emerald-500 font-bold">✓</span>
                <div>
                  <div class="font-medium text-foreground">Target Size: {examData.minKb}–{examData.maxKb} KB</div>
                  <div class="text-[11px] text-muted-foreground">Check the actual downloaded file size.</div>
                </div>
              </div>
              <div class="p-2.5 rounded-xl bg-muted/40 border border-border flex items-start gap-2">
                <span class="text-emerald-500 font-bold">✓</span>
                <div>
                  <div class="font-medium text-foreground">Dimensions: {examData.widthPx} × {examData.heightPx} px</div>
                  <div class="text-[11px] text-muted-foreground">Inspect the final image and application preview.</div>
                </div>
              </div>
              <div class="p-2.5 rounded-xl bg-muted/40 border border-border flex items-start gap-2">
                <span class="text-emerald-500 font-bold">✓</span>
                <div>
                  <div class="font-medium text-foreground">Zero Uploads • 100% Privacy</div>
                  <div class="text-[11px] text-muted-foreground">Document never leaves your browser.</div>
                </div>
              </div>
            </div>
          </div>

          <!-- Card 2: Other Exam Quick Links -->
          <div class="bg-card border border-border rounded-2xl p-5 shadow-sm space-y-3 text-xs">
            <div class="font-bold text-foreground flex items-center justify-between">
              <span>Explore Other Exam Tools</span>
              <span class="text-[10px] text-muted-foreground">Instant Presets</span>
            </div>
            <div class="space-y-1.5">
              {otherExams.slice(0, 8).map((item) => (
                <a
                  href={`/${item.slug}/`}
                  aria-current={item.slug === examData.slug ? "page" : undefined}
                  class:list={[
                    "flex items-center justify-between p-2 rounded-lg transition group text-[11px]",
                    item.slug === examData.slug
                      ? "bg-primary/10 text-primary font-bold border border-primary/30"
                      : "hover:bg-muted text-foreground"
                  ]}
                >
                  <span class="font-medium group-hover:text-primary transition">{item.authority}</span>
                  <span class="font-mono text-[10px] text-muted-foreground">{item.minKb}–{item.maxKb} KB →</span>
                </a>
              ))}
            </div>
            <a
              href="/#tool-workspace"
              class="block text-center pt-2 text-[11px] font-bold text-primary hover:underline border-t border-border/50"
            >
              Browse All Exam Presets &rarr;
            </a>
          </div>

          <!-- Card 3: Standalone Tools -->
          <div class="bg-card border border-border rounded-2xl p-5 shadow-sm space-y-3 text-xs">
            <div class="font-bold text-foreground">More Free Student Tools</div>
            <div class="space-y-2">
              <a
                href="/"
                class="block p-2.5 rounded-xl bg-muted/50 hover:bg-muted border border-border transition"
              >
                <div class="font-semibold text-foreground">Main Signature Resizer</div>
                <div class="text-[10px] text-muted-foreground">Custom CM / PX / DPI dimensions with real-time whiten &amp; crop studio.</div>
              </a>
              <a
                href="/compress-image-to-kb/"
                class="block p-2.5 rounded-xl bg-primary/5 hover:bg-primary/10 border border-primary/20 transition"
              >
                <div class="font-semibold text-primary">Compress Image to KB Tool</div>
                <div class="text-[10px] text-muted-foreground">Compress certificates, marksheets &amp; photos to 20 KB, 50 KB, 100 KB.</div>
              </a>
              <a
                href="/signature-generator/"
                class="block p-2.5 rounded-xl bg-muted/50 hover:bg-muted border border-border transition"
              >
                <div class="font-semibold text-foreground">Online Signature Generator</div>
                <div class="text-[10px] text-muted-foreground">Generate digital signatures with cursive calligraphy fonts or draw pad.</div>
              </a>
            </div>
          </div>

        </aside>
        )}
      </div>

    </main>

    <Footer />
  </body>
</html>
