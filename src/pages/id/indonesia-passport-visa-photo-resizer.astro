---
// src/pages/id/indonesia-passport-visa-photo-resizer.astro
import '../../styles/global.css';
import Header from '../../components/Header.astro';
import { SignatureTool } from '../../components/SignatureTool';
import FaqSection from '../../components/FaqSection.astro';
import Footer from '../../components/Footer.astro';
import GoogleAnalytics from '../../components/GoogleAnalytics.astro';
import GoogleFonts from '../../components/GoogleFonts.astro';
import ThemeScript from '../../components/ThemeScript.astro';

const pageTitle = "Imigrasi Paspor & eVisa Indonesia Photo Resizer (3.5x4.5 cm / 350x450 px) - SignResize";
const pageDescription = "Free online Indonesia Passport & eVisa photo resizer. Crop and compress pasfoto 3.5x4.5 cm (350x450 px), white background, 100 KB to 1000 KB JPEG for M-Paspor & eVisa Imigrasi.";
const canonicalUrl = "https://signresize.in/id/indonesia-passport-visa-photo-resizer/";
const ogImageUrl = "https://signresize.in/og-image.png";
const keywordsContent = "paspor indonesia photo resizer, pasfoto m paspor 350x450 px, ubah ukuran foto evisa imigrasi 3.5x4.5, kompres pasfoto imigrasi 100kb 1000kb, edit foto paspor latar putih";

const passportFaqs = [
  {
    q: "Berapa ukuran dan resolusi pasfoto untuk permohonan Paspor RI dan M-Paspor?",
    a: "Pasfoto resmi Direktorat Jenderal Imigrasi Indonesia berukuran 3.5x4.5 cm dengan rasio 7:9 (resolusi minimal 350x450 piksel) dan ukuran file antara 100 KB hingga 1 MB (1000 KB) format JPG/JPEG."
  },
  {
    q: "Warna latar belakang apa yang diwajibkan untuk pasfoto Imigrasi Paspor & eVisa?",
    a: "Latar belakang pasfoto paspor dan visa Indonesia wajib berwarna putih polos sempurna tanpa bayangan, tekstur, atau gradasi warna."
  },
  {
    q: "Apakah pengguna kacamata diperbolehkan mengenakan kacamata saat foto paspor?",
    a: "Tidak. Sesuai regulasi terbaru Ditjen Imigrasi, kacamata (terutama berbingkai tebal atau berlensa reflektif/gelap) wajib dilepas agar pupil dan retina mata terlihat jelas."
  },
  {
    q: "Bagaimana aturan pakaian dan penampilan untuk pasfoto paspor Indonesia?",
    a: "Pemohon wajib mengenakan pakaian formal berkerah (bukan kaos oblong). Pakaian tidak boleh berwarna putih agar tidak menyatu dengan latar belakang. Bagi pengguna jilbab, gunakan jilbab bergelap atau kontras."
  }
];
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <ThemeScript />
    <GoogleAnalytics />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={keywordsContent} />
    <meta name="author" content="SignResize.in" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph (OG) Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="SignResize" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Web Fonts & Favicons -->
    <GoogleFonts />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <meta name="theme-color" content="#dc2626" />

    <!-- Schema.org WebApplication JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "Indonesia Passport & eVisa Photo Resizer",
      "url": canonicalUrl,
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "description": pageDescription,
      "featureList": [
        "350x450 px Pasfoto 3.5x4.5 cm Crop",
        "100 KB - 1000 KB Compression",
        "M-Paspor & Online eVisa Ready"
      ]
    })} />
  </head>

  <body class="min-h-screen bg-background text-foreground flex flex-col font-sans antialiased">
    <Header />

    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-8">
      <!-- Tool Page Header with Selector Dropdown -->
      <section class="space-y-4">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div class="space-y-2">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20">
              <span>🇮🇩 Pembuat Pasfoto Paspor & eVisa Imigrasi RI</span>
            </div>
            <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-foreground">
              Indonesia Passport & eVisa Photo Resizer
            </h1>
            <p class="text-muted-foreground text-sm sm:text-base max-w-3xl">
              Ubah ukuran dan kompres pasfoto resmi 3.5x4.5 cm (350x450 piksel, 100 KB – 1000 KB) untuk aplikasi M-Paspor dan visa elektronik Direktorat Jenderal Imigrasi.
            </p>
          </div>

          <!-- Quick Dropdown Hub Selector -->
          <div class="w-full md:w-auto min-w-[280px] bg-card p-3 rounded-xl border border-border shadow-sm">
            <label for="tool-select" class="block text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-1.5">
              Pilih Layanan Imigrasi & Ujian ID:
            </label>
            <select
              id="tool-select"
              class="w-full bg-background border border-input text-foreground rounded-lg px-3 py-2 text-sm font-medium focus:ring-2 focus:ring-primary focus:outline-none cursor-pointer"
              onchange="if(this.value) window.location.href=this.value;"
            >
              <option value="/id/">🇮🇩 Hub Utama Indonesia</option>
              <option value="/id/cpns-sscasn-photo-resizer/">BKN CPNS / SSCASN (400x600 px)</option>
              <option value="/id/utbk-snbt-photo-resizer/">SNPMB UTBK-SNBT (400x600 px)</option>
              <option value="/id/indonesia-passport-visa-photo-resizer/" selected>Paspor & eVisa Imigrasi (350x450 px)</option>
            </select>
          </div>
        </div>
      </section>

      <!-- Signature Tool Canvas Widget -->
      <section class="bg-card rounded-2xl p-4 sm:p-6 border border-border shadow-sm">
        <SignatureTool client:load initialPresetId="id-passport" initialMode="photo" />
      </section>

      <!-- SEO Educational Guide Section -->
      <section class="space-y-6 pt-6 border-t border-border">
        <div class="bg-card rounded-2xl p-6 sm:p-8 border border-border space-y-6">
          <h2 class="text-2xl font-bold text-foreground">
            Panduan Lengkap Pasfoto Paspor RI & eVisa Imigrasi Indonesia
          </h2>
          <p class="text-muted-foreground leading-relaxed">
            Aplikasi <strong>M-Paspor</strong> dan portal permohonan <strong>eVisa Direktorat Jenderal Imigrasi Kemenkumham RI</strong> menerapkan standar biometric internasional ICAO (International Civil Aviation Organization). Setiap unggahan pasfoto diverifikasi secara otomatis oleh sistem deteksi wajah. Pengunggahan foto yang buram, berukuran tidak sesuai 3.5x4.5 cm, atau latar belakang berbayangan akan memicu kegagalan validasi berkas.
          </p>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 my-6">
            <div class="p-4 bg-muted/40 rounded-xl border border-border space-y-1">
              <h3 class="font-bold text-base text-foreground">Ukuran & Resolusi</h3>
              <p class="text-xs text-muted-foreground">3.5 x 4.5 cm (350 x 450 px), rasio portrait 7:9.</p>
            </div>
            <div class="p-4 bg-muted/40 rounded-xl border border-border space-y-1">
              <h3 class="font-bold text-base text-foreground">Batas Ukuran File</h3>
              <p class="text-xs text-muted-foreground">Minimal 100 KB, Maksimal 1000 KB (1 MB) format JPG/JPEG.</p>
            </div>
            <div class="p-4 bg-muted/40 rounded-xl border border-border space-y-1">
              <h3 class="font-bold text-base text-foreground">Latar Belakang</h3>
              <p class="text-xs text-muted-foreground">Wajib putih polos sempurna (Pure White Background).</p>
            </div>
          </div>

          <h3 class="text-xl font-semibold text-foreground pt-4">
            Aturan Ketat Penampilan & Pakaian Pasfoto Imigrasi
          </h3>
          <ul class="list-disc list-inside text-muted-foreground space-y-2">
            <li><strong>Pakaian Berkerah:</strong> Wajib menggunakan kemeja atau pakaian formal berkerah. Hindari baju tanpa lengan atau kaos oblong.</li>
            <li><strong>Warna Pakaian Kontras:</strong> Dilarang menggunakan kemeja/baju berwarna putih agar tidak menyatu dengan latar belakang.</li>
            <li><strong>Tanpa Kacamata & Aksesori:</strong> Kacamata, topi, dan aksesori penutup wajah harus dilepas agar alis dan pupil mata terlihat jelas.</li>
            <li><strong>Posisi Wajah Simetris:</strong> Kepala menghadap lurus ke depan dengan ekspresi netral (tidak tersenyum memperlihatkan gigi).</li>
          </ul>

          <h3 class="text-xl font-semibold text-foreground pt-4">
            Mengapa Menggunakan SignResize Paspor Resizer?
          </h3>
          <p class="text-muted-foreground leading-relaxed">
            Alat kami memproses seluruh gambar secara aman di dalam peramban web Anda tanpa mengunggah foto pribadi ke server mana pun (100% Client-Side HTML5 Canvas). Pasfoto Anda langsung dipotong tepat pada rasio 350x450 piksel dan dikompresi ke rentang 100 KB – 1 MB tanpa mengurangi ketajaman wajah.
          </p>
        </div>
      </section>

      <!-- FAQ Section -->
      <FaqSection faqs={passportFaqs} />
    </main>

    <Footer />
  </body>
</html>
