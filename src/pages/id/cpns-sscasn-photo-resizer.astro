---
// src/pages/id/cpns-sscasn-photo-resizer.astro
import '../../styles/global.css';
import Header from '../../components/Header.astro';
import { SignatureTool } from '../../components/SignatureTool';
import FaqSection from '../../components/FaqSection.astro';
import Footer from '../../components/Footer.astro';
import GoogleAnalytics from '../../components/GoogleAnalytics.astro';
import GoogleFonts from '../../components/GoogleFonts.astro';
import ThemeScript from '../../components/ThemeScript.astro';
import IDToolSwitcher from '../../components/IDToolSwitcher.astro';

const pageTitle = "CPNS SSCASN Photo Resizer (Pasfoto Latar Merah 3×4, 120–200 KB) - SignResize";
const pageDescription = "Alat resize dan kompres pasfoto formal CPNS SSCASN BKN (3×4 cm, rasio 3:4, latar belakang merah, 120–200 KB JPG/JPEG). Gratis di browser beserta panduan swafoto kamera portal.";
const canonicalUrl = "https://signresize.in/id/cpns-sscasn-photo-resizer/";
const ogImageUrl = "https://signresize.in/og-image.png";
const keywordsContent = "cpns sscasn photo resizer, kompres foto cpns 120 200 kb, edit pasfoto sscasn latar merah, pasfoto 3x4 cpns bkn, swafoto sscasn";

const cpnsFaqs = [
  {
    q: "Berapa ukuran dan batas kilobyte pasfoto formal CPNS SSCASN?",
    a: "Pasfoto formal SSCASN BKN berukuran 3×4 cm (rasio aspek 3:4 tegak) dengan latar belakang merah polos, mengenakan kemeja putih berkerah, dalam format JPG/JPEG berukuran 120 KB hingga 200 KB. Buku petunjuk BKN tidak menetapkan angka piksel baku—ukuran piksel mengikuti ketentuan portal dan pengumuman instansi."
  },
  {
    q: "Apakah swafoto (selfie) CPNS masih diunggah sebagai file atau memegang KTP?",
    a: "Berdasarkan Buku Petunjuk Pendaftaran Seleksi CASN BKN (§3.1 langkah 12), swafoto diambil langsung secara live melalui kamera di dalam portal SSCASN saat pembuatan akun sebagai langkah pengenalan wajah—bukan unggah file terpisah dan tidak lagi memegang KTP serta kartu informasi akun."
  },
  {
    q: "Apa warna latar belakang dan pakaian resmi pasfoto formal CPNS BKN?",
    a: "Latar belakang resmi pasfoto formal CPNS adalah warna merah polos, dengan mengenakan kemeja putih berkerah rapi (dan jilbab hitam polos bagi pelamar berhijab)."
  },
  {
    q: "Bagaimana cara menyiapkan pasfoto CPNS 120–200 KB tanpa Photoshop?",
    a: "Unggah pasfoto Anda ke SignResize, pilih preset CPNS Pasfoto (3:4), atur area crop wajah, dan unduh file JPG yang sudah dikompresi otomatis ke rentang 120–200 KB untuk diunggah ke sscasn.bkn.go.id."
  }
];
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <ThemeScript />
    <GoogleAnalytics />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={keywordsContent} />
    <meta name="author" content="SignResize.in" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph (OG) Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="SignResize" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Web Fonts & Favicons -->
    <GoogleFonts />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <meta name="theme-color" content="#dc2626" />

    <!-- Schema.org WebApplication JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "CPNS SSCASN Pasfoto Formal Resizer",
      "url": canonicalUrl,
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "description": pageDescription,
      "featureList": [
        "3:4 Pasfoto Formal Latar Merah Crop (450x600 px)",
        "120 KB - 200 KB JPG/JPEG Compression",
        "100% In-Browser Privacy Protection"
      ]
    })} />
  </head>

  <body class="min-h-screen bg-background text-foreground flex flex-col font-sans antialiased">
    <Header />

    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-8">
      <!-- Tool Page Header with Selector Dropdown -->
      <section class="space-y-4">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div class="space-y-2">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-red-500/10 text-red-600 dark:text-red-400 border border-red-500/20">
              <span>🇮🇩 SSCASN BKN CPNS &amp; PPPK Standard</span>
            </div>
            <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-foreground">
              CPNS / SSCASN Pasfoto Resizer <span class="text-primary">(3×4, 120–200 KB)</span>
            </h1>
            <p class="text-sm text-muted-foreground max-w-3xl">
              Ubah ukuran dan kompres pasfoto formal latar belakang merah (3×4 cm / rasio 3:4, 120–200 KB, format JPG/JPEG) sesuai ketentuan pendaftaran CPNS &amp; PPPK di sscasn.bkn.go.id.
            </p>
            <p class="text-[11px] font-mono text-muted-foreground">
              Spesifikasi diperiksa 26 November 2026 berdasarkan Buku Petunjuk Pendaftaran Seleksi CASN BKN 2024 (v01.00) dan pola pengumuman resmi instansi.
            </p>
          </div>

          <!-- Dropdown Switcher to Other ID Tools -->
          <IDToolSwitcher currentTool="cpns" />
        </div>
      </section>

      <!-- Resizer Studio Tool Workspace initialized with CPNS Preset -->
      <section id="tool-workspace" class="scroll-mt-20">
        <SignatureTool client:idle initialPresetId="id-cpns" initialMode="photo" />
      </section>

      <!-- Technical Guidelines & Interlinking Section -->
      <section class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="md:col-span-2 space-y-4 bg-card border border-border p-6 rounded-2xl">
          <h2 class="text-xl font-bold text-foreground">
            Spesifikasi Pasfoto Formal &amp; Swafoto Live SSCASN BKN
          </h2>
          <ul class="space-y-2.5 text-xs sm:text-sm text-muted-foreground">
            <li class="flex items-start gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span><strong>Ukuran &amp; Rasio Pasfoto:</strong> Ukuran cetak 3×4 cm (rasio aspek 3:4 tegak, disiapkan pada kanvas tajam 450 × 600 px). Buku petunjuk BKN (§3.5) tidak menetapkan angka piksel baku; dimensi mengikuti rasio resmi 3:4.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span><strong>Ukuran File Pasfoto Formal:</strong> 120 KB hingga 200 KB dalam format JPG/JPEG sesuai ketentuan pengumuman resmi instansi &amp; portal SSCASN.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span><strong>Latar Belakang &amp; Pakaian:</strong> Warna merah polos, mengenakan kemeja putih berkerah rapi (tanpa bayangan atau corak).</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-amber-500 font-bold">ℹ</span>
              <span><strong>Swafoto (Kamera Live Portal):</strong> Berdasarkan Buku Petunjuk CASN BKN (§3.1 langkah 12), swafoto diambil langsung melalui kamera di portal saat pembuatan akun (verifikasi pengenalan wajah, bukan file unggahan dan tidak memegang KTP/kartu akun). Pastikan cahaya depan terang dan wajah tanpa masker/kacamata hitam.</span>
            </li>
          </ul>
        </div>

        <!-- Cross Interlinking Box -->
        <div class="space-y-4 bg-primary/5 border border-primary/20 p-6 rounded-2xl">
          <h3 class="text-base font-bold text-foreground">Panduan &amp; Alat Terkait Indonesia</h3>
          <div class="space-y-2 text-xs">
            <a href="/blog/cpns-sscasn-2026-panduan-daftar-pasfoto-merah-swafoto-kompres-100-300kb/" class="block p-2.5 rounded-xl bg-red-500/10 border border-red-500/30 text-red-700 dark:text-red-300 hover:bg-red-500/20 transition font-bold">
              📖 Panduan Lengkap CPNS 2026: Pasfoto 3×4 (120–200 KB), Swafoto Live &amp; e-Meterai →
            </a>
            <a href="/id/utbk-snbt-photo-resizer/" class="block p-2.5 rounded-xl bg-card border border-border hover:border-primary transition font-medium text-foreground">
              🎓 UTBK-SNBT Pasfoto Resizer (4×6 cm, 40–100 KB) →
            </a>
            <a href="/id/indonesia-passport-visa-photo-resizer/" class="block p-2.5 rounded-xl bg-card border border-border hover:border-primary transition font-medium text-foreground">
              🛂 Indonesia Passport &amp; eVisa Photo Resizer →
            </a>
            <a href="/id/" class="block p-2.5 rounded-xl bg-primary text-primary-foreground text-center font-bold hover:opacity-90 transition mt-2">
              Kembali ke Hub Indonesia →
            </a>
          </div>
        </div>
      </section>

      <!-- FAQ Section -->
      <section class="space-y-6">
        <FaqSection faqs={cpnsFaqs} title="Pertanyaan Umum CPNS / SSCASN Photo Resizer" />
      </section>
    </main>

    <Footer />
  </body>
</html>
