---
// src/pages/compress-image-to-kb.astro
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import GoogleFonts from '../components/GoogleFonts.astro';
import { ImageCompressorTool } from '../components/ImageCompressorTool';

const pageTitle = "Photo Size Reducer & KB Increaser (20KB, 50KB, 100KB) - SignResize";
const pageDescription = "Free photo size reducer and KB increaser online. Reduce image size in KB (15KB, 20KB, 50KB, 100KB) or increase small JPGs to minimum KB without blurring pixels.";
const canonicalUrl = "https://signresize.in/compress-image-to-kb/";
const ogImageUrl = "https://signresize.in/og-image.png";
const keywordsContent = "photo size reducer, compress image to kb, reduce image size in kb, photo size increase in kb, compress image to 20 kb, compress image to 50 kb, compress image to 100 kb, photo size should be maximum 100kb, signature size should be at least 20kb, photo ka size kaise kam kare, photo ka size kaise badhaye";

const faqs = [
  {
    q: "How to use this Photo Size Reducer to reduce photo to 20 KB, 50 KB, or 100 KB?",
    a: "Upload your photo, certificate, or signature into the workspace, keep 'Reduce Size (Max KB)' selected, and click 20 KB, 50 KB, or 100 KB (or type any target like 15 KB, 30 KB, or 40 KB). Your browser reduces the file size immediately while preserving sharp text and facial edges."
  },
  {
    q: "How to increase photo or signature size in KB (fix 'should be at least 20kb' error)?",
    a: "Switch to the 'Increase Size (Min KB)' tab above the upload box, select JPG format, and enter the minimum KB required by your form (such as 20 KB, 30 KB, or 50 KB). SignResize safely adds standard JPG metadata padding to lift undersized files above the minimum floor without stretching or blurring pixels. (If your original image has very low pixel resolution, capture a clearer scan first.)"
  },
  {
    q: "How do I fix 'photo size should be maximum 100kb' or 'signature size should be between 10 kb and 20 kb'?",
    a: "When an application portal shows 'photo size should be maximum 100kb', select Reduce Size and choose 100 KB (or 50 KB). If it says 'signature size should be between 10 kb and 20 kb', use our dedicated 10–20 KB Signature Resizer or set 20 KB here and check the final downloaded file size. (Hindi meaning: आपकी फोटो या हस्ताक्षर फाइल की साइज पोर्टल की तय KB सीमा से बाहर है — सही KB सेट करके दोबारा डाउनलोड करें।)"
  },
  {
    q: "Photo ka size kaise kam kare ya badhaye online (फोटो का साइज कैसे कम करें)?",
    a: "Photo ka size kam karne ke liye 'Reduce Size (Max KB)' par apna target KB (20 KB, 50 KB, ya 100 KB) chunein. Agar form me minimum KB mang raha hai aur photo chhoti pad rahi hai, toh 'Increase Size (Min KB)' chunkar photo ka size badhaye. Complete Hindi guide ke liye SignResize Hindi (/hi/) page bhi dekhein."
  },
  {
    q: "Will reducing my certificate or marksheet make the text unreadable?",
    a: "No. SignResize uses iterative HTML5 canvas quantization in your browser to keep characters, roll numbers, and edges sharp even at 50 KB or 100 KB."
  },
  {
    q: "What image formats are supported for reducing or increasing KB?",
    a: "You can upload JPG, JPEG, PNG, and WebP photos or scans. Reducing size supports JPG, WebP, and PNG exports; increasing undersized files to minimum KB uses standard JPG format."
  },
  {
    q: "Is it safe to upload government ID cards and certificates here?",
    a: "Yes, 100%. SignResize runs entirely in your browser memory on your own device. Zero bytes are uploaded to external servers."
  }
];
---

<!doctype html>
<html lang="en-IN" class="scroll-smooth">
  <head>
    <!-- Google tag (gtag.js) -->
    <GoogleAnalytics />

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={keywordsContent} />
    <meta name="author" content="SignResize.in" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph (OG) Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="SignResize" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- PWA & Mobile Meta Tags -->
    <meta name="theme-color" content="#4f46e5" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="SignResize" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Async Google Fonts -->
    <GoogleFonts />

    <!-- SoftwareApplication & WebApplication Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": ["SoftwareApplication", "WebApplication"],
      "name": "Compress Image to KB Tool",
      "url": canonicalUrl,
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "All (Android, iOS, Windows, macOS, Linux)",
      "browserRequirements": "Requires JavaScript. Requires HTML5 Canvas support.",
      "description": pageDescription,
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "INR"
      },
      "featureList": [
        "Compress image to 20 KB, 50 KB, 100 KB, 200 KB, 500 KB",
        "Fine-tuning target KB slider",
        "JPG, PNG, WebP format support",
        "100% in-browser privacy with zero server uploads"
      ]
    })} />

    <!-- BreadcrumbList Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://signresize.in/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Compress Image to KB",
          "item": canonicalUrl
        }
      ]
    })} />

    <!-- FAQPage Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": f.a
        }
      }))
    })} />
  </head>

  <body class="bg-background text-foreground selection:bg-primary/20 selection:text-primary min-h-screen flex flex-col antialiased">
    <Header />

    <main class="flex-1 w-full max-w-[1480px] mx-auto px-3 sm:px-6 lg:px-8 py-6 space-y-8">
      
      <!-- Breadcrumb Bar -->
      <nav class="flex items-center gap-2 text-xs text-muted-foreground" aria-label="Breadcrumb">
        <a href="/" class="hover:text-primary transition">Home</a>
        <span>/</span>
        <span class="text-foreground font-medium">Compress Image to KB</span>
      </nav>

      <!-- Hero Header Banner -->
      <section class="rounded-2xl border border-primary/20 bg-gradient-to-r from-card via-card/90 to-primary/5 p-4 sm:p-6 shadow-sm backdrop-blur">
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
          <div class="space-y-1.5">
            <div class="flex items-center gap-2 flex-wrap">
              <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-primary/10 text-primary border border-primary/20">
                <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
                Precision KB Engine
              </span>
              <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md text-[11px] font-mono text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 border border-emerald-500/20">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                0 Bytes Uploaded • 100% Private
              </span>
            </div>
            <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-foreground leading-[1.15]">
              Photo Size Reducer &amp; <span class="text-primary">Target KB</span> Tool
            </h1>
            <p class="text-xs sm:text-sm text-muted-foreground max-w-3xl leading-relaxed">
              Reduce image size in KB (<strong>15KB, 20KB, 30KB, 40KB, 50KB, 100KB, 200KB</strong>) or <strong>increase small JPGs above minimum KB thresholds</strong> (fix <em>"should be at least 20kb"</em> or <em>"maximum 100kb"</em> portal errors). 100% private in-browser engine.
            </p>
          </div>

          <!-- Quick KB Badges -->
          <div class="flex items-center gap-2 flex-wrap shrink-0">
            <div class="px-3 py-2 rounded-xl bg-card border border-border text-center">
              <div class="text-[9px] uppercase font-bold text-muted-foreground">SSC &amp; Bank</div>
              <div class="text-xs font-bold text-primary font-mono">20 KB</div>
            </div>
            <div class="px-3 py-2 rounded-xl bg-card border border-border text-center">
              <div class="text-[9px] uppercase font-bold text-muted-foreground">PAN &amp; UPSC</div>
              <div class="text-xs font-bold text-primary font-mono">50 KB</div>
            </div>
            <div class="px-3 py-2 rounded-xl bg-card border border-border text-center">
              <div class="text-[9px] uppercase font-bold text-muted-foreground">Certificates</div>
              <div class="text-xs font-bold text-primary font-mono">100–200 KB</div>
            </div>
          </div>
        </div>
      </section>

      <!-- Main Layout: Compressor Tool + Knowledge Sidebar -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        <div class="lg:col-span-8 space-y-6">
          <div class="bg-card border border-border rounded-2xl p-4 sm:p-6 shadow-sm min-h-[650px] sm:min-h-[580px]">
            <ImageCompressorTool client:idle />
          </div>

          <!-- Guide Section -->
          <div class="bg-card border border-border rounded-2xl p-5 shadow-sm space-y-4">
            <h2 class="text-base font-bold text-foreground flex items-center gap-2">
              <span>📖</span> How Reducing &amp; Increasing Image Size in KB Works
            </h2>
            <div class="space-y-3 text-xs text-muted-foreground leading-relaxed">
              <p>
                <strong>1. Reduce Size (Max KB):</strong> Application forms commonly limit photos or documents to <strong>20 KB, 50 KB, or 100 KB maximum</strong>. SignResize uses iterative binary-search compression on your browser's canvas to lower file size while keeping text and faces crisp.
              </p>
              <p>
                <strong>2. Increase Size (Min KB):</strong> Many portals reject tiny mobile crops with errors like <em>"file size should be at least 20kb"</em> or require <strong>20–50 KB</strong> minimum bounds. Switch to <strong>Increase Size (Min KB)</strong> mode above to safely lift undersized JPGs above your target floor using legal JPEG comment padding without stretching pixels. Check your notice's pixel dimensions separately on the <a href="/photo-resizer/" class="text-primary font-semibold underline">Photo Resizer in KB</a> page when resizing dimensions too.
              </p>
            </div>

            <!-- FAQ Section -->
            <div class="pt-4 border-t border-border space-y-3">
              <h3 class="text-sm font-bold text-foreground">Frequently Asked Questions</h3>
              <div class="space-y-2">
                {faqs.map((f) => (
                  <details class="group p-3.5 rounded-xl border border-border bg-muted/20 open:bg-card transition">
                    <summary class="flex items-center justify-between font-semibold text-foreground text-xs cursor-pointer select-none">
                      <span>{f.q}</span>
                      <span class="text-primary group-open:rotate-180 transition-transform ml-2">▼</span>
                    </summary>
                    <p class="pt-2 text-xs text-muted-foreground leading-relaxed">{f.a}</p>
                  </details>
                ))}
              </div>
            </div>
          </div>
        </div>

        <!-- Sidebar -->
        <aside class="lg:col-span-4 space-y-4 sticky top-16">
          <div class="bg-card border border-border rounded-2xl p-5 shadow-sm space-y-3 text-xs">
            <div class="font-bold text-foreground">Common Portal Size Requirements</div>
            <ul class="space-y-2 text-[11px] text-muted-foreground">
              <li class="flex items-center justify-between pb-1.5 border-b border-border/50">
                <strong class="text-foreground">Candidate Photograph:</strong>
                <span class="font-mono text-primary">20 KB – 50 KB</span>
              </li>
              <li class="flex items-center justify-between pb-1.5 border-b border-border/50">
                <strong class="text-foreground">Candidate Signature:</strong>
                <span class="font-mono text-primary">10 KB – 20 KB</span>
              </li>
              <li class="flex items-center justify-between pb-1.5 border-b border-border/50">
                <strong class="text-foreground">Left Thumb Impression:</strong>
                <span class="font-mono text-primary">10 KB – 20 KB</span>
              </li>
              <li class="flex items-center justify-between pb-1.5 border-b border-border/50">
                <strong class="text-foreground">Class 10th / 12th Certificate:</strong>
                <span class="font-mono text-primary">100 KB – 200 KB</span>
              </li>
              <li class="flex items-center justify-between">
                <strong class="text-foreground">Caste / EWS / PwD Certificate:</strong>
                <span class="font-mono text-primary">100 KB – 300 KB</span>
              </li>
            </ul>
          </div>

          <div class="bg-card border border-border rounded-2xl p-5 shadow-sm space-y-3 text-xs">
            <div class="font-bold text-foreground">Need to Resize a Signature?</div>
            <p class="text-[11px] text-muted-foreground">
              Use our dedicated signature resizer to automatically crop to 140×60 px (4×2 cm) with Clean White Paper shadow removal.
            </p>
            <a
              href="/#tool-workspace"
              class="block w-full text-center py-2 px-3 rounded-xl bg-primary text-primary-foreground font-bold text-xs hover:bg-primary/90 transition shadow-xs"
            >
              Go to Signature Resizer →
            </a>
          </div>
        </aside>
      </div>

    </main>

    <Footer />
  </body>
</html>
