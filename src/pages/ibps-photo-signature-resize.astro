    <Footer />

    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const signBtn = document.getElementById('btn-switch-sign');
        const photoBtn = document.getElementById('btn-switch-photo');
        const thumbBtn = document.getElementById('btn-switch-thumb');
        const declBtn = document.getElementById('btn-switch-declaration');

        if (signBtn) {
          signBtn.addEventListener('click', () => {
            window.dispatchEvent(new CustomEvent('select-ibps-section', { detail: 'signature' }));
            document.getElementById('crop-workspace')?.scrollIntoView({ behavior: 'smooth' });
          });
        }

        if (photoBtn) {
          photoBtn.addEventListener('click', () => {
            window.dispatchEvent(new CustomEvent('select-ibps-section', { detail: 'photo' }));
            document.getElementById('crop-workspace')?.scrollIntoView({ behavior: 'smooth' });
          });
        }

        if (thumbBtn) {
          thumbBtn.addEventListener('click', () => {
            window.dispatchEvent(new CustomEvent('select-ibps-section', { detail: 'thumb' }));
            document.getElementById('crop-workspace')?.scrollIntoView({ behavior: 'smooth' });
          });
        }

        if (declBtn) {
          declBtn.addEventListener('click', () => {
            window.dispatchEvent(new CustomEvent('select-ibps-section', { detail: 'declaration' }));
            document.getElementById('crop-workspace')?.scrollIntoView({ behavior: 'smooth' });
          });
        }
      });
