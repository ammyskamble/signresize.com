    <script>
      function initTocScrollSpy() {
        const tocLinks = document.querySelectorAll('.toc-desktop-link');
        if (!tocLinks.length) return;

        const headingIds = Array.from(tocLinks).map(link => link.getAttribute('data-target')).filter(Boolean);
        const headings = headingIds.map(id => document.getElementById(id)).filter(Boolean);

        if (!headings.length) return;

        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              const currentId = entry.target.id;
              tocLinks.forEach(link => {
                const isMatch = link.getAttribute('data-target') === currentId;
                if (isMatch) {
                  link.classList.add(
                    'text-blue-900',
                    'dark:text-cyan-200',
                    'font-bold',
                    'bg-blue-100',
                    'dark:bg-cyan-950/70',
                    'border-l-[3px]',
                    'border-blue-600',
                    'dark:border-cyan-400',
                    'shadow-2xs'
                  );
                  link.classList.remove('text-slate-700', 'dark:text-slate-300', 'font-medium');
                } else {
                  link.classList.remove(
                    'text-blue-900',
                    'dark:text-cyan-200',
                    'font-bold',
                    'bg-blue-100',
                    'dark:bg-cyan-950/70',
                    'border-l-[3px]',
                    'border-blue-600',
                    'dark:border-cyan-400',
                    'shadow-2xs'
                  );
                  link.classList.add('text-slate-700', 'dark:text-slate-300', 'font-medium');
                }
              });
            }
          });
        }, {
          rootMargin: '-10% 0px -70% 0px',
          threshold: 0
        });

        headings.forEach(h => observer.observe(h));
      }

      document.addEventListener('DOMContentLoaded', initTocScrollSpy);
      document.addEventListener('astro:page-load', initTocScrollSpy);
    </script>
  </body>
</html>
