---
// src/pages/blog/[slug].astro
import '../../styles/global.css';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import GoogleAnalytics from '../../components/GoogleAnalytics.astro';
import GoogleFonts from '../../components/GoogleFonts.astro';
import ThemeScript from '../../components/ThemeScript.astro';
import { WebcamChecker } from '../../components/WebcamChecker';
import SocialShare from '../../components/SocialShare.astro';
import { BLOG_POSTS, type BlogPost } from '../../data/blogPostsData';
import { EXAM_PRESETS, ALL_COMBINED_PRESETS } from '../../data/examPresets';
import { EXAM_PAGES_DATA } from '../../data/examPagesData';
import { EXAM_GUIDANCE } from '../../data/examGuidance';
import { getExamPageUrl } from '../../utils/examPageUrls';

export function getStaticPaths() {
  return BLOG_POSTS.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;

const pageTitle = post.metaTitle || (post.title.length > 50 ? `${post.title.slice(0, 48)}... | SignResize` : `${post.title} | SignResize`);
const pageDescription = post.metaDescription || post.excerpt;
const canonicalUrl = `https://signresize.in/blog/${post.slug}/`;

// Find related preset if specified
const relatedPreset = post.relatedExamPreset
  ? ALL_COMBINED_PRESETS.find(p => p.id === post.relatedExamPreset) || EXAM_PRESETS.find(p => p.id === post.relatedExamPreset)
  : null;

const focusedPreset = post.relatedExamPreset || (/sbi-clerk/i.test(post.slug) ? 'sbi-clerk' : /sbi-po/i.test(post.slug) ? 'sbi-po' : /sbi/i.test(post.slug) ? 'sbi-signature' : /iit-jam/i.test(post.slug) ? 'iit-jam' : undefined);

// Determine related exam page slug based on explicit country or preset mapping
let relatedExamSlug = 'ssc-signature-resize';
if (post.country === 'BD') {
  relatedExamSlug = 'teletalk-photo-signature-resize';
} else if (post.country === 'PK') {
  relatedExamSlug = 'pk/ppsc-signature-resize';
} else if (post.country === 'PH') {
  relatedExamSlug = 'ph/prc-photo-signature-resize-philippines';
} else if (post.country === 'NP') {
  relatedExamSlug = 'np/lok-sewa-photo-resize-nepal';
} else if (post.country === 'US') {
  relatedExamSlug = 'us/ds-160-photo-resizer';
} else if (post.country === 'ID') {
  relatedExamSlug = 'id/cpns-sscasn-photo-resizer';
} else if (focusedPreset) {
  const matchedPage = EXAM_PAGES_DATA.find(p => p.presetId === focusedPreset || p.slug === focusedPreset);
  if (matchedPage) {
    relatedExamSlug = matchedPage.slug;
  }
}

const isPkiCompliancePost = post.country === 'US' || (post.tags && post.tags.some(t => /pki|nist|digital signature|esign|cryptograph/i.test(t)));
const isWbpscPost = Boolean(post.tags && post.tags.some(t => /wbpsc|wbcs/i.test(t)));
const isOssscPost = Boolean(post.slug?.includes("osssc") || (post.tags && post.tags.some(t => /osssc/i.test(t))));
// Route exam-specific articles to their own guidance instead of a generic SSC CTA.
const guidanceSlug = post.slug.startsWith('ssc-cgl-') ? 'ssc-cgl-signature-resize'
  : post.slug.startsWith('ssc-chsl-') ? 'ssc-chsl-signature-resize'
  : post.slug.startsWith('ssc-mts-') ? 'ssc-mts-signature-resize'
  : post.slug.startsWith('ctet-') ? 'ctet-signature-resize'
  : post.slug.startsWith('ssc-live-photo-') ? 'ssc-photo-resize'
  : null;
const sourceGuide = guidanceSlug ? EXAM_PAGES_DATA.find(page => page.slug === guidanceSlug) : null;
if (guidanceSlug) relatedExamSlug = guidanceSlug;

// Intelligent Related Posts selection:
// Calculate relevance score for all other posts based on category, tags, and cluster overlap
const scoredPosts = BLOG_POSTS.filter(p => p.slug !== post.slug).map(other => {
  let score = 0;
  if (other.category === post.category) score += 3;
  if (other.relatedExamPreset && post.relatedExamPreset && other.relatedExamPreset === post.relatedExamPreset) score += 5;
  if (other.tags && post.tags) {
    const sharedTags = other.tags.filter(t => post.tags.includes(t));
    score += sharedTags.length * 2;
  }
  // High-value cross-relevance bonuses (e.g. general mistake guide relevant to all)
  if (other.slug === 'top-5-mistakes-photo-signature-rejection-govt-exams') score += 1;
  return { post: other, score };
});

scoredPosts.sort((a, b) => b.score - a.score);
const relatedPosts = scoredPosts.slice(0, 3).map(s => s.post);

// Date formatting helper for Schema
function toIsoDate(dateStr?: string): string {
  if (!dateStr) return "2026-09-20";
  try {
    const parsed = new Date(dateStr);
    if (!isNaN(parsed.getTime())) {
      return parsed.toISOString().split('T')[0];
    }
  } catch {}
  return "2026-09-20";
}

const publishedIso = toIsoDate(post.publishDate);
const modifiedIso = toIsoDate(post.lastUpdated || post.publishDate);

// Dynamic Breadcrumb Schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://signresize.in/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Blog",
      "item": "https://signresize.in/blog/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": post.title,
      "item": canonicalUrl
    }
  ]
};

// Dynamic BlogPosting & TechArticle Schema
const articleSchema = {
  "@context": "https://schema.org",
  "@type": post.category === 'Guidelines & Tips' ? ["BlogPosting", "TechArticle"] : "BlogPosting",
  "headline": post.title,
  "description": post.excerpt,
  "image": ["https://signresize.in/favicon-96x96.png"],
  "datePublished": publishedIso,
  "dateModified": modifiedIso,
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalUrl
  },
  "author": {
    "@type": "Organization",
    "name": post.author,
    "url": "https://signresize.in/about"
  },
  "publisher": {
    "@type": "Organization",
    "name": "SignResize",
    "url": "https://signresize.in",
    "logo": {
      "@type": "ImageObject",
      "url": "https://signresize.in/favicon-96x96.png"
    }
  }
};

// Helper to sanitize text for JSON-LD Schemas (removing markdown markup and HTML tags)
function cleanSchemaText(text: string): string {
  if (!text) return '';
  return text
    .replace(/<[^>]*>?/gm, '')
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
    .replace(/(\*\*|__)(.*?)\1/g, '$2')
    .replace(/(\*|_)(.*?)\1/g, '$2')
    .replace(/`([^`]+)`/g, '$1')
    .replace(/==/g, '')
    .replace(/\s+/g, ' ')
    .trim();
}

interface NavItem {
  id: string;
  title: string;
}

function slugify(text: string): string {
  return text
    .toLowerCase()
    .replace(/<[^>]*>/g, '')
    .replace(/[^\w\s-]/g, '')
    .trim()
    .replace(/\s+/g, '-');
}

function decodeHtmlEntities(str: string): string {
  if (!str) return '';
  return str
    .replace(/&amp;/g, '&')
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'")
    .replace(/&nbsp;/g, ' ');
}

// Process article HTML to inject missing IDs on <h2>, adjust sticky offsets, and format markups
function processArticleContent(rawHtml: string, faqs?: any[]): { processedHtml: string; navItems: NavItem[] } {
  if (!rawHtml) return { processedHtml: '', navItems: [] };

  let html = rawHtml;
  const navItems: NavItem[] = [];
  const registeredIds = new Set<string>();

  // 1. First ensure all <h2> tags have an id attribute and scroll-mt-28 sm:scroll-mt-32 to clear the 104px sticky header
  html = html.replace(/<h2([^>]*)>([\s\S]*?)<\/h2>/gi, (match, attrs, content) => {
    const rawText = decodeHtmlEntities(content.replace(/<[^>]*>/g, '').replace(/\s+/g, ' ').trim());
    const idMatch = attrs.match(/id="([^"]+)"/);
    let id = idMatch ? idMatch[1] : slugify(rawText);
    if (!id) id = `section-h2-${navItems.length + 1}`;

    let updatedAttrs = attrs;
    if (!updatedAttrs.includes('id=')) {
      updatedAttrs = ` id="${id}"${updatedAttrs}`;
    }
    if (!updatedAttrs.includes('scroll-mt-')) {
      if (updatedAttrs.includes('class="')) {
        updatedAttrs = updatedAttrs.replace(/class="([^"]*)"/, 'class="$1 scroll-mt-40 sm:scroll-mt-44"');
      } else {
        updatedAttrs = ` class="scroll-mt-40 sm:scroll-mt-44"${updatedAttrs}`;
      }
    }

    // Auto-inject alias anchor for numeric sections like #section-5 or #section-1
    let prefix = '';
    const sectionNumMatch = rawText.match(/(?:^|\b)(?:section\s+)?(\d+)[\.\-\)]\s*/i);
    if (sectionNumMatch && id !== `section-${sectionNumMatch[1]}`) {
      prefix = `<span id="section-${sectionNumMatch[1]}" class="scroll-mt-40 sm:scroll-mt-44 block -mt-6 pt-6"></span>`;
    }

    return `${prefix}<h2${updatedAttrs}>${content}</h2>`;
  });

  // 2. Parse all <h2> elements (including those inside <section id="...">) in order
  const h2Regex = /<h2[^>]*id="([^"]+)"[^>]*>([\s\S]*?)<\/h2>/gi;
  let h2Match: RegExpExecArray | null;
  while ((h2Match = h2Regex.exec(html)) !== null) {
    const id = h2Match[1];
    const rawTitle = decodeHtmlEntities(h2Match[2].replace(/<[^>]*>/g, '').replace(/\s+/g, ' ').trim());
    const cleanTitle = rawTitle
      .replace(/^([\p{Extended_Pictographic}\u2000-\u3300\uFE00-\uFE0F\s]*\d+[\.\-\)]\s*)+/u, '')
      .replace(/^[*_~`]+|[*_~`]+$/g, '')
      .replace(/[*_~`]/g, '')
      .trim() || rawTitle;

    if (!registeredIds.has(id)) {
      registeredIds.add(id);
      navItems.push({ id, title: cleanTitle });
    }
  }

  // 3. Fallback: if still empty, check for known landmark IDs in the HTML
  if (navItems.length === 0) {
    const knownLandmarks = [
      { id: 'overview', title: 'Overview & Context' },
      { id: 'master-specs', title: 'Master Specifications' },
      { id: 'diagnostic-failures', title: 'Rejection Traps & Fixes' },
      { id: 'online-workflow', title: 'Step-by-Step Workflow' },
      { id: 'dedicated-tools', title: 'Dedicated Resizer Tools' },
      { id: 'shooting-guide', title: 'Smartphone Shooting Guide' },
      { id: 'fee-payment-guide', title: 'Fee Payment Blueprint' },
      { id: 'ppsc-planner-guide', title: 'Planner & Exam Schedule' },
      { id: 'privacy-guarantee', title: 'Security & Privacy Guarantee' },
      { id: 'exam-pattern', title: 'Exam Pattern' },
      { id: 'document-specs', title: 'Document Specs' },
      { id: 'strategy', title: 'Preparation Strategy' }
    ];

    for (const landmark of knownLandmarks) {
      if (html.includes(`id="${landmark.id}"`) && !registeredIds.has(landmark.id)) {
        registeredIds.add(landmark.id);
        navItems.push(landmark);
      }
    }
  }

  // Always append FAQs if present
  if (faqs && faqs.length > 0) {
    navItems.push({ id: 'faqs', title: `Frequently Asked Questions (${faqs.length} Clarified)` });
  }

  // 4. Adjust sticky jump bars from `sticky top-4` or `sticky top-20` to `sticky top-28 sm:top-[116px]` to clear the sticky header and announcement strip
  html = html.replace(/sticky top-(?:4|20)/g, 'sticky top-28 sm:top-[116px]');

  // 5. Highlight syntax ==...==
  html = html.replace(/==(.*?)==/g, '<mark class="bg-amber-200/90 dark:bg-amber-900/60 text-amber-950 dark:text-amber-100 font-bold px-1.5 py-0.5 rounded border border-amber-400/40 dark:border-amber-600/40 selection:bg-amber-300 dark:selection:bg-amber-800">$1</mark>');

  return { processedHtml: html, navItems };
}

function formatHighlightMarkup(html: string): string {
  if (!html) return '';
  return html.replace(/==(.*?)==/g, '<mark class="bg-amber-200/90 dark:bg-amber-900/60 text-amber-950 dark:text-amber-100 font-bold px-1.5 py-0.5 rounded border border-amber-400/40 dark:border-amber-600/40 selection:bg-amber-300 dark:selection:bg-amber-800">$1</mark>');
}

const { processedHtml, navItems } = processArticleContent(post.contentHtml, post.faqs);


// Dynamic FAQPage Schema
const faqSchema = (post.faqs && post.faqs.length > 0) ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": post.faqs.map(f => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": cleanSchemaText(f.answer)
    }
  }))
} : null;
---

<!doctype html>
<html lang={post.country === 'US' ? 'en-US' : 'en-IN'} class="scroll-smooth">
  <head>
    <ThemeScript />
    <GoogleAnalytics />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={`https://signresize.in/blog/${post.slug}/`} />
    {Boolean(post.contentHtml_hi) && (
      <link rel="alternate" hreflang="hi" href={`https://signresize.in/hi/blog/${post.slug}/`} />
    )}
    {Boolean(post.contentHtml_mr) && (
      <link rel="alternate" hreflang="mr" href={`https://signresize.in/mr/blog/${post.slug}/`} />
    )}
    <link rel="alternate" hreflang="x-default" href={`https://signresize.in/blog/${post.slug}/`} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="SignResize" />
    <link rel="manifest" href="/site.webmanifest" />
    <GoogleFonts />

    <!-- Open Graph & Social Cards -->
    <meta property="og:type" content="article" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="SignResize" />
    <meta property="og:image" content="https://signresize.in/og-image.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content="https://signresize.in/og-image.png" />

    <!-- Article & Breadcrumb Schemas -->
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    {faqSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    )}
  </head>

  <body class="min-h-screen flex flex-col bg-background text-foreground antialiased selection:bg-primary/20 selection:text-primary">
    <Header />

    <main class="flex-1 max-w-6xl xl:max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 pt-6 sm:pt-10 md:pt-12 pb-20 sm:pb-12 space-y-6 sm:space-y-8 w-full min-w-0">
      
      <!-- Breadcrumbs & Language Switcher Bar -->
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-border/60 pb-3">
        <nav class="flex flex-wrap items-center gap-1.5 text-xs text-slate-600 dark:text-slate-400 font-medium" aria-label="Breadcrumb">
          <a href="/" class="hover:text-primary transition flex items-center gap-1 text-slate-700 dark:text-slate-300">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
            Home
          </a>
          <span>/</span>
          <a href="/blog/" class="hover:text-primary transition text-slate-700 dark:text-slate-300">Blog</a>
          <span>/</span>
          <span class="text-foreground font-semibold truncate max-w-[150px] sm:max-w-xs md:max-w-md">{post.title}</span>
        </nav>

        <!-- Language Switcher Bar / Edition Tag -->
        {post.country === 'US' ? (
          <div class="flex items-center gap-1.5 text-xs bg-slate-100 dark:bg-slate-800/80 px-3 py-1 rounded-xl border border-border text-slate-700 dark:text-slate-300">
            <span class="text-[10px] font-bold uppercase tracking-wider text-primary">🇺🇸 US Edition:</span>
            <span class="font-semibold text-foreground">Federal ESIGN & PKI Standards</span>
          </div>
        ) : (
          <div class="flex items-center gap-1.5 text-xs bg-slate-100 dark:bg-slate-800/80 p-1 rounded-xl border border-border">
            <span class="text-[10px] font-bold uppercase tracking-wider text-slate-600 dark:text-slate-400 px-2">📖 Read In:</span>
            <a href={`/blog/${post.slug}/`} class="px-2.5 py-1 rounded-lg bg-primary text-primary-foreground font-bold shadow-2xs">🇬🇧 English</a>
            {post.contentHtml_hi && <a href={`/hi/blog/${post.slug}/`} class="px-2.5 py-1 rounded-lg hover:bg-card text-slate-700 dark:text-slate-300 hover:text-foreground font-semibold transition">🇮🇳 हिंदी</a>}
            {post.contentHtml_mr && <a href={`/mr/blog/${post.slug}/`} class="px-2.5 py-1 rounded-lg hover:bg-card text-slate-700 dark:text-slate-300 hover:text-foreground font-semibold transition">🚩 मराठी</a>}
          </div>
        )}
      </div>

      <!-- Article Header -->
      <header id="article-header" class="space-y-3 sm:space-y-4 border-b border-border pb-5 sm:pb-6 scroll-mt-32 sm:scroll-mt-36">
        <div class="flex flex-wrap items-center gap-2 text-xs">
          <span class="inline-flex items-center gap-2 px-2.5 py-1 rounded-md font-bold uppercase tracking-wider bg-primary/10 text-primary border border-primary/20 shrink-0">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-primary"></span>
            </span>
            <span>{post.category}</span>
          </span>
          <span class="px-2.5 py-1 rounded-md text-slate-700 dark:text-slate-300 font-mono font-medium bg-slate-100 dark:bg-slate-800/80 border border-border flex items-center gap-1 shrink-0">
            <span>📅</span> {post.publishDate}
          </span>
          <span class="px-2.5 py-1 rounded-md font-semibold bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/25 flex items-center gap-1.5 font-mono shadow-xs shrink-0">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>Updated: {post.lastUpdated || post.publishDate}</span>
          </span>
          <span class="px-2.5 py-1 rounded-md text-slate-700 dark:text-slate-300 font-mono font-medium bg-slate-100 dark:bg-slate-800/80 border border-border flex items-center gap-1 shrink-0">
            ⏱️ {post.readTime}
          </span>
        </div>

        <!-- Highlighted Main Headline (H1) with Matching Ambient Animation -->
        <div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-primary/10 via-primary/5 to-card border border-primary/25 p-3.5 sm:p-6 shadow-xs scroll-mt-32 sm:scroll-mt-36">
          <!-- Ambient animated glowing flares matching hero banner -->
          <div class="absolute -right-8 -top-8 w-44 h-44 bg-primary/15 dark:bg-primary/25 rounded-full blur-2xl pointer-events-none animate-pulse"></div>
          <div class="absolute left-1/3 -bottom-10 w-36 h-36 bg-cyan-glow/10 rounded-full blur-xl pointer-events-none animate-pulse" style="animation-duration: 4s;"></div>
          <h1 class="relative text-xl sm:text-3xl lg:text-[2.5rem] font-extrabold tracking-tight text-foreground leading-[1.3] break-words hyphens-auto">
            {post.title}
          </h1>
        </div>

        <!-- Highlighted Subheadline Excerpt -->
        <p class="text-sm sm:text-base md:text-lg text-foreground/90 font-medium leading-relaxed pl-3 sm:pl-4 border-l-4 border-primary bg-primary/5 py-2.5 rounded-r-xl break-words">
          {post.excerpt}
        </p>

        <!-- Compact Action Strip (Instant Above-the-fold Tool Discovery) -->
        {post.quickTools && post.quickTools.length > 0 && (
          <div class="my-3 p-3 rounded-2xl bg-gradient-to-r from-primary/15 via-primary/5 to-card border-2 border-primary/30 shadow-xs space-y-2">
            <div class="flex items-center justify-between px-1">
              <span class="text-[11px] font-extrabold uppercase tracking-wider text-primary flex items-center gap-1.5">
                <span class="relative flex h-2 w-2">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
                  <span class="relative inline-flex rounded-full h-2 w-2 bg-primary"></span>
                </span>
                <span>⚡ Instant 1-Click Tool Launchpad</span>
              </span>
              <span class="text-[10px] text-muted-foreground font-mono hidden sm:inline">100% Free • No Sign-up • Zero Server Upload</span>
            </div>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
              {post.quickTools.map(t => (
                <a
                  href={t.href}
                  class="flex items-center gap-2 px-3 py-2 sm:py-2.5 rounded-xl bg-card border border-border hover:border-primary hover:bg-primary/5 transition font-semibold text-xs text-foreground shadow-2xs group"
                >
                  <span class="text-lg group-hover:scale-110 transition shrink-0">{t.icon || '⚡'}</span>
                  <div class="min-w-0 flex-1 leading-tight">
                    <div class="font-bold truncate text-foreground group-hover:text-primary transition">{t.label}</div>
                    {t.sublabel && <div class="text-[10px] text-emerald-600 dark:text-emerald-400 font-mono truncate">{t.sublabel}</div>}
                  </div>
                  <span class="text-primary text-xs opacity-60 group-hover:opacity-100 group-hover:translate-x-0.5 transition hidden md:inline shrink-0">&rarr;</span>
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- Author / Editorial Badge & Social Share Bar -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-3 border-t border-border/60">
          <div class="flex items-center gap-3 min-w-0">
