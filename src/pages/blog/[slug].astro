---
// src/pages/blog/[slug].astro
import '../../styles/global.css';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import GoogleAnalytics from '../../components/GoogleAnalytics.astro';
import GoogleFonts from '../../components/GoogleFonts.astro';
import ThemeScript from '../../components/ThemeScript.astro';
import { BLOG_POSTS, type BlogPost } from '../../data/blogPostsData';
import { EXAM_PRESETS } from '../../data/examPresets';
import { EXAM_PAGES_DATA } from '../../data/examPagesData';

export function getStaticPaths() {
  return BLOG_POSTS.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;

const pageTitle = post.metaTitle || (post.title.length > 50 ? `${post.title.slice(0, 48)}... | SignResize` : `${post.title} | SignResize`);
const pageDescription = post.metaDescription || post.excerpt;
const canonicalUrl = `https://signresize.in/blog/${post.slug}/`;

// Find related preset if specified
const relatedPreset = post.relatedExamPreset
  ? EXAM_PRESETS.find(p => p.id === post.relatedExamPreset)
  : null;

const relatedExamPage = post.relatedExamPreset
  ? EXAM_PAGES_DATA.find(p => p.presetId === post.relatedExamPreset || p.slug === post.relatedExamPreset)
  : null;
const relatedExamSlug = relatedExamPage ? relatedExamPage.slug : 'ssc-signature-resize';

// Related posts (excluding current)
const relatedPosts = BLOG_POSTS.filter(p => p.slug !== post.slug).slice(0, 2);

// Date formatting helper for Schema
function toIsoDate(dateStr?: string): string {
  if (!dateStr) return "2026-09-20";
  try {
    const parsed = new Date(dateStr);
    if (!isNaN(parsed.getTime())) {
      return parsed.toISOString().split('T')[0];
    }
  } catch {}
  return "2026-09-20";
}

const publishedIso = toIsoDate(post.publishDate);
const modifiedIso = toIsoDate(post.lastUpdated || post.publishDate);

// Dynamic Breadcrumb Schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://signresize.in/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Blog",
      "item": "https://signresize.in/blog/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": post.title,
      "item": canonicalUrl
    }
  ]
};

// Dynamic BlogPosting Schema
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.title,
  "description": post.excerpt,
  "image": ["https://signresize.in/favicon-96x96.png"],
  "datePublished": publishedIso,
  "dateModified": modifiedIso,
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalUrl
  },
  "author": {
    "@type": "Organization",
    "name": post.author,
    "url": "https://signresize.in/about"
  },
  "publisher": {
    "@type": "Organization",
    "name": "SignResize",
    "url": "https://signresize.in",
    "logo": {
      "@type": "ImageObject",
      "url": "https://signresize.in/favicon-96x96.png"
    }
  }
};

// Dynamic FAQPage Schema
const faqSchema = (post.faqs && post.faqs.length > 0) ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": post.faqs.map(f => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.answer.replace(/<[^>]*>?/gm, '').trim()
    }
  }))
} : null;
---

<!doctype html>
<html lang="en-IN" class="scroll-smooth">
  <head>
    <ThemeScript />
    <GoogleAnalytics />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="SignResize" />
    <link rel="manifest" href="/site.webmanifest" />
    <GoogleFonts />

    <!-- Open Graph -->
    <meta property="og:type" content="article" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="SignResize" />

    <!-- Article & Breadcrumb Schemas -->
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    {faqSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    )}
  </head>

  <body class="min-h-screen flex flex-col bg-background text-foreground antialiased selection:bg-primary/20 selection:text-primary">
    <Header />

    <main class="flex-1 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8 space-y-8">
      
      <!-- Breadcrumbs -->
      <nav class="flex items-center gap-2 text-xs text-muted-foreground" aria-label="Breadcrumb">
        <a href="/" class="hover:text-primary transition flex items-center gap-1">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          Home
        </a>
        <span>/</span>
        <a href="/blog/" class="hover:text-primary transition">Blog</a>
        <span>/</span>
        <span class="text-foreground font-medium truncate max-w-[200px] sm:max-w-none">{post.title}</span>
      </nav>

      <!-- Article Header -->
      <header class="space-y-4 border-b border-border pb-6">
        <div class="flex flex-wrap items-center gap-2">
          <span class="px-2.5 py-1 rounded-md text-xs font-bold uppercase tracking-wider bg-primary/10 text-primary border border-primary/20">
            {post.category}
          </span>
          <span class="text-xs text-muted-foreground font-mono">
            {post.publishDate}
          </span>
          {post.lastUpdated && (
            <span class="px-2 py-0.5 rounded text-[11px] font-semibold bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20">
              Verified: {post.lastUpdated}
            </span>
          )}
          <span class="text-muted-foreground">•</span>
          <span class="text-xs text-muted-foreground font-mono">
            ⏱️ {post.readTime}
          </span>
        </div>

        <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-foreground leading-[1.2]">
          {post.title}
        </h1>

        <p class="text-base sm:text-lg text-muted-foreground leading-relaxed">
          {post.excerpt}
        </p>

        <!-- Author / Editorial Badge (E-E-A-T) -->
        <div class="flex items-center gap-3 pt-2">
          <div class="w-9 h-9 rounded-full bg-primary/10 border border-primary/20 flex items-center justify-center font-bold text-primary text-sm">
            SR
          </div>
          <div class="text-xs">
            <div class="font-bold text-foreground">{post.author}</div>
            <div class="text-muted-foreground">{post.authorRole} • Official Exam Standards</div>
          </div>
        </div>
      </header>

      <!-- Executive Summary / Quick Facts Banner (if available) -->
      {post.quickFacts && post.quickFacts.length > 0 && (
        <section class="rounded-2xl border-2 border-primary/30 bg-gradient-to-br from-card via-primary/5 to-card p-5 sm:p-6 shadow-xs space-y-3">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-primary">
              <span>⚡</span>
              <span>Quick Facts &amp; Executive Summary</span>
            </div>
            <span class="text-[11px] text-muted-foreground font-mono">Official Benchmarks</span>
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 pt-1">
            {post.quickFacts.map((fact) => (
              <div class="p-3 rounded-xl bg-card border border-border/70 space-y-1">
                <div class="text-[11px] font-semibold text-muted-foreground uppercase tracking-wide">
                  {fact.label}
                </div>
                <div class="text-xs sm:text-sm font-bold text-foreground">
                  {fact.value}
                </div>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Table of Contents / Quick Jump -->
      <nav class="rounded-xl border border-border bg-muted/30 p-4 sm:p-5 space-y-2.5">
        <div class="flex items-center gap-2 text-xs font-bold text-foreground uppercase tracking-wider">
          <span>📑</span>
          <span>Quick Navigation &amp; Key Sections</span>
        </div>
        <div class="flex flex-wrap gap-2 text-xs">
          <a href="#overview" class="px-2.5 py-1 rounded-lg bg-card border border-border hover:border-primary/50 hover:text-primary transition font-medium">
            1. Overview &amp; Key Dates
          </a>
          <a href="#exam-pattern" class="px-2.5 py-1 rounded-lg bg-card border border-border hover:border-primary/50 hover:text-primary transition font-medium">
            2. Exam Pattern &amp; Blueprint
          </a>
          <a href="#document-specs" class="px-2.5 py-1 rounded-lg bg-card border border-border hover:border-primary/50 hover:text-primary transition font-medium">
            3. Photo &amp; Signature Specs
          </a>
          <a href="#strategy" class="px-2.5 py-1 rounded-lg bg-card border border-border hover:border-primary/50 hover:text-primary transition font-medium">
            4. Preparation Strategy
          </a>
          {post.faqs && post.faqs.length > 0 && (
            <a href="#faqs" class="px-2.5 py-1 rounded-lg bg-primary/10 text-primary border border-primary/30 hover:bg-primary/20 transition font-bold">
              5. Top 10 FAQs (Accordion)
            </a>
          )}
        </div>
      </nav>

      <!-- Main Article Prose Content -->
      <article class="prose prose-slate dark:prose-invert max-w-none prose-headings:font-bold prose-h2:text-xl sm:prose-h2:text-2xl prose-h2:mt-8 prose-h2:mb-3 prose-p:leading-relaxed prose-p:text-slate-700 dark:prose-p:text-slate-300 prose-li:text-slate-700 dark:prose-li:text-slate-300">
        <Fragment set:html={post.contentHtml} />
      </article>

      <!-- Interactive FAQ Accordion Section (Rendered if faqs array exists) -->
      {post.faqs && post.faqs.length > 0 && (
        <section id="faqs" class="space-y-4 pt-6 border-t border-border">
          <div class="space-y-1">
            <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold bg-primary/10 text-primary border border-primary/20">
              <span>❓</span> Official Candidate FAQs
            </div>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-foreground tracking-tight">
              Frequently Asked Questions (Top 10 Clarified)
            </h2>
            <p class="text-sm text-muted-foreground">
              Direct, authoritative answers verified against official commission gazettes, application instructions, and scrutiny standards.
            </p>
          </div>

          <div class="space-y-3 pt-2">
            {post.faqs.map((faq, idx) => (
              <details class="group rounded-2xl border border-border bg-card p-4 sm:p-5 transition-all hover:border-primary/40 open:border-primary/50 open:bg-primary/5 open:shadow-xs cursor-pointer">
                <summary class="flex items-start justify-between gap-4 font-bold text-foreground text-sm sm:text-base list-none select-none">
                  <div class="flex items-start gap-3">
                    <span class="px-2 py-0.5 rounded-md text-xs font-mono font-bold bg-primary/10 text-primary border border-primary/20 shrink-0 mt-0.5">
                      Q{idx + 1}
                    </span>
                    <span class="group-open:text-primary transition">{faq.question}</span>
                  </div>
                  <span class="shrink-0 text-muted-foreground group-open:rotate-180 group-open:text-primary transition-transform duration-200 mt-1">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                  </span>
                </summary>
                <div class="mt-3.5 pl-9 text-xs sm:text-sm leading-relaxed text-slate-700 dark:text-slate-300 border-t border-border/50 pt-3 prose prose-slate dark:prose-invert max-w-none">
                  <Fragment set:html={faq.answer} />
                </div>
              </details>
            ))}
          </div>
        </section>
      )}

      <!-- Educational & Fair Use Disclaimer Box -->
      <section class="rounded-xl border border-border/80 bg-muted/40 p-4 text-xs text-muted-foreground space-y-1.5">
        <div class="flex items-center gap-1.5 font-semibold text-foreground text-[11px] uppercase tracking-wider">
          <span>⚖️</span>
          <span>Educational Disclaimer &amp; Fair Use Notice</span>
        </div>
        <p class="leading-relaxed text-[11px]">
          SignResize.in is an independent, non-governmental document utility and candidate educational guidance platform. All references to public examinations (including SSC, UPSC, RRB, IBPS, and State PSCs), syllabus topics, and government portals are made strictly under nominative fair use for descriptive, identification, and educational assistance. SignResize is neither affiliated with, nor endorsed, sponsored, or certified by any government commission or commercial coaching entity.
        </p>
      </section>

      <!-- In-Article Dynamic Resizer Tool Callout -->
      {relatedPreset && (
        <section class="rounded-2xl border-2 border-primary/30 bg-gradient-to-r from-primary/5 via-card to-card p-5 sm:p-6 shadow-xs space-y-3">
          <div class="flex items-center gap-2 text-primary font-bold text-xs uppercase tracking-wider">
            <span>⚡ Recommended Instant Tool</span>
          </div>
          <h3 class="text-lg font-bold text-foreground">
            Resize Documents for {relatedPreset.name}
          </h3>
          <p class="text-xs sm:text-sm text-muted-foreground">
            Official Specs: {relatedPreset.widthPx}&times;{relatedPreset.heightPx} px ({relatedPreset.widthCm}&times;{relatedPreset.heightCm} cm), file size strictly {relatedPreset.minKb} to {relatedPreset.maxKb} KB ({relatedPreset.inkRequirement}).
          </p>
          <div class="pt-1 flex flex-wrap items-center gap-3">
            <a
              href={`/${relatedExamSlug}/`}
              class="px-4 py-2 rounded-xl bg-primary text-primary-foreground font-bold text-xs hover:opacity-90 transition shadow-xs flex items-center gap-1.5"
            >
              <span>Launch {relatedPreset.shortCode} Preset Resizer</span>
              <span>&rarr;</span>
            </a>
            <a
              href="/#tool-workspace"
              class="px-4 py-2 rounded-xl bg-card border border-border text-foreground font-semibold text-xs hover:bg-muted transition"
            >
              Universal 10-20KB Tool
            </a>
          </div>
        </section>
      )}

      <!-- Tags -->
      <div class="flex flex-wrap items-center gap-2 pt-4 border-t border-border">
        <span class="text-xs font-semibold text-muted-foreground">Topics:</span>
        {post.tags.map(tag => (
          <span class="text-xs px-2.5 py-0.5 rounded-lg bg-muted text-muted-foreground border border-border">
            #{tag}
          </span>
        ))}
      </div>

      <!-- Related Posts Section -->
      {relatedPosts.length > 0 && (
        <section class="border-t border-border pt-8 space-y-4">
          <h3 class="text-lg font-bold text-foreground">More from SignResize Blog</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {relatedPosts.map(p => (
              <a
                href={`/blog/${p.slug}/`}
                class="p-4 rounded-xl border border-border bg-card hover:border-primary/40 transition group flex flex-col justify-between space-y-2"
              >
                <div>
                  <span class="text-[10px] font-bold uppercase tracking-wider text-primary">
                    {p.category}
                  </span>
                  <h4 class="font-bold text-sm text-foreground group-hover:text-primary transition mt-1 line-clamp-2">
                    {p.title}
                  </h4>
                </div>
                <div class="text-xs text-muted-foreground font-mono flex items-center justify-between">
                  <span>{p.readTime}</span>
                  <span class="text-primary font-bold group-hover:translate-x-0.5 transition">&rarr;</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

    </main>

    <Footer />
  </body>
</html>
