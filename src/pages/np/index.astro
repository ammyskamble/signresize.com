---
// src/pages/np/index.astro
import '../../styles/global.css';
import Header from '../../components/Header.astro';
import { SignatureTool } from '../../components/SignatureTool';
import ExamSpecsTable from '../../components/ExamSpecsTable.astro';
import FaqSection from '../../components/FaqSection.astro';
import CountryBlogSection from '../../components/CountryBlogSection.astro';
import Footer from '../../components/Footer.astro';
import GoogleAnalytics from '../../components/GoogleAnalytics.astro';
import GoogleFonts from '../../components/GoogleFonts.astro';
import ThemeScript from '../../components/ThemeScript.astro';

const pageTitle = "Lok Sewa Aayog Nepal Photo Resizer (50 KB) Online - SignResize";
const pageDescription = "Free Lok Sewa Aayog photo & signature resizer for Nepal. Format passport photo to 35x45 mm (50 KB max) and signature for Public Service Commission Nepal (Lok Sewa Aayog), TSC Teacher Exam, and e-Passport.";
const canonicalUrl = "https://signresize.in/np/";
const ogImageUrl = "https://signresize.in/og-image.png";
const keywordsContent = "lok sewa aayog photo resizer nepal, nepal passport photo size resizer 50kb, tsc nepal signature resizer, public service commission nepal photo size, e-passport nepal photo editor";
---

<!doctype html>
<html lang="en-NP" class="scroll-smooth">
  <head>
    <ThemeScript />
    <GoogleAnalytics />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={keywordsContent} />
    <meta name="author" content="SignResize.in" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Hreflang Tags -->
    <link rel="alternate" hreflang="en-NP" href="https://signresize.in/np/" />
    <link rel="alternate" hreflang="x-default" href="https://signresize.in/" />

    <!-- Open Graph (OG) Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="SignResize" />
    <meta property="og:locale" content="en_NP" />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Web Fonts & Favicons -->
    <GoogleFonts />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#4f46e5" />

    <!-- Schema.org WebApplication JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "SignResize Nepal - Lok Sewa Aayog Photo Resizer",
      "url": "https://signresize.in/np/",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5 Canvas.",
      "inLanguage": "en-NP",
      "description": "Free passport photo and signature resizer for Lok Sewa Aayog Public Service Commission Nepal, TSC Teacher Exam, and e-Passport online portal."
    })} />
  </head>

  <body class="min-h-screen bg-background text-foreground flex flex-col font-sans antialiased selection:bg-primary/20 selection:text-primary">
    <Header />

    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-8">
      <!-- Nepal Hero Header -->
      <section class="space-y-4">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div class="space-y-1.5">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-red-500/10 text-red-600 dark:text-red-400 border border-red-500/20">
              <span>🇳🇵 Official Nepal Presets (Lok Sewa Aayog, TSC, e-Passport)</span>
            </div>
            <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-foreground">
              Nepal Lok Sewa Aayog Photo &amp; Signature Resizer <span class="text-primary">(≤ 50 KB)</span>
            </h1>
            <p class="text-sm sm:text-base text-muted-foreground max-w-3xl">
              Calibrated passport photo (35×45 mm) and scanned signature presets for Lok Sewa Aayog (Public Service Commission Nepal `psc.gov.np`), TSC Teacher Exam, and Nepal e-Passport pre-enrollment.
            </p>
          </div>
        </div>
      </section>

      <!-- Resizer Studio Tool loaded with Lok Sewa Nepal Preset -->
      <section id="tool-workspace" class="scroll-mt-20">
        <SignatureTool client:idle initialPresetId="loksewa-np" />
      </section>

      <!-- Nepal Resizer Directory (Deadline Order) -->
      <section class="space-y-4" aria-labelledby="nepal-tools-heading">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <h2 id="nepal-tools-heading" class="text-xl sm:text-2xl font-extrabold text-foreground">
            Nepal Exam &amp; Portal Photo Resizers (By Deadline)
          </h2>
          <span class="text-xs font-mono text-muted-foreground">Updated 12 Nov 2026</span>
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
          <a href="/np/pradesh-lok-sewa-photo-resize/" class="group rounded-2xl border border-primary/30 bg-card p-4 space-y-2 hover:border-primary transition shadow-xs">
            <div class="flex items-center justify-between text-[11px] font-bold">
              <span class="px-2 py-0.5 rounded-full bg-rose-500/10 text-rose-700 dark:text-rose-300 border border-rose-500/20">OPEN NOW · CLOSES 17 NOV</span>
              <span class="font-mono text-muted-foreground">≤500 KB JPG/PNG</span>
            </div>
            <h3 class="font-bold text-base text-foreground group-hover:text-primary">Pradesh Lok Sewa Aayog Photo and Signature Resizer</h3>
            <p class="text-xs text-muted-foreground">Open now: Gandaki 7th Level closes 17 Nov 2026 (double fee 24 Nov); Karnali 4th Level (153 posts) closes 30 Nov 2026.</p>
          </a>

          <a href="/np/nepal-telecom-photo-signature-resize/" class="group rounded-2xl border border-primary/30 bg-card p-4 space-y-2 hover:border-primary transition shadow-xs">
            <div class="flex items-center justify-between text-[11px] font-bold">
              <span class="px-2 py-0.5 rounded-full bg-amber-500/10 text-amber-700 dark:text-amber-300 border border-amber-500/20">OPEN NOW · CLOSES 19 NOV</span>
              <span class="font-mono text-muted-foreground">100–200 KB .JPG</span>
            </div>
            <h3 class="font-bold text-base text-foreground group-hover:text-primary">Nepal Telecom (NTC) Photo and Signature Resizer</h3>
            <p class="text-xs text-muted-foreground">Open now: Notice 06/2083-84 (80 posts, Levels 3–9) closes 19 Nov 2026 (double fee 26 Nov) · strict 100–200 KB (≤200 KB) .JPG rule.</p>
          </a>

          <a href="/np/nea-photo-signature-resize/" class="group rounded-2xl border border-border bg-card p-4 space-y-2 hover:border-primary transition shadow-xs">
            <div class="flex items-center justify-between text-[11px] font-bold">
              <span class="px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 border border-emerald-500/20">OPEN NOW · CLOSES 26 NOV</span>
              <span class="font-mono text-muted-foreground">Both Ears Visible JPG</span>
            </div>
            <h3 class="font-bold text-base text-foreground group-hover:text-primary">NEA Photo and Signature Resizer</h3>
            <p class="text-xs text-muted-foreground">Open now: Officer Levels 10/8/7 &amp; Assistant Level 5 close 26 Nov 2026 (double fee 3 Dec) · both-ears-visible JPG mandate.</p>
          </a>

          <div class="rounded-2xl border border-dashed border-border bg-muted/30 p-4 space-y-2">
            <div class="flex items-center justify-between text-[11px] font-bold">
              <span class="px-2 py-0.5 rounded-full bg-indigo-500/10 text-indigo-700 dark:text-indigo-300 border border-indigo-500/20">NOTICE ON 13 NOV 2026</span>
              <span class="font-mono text-muted-foreground">nrb.org.np</span>
            </div>
            <h3 class="font-bold text-base text-foreground">Nepal Rastra Bank (NRB) Resizer</h3>
            <p class="text-xs text-muted-foreground">Scheduled trigger: Special Notice confirmed main NRB vacancy notice publishes on nrb.org.np on 13 Nov 2026; dedicated page opens once published.</p>
          </div>

          <a href="/np/lok-sewa-photo-resize-nepal/" class="group rounded-2xl border border-border bg-card p-4 space-y-2 hover:border-primary transition shadow-xs">
            <div class="flex items-center justify-between text-[11px] font-bold">
              <span class="px-2 py-0.5 rounded-full bg-primary/10 text-primary border border-primary/20">FEDERAL PSC · ≤50 KB</span>
              <span class="font-mono text-muted-foreground">3.5×4.5 cm JPG</span>
            </div>
            <h3 class="font-bold text-base text-foreground group-hover:text-primary">Federal Lok Sewa Photo &amp; Signature Resizer</h3>
            <p class="text-xs text-muted-foreground">Open federal PSC Master Profile portal (psconline.psc.gov.np) · ≤50 KB passport photo &amp; signature for Kharidar, NaSu &amp; Officer rounds.</p>
          </a>

          <a href="/np/university-entrance-photo-resize/" class="group rounded-2xl border border-border bg-card p-4 space-y-2 hover:border-primary transition shadow-xs">
            <div class="flex items-center justify-between text-[11px] font-bold">
              <span class="px-2 py-0.5 rounded-full bg-sky-500/10 text-sky-700 dark:text-sky-300 border border-sky-500/20">OPEN · ADMISSION / ENTRANCE</span>
              <span class="font-mono text-muted-foreground">KU ≤500KB · PU 51×51mm</span>
            </div>
            <h3 class="font-bold text-base text-foreground group-hover:text-primary">University Entrance Photo Resizer — Nepal</h3>
            <p class="text-xs text-muted-foreground">Open now: Kathmandu Univ. SoE Master’s (≤500 KB, 50–60% face) and Purbanchal Univ. BE/B.Arch Re-Entrance (51×51 mm JPG/PNG).</p>
          </a>

          <a href="/np/driving-license-photo-resize/" class="group rounded-2xl border border-border bg-card p-4 space-y-2 hover:border-primary transition shadow-xs md:col-span-2 lg:col-span-3">
            <div class="flex items-center justify-between text-[11px] font-bold">
              <span class="px-2 py-0.5 rounded-full bg-slate-500/10 text-foreground border border-border">ALWAYS OPEN · EVERGREEN</span>
              <span class="font-mono text-muted-foreground">eDLVRS ≤1 MB JPG/PNG</span>
            </div>
            <h3 class="font-bold text-base text-foreground group-hover:text-primary">Nepal Driving License Photo Resize Online (Provincial eDLVRS)</h3>
            <p class="text-xs text-muted-foreground">Always open across provincial eDLVRS portals (Bagmati, Gandaki, Koshi, Lumbini); National ID required and biometrics captured at office visit.</p>
          </a>
        </div>
      </section>

      <!-- Specifications Table, Country Blog Section & FAQs -->
      <section class="space-y-6">
        <ExamSpecsTable country="NP" />
        <CountryBlogSection country="NP" />
        <FaqSection country="NP" />
      </section>
    </main>

    <Footer />
  </body>
</html>
