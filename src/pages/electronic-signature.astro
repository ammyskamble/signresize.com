---
// src/pages/electronic-signature.astro
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import GoogleFonts from '../components/GoogleFonts.astro';
import { SignatureCreatorTool } from '../components/SignatureCreatorTool';

const pageTitle = "Free Electronic Signature Online | Draw & Download eSign for PDFs - SignResize";
const pageDescription = "Free online electronic signature pad. Draw your legal digital e-signature smoothly on screen with finger, stylus, or mouse. Export high-resolution transparent PNG or white JPG for signing PDFs and documents.";
const canonicalUrl = "https://signresize.in/electronic-signature/";
const ogImageUrl = "https://signresize.in/og-image.png";
const keywordsContent = "electronic signature, esign online, free electronic signature, draw signature on screen, electronic signature maker, esign for pdf, digital signature pad, online signature pad, sign pdf online free";

const faqs = [
  {
    q: "How do I create a free electronic signature on screen?",
    a: "Select the Draw tab on our Electronic Signature pad. Use your touchscreen, tablet stylus, or computer mouse to sign naturally. You can select your ink color (Black, Navy Blue, Royal Blue), adjust stroke thickness, and undo mistakes. Once satisfied, click 'Download PNG' for a transparent signature ready to sign any PDF or document."
  },
  {
    q: "Is an electronic signature drawn here legally valid for documents?",
    a: "Under major electronic transactions and IT laws (such as the Indian Information Technology Act 2000, US ESIGN Act, and EU eIDAS regulations), an electronic signature executed with the intent to sign is widely accepted for business agreements, offer letters, invoices, and standard commercial contracts. For notarized court affidavits, government certificates, or specific competitive exam uploads, physical ink signatures or Aadhaar-based digital signatures may be prescribed."
  },
  {
    q: "How can I insert my electronic signature into a PDF document?",
    a: "Download your signature with the 'Transparent Background (PNG)' option enabled. Then open your PDF in any reader (Adobe Acrobat Reader, Apple Preview, Google Chrome, or Microsoft Word), select 'Add Image' or 'Sign Document', and place your transparent signature image onto the signature line."
  },
  {
    q: "Is my electronic signature stored or uploaded anywhere?",
    a: "Never. SignResize processes everything 100% locally within your browser using HTML5 Canvas. Your signature coordinates, strokes, and images are never transmitted to any external server or saved in any database."
  },
  {
    q: "How to resize my electronic signature to 10 to 20 KB?",
    a: "If an application portal requires an exact file size limit (such as 10 KB to 20 KB), simply download your signature here, then open our Signature Resizer tool and set your target file size to 15 KB with exact pixel dimensions."
  }
];
---

<!doctype html>
<html lang="en-IN" class="scroll-smooth">
  <head>
    <!-- Google tag (gtag.js) -->
    <GoogleAnalytics />

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={keywordsContent} />
    <meta name="author" content="SignResize.in" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph (OG) Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="SignResize" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- PWA & Mobile Meta Tags -->
    <meta name="theme-color" content="#4f46e5" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="SignResize" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Async Google Fonts -->
    <GoogleFonts />

    <!-- SoftwareApplication & WebApplication Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": ["SoftwareApplication", "WebApplication"],
      "name": "Free Electronic Signature Online (eSign Pad)",
      "url": canonicalUrl,
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "All (Android, iOS, Windows, macOS, Linux)",
      "browserRequirements": "Requires JavaScript. Requires HTML5 Canvas support.",
      "description": pageDescription,
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "INR"
      },
      "featureList": [
        "Touchscreen and stylus electronic drawing pad",
        "Smooth stroke velocity smoothing algorithm",
        "Customizable stroke thickness and ink colors",
        "Transparent PNG export for seamless PDF signing",
        "Zero server upload - 100% private in-browser eSign"
      ]
    })} />

    <!-- HowTo Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "HowTo",
      "name": "How to Draw and Create an Electronic Signature Online",
      "description": "Step-by-step instructions to draw and download an electronic signature on any mobile phone, tablet, or PC.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Access the Drawing Pad",
          "text": "Open the Electronic Signature canvas on your phone, tablet, or computer.",
          "position": 1
        },
        {
          "@type": "HowToStep",
          "name": "Draw Your Signature",
          "text": "Use your finger, stylus, or mouse to sign naturally on the drawing area.",
          "position": 2
        },
        {
          "@type": "HowToStep",
          "name": "Adjust Pen Width & Color",
          "text": "Customize the stroke width slider and pick Black or Blue ink.",
          "position": 3
        },
        {
          "@type": "HowToStep",
          "name": "Export Transparent PNG",
          "text": "Click 'Download PNG' with transparent background to insert directly into PDF documents.",
          "position": 4
        }
      ]
    })} />

    <!-- BreadcrumbList Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://signresize.in/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Electronic Signature",
          "item": canonicalUrl
        }
      ]
    })} />

    <!-- FAQPage Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": f.a
        }
      }))
    })} />
  </head>

  <body class="bg-background text-foreground selection:bg-primary/20 selection:text-primary min-h-screen flex flex-col antialiased">
    <Header />

    <main class="flex-1 w-full max-w-[1480px] mx-auto px-3 sm:px-6 lg:px-8 py-6 space-y-8">
      
      <!-- Breadcrumb Bar -->
      <nav class="flex items-center gap-2 text-xs text-muted-foreground" aria-label="Breadcrumb">
        <a href="/" class="hover:text-primary transition">Home</a>
        <span>/</span>
        <span class="text-foreground font-medium">Electronic Signature</span>
      </nav>

      <!-- Hero Header Banner -->
      <section class="rounded-2xl border border-primary/20 bg-gradient-to-r from-card via-card/90 to-primary/5 p-4 sm:p-6 shadow-xs backdrop-blur">
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
          <div class="space-y-1.5">
            <div class="flex items-center gap-2 flex-wrap">
              <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                Free Electronic Signature Pad
              </span>
              <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-md text-[11px] font-mono text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 border border-emerald-500/20">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                100% Client-Side In-Browser
              </span>
            </div>
            <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-foreground leading-[1.15]">
              Free Online <span class="text-primary">Electronic Signature</span> (eSign Pad)
            </h1>
            <p class="text-xs sm:text-sm text-muted-foreground max-w-3xl leading-relaxed">
              Draw smooth, legally admissible electronic signatures directly on screen using your touch screen, mobile phone, stylus, or mouse. Export high-resolution transparent PNGs to sign PDF documents, agreements, and contracts in seconds.
            </p>
          </div>

          <!-- Feature Badges -->
          <div class="flex items-center gap-2 flex-wrap shrink-0">
            <div class="px-3 py-2 rounded-xl bg-card border border-border text-center">
              <div class="text-[9px] uppercase font-bold text-muted-foreground">Input</div>
              <div class="text-xs font-bold text-primary font-mono">Touch / Mouse</div>
            </div>
            <div class="px-3 py-2 rounded-xl bg-card border border-border text-center">
              <div class="text-[9px] uppercase font-bold text-muted-foreground">Output</div>
              <div class="text-xs font-bold text-foreground font-mono">Transparent PNG</div>
            </div>
            <div class="px-3 py-2 rounded-xl bg-card border border-border text-center">
              <div class="text-[9px] uppercase font-bold text-muted-foreground">Usage</div>
              <div class="text-xs font-bold text-emerald-600 dark:text-emerald-400 font-mono">PDF &amp; Contracts</div>
            </div>
          </div>
        </div>
      </section>

      <!-- Main Layout: eSign Tool + Content -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        <div class="lg:col-span-8 space-y-6">
          <!-- Force Initial Tab to 'draw' for Electronic Signature -->
          <SignatureCreatorTool client:load initialTab="draw" />

          <!-- Editorial Guide & Legal Compliance Content -->
          <div class="bg-card border border-border rounded-2xl p-5 shadow-xs space-y-6">
            <div class="space-y-3">
              <h2 class="text-lg sm:text-xl font-bold text-foreground flex items-center gap-2">
                <span>🖋️</span> Electronic Signatures: Legal Validity &amp; Best Practices
              </h2>
              <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed">
                Electronic signatures (e-signatures) have replaced physical paper signing across modern commercial transactions, freelance agreements, employment offer letters, and non-disclosure agreements (NDAs).
              </p>
              
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-1">
                <div class="p-3 rounded-xl bg-muted/30 border border-border space-y-1">
                  <div class="text-xs font-bold text-foreground">1. Legally Binding</div>
                  <p class="text-[11px] text-muted-foreground">Recognized under the IT Act 2000, US ESIGN Act, and international standards for standard contracts and agreements.</p>
                </div>
                <div class="p-3 rounded-xl bg-muted/30 border border-border space-y-1">
                  <div class="text-xs font-bold text-foreground">2. Transparent Alpha</div>
                  <p class="text-[11px] text-muted-foreground">Downloads with zero background color, so your signature blends cleanly over lines and text in PDF documents.</p>
                </div>
                <div class="p-3 rounded-xl bg-muted/30 border border-border space-y-1">
                  <div class="text-xs font-bold text-foreground">3. High Definition</div>
                  <p class="text-[11px] text-muted-foreground">Vector-quality canvas smoothing delivers crisp ink lines even when scaled up on high-DPI retina screens.</p>
                </div>
              </div>
            </div>

            <!-- Steps to Sign a PDF -->
            <div class="space-y-2 pt-2 border-t border-border">
              <h3 class="text-sm font-bold text-foreground">How to Insert Your Electronic Signature into a PDF</h3>
              <ol class="list-decimal pl-5 space-y-1.5 text-xs text-muted-foreground">
                <li>Draw your signature above and toggle on <strong>Transparent Background (PNG)</strong>.</li>
                <li>Click <strong>Download PNG</strong> to save the file to your computer or phone.</li>
                <li>Open your document in Adobe Acrobat, Apple Preview, or free web tools (such as Sejda or Smallpdf).</li>
                <li>Select the <strong>Sign</strong> tool, choose <strong>Add Image</strong>, select your downloaded PNG, and drag it onto the signature line.</li>
              </ol>
            </div>

            <!-- FAQs -->
            <div class="pt-2 border-t border-border space-y-3">
              <h3 class="text-sm font-bold text-foreground">Frequently Asked Questions</h3>
              <div class="space-y-2">
                {faqs.map((f) => (
                  <details class="group p-3.5 rounded-xl border border-border bg-muted/20 open:bg-card transition">
                    <summary class="flex items-center justify-between font-semibold text-foreground text-xs cursor-pointer select-none">
                      <span>{f.q}</span>
                      <span class="text-primary group-open:rotate-180 transition-transform ml-2">▼</span>
                    </summary>
                    <p class="pt-2 text-xs text-muted-foreground leading-relaxed">{f.a}</p>
                  </details>
                ))}
              </div>
            </div>
          </div>
        </div>

        <!-- Sidebar -->
        <aside class="lg:col-span-4 space-y-4 sticky top-16">
          <div class="bg-card border border-border rounded-2xl p-5 shadow-xs space-y-3 text-xs">
            <div class="font-bold text-foreground">Related Signature Tools</div>
            <ul class="space-y-2 text-[11px] text-muted-foreground">
              <li>
                <a href="/signature-generator/" class="flex items-center justify-between p-2 rounded-lg hover:bg-muted/40 transition">
                  <span class="font-semibold text-foreground">✨ Signature Generator (Type)</span>
                  <span class="text-primary font-bold">Open →</span>
                </a>
              </li>
              <li>
                <a href="/signature-creator/" class="flex items-center justify-between p-2 rounded-lg hover:bg-muted/40 transition">
                  <span class="font-semibold text-foreground">🎨 Signature Creator &amp; Maker</span>
                  <span class="text-primary font-bold">Open →</span>
                </a>
              </li>
              <li>
                <a href="/#tool-workspace" class="flex items-center justify-between p-2 rounded-lg hover:bg-muted/40 transition">
                  <span class="font-semibold text-foreground">✍️ Signature Resizer (10–20 KB)</span>
                  <span class="text-primary font-bold">Open →</span>
                </a>
              </li>
            </ul>
          </div>

          <div class="bg-card border border-border rounded-2xl p-5 shadow-xs space-y-3 text-xs">
            <div class="font-bold text-foreground">Need Exact 10–20 KB File?</div>
            <p class="text-[11px] text-muted-foreground leading-relaxed">
              If your portal requires an exact 140×60 px JPG under 20 KB, take your downloaded signature and run it through our official resizer.
            </p>
            <a
              href="/#tool-workspace"
              class="block w-full text-center py-2 px-3 rounded-xl bg-primary text-primary-foreground font-bold text-xs hover:bg-primary/90 transition shadow-xs"
            >
              Open Signature Resizer →
            </a>
          </div>
        </aside>
      </div>

    </main>

    <Footer />
  </body>
</html>
