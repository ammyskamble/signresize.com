---
// src/pages/bd/bcs-photo-signature-resizer.astro
import '../../styles/global.css';
import Header from '../../components/Header.astro';
import { SignatureTool } from '../../components/SignatureTool';
import FaqSection from '../../components/FaqSection.astro';
import ExamSpecsTable from '../../components/ExamSpecsTable.astro';
import Footer from '../../components/Footer.astro';
import GoogleAnalytics from '../../components/GoogleAnalytics.astro';
import GoogleFonts from '../../components/GoogleFonts.astro';
import ThemeScript from '../../components/ThemeScript.astro';

const pageTitle = "BCS Photo & Signature Resizer 300x300 (100 KB) & 300x80 (60 KB) - SignResize";
const pageDescription = "Free online BCS photo and signature resizer for Bangladesh Public Service Commission (BPSC) 47th BCS and Non-Cadre applications. Crop photo to 300x300 px (≤100 KB) and signature to 300x80 px (≤60 KB) in JPG format.";
const canonicalUrl = "https://signresize.in/bd/bcs-photo-signature-resizer/";
const ogImageUrl = "https://signresize.in/og-image.png";
const keywordsContent = "bcs photo resizer 300x300, bcs signature resizer 300x80, bpsc photo resizer bangladesh, 47th bcs photo size, bpsc teletalk image resize, bcs non cadre photo size";

const bcsFaqs = [
  {
    q: "What is the official photograph dimension and size for BCS (BPSC) application?",
    summary: "The Bangladesh Public Service Commission (BPSC) strictly mandates a 300×300 pixel photo with file weight between 10 KB and 100 KB.",
    details: "Your photograph must be in JPG/JPEG format with a clean white or neutral background. The face must occupy around 70-80% of the frame with both ears clearly visible."
  },
  {
    q: "What are the signature specifications for the BCS examination?",
    summary: "The signature must be strictly 300×80 pixels with file size between 5 KB and 60 KB in JPG format.",
    details: "Sign with black ink on unruled white paper. Block/capital letter signatures are strictly disqualified by BPSC scrutiny."
  },
  {
    q: "Why does the BPSC Teletalk portal show 'Photo dimensions must be 300x300 pixels'?",
    summary: "The portal runs an exact client-side dimension validator. Even a 1-pixel variance (like 301×300) causes immediate rejection.",
    details: "SignResize guarantees integer-locked 300×300 px and 300×80 px outputs that pass BPSC's verification algorithm on the very first try."
  },
  {
    q: "Are BPSC Non-Cadre job photo requirements the same as Cadre BCS?",
    summary: "Yes, all BPSC recruitments (10th grade, 9th grade gazetted/non-gazetted, senior staff nurse) use the identical 300×300 px (≤100 KB) and 300×80 px (≤60 KB) format.",
    details: "Both portals operate on bpsc.teletalk.com.bd and share identical image processing validation pipelines."
  }
];
---

<!doctype html>
<html lang="en-BD" class="scroll-smooth">
  <head>
    <ThemeScript />
    <GoogleAnalytics />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={keywordsContent} />
    <meta name="author" content="SignResize.in" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph (OG) Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="SignResize" />
    <meta property="og:locale" content="en_BD" />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Web Fonts & Favicons -->
    <GoogleFonts />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <meta name="theme-color" content="#4f46e5" />

    <!-- Schema.org WebApplication JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "BCS Photo & Signature Resizer",
      "url": canonicalUrl,
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "description": pageDescription,
      "featureList": [
        "300x300 px BCS Photo Resizer (≤100 KB)",
        "300x80 px BCS Signature Resizer (≤60 KB)",
        "Zero Server Upload - 100% Client-Side Privacy",
        "Instant Teletalk All Jobs Pass Guarantee"
      ]
    })} />
  
    <!-- Schema.org FAQPage JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": bcsFaqs.map(faq => ({
        "@type": "Question",
        "name": faq.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": `${faq.summary} ${faq.details}`
        }
      }))
    })} />

    <!-- Schema.org HowTo JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "HowTo",
      "name": "How to Resize Photo & Signature for BPSC BCS Application",
      "description": "Step-by-step guide to crop, resize, and compress image uploads strictly compliant with bpsc.teletalk.com.bd.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Select BCS Photo (300×300 px) or Signature",
          "text": "Open the tool with the preloaded preset. The official pixel dimensions and aspect ratio are automatically locked.",
          "url": canonicalUrl
        },
        {
          "@type": "HowToStep",
          "name": "Upload & Adjust Crop Frame",
          "text": "Upload your photo or signature scan. Adjust zoom and position within the guide frame.",
          "url": canonicalUrl
        },
        {
          "@type": "HowToStep",
          "name": "Download Certified JPG",
          "text": "Click Download to export your image strictly within the required KB limits, guaranteed to pass bpsc.teletalk.com.bd.",
          "url": canonicalUrl
        }
      ]
    })} />
  </head>

  <body class="min-h-screen bg-background text-foreground flex flex-col font-sans antialiased">
    <Header />

    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-8">
      <!-- Tool Page Header with Selector Dropdown -->
      <section class="space-y-4">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div class="space-y-2">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20">
              <svg class="w-4 h-2.5 rounded-xs shadow-2xs shrink-0 inline-block" viewBox="0 0 20 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <rect width="20" height="12" fill="#006a4e" rx="1" />
                <circle cx="9" cy="6" r="4" fill="#f42a41" />
              </svg>
              <span>BPSC Official Preset (bpsc.teletalk.com.bd)</span>
            </div>
            <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-foreground">
              BCS Photo &amp; Signature Resizer <span class="text-primary">(300×300 / 300×80)</span>
            </h1>
            <p class="text-muted-foreground text-sm sm:text-base max-w-3xl">
              Calibrated cropping and size reduction for Bangladesh Civil Service (BCS 47th / 46th) Cadre and Non-Cadre applications on the official BPSC Teletalk portal.
            </p>
          </div>

          <!-- Quick Dropdown Hub Selector -->
          <div class="w-full md:w-auto min-w-[280px] bg-card p-3 rounded-xl border border-border shadow-sm">
            <label for="bd-tool-select" class="block text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-1.5">
              Select Bangladesh Portal Tool:
            </label>
            <select
              id="bd-tool-select"
              class="w-full bg-background border border-input text-foreground rounded-lg px-3 py-2 text-sm font-medium focus:ring-2 focus:ring-primary focus:outline-none cursor-pointer"
              onchange="if(this.value) window.location.href=this.value;"
            >
              <option value="/bd/">Bangladesh Main Hub</option>
              <option value="/bd/bcs-photo-signature-resizer/" selected>BCS &amp; BPSC (300×300 / 300×80 px)</option>
              <option value="/bd/bangladesh-bank-photo-signature-resizer/">Bangladesh Bank (600×600 / 300×80 px)</option>
              <option value="/bd/primary-teacher-dpe-photo-resizer/">DPE Primary Assistant Teacher</option>
              <option value="/bd/ntrca-photo-signature-resizer/">NTRCA Teacher Registration</option>
              <option value="/bd/medical-admission-photo-resizer/">DGME Medical MBBS/BDS Admission</option>
            </select>
          </div>
        </div>
      </section>

      <!-- Signature Tool Canvas Widget loaded with BCS preset -->
      <section id="tool-workspace" class="scroll-mt-20 bg-card rounded-2xl p-4 sm:p-6 border border-border shadow-sm">
        <SignatureTool client:idle initialPresetId="bpsc-bd" initialMode="photo" />
      </section>

      <!-- SEO Educational Guide Section -->
      <section class="space-y-6 pt-6 border-t border-border">
        <div class="bg-card rounded-2xl p-6 sm:p-8 border border-border space-y-6">
          <h2 class="text-2xl font-bold text-foreground">
            BPSC Bangladesh Civil Service (BCS) Photo &amp; Signature Guidelines
          </h2>
          <p class="text-muted-foreground leading-relaxed">
            The <strong>Bangladesh Public Service Commission (BPSC)</strong> conducts the prestigious Bangladesh Civil Service (BCS) examination for gazetted cadre posts. During online registration at <em>bpsc.teletalk.com.bd</em>, candidates must upload a standardized color photograph and specimen signature. Incorrect dimensions or excessive file weight cause instantaneous server rejection.
          </p>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 my-6">
            <div class="p-4 bg-muted/40 rounded-xl border border-border space-y-1">
              <h3 class="font-bold text-base text-foreground">Photograph Specs</h3>
              <p class="text-xs text-muted-foreground"><strong>300 × 300 pixels</strong> (Aspect Ratio 1:1). File size: 10 KB to 100 KB in JPG format.</p>
            </div>
            <div class="p-4 bg-muted/40 rounded-xl border border-border space-y-1">
              <h3 class="font-bold text-base text-foreground">Signature Specs</h3>
              <p class="text-xs text-muted-foreground"><strong>300 × 80 pixels</strong> (Aspect Ratio 3.75:1). File size: 5 KB to 60 KB in JPG format.</p>
            </div>
            <div class="p-4 bg-muted/40 rounded-xl border border-border space-y-1">
              <h3 class="font-bold text-base text-foreground">Validation Guarantee</h3>
              <p class="text-xs text-muted-foreground">100% compliant with BPSC client-side checks with clean white paper background extraction.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Specifications Table & FAQ Section -->
      <section class="space-y-6">
        <ExamSpecsTable country="BD" />
        <FaqSection faqs={bcsFaqs} title="Frequently Asked Questions (BCS & BPSC)" />
      </section>
    </main>

    <Footer />
  </body>
</html>

