---
// src/pages/bd/index.astro
import '../../styles/global.css';
import Header from '../../components/Header.astro';
import { SignatureTool } from '../../components/SignatureTool';
import ExamSpecsTable from '../../components/ExamSpecsTable.astro';
import FaqSection from '../../components/FaqSection.astro';
import CountryBlogSection from '../../components/CountryBlogSection.astro';
import Footer from '../../components/Footer.astro';
import GoogleAnalytics from '../../components/GoogleAnalytics.astro';
import GoogleFonts from '../../components/GoogleFonts.astro';
import ThemeScript from '../../components/ThemeScript.astro';

const pageTitle = "Teletalk Bangladesh Photo & Signature Resizer 300x300 - SignResize";
const pageDescription = "Free Teletalk Bangladesh photo and signature resizer. Format photo to 300x300 px (100 KB max) and signature to 300x80 px (60 KB max) for Teletalk All Jobs (alljobs.teletalk.com.bd), BCS (BPSC), and NTRCA.";
const canonicalUrl = "https://signresize.in/bd/";
const ogImageUrl = "https://signresize.in/og-image.png";
const keywordsContent = "teletalk photo resizer 300x300, teletalk signature resizer 300x80, teletalk photo resizer 100kb, bpsc photo resizer bangladesh, ntrca photo resizer, alljobs teletalk photo size editor";
---

<!doctype html>
<html lang="en-BD" class="scroll-smooth">
  <head>
    <ThemeScript />
    <GoogleAnalytics />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={keywordsContent} />
    <meta name="author" content="SignResize.in" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Hreflang Tags -->
    <link rel="alternate" hreflang="en-BD" href="https://signresize.in/bd/" />
    <link rel="alternate" hreflang="x-default" href="https://signresize.in/" />

    <!-- Open Graph (OG) Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="SignResize" />
    <meta property="og:locale" content="en_BD" />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Web Fonts & Favicons -->
    <GoogleFonts />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#4f46e5" />

    <!-- Schema.org WebApplication JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "SignResize Bangladesh - Teletalk Photo & Signature Resizer",
      "url": "https://signresize.in/bd/",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5 Canvas.",
      "inLanguage": "en-BD",
      "description": "Free 300x300 photo and 300x80 signature resizer for Teletalk All Jobs (alljobs.teletalk.com.bd), BPSC BCS Exam, and NTRCA in Bangladesh."
    })} />
  </head>

  <body class="min-h-screen bg-background text-foreground flex flex-col font-sans antialiased selection:bg-primary/20 selection:text-primary">
    <Header />

    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-8">
      <!-- Bangladesh Hero Header -->
      <section class="space-y-4">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div class="space-y-1.5">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20">
              <span>🇧🇩 Official Bangladesh Presets (Teletalk All Jobs, BPSC, NTRCA)</span>
            </div>
            <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-foreground">
              Teletalk Bangladesh Photo &amp; Signature Resizer <span class="text-primary">(300×300 / 300×80)</span>
            </h1>
            <p class="text-sm sm:text-base text-muted-foreground max-w-3xl">
              Official 300×300 px (≤ 100 KB) photo and 300×80 px (≤ 60 KB) signature presets compliant with Teletalk All Jobs (`alljobs.teletalk.com.bd`), BPSC (BCS Exam), NTRCA, and Primary Teacher Recruitment.
            </p>
          </div>
        </div>
      </section>

      <!-- Resizer Studio Tool loaded with Teletalk BD Preset -->
      <section id="tool-workspace" class="scroll-mt-20">
        <SignatureTool client:load initialPresetId="teletalk-bd" />
      </section>

      <!-- Specifications Table, Country Blog Section & FAQs -->
      <section class="space-y-6">
        <ExamSpecsTable country="BD" />
        <CountryBlogSection country="BD" />
        <FaqSection country="BD" />
      </section>
    </main>

    <Footer />
  </body>
</html>
