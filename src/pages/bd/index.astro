---
// src/pages/bd/index.astro
import '../../styles/global.css';
import Header from '../../components/Header.astro';
import ExamSpecsTable from '../../components/ExamSpecsTable.astro';
import FaqSection from '../../components/FaqSection.astro';
import CountryBlogSection from '../../components/CountryBlogSection.astro';
import Footer from '../../components/Footer.astro';
import GoogleAnalytics from '../../components/GoogleAnalytics.astro';
import GoogleFonts from '../../components/GoogleFonts.astro';
import ThemeScript from '../../components/ThemeScript.astro';

const pageTitle = "Bangladesh Photo & Signature Tools Directory (24 Presets) | SignResize";
const pageDescription = "Find 24 verified Bangladesh photo and signature presets across 12 application tools for Teletalk, BCS, Bangladesh Bank, DPE, NTRCA, Police, and University Admissions (BUET, KUET, RUET, DU, Agri Cluster).";
const canonicalUrl = "https://signresize.in/bd/";
const ogImageUrl = "https://signresize.in/og-image.png";
const keywordsContent = "teletalk photo resizer 300x300, teletalk signature resizer 300x80, bcs photo resizer bangladesh, bangladesh bank photo size 600x600, primary teacher photo resizer, ntrca photo resizer, alljobs teletalk photo editor";
---

<!doctype html>
<html lang="en-BD" class="scroll-smooth">
  <head>
    <ThemeScript />
    <GoogleAnalytics />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={keywordsContent} />
    <meta name="author" content="SignResize.in" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Hreflang Tags -->
    <link rel="alternate" hreflang="en-BD" href="https://signresize.in/bd/" />
    <link rel="alternate" hreflang="x-default" href="https://signresize.in/bd/" />

    <!-- Open Graph (OG) Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="SignResize" />
    <meta property="og:locale" content="en_BD" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Web Fonts & Favicons -->
    <GoogleFonts />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#4f46e5" />

    <!-- Schema.org WebApplication JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": "Bangladesh Photo & Signature Tools Directory",
      "url": canonicalUrl,
      "inLanguage": "en-BD",
      "description": pageDescription
    })} />

  </head>

  <body class="min-h-screen bg-background text-foreground flex flex-col font-sans antialiased selection:bg-primary/20 selection:text-primary">
    <Header />

    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-8">
      <!-- Bangladesh Hero Header with Quick Dropdown Switcher -->
      <section class="space-y-4">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div class="space-y-1.5">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20">
              <svg class="w-4 h-2.5 rounded-xs shadow-2xs shrink-0 inline-block" viewBox="0 0 20 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <rect width="20" height="12" fill="#006a4e" rx="1" />
                <circle cx="9" cy="6" r="4" fill="#f42a41" />
              </svg>
              <span>Bangladesh tools directory</span>
            </div>
            <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-foreground">
              Bangladesh Photo &amp; Signature Tools
            </h1>
            <p class="text-sm sm:text-base text-muted-foreground max-w-3xl">
              Find 24 verified photo and signature presets across 12 application tools for Teletalk, BCS, Bangladesh Bank, DPE, NTRCA, Police, and University Admissions (BUET, KUET, RUET, DU, Agri Cluster).
            </p>
          </div>

          <!-- Quick Dropdown Hub Selector -->
          <div class="w-full md:w-auto min-w-[280px] bg-card p-3 rounded-xl border border-border shadow-sm">
            <label for="bd-tool-select" class="block text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-1.5">
              Select Bangladesh Portal Tool:
            </label>
            <select
              id="bd-tool-select"
              class="w-full bg-background border border-input text-foreground rounded-lg px-3 py-2 text-sm font-medium focus:ring-2 focus:ring-primary focus:outline-none cursor-pointer"
              onchange="if(this.value) window.location.href=this.value;"
            >
              <option value="/bd/" selected>Bangladesh Main Hub (All 24 Presets)</option>
              <optgroup label="Government Recruitment Tools">
                <option value="/teletalk-photo-signature-resize/">Teletalk All Jobs (300×300 / 300×80)</option>
                <option value="/bd/bcs-photo-signature-resizer/">BCS &amp; BPSC (300×300 / 300×80 px)</option>
                <option value="/bd/bangladesh-bank-photo-signature-resizer/">Bangladesh Bank (600×600 / 300×80 px)</option>
                <option value="/bd/primary-teacher-dpe-photo-resizer/">DPE Primary Assistant Teacher</option>
                <option value="/bd/ntrca-photo-signature-resizer/">NTRCA Teacher Registration</option>
                <option value="/?preset=police-constable-photo-bd#tool-workspace">Bangladesh Police (SI &amp; TRC)</option>
              </optgroup>
              <optgroup label="University & Medical Admission Tools">
                <option value="/bd/medical-admission-photo-resizer/">DGME Medical MBBS/BDS Admission</option>
                <option value="/?preset=agri-cluster-photo-bd#tool-workspace">Agricultural Universities (ACAS Cluster)</option>
                <option value="/?preset=buet-admission-photo-bd#tool-workspace">BUET Admission (300×350 / 300×80 px)</option>
                <option value="/?preset=kuet-admission-photo-bd#tool-workspace">KUET &amp; RUET Admission (300×350 px)</option>
                <option value="/?preset=du-admission-photo-bd#tool-workspace">Dhaka University (DU EIS 450×550 px)</option>
                <option value="/?preset=ru-admission-photo-bd#tool-workspace">Rajshahi University (RU 300×400 px)</option>
              </optgroup>
            </select>
          </div>
        </div>
      </section>

      <section id="tool-workspace" class="scroll-mt-20 rounded-2xl border border-border bg-card p-5 sm:p-6 space-y-5">
        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-border/80 pb-3">
          <div>
            <span class="text-xs font-bold text-amber-600 dark:text-amber-400 uppercase tracking-wider">বাংলাদেশ অনলাইন আবেদন নির্দেশিকা</span>
            <h2 class="font-extrabold text-xl sm:text-2xl text-foreground">Bangladesh Portal Photo &amp; Signature Standards (2026–27)</h2>
          </div>
          <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
            ✓ Verified 16 Nov 2026
          </span>
        </div>

        <p class="text-sm text-muted-foreground leading-relaxed">
          Bangladesh online application portals use <strong>two distinct specification families</strong>. The majority of government recruitments and admissions run on the <strong>Teletalk All Jobs engine (300×300 px photo &amp; 300×80 px signature)</strong>, while the <strong>Bangladesh Bank e-Recruitment system mandates 600×600 px photos</strong>. Both require exact pixel locks in JPG format with color photographs on plain white backgrounds.
        </p>

        <!-- Spec Families Comparison Cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-1">
          <div class="p-4 rounded-xl border border-primary/20 bg-primary/5 space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold uppercase tracking-wider text-primary">Family 1: Teletalk Standard</span>
              <span class="text-xs font-semibold text-muted-foreground">300×300 / 300×80 px</span>
            </div>
            <h3 class="font-bold text-base text-foreground">BCS, DPE, NTRCA, Medical &amp; AllJobs</h3>
            <p class="text-xs text-muted-foreground">
              <strong>রঙিন ছবি (Color Photo):</strong> 300×300 pixels (1:1), 10 KB to 100 KB max.<br/>
              <strong>স্বাক্ষর (Signature):</strong> 300×80 pixels (3.75:1), 5 KB to 60 KB max.<br/>
              <span class="text-amber-600 dark:text-amber-400 font-semibold">Strict rule:</span> Greyscale or monochrome photographs are rejected by portal pre-validation.
            </p>
            <div class="pt-2">
              <a href="/teletalk-photo-signature-resize/" class="text-xs font-bold text-primary hover:underline inline-flex items-center gap-1">
                Open Teletalk Master Resizer &rarr;
              </a>
            </div>
          </div>

          <div class="p-4 rounded-xl border border-amber-500/20 bg-amber-500/5 space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold uppercase tracking-wider text-amber-600 dark:text-amber-400">Family 2: Central Bank Standard</span>
              <span class="text-xs font-semibold text-muted-foreground">600×600 / 300×80 px</span>
            </div>
            <h3 class="font-bold text-base text-foreground">Bangladesh Bank &amp; Combined 8/9 Banks</h3>
            <p class="text-xs text-muted-foreground">
              <strong>রঙিন ছবি (Color Photo):</strong> 600×600 pixels (1:1), Maximum 100 KB.<br/>
              <strong>স্বাক্ষর (Signature):</strong> 300×80 pixels, Maximum 60 KB in JPG.<br/>
              <span class="text-foreground font-semibold">Portals:</span> erecruitment.bb.org.bd (AD, Officer General, Cash Officer).
            </p>
            <div class="pt-2">
              <a href="/bd/bangladesh-bank-photo-signature-resizer/" class="text-xs font-bold text-primary hover:underline inline-flex items-center gap-1">
                Open Bangladesh Bank Resizer &rarr;
              </a>
            </div>
          </div>
        </div>

        <!-- Spec Diagrams Visual Proof Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
          <div class="space-y-1.5">
            <span class="text-xs font-bold text-muted-foreground">Official Teletalk Photograph Format:</span>
            <img 
              src="/images/teletalk-photo-spec-300x300.svg" 
              alt="Teletalk Bangladesh 300x300 Photo Specifications Diagram" 
              width="760" 
              height="360" 
              loading="lazy" 
              class="w-full rounded-xl border border-border"
            />
          </div>
          <div class="space-y-1.5">
            <span class="text-xs font-bold text-muted-foreground">Official Teletalk Specimen Signature Format:</span>
            <img 
              src="/images/teletalk-signature-spec-300x80.svg" 
              alt="Teletalk Bangladesh 300x80 Signature Specifications Diagram" 
              width="760" 
              height="360" 
              loading="lazy" 
              class="w-full rounded-xl border border-border"
            />
          </div>
        </div>

        <!-- Active Admissions & Police Notice Box -->
        <div class="p-4 rounded-xl border border-blue-500/20 bg-blue-500/5 space-y-2 text-xs sm:text-sm">
          <div class="flex items-center gap-2 font-bold text-blue-900 dark:text-blue-200">
            <span>📢 Special Portal Exceptions &amp; Current Windows:</span>
          </div>
          <ul class="list-disc pl-5 space-y-1 text-muted-foreground">
            <li>
              <strong>BUET Admission 2026-27 (applications 1 Dec 2026 &ndash; 7 Jan 2027):</strong> 1,309 seats; admission test 1 Feb 2027 (fee payment by 8 Jan). Photo and signature upload on the BUET admission portal: photo 300&times;350 px, max 75 KB, JPG; signature 300&times;80 px, max 20 KB, JPG on clean white background &mdash; source: BUET undergraduate admission circular 2026-27, <span class="font-mono">buet.ac.bd</span>, checked 22 Nov 2026. Use the BUET Admission presets below.
            </li>
            <li>
              <strong>KUET, RUET &amp; CUET Admission 2026-27:</strong> The three engineering universities outside BUET run their own admission portals. KUET: first application deadline 10 Dec 2026 (9:00 PM), admission test 9 Jan 2027; RUET: admission test 28 Jan 2027; CUET (Chittagong): application window unconfirmed at drafting &mdash; preset will publish once its circular releases (distinct from Indian NTA CUET). Photo upload required on each portal: KUET photo 300&times;350 px, max 75 KB (<span class="font-mono">admission.kuet.ac.bd</span>); RUET photo 300&times;350 px, max 75 KB (<span class="font-mono">ruet.ac.bd</span>); CUET verification pending circular &mdash; source: official university admission circulars, checked 22 Nov 2026. Use the KUET &amp; RUET presets below.
            </li>
            <li>
              <strong>Dhaka University (DU EIS &mdash; applications 11–25 Nov 2026):</strong> independent portal rule for 2026-27 &mdash; photo minimum 450×550 px, 20 KB, JPG, plain white background, at <span class="font-mono">admission.eis.du.ac.bd</span> (not the Teletalk 300×300 standard). Use the Dhaka University preset below.
            </li>
            <li>
              <strong>Rajshahi University (RU &mdash; applications 15–30 Nov 2026):</strong> photo 300×400 px, JPG up to 100 KB, white background, at <span class="font-mono">admission.ru.ac.bd</span>. Use the Rajshahi University preset below. The portal also captures a selfie live.
            </li>
            <li>
              <strong>Agricultural Universities Admission 2026-27 (9 universities, combined cluster &mdash; applications open 25 Nov 2026):</strong> Combined admission test covers nine agricultural universities (BAU, BSMRAU, SAU Dhaka, PSTU, CVASU, SAU Sylhet, KAU, HAU, KAU). Photo upload required on the cluster portal: photo 300&times;300 px, max 100 KB, JPG, plain white background; signature 300&times;80 px, max 60 KB, JPG, black or blue ink &mdash; source: Agricultural Cluster Admission System (ACAS) circular via <span class="font-mono">acas.edu.bd</span> &amp; member university portals, checked 22 Nov 2026. Use the BD Agricultural Universities presets below.
            </li>
            <li>
              <strong>Bangladesh Police (SI &amp; TRC Recruitments):</strong> Follows standard Teletalk 300×300 px (≤100 KB) and 300×80 px (≤60 KB) on <span class="font-mono">police.teletalk.com.bd</span>. Candidates can resize directly using the <a class="font-semibold text-primary underline" href="/teletalk-photo-signature-resize/">Teletalk Tool</a>.
            </li>
            <li>
              <strong>Medical (DGME MBBS &amp; BDS 2026–27):</strong> Circular delayed beyond initial 15–18 Nov estimate; applications awaited on <span class="font-mono">dgme.teletalk.com.bd</span> (strictly requires color photos with both ears visible; monochrome scans are rejected). Use the dedicated <a class="font-semibold text-primary underline" href="/bd/medical-admission-photo-resizer/">Medical Admission Resizer</a>.
            </li>
          </ul>
        </div>
      </section>

      <!-- 12 Quick-Access Dedicated Bangladesh Application Tools Grid -->
      <section class="space-y-4 pt-4">
        <div class="flex items-center justify-between">
          <h2 class="text-xl font-bold text-foreground">Dedicated Bangladesh Application Tools</h2>
          <span class="text-xs text-muted-foreground">All 12 portal tools &amp; presets client-side &amp; 100% private</span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          <!-- 1. Teletalk Master -->
          <a href="/teletalk-photo-signature-resize/" class="group p-5 bg-card hover:bg-muted/50 rounded-2xl border border-border hover:border-primary/40 transition space-y-3 shadow-sm flex flex-col justify-between">
            <div class="space-y-2">
              <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center font-bold text-lg">🌐</div>
              <h3 class="font-bold text-foreground group-hover:text-primary transition text-base">Teletalk All Jobs (Master)</h3>
              <p class="text-xs text-muted-foreground leading-relaxed">300×300 px | 300×80 px | alljobs.teletalk.com.bd general portal for all ministries &amp; govt departments.</p>
            </div>
            <span class="inline-flex items-center text-xs font-semibold text-primary">Open Teletalk Resizer &rarr;</span>
          </a>

          <!-- 2. BCS & BPSC -->
          <a href="/bd/bcs-photo-signature-resizer/" class="group p-5 bg-card hover:bg-muted/50 rounded-2xl border border-border hover:border-amber-500/40 transition space-y-3 shadow-sm flex flex-col justify-between">
            <div class="space-y-2">
              <div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-600 dark:text-amber-400 flex items-center justify-center font-bold text-lg">🏛️</div>
              <h3 class="font-bold text-foreground group-hover:text-primary transition text-base">BCS &amp; BPSC (Cadre &amp; Non-Cadre)</h3>
              <p class="text-xs text-muted-foreground leading-relaxed">300×300 px | 300×80 px | 47th / 46th BCS &amp; 9th/10th grade BPSC Non-Cadre posts.</p>
            </div>
            <span class="inline-flex items-center text-xs font-semibold text-primary">Open BCS Tool &rarr;</span>
          </a>

          <!-- 3. Bangladesh Bank -->
          <a href="/bd/bangladesh-bank-photo-signature-resizer/" class="group p-5 bg-card hover:bg-muted/50 rounded-2xl border border-border hover:border-amber-500/40 transition space-y-3 shadow-sm flex flex-col justify-between">
            <div class="space-y-2">
              <div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-600 dark:text-amber-400 flex items-center justify-center font-bold text-lg">🏦</div>
              <h3 class="font-bold text-foreground group-hover:text-primary transition text-base">Bangladesh Bank &amp; State Banks</h3>
              <p class="text-xs text-muted-foreground leading-relaxed">600×600 px | 300×80 px | erecruitment.bb.org.bd Combined 8/9 Banks, AD, Officer General.</p>
            </div>
            <span class="inline-flex items-center text-xs font-semibold text-primary">Open Bank Tool &rarr;</span>
          </a>

          <!-- 4. DPE Primary Teacher -->
          <a href="/bd/primary-teacher-dpe-photo-resizer/" class="group p-5 bg-card hover:bg-muted/50 rounded-2xl border border-border hover:border-amber-500/40 transition space-y-3 shadow-sm flex flex-col justify-between">
            <div class="space-y-2">
              <div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-600 dark:text-amber-400 flex items-center justify-center font-bold text-lg">📚</div>
              <h3 class="font-bold text-foreground group-hover:text-primary transition text-base">DPE Primary Assistant Teacher</h3>
              <p class="text-xs text-muted-foreground leading-relaxed">300×300 px | 300×80 px | dpe.teletalk.com.bd 10 Lakh+ Primary Education recruitment pool.</p>
            </div>
            <span class="inline-flex items-center text-xs font-semibold text-primary">Open DPE Tool &rarr;</span>
          </a>

          <!-- 5. NTRCA -->
          <a href="/bd/ntrca-photo-signature-resizer/" class="group p-5 bg-card hover:bg-muted/50 rounded-2xl border border-border hover:border-amber-500/40 transition space-y-3 shadow-sm flex flex-col justify-between">
            <div class="space-y-2">
              <div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-600 dark:text-amber-400 flex items-center justify-center font-bold text-lg">🎓</div>
              <h3 class="font-bold text-foreground group-hover:text-primary transition text-base">NTRCA Teacher Registration</h3>
              <p class="text-xs text-muted-foreground leading-relaxed">300×300 px | 300×80 px | ntrca.teletalk.com.bd 18th &amp; 19th Non-Govt Teacher Registration.</p>
            </div>
            <span class="inline-flex items-center text-xs font-semibold text-primary">Open NTRCA Tool &rarr;</span>
          </a>

          <!-- 6. DGME Medical Admission -->
          <a href="/bd/medical-admission-photo-resizer/" class="group p-5 bg-card hover:bg-muted/50 rounded-2xl border border-border hover:border-amber-500/40 transition space-y-3 shadow-sm flex flex-col justify-between">
            <div class="space-y-2">
              <div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-600 dark:text-amber-400 flex items-center justify-center font-bold text-lg">🩺</div>
              <h3 class="font-bold text-foreground group-hover:text-primary transition text-base">DGME Medical Admission (MBBS/BDS)</h3>
              <p class="text-xs text-muted-foreground leading-relaxed">300×300 px | 300×80 px | dgme.teletalk.com.bd MBBS &amp; BDS 2026–27 government &amp; private seats.</p>
              <p class="text-xs font-medium text-emerald-700 dark:text-emerald-300 leading-snug">Applications open mid-Nov 2026 · Admission test 18 Dec 2026.</p>
            </div>
            <span class="inline-flex items-center text-xs font-semibold text-primary">Open Medical Tool &rarr;</span>
          </a>

          <!-- 7. Agricultural Universities Cluster (ACAS) -->
          <a href="/?preset=agri-cluster-photo-bd#tool-workspace" class="group p-5 bg-card hover:bg-muted/50 rounded-2xl border border-border hover:border-emerald-500/40 transition space-y-3 shadow-sm flex flex-col justify-between">
            <div class="space-y-2">
              <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold text-lg">🌾</div>
              <h3 class="font-bold text-foreground group-hover:text-primary transition text-base">Agricultural Universities (ACAS)</h3>
              <p class="text-xs text-muted-foreground leading-relaxed">300×300 px (≤100 KB) photo &amp; 300×80 px (≤60 KB) signature | acas.edu.bd 9-university combined cluster.</p>
              <p class="text-xs font-medium text-emerald-700 dark:text-emerald-300 leading-snug">Applications open 25 November 2026.</p>
            </div>
            <span class="inline-flex items-center text-xs font-semibold text-primary">Open Agri Cluster Tool &rarr;</span>
          </a>

          <!-- 8. BUET Undergraduate Admission -->
          <a href="/?preset=buet-admission-photo-bd#tool-workspace" class="group p-5 bg-card hover:bg-muted/50 rounded-2xl border border-border hover:border-blue-500/40 transition space-y-3 shadow-sm flex flex-col justify-between">
            <div class="space-y-2">
              <div class="w-10 h-10 rounded-xl bg-blue-500/10 text-blue-600 dark:text-blue-400 flex items-center justify-center font-bold text-lg">🏛️</div>
              <h3 class="font-bold text-foreground group-hover:text-primary transition text-base">BUET Undergraduate Admission</h3>
              <p class="text-xs text-muted-foreground leading-relaxed">300×350 px (≤75 KB) photo &amp; 300×80 px (≤20 KB) signature | buet.ac.bd 1,309 engineering seats.</p>
              <p class="text-xs font-medium text-blue-700 dark:text-blue-300 leading-snug">Applications 1 Dec 2026 – 7 Jan 2027 · Test 1 Feb 2027.</p>
            </div>
            <span class="inline-flex items-center text-xs font-semibold text-primary">Open BUET Tool &rarr;</span>
          </a>

          <!-- 9. KUET & RUET Engineering Admission -->
          <a href="/?preset=kuet-admission-photo-bd#tool-workspace" class="group p-5 bg-card hover:bg-muted/50 rounded-2xl border border-border hover:border-indigo-500/40 transition space-y-3 shadow-sm flex flex-col justify-between">
            <div class="space-y-2">
              <div class="w-10 h-10 rounded-xl bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 flex items-center justify-center font-bold text-lg">⚙️</div>
              <h3 class="font-bold text-foreground group-hover:text-primary transition text-base">KUET &amp; RUET Admission</h3>
              <p class="text-xs text-muted-foreground leading-relaxed">300×350 px (≤75 KB) photo | admission.kuet.ac.bd &amp; ruet.ac.bd independent engineering portals.</p>
