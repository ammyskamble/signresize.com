---
// src/pages/bd/medical-admission-photo-resizer.astro
import '../../styles/global.css';
import Header from '../../components/Header.astro';
import { SignatureTool } from '../../components/SignatureTool';
import FaqSection from '../../components/FaqSection.astro';
import ExamSpecsTable from '../../components/ExamSpecsTable.astro';
import CountryBlogSection from '../../components/CountryBlogSection.astro';
import Footer from '../../components/Footer.astro';
import GoogleAnalytics from '../../components/GoogleAnalytics.astro';
import GoogleFonts from '../../components/GoogleFonts.astro';
import ThemeScript from '../../components/ThemeScript.astro';

const pageTitle = "Bangladesh Medical MBBS/BDS Admission 2026-27 Photo & Signature Resizer - SignResize";
const pageDescription = "Format photo to 300x300 px (10–100 KB) and signature to 300x80 px (5–60 KB) for DGME Medical MBBS/BDS Admission 2026-27. Circular delayed beyond mid-Nov estimate — prep presets ready for dgme.teletalk.com.bd.";
const canonicalUrl = "https://signresize.in/bd/medical-admission-photo-resizer/";
const ogImageUrl = "https://signresize.in/og-image.png";
const keywordsContent = "medical admission photo resizer bangladesh, mbbs admission 2026-27 photo size 300x300, bds dental admission signature size 300x80, dgme teletalk photo crop, dghs medical photo size";

const medicalFaqs = [
  {
    q: "When is the Bangladesh MBBS/BDS Medical Admission 2026-27 application and exam date?",
    summary: "The DGME MBBS & BDS admission circular is currently delayed beyond the initial 15–18 November projection. Online applications will open on dgme.teletalk.com.bd once the official circular releases, with the admission test tentatively scheduled for 18 December 2026.",
    details: "As of late November 2026, the official 2026-27 DGME admission circular has not yet been published. Monitor dgme.gov.bd for the revised schedule, and prepare your 300×300 photo (10–100 KB) and 300×80 signature (5–60 KB) in advance."
  },
  {
    q: "What is the official photo size for MBBS & BDS admission in Bangladesh?",
    summary: "The Directorate General of Medical Education (DGME) requires a 300×300 pixel color photograph with file weight between 10 KB and 100 KB in JPG format.",
    details: "The applicant's face must be centered with both ears and eyes clearly visible. Caps, dark sunglasses, or heavily edited filters are strictly prohibited."
  },
  {
    q: "What are the signature requirements for DGME Medical Admission (dgme.teletalk.com.bd)?",
    summary: "The specimen signature must be exactly 300×80 pixels with file size between 5 KB and 60 KB in JPG format.",
    details: "Sign in dark ink on clean unruled white paper. Ensure high contrast so the signature prints clearly on the examination admit card."
  },
  {
    q: "Are the photo rules the same for Government Medical and Private Medical Colleges?",
    summary: "Yes, all 37 government medical colleges, 67 private medical colleges, and dental colleges operate under the centralized DGME portal.",
    details: "Every applicant submits images through dgme.teletalk.com.bd, which runs the standard 300×300 px and 300×80 px validation."
  },
  {
    q: "How can I avoid rejection during biometric admit card scanning on exam day?",
    summary: "Use SignResize to produce sharp 300×300 pixels without compression artifacts or pixelation.",
    details: "Invigilators cross-verify your physical appearance against the admit card photo. Clear lighting and neutral expression are strongly recommended."
  },
  {
    q: "মেডিকেল ও বিডিএস ভর্তি পরীক্ষার ছবির সাইজ কত? (What is Medical admission photo size in Bangla?)",
    summary: "ডিজিএমই (DGME) মেডিকেল (MBBS) ও ডেন্টাল (BDS) ভর্তি আবেদনের জন্য রঙিন ছবির সাইজ ৩০০ × ৩০০ পিক্সেল (১০–১০০ KB) এবং স্বাক্ষরের সাইজ ৩০০ × ৮০ পিক্সেল (৫–৬০ KB) হতে হবে।",
    details: "উভয় ফাইল অবশ্যই JPG ফরম্যাটে হতে হবে। সাদা ব্যাকগ্রাউন্ডে উভয় কান ও চোখ স্পষ্টভাবে দেখা যেতে হবে। সাদাকালো ছবি দিলে আবেদন বাতিল হবে।"
  },
  {
    q: "dgme.teletalk.com.bd ওয়েবসাইটে ছবি আপলোড না হলে কী করবেন?",
    summary: "মেডিকেল ভর্তি পোর্টালে ছবির অনুপাত ১:১ এবং ৩০০×৩০০ পিক্সেল না হলে সরাসরি রিজেক্ট করে।",
    details: "SignResize-এ ছবি আপলোড করে ক্রপ করলে স্বয়ংক্রিয়ভাবে ডিজিএমই নির্ধারিত ৩০০×৩০০ পিক্সেল ও ১০০ KB-এর মধ্যে রেডি হয়ে যাবে।"
  }
];
---

<!doctype html>
<html lang="en-BD" class="scroll-smooth">
  <head>
    <ThemeScript />
    <GoogleAnalytics />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={keywordsContent} />
    <meta name="author" content="SignResize.in" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Hreflang Tags -->
    <link rel="alternate" hreflang="en-BD" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />

    <!-- Open Graph (OG) Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="SignResize" />
    <meta property="og:locale" content="en_BD" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Web Fonts & Favicons -->
    <GoogleFonts />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <meta name="theme-color" content="#4f46e5" />

    <!-- Schema.org WebApplication JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "Bangladesh Medical Admission Photo & Signature Resizer",
      "url": canonicalUrl,
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "description": pageDescription,
      "featureList": [
        "300x300 px Medical MBBS Photo Resizer (≤100 KB)",
        "300x80 px Dental BDS Signature Resizer (≤60 KB)",
        "Zero Server Upload - 100% In-Browser Privacy",
        "DGME & DGHS Teletalk 100% Pass Guarantee"
      ]
    })} />
  
    <!-- Schema.org FAQPage JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": medicalFaqs.map(faq => ({
        "@type": "Question",
        "name": faq.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": `${faq.summary} ${faq.details}`
        }
      }))
    })} />

    <!-- Schema.org HowTo JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "HowTo",
      "name": "How to Resize Photo & Signature for DGME Medical MBBS/BDS Admission",
      "description": "Step-by-step guide to crop, resize, and compress image uploads strictly compliant with dgme.teletalk.com.bd.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Select Medical Admission Photo (300×300 px) or Signature",
          "text": "Open the tool with the preloaded preset. The official pixel dimensions and aspect ratio are automatically locked.",
          "url": canonicalUrl
        },
        {
          "@type": "HowToStep",
          "name": "Upload & Adjust Crop Frame",
          "text": "Upload your photo or signature scan. Adjust zoom and position within the guide frame.",
          "url": canonicalUrl
        },
        {
          "@type": "HowToStep",
          "name": "Download Certified JPG",
          "text": "Click Download to export your image strictly within the required KB limits, guaranteed to pass dgme.teletalk.com.bd.",
          "url": canonicalUrl
        }
      ]
    })} />
  </head>

  <body class="min-h-screen bg-background text-foreground flex flex-col font-sans antialiased">
    <Header />

    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-8">
      <!-- Tool Page Header with Selector Dropdown -->
      <section class="space-y-4">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div class="space-y-2">
            <div class="flex flex-wrap items-center gap-2">
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-amber-500/10 text-amber-700 dark:text-amber-300 border border-amber-500/20">
                <svg class="w-4 h-2.5 rounded-xs shadow-2xs shrink-0 inline-block" viewBox="0 0 20 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <rect width="20" height="12" fill="#006a4e" rx="1" />
                  <circle cx="9" cy="6" r="4" fill="#f42a41" />
                </svg>
                <span>DGME Official Preset (dgme.teletalk.com.bd)</span>
              </div>
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 border border-emerald-500/25">
                Admission 2026-27 · Test: 18 December 2026
              </span>
            </div>
            <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-foreground">
              Medical Admission Photo &amp; Signature Resizer <span class="text-primary">(300×300 / 300×80)</span>
            </h1>
            <div class="text-xs font-semibold text-amber-700 dark:text-amber-400">
              মেডিকেল ও বিডিএস ভর্তি পরীক্ষা রঙিন ছবি ৩০০×৩০০ পিক্সেল (সর্বোচ্চ ১০০ KB) ও স্বাক্ষর ৩০০×৮০ পিক্সেল (সর্বোচ্চ ৬০ KB)
            </div>
            <p class="text-muted-foreground text-sm sm:text-base max-w-3xl">
              MBBS &amp; BDS Admission 2026-27: calibrated cropping and size reduction for Bangladesh Medical &amp; Dental admission tests conducted by DGME (applications expected mid-November on <span class="font-medium text-foreground">dgme.teletalk.com.bd</span>, test on <span class="font-medium text-foreground">18 December 2026</span>).
            </p>
          </div>

          <!-- Quick Dropdown Hub Selector -->
          <div class="w-full md:w-auto min-w-[280px] bg-card p-3 rounded-xl border border-border shadow-sm">
            <label for="bd-tool-select" class="block text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-1.5">
              Select Bangladesh Portal Tool:
            </label>
            <select
              id="bd-tool-select"
              class="w-full bg-background border border-input text-foreground rounded-lg px-3 py-2 text-sm font-medium focus:ring-2 focus:ring-primary focus:outline-none cursor-pointer"
              onchange="if(this.value) window.location.href=this.value;"
            >
              <option value="/bd/">Bangladesh Main Hub</option>
              <option value="/teletalk-photo-signature-resize/">Teletalk Photo &amp; Signature</option>
              <option value="/bd/bcs-photo-signature-resizer/">BCS &amp; BPSC (300×300 / 300×80 px)</option>
              <option value="/bd/bangladesh-bank-photo-signature-resizer/">Bangladesh Bank (600×600 / 300×80 px)</option>
              <option value="/bd/primary-teacher-dpe-photo-resizer/">DPE Primary Assistant Teacher</option>
              <option value="/bd/ntrca-photo-signature-resizer/">NTRCA Teacher Registration</option>
              <option value="/bd/medical-admission-photo-resizer/" selected>DGME Medical MBBS/BDS Admission</option>
            </select>
          </div>
        </div>
      </section>

      <!-- Admission 2026-27 Schedule & Upload Spec Block -->
      <section aria-labelledby="admission-2026-27-heading" class="rounded-2xl border border-primary/25 bg-card p-4 sm:p-6 shadow-sm space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div class="space-y-1">
            <p class="text-xs font-bold uppercase tracking-wider text-primary">Admission 2026-27 · Bangladesh MBBS &amp; BDS</p>
            <h2 id="admission-2026-27-heading" class="text-lg sm:text-xl font-bold text-foreground">
              DGME 2026-27 Schedule &amp; Photo / Signature Specifications
            </h2>
          </div>
          <a href="#tool-workspace" class="inline-flex min-h-11 items-center justify-center rounded-xl bg-primary px-4 py-2 text-xs sm:text-sm font-bold text-primary-foreground hover:opacity-90 transition shrink-0">
            Resize Photo &amp; Signature ↓
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs sm:text-sm">
          <div class="rounded-xl border border-amber-500/30 bg-amber-500/10 p-3 space-y-0.5">
            <div class="text-[11px] font-semibold uppercase tracking-wider text-amber-800 dark:text-amber-200">Online Applications</div>
            <div class="font-bold text-foreground text-amber-700 dark:text-amber-300">Delayed (Awaited Late Nov 2026)</div>
            <div class="text-xs text-amber-900 dark:text-amber-100">Delayed beyond 15–18 Nov estimate · Portal: <span class="font-mono text-foreground">dgme.teletalk.com.bd</span></div>
          </div>
          <div class="rounded-xl border border-border bg-muted/40 p-3 space-y-0.5">
            <div class="text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">Admission Test Date</div>
            <div class="font-bold text-foreground">18 December 2026 (Tentative)</div>
            <div class="text-xs text-muted-foreground">Govt &amp; Private Medical / Dental Colleges</div>
          </div>
          <div class="rounded-xl border border-border bg-muted/40 p-3 space-y-0.5">
            <div class="text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">Circular Status</div>
            <div class="font-bold text-foreground">Circular Awaited (Delayed Past 18 Nov)</div>
            <div class="text-xs text-muted-foreground">Official circular delayed; check <span class="font-mono text-foreground">dgme.gov.bd</span> for revised release notice.</div>
          </div>
        </div>

        <div class="overflow-x-auto rounded-xl border border-border">
          <table class="w-full text-left text-xs sm:text-sm">
            <caption class="sr-only">DGME MBBS and BDS Admission 2026-27 Photo and Signature Upload Specifications</caption>
            <thead class="bg-muted text-foreground font-semibold">
              <tr>
                <th scope="col" class="p-3">Upload File</th>
                <th scope="col" class="p-3">Dimensions</th>
                <th scope="col" class="p-3">File Size</th>
                <th scope="col" class="p-3">Format &amp; Upload Rules</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border">
              <tr>
                <th scope="row" class="p-3 font-bold text-foreground">MBBS / BDS Photograph</th>
                <td class="p-3 font-mono font-bold text-primary">300 × 300 px</td>
                <td class="p-3 font-mono font-semibold text-emerald-700 dark:text-emerald-400">10–100 KB</td>
                <td class="p-3 text-muted-foreground">JPG/JPEG, recent color portrait, plain white background, both ears visible, no glasses/caps.</td>
              </tr>
              <tr>
                <th scope="row" class="p-3 font-bold text-foreground">Specimen Signature</th>
                <td class="p-3 font-mono font-bold text-primary">300 × 80 px</td>
                <td class="p-3 font-mono font-semibold text-emerald-700 dark:text-emerald-400">5–60 KB</td>
                <td class="p-3 text-muted-foreground">JPG/JPEG, dark black ink signature on clean unruled white paper.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Signature Tool Canvas Widget loaded with Medical Admission preset -->
      <section id="tool-workspace" class="scroll-mt-20 bg-card rounded-2xl p-4 sm:p-6 border border-border shadow-sm">
        <SignatureTool client:idle initialPresetId="dgme-medical-photo-bd" initialMode="photo" />
      </section>

      <!-- SEO Educational Guide Section -->
      <section class="space-y-6 pt-6 border-t border-border">
        <div class="bg-card rounded-2xl p-6 sm:p-8 border border-border space-y-6">
          <div class="flex flex-wrap items-center justify-between gap-2 border-b border-border/80 pb-3">
            <div>
              <span class="text-xs font-bold text-amber-600 dark:text-amber-400 uppercase tracking-wider">ডিজিএমই মেডিকেল ও ডেন্টাল ভর্তি নির্দেশিকা</span>
              <h2 class="text-2xl font-bold text-foreground">
                Complete Bangladesh Medical College MBBS &amp; BDS Image Guidelines
              </h2>
            </div>
            <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
              ✓ Verified 16 Nov 2026: Official DGME Admission Portal
            </span>
          </div>

          <p class="text-muted-foreground leading-relaxed">
            Every year, approximately 1.4 lakh candidates compete for seats across government and private medical and dental colleges in Bangladesh. Online applications are processed centrally on <em>dgme.teletalk.com.bd</em>. Submitting photos that do not match the required 300×300 pixel dimension or exceed 100 KB will cause automatic application failure.
          </p>

          <div class="p-3.5 rounded-xl border border-rose-500/25 bg-rose-500/10 text-xs sm:text-sm text-rose-950 dark:text-rose-100 font-medium space-y-1">
            <strong>⚠️ DGME Mandatory Upload Rules &amp; Disqualification Causes:</strong>
            <ul class="list-disc pl-5 space-y-0.5 text-xs text-muted-foreground">
              <li><strong class="text-foreground">Color Photograph Only:</strong> DGME scrutiny strictly disqualifies monochrome, greyscale, black-and-white, or beauty-filtered selfies.</li>
              <li><strong class="text-foreground">Biometric Clarity:</strong> Both ears, eyes, and eyebrows must be uncovered and clearly visible. Caps and tinted glasses are prohibited.</li>
              <li><strong class="text-foreground">Specimen Signature:</strong> Must be signed in black ink on clean white paper and cropped strictly to 300×80 px (≤60 KB).</li>
            </ul>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 my-4">
            <div class="p-4 bg-muted/40 rounded-xl border border-border space-y-1">
              <h3 class="font-bold text-base text-foreground">MBBS Photograph</h3>
              <p class="text-xs text-muted-foreground"><strong>300 × 300 pixels</strong>, 10 KB to 100 KB JPG. Recent color photo on plain white background.</p>
            </div>
            <div class="p-4 bg-muted/40 rounded-xl border border-border space-y-1">
              <h3 class="font-bold text-base text-foreground">Specimen Signature</h3>
              <p class="text-xs text-muted-foreground"><strong>300 × 80 pixels</strong>, 5 KB to 60 KB JPG. Plain white paper with dark black ink.</p>
            </div>
            <div class="p-4 bg-muted/40 rounded-xl border border-border space-y-1">
              <h3 class="font-bold text-base text-foreground">National Exam Scope</h3>
              <p class="text-xs text-muted-foreground">Applies to all Government Medical Colleges (DMC, SSMC, SOMC, etc.) and Dental Colleges.</p>
            </div>
          </div>

          <!-- Official Visual Diagrams Grid -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 my-6">
            <div class="space-y-1.5">
              <span class="text-xs font-bold text-muted-foreground">DGME Medical Photo Diagram (রঙিন ছবি ৩০০×৩০০):</span>
              <img 
                src="/images/teletalk-photo-spec-300x300.svg" 
                alt="DGME Medical Admission 300x300 Photo Specification Diagram" 
                width="760" 
                height="360" 
                loading="lazy" 
                class="w-full rounded-xl border border-border shadow-xs"
              />
            </div>
            <div class="space-y-1.5">
              <span class="text-xs font-bold text-muted-foreground">DGME Medical Signature Diagram (স্বাক্ষর ৩০০×৮০):</span>
              <img 
                src="/images/teletalk-signature-spec-300x80.svg" 
                alt="DGME Medical Admission 300x80 Signature Specification Diagram" 
                width="760" 
                height="360" 
                loading="lazy" 
                class="w-full rounded-xl border border-border shadow-xs"
              />
            </div>
          </div>

          <!-- In-Cluster Deep Guide Link -->
          <div class="p-4 rounded-xl border border-primary/20 bg-primary/5 text-xs sm:text-sm space-y-1.5">
            <h4 class="font-bold text-foreground flex items-center gap-2">
              <span>🩺</span>
              <span>Need Detailed University &amp; Medical Admission Upload Rules?</span>
            </h4>
            <p class="text-muted-foreground leading-relaxed">
              Compare DGME Medical standards with Dhaka University (DU EIS) and GST Cluster application requirements: 
              <a href="/blog/bangladesh-university-medical-admission-photo-signature-guide-2026/" class="text-primary underline font-bold">DU, GST Cluster &amp; Medical (DGME) Admission Photo &amp; Signature Specifications 2026 &rarr;</a>
            </p>
          </div>
        </div>
      </section>

      <!-- Specifications Table, Country Blog Section & FAQ Section -->
      <section class="space-y-6">
        <ExamSpecsTable country="BD" />
        <CountryBlogSection country="BD" />
        <FaqSection faqs={medicalFaqs} title="Frequently Asked Questions (Medical Admission)" />
      </section>
    </main>

    <Footer />
  </body>
</html>

