---
// src/pages/us/ds-160-photo-resizer.astro
import '../../styles/global.css';
import Header from '../../components/Header.astro';
import { SignatureTool } from '../../components/SignatureTool';
import FaqSection from '../../components/FaqSection.astro';
import Footer from '../../components/Footer.astro';
import GoogleAnalytics from '../../components/GoogleAnalytics.astro';
import GoogleFonts from '../../components/GoogleFonts.astro';
import ThemeScript from '../../components/ThemeScript.astro';
import USToolSwitcher from '../../components/USToolSwitcher.astro';

const pageTitle = "DS-160 Photo Resizer Online (600x600 Pixels & Under 240KB) - SignResize";
const pageDescription = "Free Form DS-160 US Visa photo resizer. Crop and compress your digital visa photo to 600x600 pixels, under 240 KB, JPEG format, and white background instantly. Meets travel.state.gov rules.";
const canonicalUrl = "https://signresize.in/us/ds-160-photo-resizer/";
const ogImageUrl = "https://signresize.in/og-image.png";
const keywordsContent = "ds 160 photo resizer online, crop photo for ds 160, ds 160 photo converter 600x600, us visa photo size in pixels, ds 160 photo 240kb, travel state gov visa photo validator, free us visa photo crop tool";

const ds160Faqs = [
  {
    q: "Why does the Form DS-160 website reject my photo?",
    a: "Common reasons for DS-160 photo rejection include incorrect dimensions (not 600x600 pixels), file size exceeding 240 KB, non-white or shadowy backgrounds, wearing eyeglasses, incorrect head height ratio (must be 50%-69%), or bad image compression."
  },
  {
    q: "What are the exact pixel dimensions required for DS-160?",
    a: "The digital photo must be a square aspect ratio (1:1), with minimum dimensions of 600x600 pixels and maximum dimensions of 1200x1200 pixels."
  },
  {
    q: "Can I wear eyeglasses in my US visa photograph?",
    a: "No. Eyeglasses are strictly prohibited in US visa photos, except in rare medical circumstances (e.g., recent eye surgery) accompanied by a signed doctor's medical certificate."
  },
  {
    q: "How does the SignResize DS-160 Resizer ensure compliance?",
    a: "Our tool automatically forces a 1:1 square crop ratio, renders an overlay face guide for 50-69% head ratio alignment, enforces 600x600 pixel canvas output, and compresses file size under 240 KB in pure JPEG format."
  }
];
---

<!doctype html>
<html lang="en-US" class="scroll-smooth">
  <head>
    <ThemeScript />
    <GoogleAnalytics />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={keywordsContent} />
    <meta name="author" content="SignResize.in" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph (OG) Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="SignResize" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Web Fonts & Favicons -->
    <GoogleFonts />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <meta name="theme-color" content="#4f46e5" />

    <!-- Schema.org SoftwareApplication & HowTo JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": ["SoftwareApplication", "WebApplication"],
      "name": "Form DS-160 US Visa Photo Resizer",
      "url": canonicalUrl,
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "All",
      "description": pageDescription,
      "featureList": [
        "Resize photo to 600x600 pixels for Form DS-160",
        "Compress file size under 240 KB",
        "1:1 Square aspect ratio cropping",
        "Face head height alignment guide (50-69%)"
      ]
    })} />
  </head>

  <body class="min-h-screen bg-background text-foreground flex flex-col font-sans antialiased selection:bg-primary/20 selection:text-primary">
    <Header />

    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-8">
      <!-- Breadcrumb Navigation -->
      <nav class="flex items-center gap-2 text-xs text-muted-foreground">
        <a href="/" class="hover:text-primary transition">Home</a>
        <span>/</span>
        <a href="/us/" class="hover:text-primary transition">US Hub</a>
        <span>/</span>
        <span class="text-foreground font-semibold">Form DS-160 Photo Resizer</span>
      </nav>

      <!-- Page Hero Header -->
      <section class="space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div class="space-y-1.5">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 border border-indigo-500/20">
              <span>🇺🇸 Travel.state.gov Official Compliant</span>
            </div>
            <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-foreground">
              Form DS-160 US Visa Photo Resizer <span class="text-primary">(600×600 px | &lt;240 KB)</span>
            </h1>
            <p class="text-sm sm:text-base text-muted-foreground max-w-3xl">
              Crop and resize your US Nonimmigrant Visa photo for Form DS-160. Ensures 600×600 pixel dimensions, JPEG formatting, and under 240 KB file size limits with 100% client-side privacy.
            </p>
          </div>

          <!-- Quick Switch US Tools Dropdown -->
          <USToolSwitcher currentTool="ds160" />
        </div>
      </section>

      <!-- Prominent White Background Requirement Notice for US Portals -->
      <div class="p-4 sm:p-5 rounded-2xl border-2 border-emerald-500/30 bg-emerald-500/5 shadow-2xs flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="space-y-1">
          <div class="inline-flex items-center gap-1.5 text-xs font-bold text-emerald-700 dark:text-emerald-400">
            <span>🪄</span>
            <span>Official US Requirement: 100% Plain White Background (#FFFFFF)</span>
          </div>
          <p class="text-xs text-muted-foreground leading-relaxed">
            US Department of State &amp; USCIS strictly reject digital photos with room objects, textures, shadows, or colors. Upload your portrait below and use the built-in <strong>Make Background Pure White</strong> button in the workspace to automatically replace your background with compliant white (#FFFFFF).
          </p>
        </div>
        <a
          href="/photo-background-remover/"
          class="shrink-0 inline-flex items-center justify-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-bold bg-white dark:bg-slate-800 border border-emerald-500/40 text-emerald-700 dark:text-emerald-300 hover:bg-emerald-500/10 transition shadow-2xs"
        >
          <span>Standalone BG Remover →</span>
        </a>
      </div>

      <!-- Resizer Studio Tool Workspace initialized with US DS-160 Preset -->
      <section id="tool-workspace" class="scroll-mt-20">
        <SignatureTool client:load initialPresetId="us-ds160" />
      </section>

      <!-- Technical Guidelines & Interlinking Section -->
      <section class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="md:col-span-2 space-y-4 bg-card border border-border p-6 rounded-2xl">
          <h2 class="text-xl font-bold text-foreground">
            Form DS-160 Digital Image Requirements Checklist
          </h2>
          <ul class="space-y-2.5 text-xs sm:text-sm text-muted-foreground">
            <li class="flex items-start gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span><strong>Dimensions:</strong> Exactly 600 × 600 pixels (1:1 square ratio) up to 1200 × 1200 pixels max.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span><strong>File Size:</strong> Must be equal to or less than 240 KB (Kilobytes).</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span><strong>Format:</strong> JPEG (.jpg / .jpeg) format.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span><strong>Head Position:</strong> Chin to top of hair must measure between 50% and 69% of image height.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span><strong>Background &amp; Glasses:</strong> Plain white or off-white background with neutral expression. No eyeglasses allowed.</span>
            </li>
          </ul>
        </div>

        <!-- Cross Interlinking Box -->
        <div class="space-y-4 bg-primary/5 border border-primary/20 p-6 rounded-2xl">
          <h3 class="text-base font-bold text-foreground">Related US Photo Tools</h3>
          <div class="space-y-2 text-xs">
            <a href="/us/passport-photo-resizer/" class="block p-2.5 rounded-xl bg-card border border-border hover:border-primary transition font-medium text-foreground">
              🛂 US Passport Photo Resizer (2×2 Inch) →
            </a>
            <a href="/us/green-card-photo-resizer/" class="block p-2.5 rounded-xl bg-card border border-border hover:border-primary transition font-medium text-foreground">
              🗽 USCIS Green Card &amp; DV Lottery Tool →
            </a>
            <a href="/us/common-app-photo-resizer/" class="block p-2.5 rounded-xl bg-card border border-border hover:border-primary transition font-medium text-foreground">
              🎓 Common App Student Photo Resizer →
            </a>
            <a href="/blog/us-visa-passport-photo-resizer-ds160-greencard-guide-2026/" class="block p-2.5 rounded-xl bg-indigo-500/10 border border-indigo-500/25 hover:border-indigo-500 transition font-bold text-indigo-700 dark:text-indigo-300">
              📖 Read US Photo Master Guide 2026 (DS-160, Passport, USCIS) →
            </a>
            <a href="/us/" class="block p-2.5 rounded-xl bg-primary text-primary-foreground text-center font-bold hover:opacity-90 transition mt-2">
              Explore All US Tools Hub →
            </a>
          </div>
        </div>
      </section>

      <!-- FAQ Section -->
      <section class="space-y-6">
        <FaqSection faqs={ds160Faqs} title="Form DS-160 Photo Resizer FAQs" />
      </section>
    </main>

    <Footer />
  </body>
</html>
