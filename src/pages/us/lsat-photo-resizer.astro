---
// src/pages/us/lsat-photo-resizer.astro
import '../../styles/global.css';
import Header from '../../components/Header.astro';
import { SignatureTool } from '../../components/SignatureTool';
import FaqSection from '../../components/FaqSection.astro';
import Footer from '../../components/Footer.astro';
import GoogleAnalytics from '../../components/GoogleAnalytics.astro';
import GoogleFonts from '../../components/GoogleFonts.astro';
import ThemeScript from '../../components/ThemeScript.astro';
import USToolSwitcher from '../../components/USToolSwitcher.astro';

const pageTitle = "LSAC / LSAT Candidate Photo Resizer (Test Day ID 600x600 px) - SignResize";
const pageDescription = "Free online LSAC candidate photo resizer for the LSAT exam. Format, crop, and resize your photo to 600x600 pixels square, under 5 MB in JPEG format for JD.LSAC.org candidate profile verification.";
const canonicalUrl = "https://signresize.in/us/lsat-photo-resizer/";
const ogImageUrl = "https://signresize.in/og-image.png";
const keywordsContent = "lsat candidate photo upload size, lsac candidate photo resizer, lsat test day photo requirements, proctoru lsat photo upload, lsac photo upload error, resize photo for lsat registration";

const lsatFaqs = [
  {
    q: "What are the LSAC candidate photo requirements for the LSAT?",
    a: "LSAC requires a passport-style candidate photograph: square 1:1 aspect ratio (measuring at least 600×600 pixels), maximum file size of 5 MB, in JPG format. The photo must feature a clear, forward-facing view of your head and shoulders against a plain light background."
  },
  {
    q: "How does LSAC use my candidate photo on test day?",
    a: "Your candidate photo is printed on your LSAT admission ticket, displayed on the Prometric check-in terminal, and provided to ProctorU remote proctors to verify your identity before administering the exam."
  },
  {
    q: "What are the common reasons LSAC rejects applicant photos?",
    a: "Rejections occur when photos are too dark, include other individuals, show excessive head tilting, feature sunglasses or hats, have distracting backgrounds, or fail to follow the 1:1 square ratio."
  },
  {
    q: "Can I use an iPhone or Android portrait for my LSAT registration?",
    a: "Yes. Have a friend take a straight-on portrait in front of a white wall in good lighting. Upload it to SignResize to lock the 600×600 px dimensions, center your face, and clean up the background."
  },
  {
    q: "Are my candidate photos stored or uploaded to an external server?",
    a: "No. SignResize processes 100% of image manipulation directly in your browser using HTML5 Canvas APIs. Zero images or personal identifiers ever touch our servers."
  }
];
---

<!doctype html>
<html lang="en-US" class="scroll-smooth">
  <head>
    <ThemeScript />
    <GoogleAnalytics />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={keywordsContent} />
    <meta name="author" content="SignResize.in" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph (OG) Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="SignResize" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Web Fonts & Favicons -->
    <GoogleFonts />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <meta name="theme-color" content="#d97706" />

    <!-- Schema.org SoftwareApplication & HowTo JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": ["SoftwareApplication", "WebApplication"],
      "name": "LSAC / LSAT Candidate Photo Resizer",
      "url": canonicalUrl,
      "applicationCategory": "EducationalApplication",
      "operatingSystem": "All",
      "description": pageDescription,
      "featureList": [
        "1:1 Square 600x600 px crop for LSAT candidate profile",
        "Compatible with Prometric & ProctorU identity verification",
        "Guaranteed under 5 MB JPG file size limit",
        "Biometric head guide for proper head and shoulder proportion",
        "100% private in-browser canvas execution"
      ]
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "HowTo",
      "name": "How to Prepare Your LSAC Candidate Photo for the LSAT",
      "description": "Step-by-step instructions to format and upload your LSAC candidate profile picture for test day check-in.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Take a forward-facing headshot",
          "text": "Stand 4 feet away from a light-colored wall with neutral lighting and eyes open."
        },
        {
          "@type": "HowToStep",
          "name": "Upload to SignResize LSAT Tool",
          "text": "Drop your image into the workspace. The tool pre-configures a 600×600 px square canvas."
        },
        {
          "@type": "HowToStep",
          "name": "Center head and shoulders",
          "text": "Align your face with the candidate guide oval."
        },
        {
          "@type": "HowToStep",
          "name": "Download and attach to JD.LSAC.org",
          "text": "Download the JPG file and upload it to your LSAC candidate account before the photo submission deadline."
        }
      ]
    })} />
  </head>

  <body class="min-h-screen bg-background text-foreground flex flex-col font-sans antialiased selection:bg-primary/20 selection:text-primary">
    <Header />

    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-8">
      <!-- Breadcrumb Navigation -->
      <nav class="flex items-center gap-2 text-xs text-muted-foreground">
        <a href="/" class="hover:text-primary transition">Home</a>
        <span>/</span>
        <a href="/us/" class="hover:text-primary transition">US Hub</a>
        <span>/</span>
        <a href="/us/exams/" class="hover:text-primary transition">US Exams</a>
        <span>/</span>
        <span class="text-foreground font-semibold">LSAC / LSAT Candidate Photo Resizer</span>
      </nav>

      <!-- Hero Header -->
      <section class="space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div class="space-y-1.5">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20">
              <span>⚖️ Law School Admission Council (LSAC) Law School Admissions</span>
            </div>
            <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-foreground">
              LSAC / LSAT Candidate <span class="text-primary">Photo Resizer (600×600 px)</span>
            </h1>
            <p class="text-sm sm:text-base text-muted-foreground max-w-3xl">
              Format, crop, and compress your candidate profile photo for LSAT registration on JD.LSAC.org. Meets official Prometric test center check-in and ProctorU remote proctoring biometric identification guidelines.
            </p>
          </div>

          <!-- Quick Switch US Tools Dropdown -->
          <USToolSwitcher currentTool="lsat" />
        </div>
      </section>

      <!-- Background Guidance -->
      <div class="p-4 sm:p-5 rounded-2xl border-2 border-amber-500/30 bg-amber-500/5 shadow-2xs flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="space-y-1">
          <div class="inline-flex items-center gap-1.5 text-xs font-bold text-amber-700 dark:text-amber-400">
            <span>⚖️</span>
            <span>LSAC Rule: High-Quality Portrait with Plain Background</span>
          </div>
          <p class="text-xs text-muted-foreground leading-relaxed">
            LSAC requires your face and shoulders to be clearly delineated from the background so automated facial recognition at testing check-in does not fail. Use the <strong>Make Background Pure White</strong> button in the editor below if you took your photo in a room with shadows or textures.
          </p>
        </div>
        <a
          href="/photo-background-remover/"
          class="shrink-0 inline-flex items-center justify-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-bold bg-white dark:bg-slate-800 border border-amber-500/40 text-amber-700 dark:text-amber-300 hover:bg-amber-500/10 transition shadow-2xs"
        >
          <span>White BG Remover →</span>
        </a>
      </div>

      <!-- Studio Workspace preloaded with us-lsat-photo -->
      <section id="tool-workspace" class="scroll-mt-20">
        <SignatureTool client:load initialPresetId="us-lsat-photo" />
      </section>

      <!-- Official LSAC Specifications Summary Table -->
      <section class="space-y-4">
        <div class="border-b border-border/80 pb-2">
          <h2 class="text-xl font-bold text-foreground flex items-center gap-2">
            <span>📋</span>
            <span>Official LSAC Candidate Photo Requirements</span>
          </h2>
        </div>

        <div class="overflow-x-auto rounded-2xl border border-border shadow-2xs">
          <table class="w-full text-left text-xs sm:text-sm">
            <thead class="bg-muted/60 text-foreground font-semibold border-b border-border">
              <tr>
                <th class="px-4 py-3">Parameter</th>
                <th class="px-4 py-3">Official LSAC Rule</th>
                <th class="px-4 py-3">SignResize Enforcement</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border">
              <tr class="hover:bg-muted/20">
                <td class="px-4 py-3 font-bold text-foreground">Dimensions</td>
                <td class="px-4 py-3 font-mono">1:1 Square (600 × 600 px @ 300 DPI)</td>
                <td class="px-4 py-3 text-emerald-600 dark:text-emerald-400 font-semibold">Pre-set at 600×600 px square canvas</td>
              </tr>
              <tr class="hover:bg-muted/20">
                <td class="px-4 py-3 font-bold text-foreground">File Size Cap</td>
                <td class="px-4 py-3 font-mono">Maximum 5.0 MB</td>
                <td class="px-4 py-3 text-emerald-600 dark:text-emerald-400 font-semibold">Strictly compressed under 5 MB limit</td>
              </tr>
              <tr class="hover:bg-muted/20">
                <td class="px-4 py-3 font-bold text-foreground">Framing</td>
                <td class="px-4 py-3 font-mono">Head and shoulders centered, eyes open</td>
                <td class="px-4 py-3 text-emerald-600 dark:text-emerald-400 font-semibold">Biometric face guide overlay for precise centering</td>
              </tr>
              <tr class="hover:bg-muted/20">
                <td class="px-4 py-3 font-bold text-foreground">Recency</td>
                <td class="px-4 py-3 font-mono">Taken within the last 6 months</td>
                <td class="px-4 py-3 text-emerald-600 dark:text-emerald-400 font-semibold">Matches current appearance for proctor check</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Frequently Asked Questions -->
      <FaqSection items={lsatFaqs} title="LSAC / LSAT Candidate Photo FAQ" />
    </main>

    <Footer />
  </body>
</html>
