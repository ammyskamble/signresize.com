---
// src/pages/us/passport-photo-resizer.astro
import '../../styles/global.css';
import Header from '../../components/Header.astro';
import { SignatureTool } from '../../components/SignatureTool';
import FaqSection from '../../components/FaqSection.astro';
import Footer from '../../components/Footer.astro';
import GoogleAnalytics from '../../components/GoogleAnalytics.astro';
import GoogleFonts from '../../components/GoogleFonts.astro';
import ThemeScript from '../../components/ThemeScript.astro';

const pageTitle = "US Passport Photo Resizer 2x2 Inches (600x600 Pixels & Under 240KB) - SignResize";
const pageDescription = "Free online US Passport Photo Resizer. Crop and convert photos to 2x2 inches, 600x600 pixels, under 240 KB in JPEG format with a white background for US passport renewals & first-time applications.";
const canonicalUrl = "https://signresize.in/us/passport-photo-resizer/";
const ogImageUrl = "https://signresize.in/og-image.png";
const keywordsContent = "us passport photo resizer online, convert photo to us passport size 2x2, resize photo to 600x600 pixels free, us passport photo 240kb, 2x2 inch photo maker online, travel state gov passport photo crop";

const passportFaqs = [
  {
    q: "What size is a US passport photo in inches and pixels?",
    a: "In physical dimensions, a US passport photo is 2 x 2 inches (51 x 51 mm). In digital pixels, it must be square (1:1 aspect ratio), with a minimum resolution of 600 x 600 pixels up to 1200 x 1200 pixels."
  },
  {
    q: "What is the maximum file size for a digital US passport photo?",
    a: "The digital image file size must be less than or equal to 240 KB in JPEG (.jpg) format."
  },
  {
    q: "What background color is required for US passport photos?",
    a: "The background must be plain white or off-white. There should be no shadows, patterns, or dark textures behind the head."
  },
  {
    q: "How to take a compliant US passport photo at home?",
    a: "Stand 4-6 feet in front of a white wall in natural daytime lighting. Face directly toward the camera with a neutral expression. Upload the photo to SignResize to automatically crop to 600x600 pixels and compress under 240 KB."
  }
];
---

<!doctype html>
<html lang="en-US" class="scroll-smooth">
  <head>
    <ThemeScript />
    <GoogleAnalytics />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={keywordsContent} />
    <meta name="author" content="SignResize.in" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph (OG) Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="SignResize" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Web Fonts & Favicons -->
    <GoogleFonts />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <meta name="theme-color" content="#4f46e5" />

    <!-- Schema.org SoftwareApplication & HowTo JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": ["SoftwareApplication", "WebApplication"],
      "name": "US Passport Photo Resizer 2x2 Online",
      "url": canonicalUrl,
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "All",
      "description": pageDescription,
      "featureList": [
        "Resize photo to 2x2 inches (600x600 pixels)",
        "Compress image under 240 KB in JPEG format",
        "Enforce official State Department 50-69% head height ratio",
        "100% private browser-side Canvas rendering"
      ]
    })} />
  </head>

  <body class="min-h-screen bg-background text-foreground flex flex-col font-sans antialiased selection:bg-primary/20 selection:text-primary">
    <Header />

    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-8">
      <!-- Breadcrumb Navigation -->
      <nav class="flex items-center gap-2 text-xs text-muted-foreground">
        <a href="/" class="hover:text-primary transition">Home</a>
        <span>/</span>
        <a href="/us/" class="hover:text-primary transition">US Hub</a>
        <span>/</span>
        <span class="text-foreground font-semibold">US Passport Photo Resizer</span>
      </nav>

      <!-- Page Hero Header -->
      <section class="space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div class="space-y-1.5">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/20">
              <span>🛂 State Department Passport Services Specs</span>
            </div>
            <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-foreground">
              US Passport Photo Resizer <span class="text-primary">(2×2 Inches | 600×600 px)</span>
            </h1>
            <p class="text-sm sm:text-base text-muted-foreground max-w-3xl">
              Convert any picture into an official US Passport photo online. Formats your image to 2×2 inches (600×600 pixels), JPEG, and under 240 KB for online passport renewals and official mail applications.
            </p>
          </div>

          <!-- Quick Switch US Tools Dropdown -->
          <div class="relative group shrink-0">
            <button
              type="button"
              class="inline-flex items-center justify-between gap-2 px-3.5 py-2 rounded-xl bg-card border border-border hover:border-primary/50 text-foreground text-xs font-bold shadow-2xs transition cursor-pointer"
            >
              <span>🇺🇸 Switch US Tool</span>
              <svg class="w-4 h-4 text-muted-foreground transition-transform group-hover:rotate-180" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </button>
            <div class="invisible group-hover:visible opacity-0 group-hover:opacity-100 transition-all duration-150 absolute right-0 top-full mt-1 w-64 bg-white dark:bg-slate-900 rounded-2xl shadow-xl border border-border p-2 z-50 space-y-1">
              <a href="/us/ds-160-photo-resizer/" class="flex items-center gap-2 p-2 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 text-xs font-medium text-foreground">
                <span>📄 Form DS-160 Visa</span>
              </a>
              <a href="/us/passport-photo-resizer/" class="flex items-center gap-2 p-2 rounded-xl bg-primary/10 text-primary text-xs font-bold">
                <span>🛂 US Passport 2×2</span>
              </a>
              <a href="/us/green-card-photo-resizer/" class="flex items-center gap-2 p-2 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 text-xs font-medium text-foreground">
                <span>🗽 USCIS Green Card</span>
              </a>
              <a href="/us/common-app-photo-resizer/" class="flex items-center gap-2 p-2 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 text-xs font-medium text-foreground">
                <span>🎓 Common App Upload</span>
              </a>
              <a href="/us/" class="flex items-center justify-between p-2 rounded-xl bg-slate-100 dark:bg-slate-800 text-xs font-bold text-primary mt-1">
                <span>Explore All US Hub</span>
                <span>→</span>
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- Resizer Studio Tool Workspace initialized with US Passport Preset -->
      <section id="tool-workspace" class="scroll-mt-20">
        <SignatureTool client:load initialPresetId="us-passport" />
      </section>

      <!-- Technical Guidelines & Interlinking Section -->
      <section class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="md:col-span-2 space-y-4 bg-card border border-border p-6 rounded-2xl">
          <h2 class="text-xl font-bold text-foreground">
            Official US Passport Photo Standard Specs
          </h2>
          <ul class="space-y-2.5 text-xs sm:text-sm text-muted-foreground">
            <li class="flex items-start gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span><strong>Physical / Digital Dimensions:</strong> 2 × 2 inches (51 × 51 mm) or 600 × 600 pixels.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span><strong>File Weight:</strong> Maximum 240 KB in JPEG format.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span><strong>Recency:</strong> Taken within the last 6 months to reflect current appearance.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span><strong>Attire &amp; Eyeglasses:</strong> Everyday clothing. Eyeglasses and headwear (except religious) are not allowed.</span>
            </li>
          </ul>
        </div>

        <!-- Cross Interlinking Box -->
        <div class="space-y-4 bg-primary/5 border border-primary/20 p-6 rounded-2xl">
          <h3 class="text-base font-bold text-foreground">Related US Tools</h3>
          <div class="space-y-2 text-xs">
            <a href="/us/ds-160-photo-resizer/" class="block p-2.5 rounded-xl bg-card border border-border hover:border-primary transition font-medium text-foreground">
              📄 Form DS-160 US Visa Photo Resizer →
            </a>
            <a href="/us/green-card-photo-resizer/" class="block p-2.5 rounded-xl bg-card border border-border hover:border-primary transition font-medium text-foreground">
              🗽 USCIS Green Card &amp; DV Lottery Tool →
            </a>
            <a href="/us/common-app-photo-resizer/" class="block p-2.5 rounded-xl bg-card border border-border hover:border-primary transition font-medium text-foreground">
              🎓 Common App Student Photo Resizer →
            </a>
            <a href="/us/" class="block p-2.5 rounded-xl bg-primary text-primary-foreground text-center font-bold hover:opacity-90 transition mt-2">
              Back to US Tools Hub →
            </a>
          </div>
        </div>
      </section>

      <!-- FAQ Section -->
      <section class="space-y-6">
        <FaqSection faqs={passportFaqs} title="US Passport Photo Resizer FAQs" />
      </section>
    </main>

    <Footer />
  </body>
</html>
