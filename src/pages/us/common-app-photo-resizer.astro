---
// src/pages/us/common-app-photo-resizer.astro
import '../../styles/global.css';
import Header from '../../components/Header.astro';
import { SignatureTool } from '../../components/SignatureTool';
import FaqSection from '../../components/FaqSection.astro';
import Footer from '../../components/Footer.astro';
import GoogleAnalytics from '../../components/GoogleAnalytics.astro';
import GoogleFonts from '../../components/GoogleFonts.astro';
import ThemeScript from '../../components/ThemeScript.astro';

const pageTitle = "Common App Photo & Document Resizer (College Uploads) - SignResize";
const pageDescription = "Free Common App student photo and document scan resizer. Crop student profile headshots, passport scans, and application documents to <200 KB or custom size limits for US university admissions.";
const canonicalUrl = "https://signresize.in/us/common-app-photo-resizer/";
const ogImageUrl = "https://signresize.in/og-image.png";
const keywordsContent = "common app photo resizer, college application headshot size, common app document upload limit, resize photo for college application, common app passport scan upload, compress image for common app";

const commonAppFaqs = [
  {
    q: "Does the Common App require a specific photo format?",
    a: "The central Common Application portal does not enforce a universal headshot requirement for general registration. However, individual colleges, international student visa verification tabs, and portfolio supplements require headshot photos or passport scans in JPEG format, usually under 200 KB or 500 KB."
  },
  {
    q: "How do I fix file upload size errors on college application portals?",
    a: "If your document scan or student photo exceeds the university portal's file size limit (e.g. 200 KB), use SignResize to adjust resolution and compression quality while retaining text readability."
  },
  {
    q: "What is the recommended resolution for college ID and passport uploads?",
    a: "For passport identification scans, a resolution of 300 DPI in JPG or PDF format is recommended to ensure all legal text, passport numbers, and biographical fields are legible."
  }
];
---

<!doctype html>
<html lang="en-US" class="scroll-smooth">
  <head>
    <ThemeScript />
    <GoogleAnalytics />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={keywordsContent} />
    <meta name="author" content="SignResize.in" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph (OG) Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="SignResize" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Web Fonts & Favicons -->
    <GoogleFonts />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <meta name="theme-color" content="#4f46e5" />

    <!-- Schema.org SoftwareApplication & HowTo JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": ["SoftwareApplication", "WebApplication"],
      "name": "Common App Photo & Document Upload Resizer",
      "url": canonicalUrl,
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "All",
      "description": pageDescription,
      "featureList": [
        "Resize student headshots for college portals",
        "Compress document scans under 200 KB / 500 KB",
        "Export in compliant JPEG format",
        "100% private browser Canvas processing"
      ]
    })} />
  </head>

  <body class="min-h-screen bg-background text-foreground flex flex-col font-sans antialiased selection:bg-primary/20 selection:text-primary">
    <Header />

    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-8">
      <!-- Breadcrumb Navigation -->
      <nav class="flex items-center gap-2 text-xs text-muted-foreground">
        <a href="/" class="hover:text-primary transition">Home</a>
        <span>/</span>
        <a href="/us/" class="hover:text-primary transition">US Hub</a>
        <span>/</span>
        <span class="text-foreground font-semibold">Common App Photo Resizer</span>
      </nav>

      <!-- Page Hero Header -->
      <section class="space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div class="space-y-1.5">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20">
              <span>🎓 US University Admissions &amp; College Uploads</span>
            </div>
            <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-foreground">
              Common App Photo &amp; Document Resizer <span class="text-primary">(&lt;200 KB Uploads)</span>
            </h1>
            <p class="text-sm sm:text-base text-muted-foreground max-w-3xl">
              Format your student headshots, passport scans, and application documents for US university admissions via Common App. Crop image dimensions and compress file sizes instantly.
            </p>
          </div>

          <!-- Quick Switch US Tools Dropdown -->
          <div class="relative group shrink-0">
            <button
              type="button"
              class="inline-flex items-center justify-between gap-2 px-3.5 py-2 rounded-xl bg-card border border-border hover:border-primary/50 text-foreground text-xs font-bold shadow-2xs transition cursor-pointer"
            >
              <span>🇺🇸 Switch US Tool</span>
              <svg class="w-4 h-4 text-muted-foreground transition-transform group-hover:rotate-180" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </button>
            <div class="invisible group-hover:visible opacity-0 group-hover:opacity-100 transition-all duration-150 absolute right-0 top-full mt-1 w-64 bg-white dark:bg-slate-900 rounded-2xl shadow-xl border border-border p-2 z-50 space-y-1">
              <a href="/us/ds-160-photo-resizer/" class="flex items-center gap-2 p-2 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 text-xs font-medium text-foreground">
                <span>📄 Form DS-160 Visa</span>
              </a>
              <a href="/us/passport-photo-resizer/" class="flex items-center gap-2 p-2 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 text-xs font-medium text-foreground">
                <span>🛂 US Passport 2×2</span>
              </a>
              <a href="/us/green-card-photo-resizer/" class="flex items-center gap-2 p-2 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 text-xs font-medium text-foreground">
                <span>🗽 USCIS Green Card</span>
              </a>
              <a href="/us/common-app-photo-resizer/" class="flex items-center gap-2 p-2 rounded-xl bg-primary/10 text-primary text-xs font-bold">
                <span>🎓 Common App Upload</span>
              </a>
              <a href="/us/" class="flex items-center justify-between p-2 rounded-xl bg-slate-100 dark:bg-slate-800 text-xs font-bold text-primary mt-1">
                <span>Explore All US Hub</span>
                <span>→</span>
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- Resizer Studio Tool Workspace initialized with Common App Preset -->
      <section id="tool-workspace" class="scroll-mt-20">
        <SignatureTool client:load initialPresetId="us-commonapp" />
      </section>

      <!-- Guidelines & Cross Interlinking -->
      <section class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="md:col-span-2 space-y-4 bg-card border border-border p-6 rounded-2xl">
          <h2 class="text-xl font-bold text-foreground">
            College Upload Optimization Tips
          </h2>
          <ul class="space-y-2.5 text-xs sm:text-sm text-muted-foreground">
            <li class="flex items-start gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span><strong>Headshots:</strong> 600 × 600 pixels, high resolution, plain lighting.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span><strong>Passport Scans:</strong> Legible legal page scan under 200 KB – 500 KB limit.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span><strong>Format:</strong> JPEG / JPG image format.</span>
            </li>
          </ul>
        </div>

        <!-- Cross Interlinking Box -->
        <div class="space-y-4 bg-primary/5 border border-primary/20 p-6 rounded-2xl">
          <h3 class="text-base font-bold text-foreground">Related US Tools</h3>
          <div class="space-y-2 text-xs">
            <a href="/us/ds-160-photo-resizer/" class="block p-2.5 rounded-xl bg-card border border-border hover:border-primary transition font-medium text-foreground">
              📄 Form DS-160 US Visa Photo Resizer →
            </a>
            <a href="/us/passport-photo-resizer/" class="block p-2.5 rounded-xl bg-card border border-border hover:border-primary transition font-medium text-foreground">
              🛂 US Passport Photo Resizer (2×2 Inch) →
            </a>
            <a href="/us/green-card-photo-resizer/" class="block p-2.5 rounded-xl bg-card border border-border hover:border-primary transition font-medium text-foreground">
              🗽 USCIS Green Card &amp; DV Lottery Tool →
            </a>
            <a href="/us/" class="block p-2.5 rounded-xl bg-primary text-primary-foreground text-center font-bold hover:opacity-90 transition mt-2">
              Back to US Tools Hub →
            </a>
          </div>
        </div>
      </section>

      <!-- FAQ Section -->
      <section class="space-y-6">
        <FaqSection faqs={commonAppFaqs} title="Common App Photo Upload FAQs" />
      </section>
    </main>

    <Footer />
  </body>
</html>
