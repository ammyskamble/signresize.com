// src/pages/us/index.astro
import '../../styles/global.css';
import Header from '../../components/Header.astro';
import { SignatureTool } from '../../components/SignatureTool';
import ExamSpecsTable from '../../components/ExamSpecsTable.astro';
import FaqSection from '../../components/FaqSection.astro';
import CountryBlogSection from '../../components/CountryBlogSection.astro';
import Footer from '../../components/Footer.astro';
import GoogleAnalytics from '../../components/GoogleAnalytics.astro';
import GoogleFonts from '../../components/GoogleFonts.astro';
import ThemeScript from '../../components/ThemeScript.astro';
import USToolSwitcher from '../../components/USToolSwitcher.astro';

const pageTitle = "US Visa & Passport Photo Resizer (DS-160, Passport, USCIS, Common App) - SignResize";
const pageDescription = "Free online US Photo Resizer & Crop Tool. Resize images to 600x600 pixels, 2x2 inches, under 240 KB, JPEG format for Form DS-160 US Visa, Passport Renewal, USCIS Green Card (DV Lottery), and Common App.";
const canonicalUrl = "https://signresize.in/us/";
const ogImageUrl = "https://signresize.in/og-image.png";
const keywordsContent = "us visa photo resizer, ds 160 photo resizer 600x600, us passport photo size 2x2, uscis green card photo resizer, dv lottery photo tool, common app photo size, us visa photo 240kb, crop photo for us passport online free";

const usFaqs = [
  {
    q: "What are the exact digital photo specifications for US Form DS-160 Visa applications?",
    a: "Your digital photo for Form DS-160 must be a square aspect ratio (1:1), minimum 600x600 pixels up to 1200x1200 pixels, in JPEG format, with a file size of 240 KB or less. The head height must occupy between 50% and 69% of the total image height against a plain white or off-white background."
  },
  {
    q: "What is the standard US Passport photo size in pixels and inches?",
    a: "A standard physical US passport photo is 2x2 inches (51x51 mm). When uploading digitally, the image must be 600x600 pixels (minimum) to 1200x1200 pixels (maximum), JPEG format, under 240 KB, taken within the last 6 months without eyeglasses."
  },
  {
    q: "Are self-submitted photos allowed for USCIS Green Card applications?",
    a: "USCIS captures biometrics in person for most adjustment of status filings (e.g. Form I-485), but digital uploads are required for online filings, EAD card renewals, consular processing, and the annual Diversity Visa (DV) Lottery. Digital submissions must strictly measure 600x600 pixels in sRGB 24-bit color space."
  },
  {
    q: "Does the Common App require a specific photo or headshot size?",
    a: "The Common App platform does not require a universal headshot for general profile creation. However, specific universities, international student visa verification portals, and audition supplements request passport-style photos or headshots, typically capped under 200 KB or 500 KB."
  },
  {
    q: "Are my photos or personal documents saved on any server?",
    a: "No. SignResize processes 100% of image rendering locally inside your web browser using HTML5 Canvas APIs. No images, personal data, or facial captures are ever transmitted or stored on external servers."
  }
];
