    <!-- Client-Side Scripts for Interactive States -->
    <script>
      // 1. Referral Modal Controls
      const modal = document.getElementById('referral-modal');
      const openModalBtn = document.getElementById('open-referral-modal-btn');
      const heroRefBtn = document.getElementById('hero-referral-btn');
      const launchModalBtn = document.getElementById('launch-modal-btn');
      const closeModalBtn = document.getElementById('close-referral-modal-btn');
      const modalRefInput = document.getElementById('modal-ref-input') as HTMLInputElement | null;
      const modalCopyBtn = document.getElementById('modal-copy-btn');
      const copyToast = document.getElementById('copy-toast');
      const previewCopyBtn = document.getElementById('preview-copy-btn');

      function openModal() {
        modal?.classList.remove('hidden');
      }

      function closeModal() {
        modal?.classList.add('hidden');
      }

      openModalBtn?.addEventListener('click', openModal);
      heroRefBtn?.addEventListener('click', openModal);
      launchModalBtn?.addEventListener('click', openModal);
      closeModalBtn?.addEventListener('click', closeModal);

      modal?.addEventListener('click', (e) => {
        if (e.target === modal) {
          closeModal();
        }
      });

      // ESC key to close modal or drawer
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          closeModal();
          closeSpecDrawer();
        }
      });

      // Copy Link Functionality
      async function copyText(text: string, triggerBtn?: HTMLElement | null) {
        try {
          await navigator.clipboard.writeText(text);
          if (copyToast) {
            copyToast.classList.remove('hidden');
            setTimeout(() => {
              copyToast.classList.add('hidden');
            }, 3000);
          }
          if (triggerBtn) {
            const originalText = triggerBtn.textContent;
            triggerBtn.textContent = 'Copied!';
            setTimeout(() => {
              triggerBtn.textContent = originalText;
            }, 2000);
          }
        } catch (err) {
          console.error('Failed to copy', err);
        }
      }

      modalCopyBtn?.addEventListener('click', () => {
        if (modalRefInput) {
          copyText(modalRefInput.value, modalCopyBtn);
        }
      });

      previewCopyBtn?.addEventListener('click', () => {
        copyText('https://bybitglobal.com/invite?ref=MNT2026', previewCopyBtn);
      });

      // 2. Spec Drawer Controls
      const specDrawer = document.getElementById('spec-drawer');
      const specBackdrop = document.getElementById('spec-drawer-backdrop');
      const toggleSpecBtn = document.getElementById('toggle-spec-drawer');
      const closeSpecBtn = document.getElementById('close-spec-drawer');

      function openSpecDrawer() {
        specBackdrop?.classList.remove('hidden');
        specDrawer?.classList.remove('translate-x-full');
      }

      function closeSpecDrawer() {
        specBackdrop?.classList.add('hidden');
        specDrawer?.classList.add('translate-x-full');
      }

      toggleSpecBtn?.addEventListener('click', () => {
        if (specDrawer?.classList.contains('translate-x-full')) {
          openSpecDrawer();
        } else {
          closeSpecDrawer();
        }
      });

      closeSpecBtn?.addEventListener('click', closeSpecDrawer);
      specBackdrop?.addEventListener('click', closeSpecDrawer);
    </script>
  </body>
