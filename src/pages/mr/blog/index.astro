---
// src/pages/mr/blog/index.astro
import '../../../styles/global.css';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import GoogleAnalytics from '../../../components/GoogleAnalytics.astro';
import GoogleFonts from '../../../components/GoogleFonts.astro';
import ThemeScript from '../../../components/ThemeScript.astro';
import { BLOG_POSTS, getBlogPostTitle, getBlogPostExcerpt } from '../../../data/blogPostsData';
import { EXAM_PAGES_DATA } from '../../../data/examPagesData';
import SocialShare from '../../../components/SocialShare.astro';

const pageTitle = "परीक्षा मार्गदर्शक, अभ्यास तयारी आणि फोटो सही रिसाइझ नियम | SignResize मराठी ब्लॉग";
const pageDescription = "महाराष्ट्र पोलीस भरती, MPSC, SSC, RRB आणि बैंक परीक्षांसाठी फोटो-स्वाक्षरी रिसाइझ नियम, 1600m रनिंग टाइम चार्ट आणि अभ्यास मार्गदर्शन मराठीत वाचा।";
const canonicalUrl = "https://signresize.in/mr/blog/";

function parseBlogDate(dateStr: string): number {
  if (!dateStr) return 0;
  const normalized = dateStr.replace(/Sept\b/i, 'Sep');
  const timestamp = new Date(normalized).getTime();
  return isNaN(timestamp) ? 0 : timestamp;
}

const sortedPosts = [...BLOG_POSTS].sort((a, b) => {
  const timeA = parseBlogDate(a.publishDate);
  const timeB = parseBlogDate(b.publishDate);
  return timeB - timeA;
});

const featuredPost = sortedPosts.find(p => p.slug === 'maharashtra-police-bharti-2026-top-10-faq-guide') || sortedPosts[0];
const featuredExamPage = featuredPost.relatedExamPreset
  ? EXAM_PAGES_DATA.find(p => p.presetId === featuredPost.relatedExamPreset || p.slug === featuredPost.relatedExamPreset)
  : null;
const featuredToolUrl = featuredExamPage ? `/${featuredExamPage.slug}/` : '/#tool-workspace';

const regularPosts = sortedPosts.filter(p => p.slug !== featuredPost.slug);

const categories = ['सर्व', 'परीक्षा अपडेट्स', 'अभ्यास तयारी', 'मार्गदर्शक सूचना', 'करिअर संधी'];
---

<!doctype html>
<html lang="mr" class="scroll-smooth">
  <head>
    <ThemeScript />
    <GoogleAnalytics />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="SignResize" />
    <link rel="manifest" href="/site.webmanifest" />
    <GoogleFonts />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="SignResize" />
  </head>

  <body class="min-h-screen flex flex-col bg-background text-foreground antialiased selection:bg-primary/20 selection:text-primary">
    <Header />

    <main class="flex-1 max-w-6xl mx-auto px-3 sm:px-6 lg:px-8 py-4 sm:py-8 space-y-6 sm:space-y-8 w-full min-w-0 overflow-x-hidden">
      
      <!-- Breadcrumbs & Language Bar -->
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-border/60 pb-3">
        <nav class="flex flex-wrap items-center gap-1.5 text-xs text-muted-foreground" aria-label="Breadcrumb">
          <a href="/mr/" class="hover:text-primary transition flex items-center gap-1">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
            मुख्यपृष्ठ (Home)
          </a>
          <span>/</span>
          <span class="text-foreground font-medium">मराठी ब्लॉग (Marathi Blog)</span>
        </nav>

        <!-- Language Switcher Bar -->
        <div class="flex items-center gap-1.5 text-xs bg-muted/60 p-1 rounded-xl border border-border/60">
          <span class="text-[10px] font-bold uppercase tracking-wider text-muted-foreground px-2">भाषा (Language):</span>
          <a href="/blog/" class="px-2.5 py-1 rounded-lg hover:bg-card text-muted-foreground hover:text-foreground font-medium transition">🇬🇧 English</a>
          <a href="/hi/blog/" class="px-2.5 py-1 rounded-lg hover:bg-card text-muted-foreground hover:text-foreground font-medium transition">🇮🇳 हिंदी</a>
          <a href="/mr/blog/" class="px-2.5 py-1 rounded-lg bg-primary text-primary-foreground font-bold shadow-2xs">🚩 मराठी</a>
        </div>
      </div>

      <!-- Hero Header Banner -->
      <section class="relative overflow-hidden rounded-2xl border border-primary/20 bg-gradient-to-r from-card via-card/90 to-primary/5 p-4 sm:p-6 shadow-xs backdrop-blur">
        <div class="relative flex flex-col lg:flex-row lg:items-center justify-between gap-5">
          <div class="space-y-2 max-w-2xl">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-primary/10 text-primary border border-primary/20">
              <span>🚩</span>
              <span>SignResize अधिकृत मराठी ब्लॉग</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-foreground">
              महाराष्ट्र पोलीस भरती, MPSC व स्पर्धा परीक्षा मार्गदर्शक
            </h1>
            <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed">
              पोलीस भरती मैदानी चाचणी गुण (1600m रनिंग), गोळा फेकीचे गुण, OMR लेखी परीक्षा अभ्यासक्रम आणि फोटो-सही 5 ते 20 KB रिसाइझ मार्गदर्शन संपूर्ण मराठीत.
            </p>
          </div>
        </div>
      </section>

      <!-- Featured Article Banner -->
      {featuredPost && (
        <section class="group relative overflow-hidden rounded-2xl border-2 border-primary/30 bg-card p-5 sm:p-7 shadow-md hover:border-primary transition duration-200">
          <div class="flex flex-col lg:flex-row items-start justify-between gap-6">
            <div class="space-y-3 max-w-3xl">
              <div class="flex flex-wrap items-center gap-2">
                <span class="px-2.5 py-0.5 rounded-md text-[11px] font-extrabold uppercase tracking-wider bg-amber-500/15 text-amber-600 dark:text-amber-400 border border-amber-500/20">
                  🔥 विशेष लेख (Featured)
                </span>
                <span class="text-xs font-semibold text-muted-foreground">• {featuredPost.publishDate}</span>
                <span class="text-xs font-semibold text-muted-foreground">• {featuredPost.readTime_mr || featuredPost.readTime}</span>
              </div>
              <h2 class="text-xl sm:text-2xl font-black text-foreground group-hover:text-primary transition">
                <a href={`/mr/blog/${featuredPost.slug}/`}>
                  {getBlogPostTitle(featuredPost, 'mr')}
                </a>
              </h2>
              <p class="text-xs sm:text-sm text-muted-foreground line-clamp-2 leading-relaxed">
                {getBlogPostExcerpt(featuredPost, 'mr')}
              </p>
              <div class="pt-2 flex flex-wrap items-center gap-3">
                <a href={`/mr/blog/${featuredPost.slug}/`} class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-primary text-primary-foreground font-bold text-xs hover:opacity-90 transition">
                  <span>पूर्ण लेख वाचा</span>
                  <span>&rarr;</span>
                </a>
              </div>
            </div>
          </div>
        </section>
      )}

      <!-- Grid of Regular Articles -->
      <section class="space-y-4">
        <h3 class="text-lg font-bold text-foreground">नवीनतम स्पर्धा परीक्षा लेख (Latest Articles)</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
          {regularPosts.map(post => (
            <article class="flex flex-col justify-between p-4 sm:p-5 rounded-2xl bg-card border border-border hover:border-primary/50 shadow-xs hover:shadow-md transition duration-200 group">
              <div class="space-y-2.5">
                <div class="flex items-center justify-between text-[11px] text-muted-foreground">
                  <span class="px-2 py-0.5 rounded bg-primary/10 text-primary font-bold">{post.category}</span>
                  <span>{post.readTime_mr || post.readTime}</span>
                </div>
                <h4 class="font-bold text-sm sm:text-base text-foreground group-hover:text-primary transition line-clamp-2 leading-snug">
                  <a href={`/mr/blog/${post.slug}/`}>
                    {getBlogPostTitle(post, 'mr')}
                  </a>
                </h4>
                <p class="text-xs text-muted-foreground line-clamp-3 leading-relaxed">
                  {getBlogPostExcerpt(post, 'mr')}
                </p>
              </div>
              <div class="pt-4 border-t border-border/40 mt-4 flex items-center justify-between text-xs">
                <span class="text-muted-foreground font-mono">{post.publishDate}</span>
                <a href={`/mr/blog/${post.slug}/`} class="font-bold text-primary hover:underline flex items-center gap-1">
                  <span>वाचा</span>
                  <span>&rarr;</span>
                </a>
              </div>
            </article>
          ))}
        </div>
      </section>

    </main>

    <Footer />
  </body>
</html>
