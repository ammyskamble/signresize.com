---
// src/pages/index.astro
import '../styles/global.css';
import Header from '../components/Header.astro';
import { SignatureTool } from '../components/SignatureTool';
import ExamSpecsTable from '../components/ExamSpecsTable.astro';
import GuideSection from '../components/GuideSection.astro';
import SeoContentSection from '../components/SeoContentSection.astro';
import FaqSection from '../components/FaqSection.astro';
import Footer from '../components/Footer.astro';

const pageTitle = "Signature Resize | Resize Signature to 10 to 20 KB Online (Sign Resize & Compressor)";
const pageDescription = "Free online signature resize & compressor tool. Resize signature to 10 to 20 kb, adjust width and height in cm, crop thumb impression for SSC, PAN card, RRB & NSDL. 100% private, no server upload.";
const canonicalUrl = "https://signresize.com/";
const ogImageUrl = "https://signresize.com/og-image.png";
const keywordsContent = "signature resize, signature resize 10 to 20 kb, signature resize width and height in cm, ssc signature resize, pan card signature resize, rrb signature resize, pan card photo and signature resize, resize signature, sign resize, thumb impression, pi7, pdf pi7 org, pi7 image, pi7 image tool, signature resizer, nsdl pan card signature resize, signature size should be at least 20kb, signature compressor";
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={keywordsContent} />
    <meta name="author" content="SignResize.com" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Hreflang Tags for English (India) & Global -->
    <link rel="alternate" hreflang="en-IN" href="https://signresize.com/" />
    <link rel="alternate" hreflang="en" href="https://signresize.com/" />
    <link rel="alternate" hreflang="x-default" href="https://signresize.com/" />

    <!-- Open Graph (OG) Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="SignResize" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="SignResize - Online Signature Resize and Compressor Tool" />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content="SignResize - Online Signature Resize and Compressor Tool" />

    <!-- Google Fonts: Inter & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Favicon & Vector Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- WebApplication Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "SignResize",
      "url": "https://signresize.com/",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "All (Android, iOS, Windows, macOS, Linux)",
      "browserRequirements": "Requires JavaScript. Requires HTML5 Canvas support.",
      "description": "Free online signature resize, crop, and compressor tool. Resize signature to 10 to 20 KB, customize width and height in cm, and compress thumb impressions for SSC, PAN Card, RRB, and NSDL.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "INR"
      },
      "featureList": [
        "Signature resize 10 to 20 kb precision compression",
        "Signature resize width and height in cm & pixels",
        "SSC signature resize & RRB signature resizer preset",
        "PAN card photo and signature resize (NSDL / UTIITSL 200 DPI)",
        "Thumb impression resizer with square aspect ratio",
        "Dual-boundary control when signature size should be at least 20kb",
        "Clean White Paper background shadow remover",
        "100% client-side privacy with zero server uploads"
      ]
    })} />

    <!-- HowTo Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "HowTo",
      "name": "How to Resize Signature to 10 to 20 KB Online",
      "description": "Step-by-step guide to crop, resize, and compress your signature to exact 10 KB to 20 KB file bounds for SSC, RRB, and government portal uploads.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Sign on Clean White Paper",
          "text": "Sign using a black ballpoint pen on plain, unruled white paper in your natural running handwriting.",
          "position": 1
        },
        {
          "@type": "HowToStep",
          "name": "Upload Image to SignResize",
          "text": "Upload the photograph or scan to the SignResize online workspace.",
          "position": 2
        },
        {
          "@type": "HowToStep",
          "name": "Select Exam Preset or Target KB",
          "text": "Select your exam preset (e.g., SSC 140x60 px) or adjust the target file size slider between 10 KB and 20 KB.",
          "position": 3
        },
        {
          "@type": "HowToStep",
          "name": "Clean White Paper & Download",
          "text": "Enable the Clean White Paper filter to remove shadows, preview the output file size, and download your portal-ready JPG.",
          "position": 4
        }
      ]
    })} />

    <!-- BreadcrumbList Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://signresize.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Signature Resize Tool",
          "item": "https://signresize.com/#tool-workspace"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Exam Guidelines",
          "item": "https://signresize.com/#exam-specs"
        }
      ]
    })} />
  </head>

  <body class="bg-background text-foreground selection:bg-primary/20 selection:text-primary min-h-screen flex flex-col antialiased">
    <!-- Navigation Header -->
    <Header />

    <!-- Main Container (Command Center & Assistant Architecture) -->
    <main class="flex-1 w-full max-w-[1480px] mx-auto px-3 sm:px-6 lg:px-8 py-6 space-y-8">
      
      <!-- Hero / Command Header Banner -->
      <section class="rounded-2xl border border-primary/20 bg-gradient-to-r from-card via-card/90 to-primary/5 p-4 sm:p-6 shadow-sm backdrop-blur">
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
          <div class="space-y-1.5">
            <div class="flex items-center gap-2">
              <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-primary/10 text-primary border border-primary/20">
                <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
                Online Signature Resizer &amp; Compressor
              </span>
              <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md text-[11px] font-mono text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 border border-emerald-500/20">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                100% Client-Side Private
              </span>
            </div>
            <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-foreground leading-[1.15]">
              Online <span class="text-primary">Signature Resize</span> &amp; Compressor (10KB to 20KB)
            </h1>
            <p class="text-xs sm:text-sm text-muted-foreground max-w-3xl leading-relaxed">
              Instantly <strong>resize signature</strong>, adjust <strong>width and height in cm</strong> (<span class="font-mono text-foreground font-medium">140×60 px</span>, <span class="font-mono text-foreground font-medium">4×2 cm</span>), remove phone photo background shadows, and compress <strong>thumb impressions</strong> for <strong>SSC, PAN Card (NSDL), RRB &amp; UPSC</strong>.
            </p>
          </div>

          <!-- Quick System Badges -->
          <div class="flex items-center gap-2 flex-wrap shrink-0">
            <div class="px-3.5 py-2 rounded-xl bg-card border border-border text-center shadow-xs">
              <div class="text-[9px] uppercase font-bold text-muted-foreground">Standard</div>
              <div class="text-xs font-bold text-foreground font-mono">140×60 PX</div>
            </div>
            <div class="px-3.5 py-2 rounded-xl bg-card border border-border text-center shadow-xs">
              <div class="text-[9px] uppercase font-bold text-muted-foreground">Size Target</div>
              <div class="text-xs font-bold text-primary font-mono">10 KB – 20 KB</div>
            </div>
            <div class="px-3.5 py-2 rounded-xl bg-card border border-border text-center shadow-xs">
              <div class="text-[9px] uppercase font-bold text-muted-foreground">Resolution</div>
              <div class="text-xs font-bold text-foreground font-mono">200 DPI</div>
            </div>
          </div>
        </div>
      </section>

      <!-- Dual-Column Command Center: Workspace (Left 8 cols) + Sticky Assistant (Right 4 cols) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        
        <!-- Left Side: Main Interactive Resizer Tool Workspace -->
        <div class="lg:col-span-8 space-y-6">
          <div class="bg-card border border-border rounded-2xl p-4 sm:p-6 shadow-sm">
            <SignatureTool client:load />
          </div>

          <!-- Bottom Accordion Knowledge Base & Specifications -->
          <div class="bg-card border border-border rounded-2xl p-5 shadow-sm space-y-4">
            <div class="flex items-center justify-between border-b border-border pb-3">
              <h3 class="text-base font-bold text-foreground flex items-center gap-2">
                <svg class="w-4 h-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                Official Verification Matrix &amp; Knowledge Base
              </h3>
              <span class="text-xs text-muted-foreground hidden sm:inline">2026 Examination Standards</span>
            </div>

            <!-- Accordion Panels -->
            <div class="space-y-3">
              <details class="group rounded-xl border border-border bg-muted/20 p-4 open:bg-card transition" open>
                <summary class="font-semibold text-xs text-foreground cursor-pointer flex items-center justify-between select-none">
                  <span>📊 1. Official Exam Dimensions &amp; Size Table (SSC, PAN, RRB, UPSC, IBPS)</span>
                  <span class="text-primary group-open:rotate-180 transition-transform">▼</span>
                </summary>
                <div class="pt-4 border-t border-border/50 mt-3">
                  <ExamSpecsTable />
                </div>
              </details>

              <details class="group rounded-xl border border-border bg-muted/20 p-4 open:bg-card transition">
                <summary class="font-semibold text-xs text-foreground cursor-pointer flex items-center justify-between select-none">
                  <span>🛡️ 2. How to Avoid Signature Rejection (Photo vs Ink Guidelines)</span>
                  <span class="text-primary group-open:rotate-180 transition-transform">▼</span>
                </summary>
                <div class="pt-4 border-t border-border/50 mt-3">
                  <GuideSection />
                </div>
              </details>

              <details class="group rounded-xl border border-border bg-muted/20 p-4 open:bg-card transition" open>
                <summary class="font-semibold text-xs text-foreground cursor-pointer flex items-center justify-between select-none">
                  <span>📖 3. Complete Aspirant Guide (CM to Pixel Formulas &amp; DPI)</span>
                  <span class="text-primary group-open:rotate-180 transition-transform">▼</span>
                </summary>
                <div class="pt-4 border-t border-border/50 mt-3">
                  <SeoContentSection />
                </div>
              </details>

              <details class="group rounded-xl border border-border bg-muted/20 p-4 open:bg-card transition">
                <summary class="font-semibold text-xs text-foreground cursor-pointer flex items-center justify-between select-none">
                  <span>❓ 4. Frequently Asked Questions (Dual-Boundary &amp; Format Queries)</span>
                  <span class="text-primary group-open:rotate-180 transition-transform">▼</span>
                </summary>
                <div class="pt-4 border-t border-border/50 mt-3">
                  <FaqSection />
                </div>
              </details>
            </div>
          </div>
        </div>

        <!-- Right Side: Sticky Smart Assistant Sidebar (4 cols) -->
        <aside class="lg:col-span-4 space-y-4 sticky top-16">
          
          <!-- Card 1: Live Portal Compliance Checklist -->
          <div class="bg-card border border-border rounded-2xl p-5 shadow-sm space-y-4">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold uppercase tracking-wider text-muted-foreground flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                Portal Compliance Checklist
              </span>
              <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-primary/10 text-primary font-bold">Auto-Check</span>
            </div>

            <div class="space-y-2.5 text-xs">
              <div class="flex items-start gap-2.5 p-2.5 rounded-xl bg-muted/40 border border-border">
                <div class="w-5 h-5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0 font-bold text-xs">✓</div>
                <div>
                  <div class="font-semibold text-foreground">File Size Bounds (10–20 KB)</div>
                  <div class="text-[11px] text-muted-foreground">Complies with strict SSC, RRB &amp; UPSC upload limiters.</div>
                </div>
              </div>

              <div class="flex items-start gap-2.5 p-2.5 rounded-xl bg-muted/40 border border-border">
                <div class="w-5 h-5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0 font-bold text-xs">✓</div>
                <div>
                  <div class="font-semibold text-foreground">Aspect Ratio &amp; Pixels (140×60)</div>
                  <div class="text-[11px] text-muted-foreground">Standard 7:3 aspect ratio preventing stretch distortion.</div>
                </div>
              </div>

              <div class="flex items-start gap-2.5 p-2.5 rounded-xl bg-muted/40 border border-border">
                <div class="w-5 h-5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0 font-bold text-xs">✓</div>
                <div>
                  <div class="font-semibold text-foreground">Paper Shadow Whiten Filter</div>
                  <div class="text-[11px] text-muted-foreground">Converts yellowish camera photos to clean pure white paper.</div>
                </div>
              </div>

              <div class="flex items-start gap-2.5 p-2.5 rounded-xl bg-muted/40 border border-border">
                <div class="w-5 h-5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0 font-bold text-xs">✓</div>
                <div>
                  <div class="font-semibold text-foreground">100% Client-Side Privacy</div>
                  <div class="text-[11px] text-muted-foreground">Processed in your browser canvas. No server upload.</div>
                </div>
              </div>
            </div>
          </div>

          <!-- Card 2: Interactive CM to Pixel Quick Calculator Widget -->
          <div class="bg-card border border-border rounded-2xl p-5 shadow-sm space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold uppercase tracking-wider text-muted-foreground">
                CM ⇄ Pixel Converter Widget
              </span>
              <span class="text-[10px] font-mono text-muted-foreground">200 DPI Basis</span>
            </div>

            <p class="text-[11px] text-muted-foreground">
              Calculate exact pixel requirements from notification guidelines (e.g. 4.0 cm × 2.0 cm).
            </p>

            <div class="grid grid-cols-2 gap-2 text-xs">
              <div class="space-y-1">
                <label class="text-[10px] text-muted-foreground font-medium">Width (cm):</label>
                <input
                  id="calc-w-cm"
                  type="number"
                  step="0.1"
                  value="4.0"
                  class="w-full px-2.5 py-1.5 rounded-lg border border-border bg-background font-mono text-foreground text-xs"
                />
              </div>
              <div class="space-y-1">
                <label class="text-[10px] text-muted-foreground font-medium">Height (cm):</label>
                <input
                  id="calc-h-cm"
                  type="number"
                  step="0.1"
                  value="2.0"
                  class="w-full px-2.5 py-1.5 rounded-lg border border-border bg-background font-mono text-foreground text-xs"
                />
              </div>
            </div>

            <div class="p-3 rounded-xl bg-primary/10 border border-primary/20 flex items-center justify-between text-xs font-mono">
              <span class="text-muted-foreground font-medium">Calculated Target:</span>
              <span id="calc-result" class="font-bold text-primary text-sm">315 × 157 px</span>
            </div>
          </div>

          <!-- Card 3: Instant Quick Exam Requirement Reference -->
          <div class="bg-card border border-border rounded-2xl p-5 shadow-sm space-y-3 text-xs">
            <div class="font-bold text-foreground flex items-center gap-1.5">
              <svg class="w-4 h-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              Top Portal Quick Rules (2026)
            </div>

            <ul class="space-y-2 text-[11px] text-muted-foreground">
              <li class="flex items-center justify-between pb-1.5 border-b border-border/50">
                <strong class="text-foreground">SSC CGL / CHSL:</strong>
                <span class="font-mono text-primary font-medium">140×60 px (10–20 KB)</span>
              </li>
              <li class="flex items-center justify-between pb-1.5 border-b border-border/50">
                <strong class="text-foreground">PAN Card (NSDL):</strong>
                <span class="font-mono text-primary font-medium">4.5×2 cm (&lt;50 KB)</span>
              </li>
              <li class="flex items-center justify-between pb-1.5 border-b border-border/50">
                <strong class="text-foreground">RRB Railway:</strong>
                <span class="font-mono text-primary font-medium">140×60 px (10–20 KB)</span>
              </li>
              <li class="flex items-center justify-between pb-1.5 border-b border-border/50">
                <strong class="text-foreground">Left Thumb (RRB/SBI):</strong>
                <span class="font-mono text-primary font-medium">3×3 cm (10–20 KB)</span>
              </li>
              <li class="flex items-center justify-between">
                <strong class="text-foreground">UPSC Civil Services:</strong>
                <span class="font-mono text-primary font-medium">350×350 px (20–300 KB)</span>
              </li>
            </ul>
          </div>

        </aside>
      </div>

    </main>

    <!-- Global Footer -->
    <Footer />

    <!-- Script for Live CM to Pixel Calculator -->
    <script is:inline>
      const inputW = document.getElementById('calc-w-cm');
      const inputH = document.getElementById('calc-h-cm');
      const resultBox = document.getElementById('calc-result');

      function calculatePixels() {
        if (!inputW || !inputH || !resultBox) return;
        const wCm = parseFloat(inputW.value) || 0;
        const hCm = parseFloat(inputH.value) || 0;
        const dpi = 200; // Govt standard
        const wPx = Math.round((wCm / 2.54) * dpi);
        const hPx = Math.round((hCm / 2.54) * dpi);
        resultBox.textContent = `${wPx} × ${hPx} px`;
      }

      inputW?.addEventListener('input', calculatePixels);
      inputH?.addEventListener('input', calculatePixels);
    </script>
  </body>
</html>
