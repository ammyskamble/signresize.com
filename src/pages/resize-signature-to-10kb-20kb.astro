---
// src/pages/resize-signature-to-10kb-20kb.astro
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import GoogleFonts from '../components/GoogleFonts.astro';
import ThemeScript from '../components/ThemeScript.astro';
import SignatureCropExamples from '../components/SignatureCropExamples.astro';
import { SignatureTool } from '../components/SignatureTool';

const pageTitle = "Resize Signature to 10–20 KB Online | SignResize";
const pageDescription = "Resize signature to 10–20 KB (or 15–100 KB) JPG. Set custom pixels or 3.5 × 1.5 cm units, crop cleanly, and increase minimum KB limits in your browser.";
const canonicalUrl = "https://signresize.in/resize-signature-to-10kb-20kb/";
const ogImageUrl = "https://signresize.in/og-image.png";
const keywordsContent = "signature resize 10 to 20 kb, resize signature to 10 to 20 kb, resize signature to 20kb, resize signature to 50kb, resize signature to 100kb, resize signature to 3.5 cm x 1.5 cm, signature size should be between 10 kb and 20 kb, signature size should be at least 20kb, signature ka size kaise badhaye, signature compressor 10 to 20 kb";

const faqs = [
  {
    "q": "Does 10–20 KB imply a particular pixel size?",
    "a": "No. File size and pixel dimensions are separate requirements. This tool starts with a 600 × 200 px preparation canvas; change it to match your upload instructions."
  },
  {
    "q": "How do I prepare a signature between 10 and 20 KB?",
    "a": "Upload your handwritten signature, crop without clipping strokes, set the minimum to 10 KB and maximum to 20 KB, then download and inspect the JPG."
  },
  {
    "q": "Will a file in this range be accepted by every exam?",
    "a": "No. Some applications use different ranges or require a different format, crop or ink. Follow the notice for your exact exam and cycle."
  },
  {
    "q": "What if a small file is still blurry?",
    "a": "Start with a clearer scan. Adding bytes or enlarging the image does not recover detail lost in the original."
  },
  {
    "q": "Can I resize a signature to 15 KB, 20 KB, 30 KB, 40 KB, 50 KB, or 100 KB?",
    "a": "Yes. While this page defaults to the common 10–20 KB range, you can type any custom Min KB and Max KB target (for example 10–15 KB, 10–30 KB, 20–40 KB, 20–50 KB, or under 100 KB) inside Target File Bounds before downloading."
  },
  {
    "q": "How do I resize a signature to 3.5 cm × 1.5 cm or another centimeter size?",
    "a": "In the dimension unit selector inside the workspace, switch from px to cm, check the DPI value required by your application (for example 100 or 200 DPI), and enter 3.5 cm width × 1.5 cm height or the exact measurements stated in your recruitment notice."
  },
  {
    "q": "How do I fix 'signature size should be at least 20kb' or increase signature KB size?",
    "a": "Tiny scans often fall below a 20 KB minimum limit (signature ka size kaise badhaye). Set Min KB (Increase Floor) to 20 and Max KB to 30 or 50 in JPG format: SignResize pads clean JPEG comment bytes without stretching or blurring your strokes. If pixels are too small, upload a clearer high-res photo first."
  },
  {
    "q": "What does 'signature size should be between 10 kb and 20 kb' mean (meaning in hindi)?",
    "a": "It means your uploaded signature file must measure at least 10 KB and at most 20 KB on disk. (Hindi meaning: आपके हस्ताक्षर की फाइल साइज 10 KB से कम और 20 KB से ज्यादा नहीं होनी चाहिए।) Set Min KB = 10 and Max KB = 20, export JPG, and confirm the final KB check shows Ready."
  },
  {
    "q": "Are my images uploaded for processing?",
    "a": "Image processing takes place in your browser. Your uploaded signature is not sent to our server for resizing."
  }
];
---

<!doctype html>
<html lang="en-IN" class="scroll-smooth">
  <head>
    <ThemeScript />
    <GoogleAnalytics />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={keywordsContent} />
    <meta name="author" content="SignResize.in" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="SignResize" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <meta name="theme-color" content="#4f46e5" />
    <link rel="manifest" href="/site.webmanifest" />

    <GoogleFonts />

    <!-- SoftwareApplication Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "Signature Resize 10 to 20 KB Online Tool",
      "datePublished": "2026-01-15T09:00:00+05:30",
      "dateModified": "2026-11-14T17:00:00+05:30",
      "url": canonicalUrl,
      "applicationCategory": "UtilityApplication",
      "applicationSubCategory": "Document Compression Utility",
      "operatingSystem": "All",
      "description": pageDescription,
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "INR"
      },
      "featureList": [
        "Strict 10 KB to 20 KB dual-boundary compression",
        "Editable pixel dimensions and crop",
        "Clean White Paper 3.0 shadow remover",
        "100% in-browser client-side privacy",
        "JPG download with file checks"
      ]
    })} />

    <!-- HowTo Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "HowTo",
      "name": "How to Resize Signature to 10 to 20 KB Online",
      "description": "Step-by-step instructions to resize, crop, and compress a signature image to exact 10 KB to 20 KB file bounds for government exam portal uploads.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Sign on Plain White Paper",
          "text": "Sign on white paper using the ink required by your application.",
          "position": 1
        },
        {
          "@type": "HowToStep",
          "name": "Upload to Resizer",
          "text": "Upload your photo or scan to the online tool workspace.",
          "position": 2
        },
        {
          "@type": "HowToStep",
          "name": "Lock 10-20 KB Target Range",
          "text": "Set the minimum to 10 KB and maximum to 20 KB, and check the required pixel dimensions.",
          "position": 3
        },
        {
          "@type": "HowToStep",
          "name": "Clean Background & Download JPG",
          "text": "Preview optional paper cleanup, download the JPG and check its file size and legibility.",
          "position": 4
        }
      ]
    })} />

    <!-- FAQPage Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": f.a
        }
      }))
    })} />

    <!-- BreadcrumbList Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://signresize.in/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Resize Signature 10 to 20 KB",
          "item": canonicalUrl
        }
      ]
    })} />
  </head>

  <body class="bg-background text-foreground min-h-screen flex flex-col">
    <Header />
    <main class="flex-1 w-full max-w-[1480px] mx-auto px-3 sm:px-6 lg:px-8 py-5 space-y-6">
      <nav aria-label="Breadcrumb" class="text-sm"><a class="text-primary underline" href="/">Home</a> / 10–20 KB signature resizer</nav>
      <section class="rounded-2xl border border-border bg-card p-5 space-y-3">
        <div class="flex items-center gap-2 flex-wrap pb-1">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-primary/10 text-primary border border-primary/20">
            <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
            Govt Exam Standard (10–20 KB)
          </span>
          <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md text-[11px] font-mono text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 border border-emerald-500/20">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            100% Client-Side Private
          </span>
          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[11px] font-mono text-muted-foreground bg-muted/60 border border-border">
            <span>🗓️</span> Last updated: 14 Nov 2026
          </span>
        </div>
        <h1 class="text-2xl sm:text-4xl font-bold">Resize Signature to 10–20 KB Online</h1>
        <p>Prepare a JPG between 10 KB and 20 KB. Upload your handwritten signature, crop unused paper and set the pixel dimensions required by your application.</p>
        <p class="text-sm text-muted-foreground">The starting canvas is 600 × 200 px, an editable preparation setting. Switch units to set <strong>cm</strong> (such as 3.5 × 1.5 cm with DPI) or adjust Min/Max KB to reach <strong>15 KB, 20 KB, 30 KB, 40 KB, 50 KB, or 100 KB</strong> — including increasing undersized JPGs above a minimum floor. Use <a href="/hi/" class="text-primary underline font-medium">Hindi Signature Resizer</a> if you prefer Hindi instructions.</p>
      </section>
      <section id="signature-workspace" aria-label="Signature resizing workspace" class="bg-card border border-border rounded-2xl p-3 sm:p-5 min-h-[680px]">
        <SignatureTool client:idle defaultPresetId="ssc-general" />
      </section>
      <section class="rounded-2xl border border-border bg-card p-5 space-y-4">
        <h2 class="text-xl font-bold">Check the exported signature</h2>
        <ol class="list-decimal pl-5 space-y-2"><li>Match the width, height and JPG format to your application instructions.</li><li>Set both file-size bounds: 10 KB minimum and 20 KB maximum.</li><li>Download, reopen the image at actual size and ensure every stroke is legible.</li><li>Check the application's upload preview before submitting.</li></ol>
        <SignatureCropExamples />
      </section>
      <section class="rounded-2xl border border-border bg-card p-5 space-y-3">
        <h2 class="text-xl font-bold">Use guidance for your exact exam</h2>
        <p>Requirements differ by recruitment. Follow the source notices on the relevant page before selecting a preset.</p>
        <nav class="flex flex-wrap gap-4" aria-label="Exam-specific signature guidance"><a class="text-primary underline" href="/ssc-signature-resize/">SSC</a><a class="text-primary underline" href="/ibps-signature-resize/">IBPS</a><a class="text-primary underline" href="/rrb-ntpc-signature-resize/">RRB NTPC</a><a class="text-primary underline" href="/iit-jam-signature-resize/">IIT JAM</a></nav>
      </section>
      <section class="space-y-4"><h2 class="text-xl font-bold">10–20 KB signature questions</h2>{faqs.map(faq => <details class="rounded-xl border border-border bg-card p-4"><summary class="font-semibold cursor-pointer">{faq.q}</summary><p class="pt-3 text-sm">{faq.a}</p></details>)}</section>
    </main>
    <Footer />
  </body>
</html>
