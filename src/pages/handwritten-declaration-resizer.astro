---
import UtilityPage from '../layouts/UtilityPage.astro';
import { DeclarationGuide } from '../components/DeclarationGuide';
import { SignatureTool } from '../components/SignatureTool';
---
<UtilityPage title="Handwritten Declaration Resizer" description="Prepare your declaration wording, review a visual scan checklist, and resize a handwritten declaration to 800 × 400 pixels and 50–100 KB JPG using the NICL AO reference preset.">
  <DeclarationGuide client:load />
  <section class="rounded-2xl bg-card border border-border p-3 sm:p-5"><SignatureTool client:load initialPresetId="handwritten-declaration" initialMode="document" /></section>
  <p class="text-xs text-muted-foreground">Reference checked October 16, 2026: <a class="underline" href="https://ibpsreg.ibps.in/niiclsep26/">NICL AO application portal, Guidelines for scanning the Photograph &amp; Signature</a>. Check your own notification for exceptions and accessible alternatives.</p>
</UtilityPage>
