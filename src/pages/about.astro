---
// src/pages/about.astro - About Us
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import GoogleFonts from '../components/GoogleFonts.astro';

const pageTitle = "About Us | SignResize.in";
const pageDescription = "Learn about SignResize.in — the mission behind our 100% client-side, zero-upload signature resizing tool built for students and job aspirants across India.";
---

<!doctype html>
<html lang="en-IN" class="scroll-smooth">
  <head>
    <!-- Google tag (gtag.js) -->
    <GoogleAnalytics />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href="https://signresize.in/about/" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- Favicon & PWA Icons -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="SignResize" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Async Google Fonts -->
    <GoogleFonts />
  </head>

  <body class="min-h-screen flex flex-col bg-background text-foreground antialiased selection:bg-primary/20 selection:text-primary">
    <Header />

    <main class="flex-1 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
      
      <!-- Breadcrumb Bar -->
      <nav class="flex items-center gap-2 text-xs text-muted-foreground" aria-label="Breadcrumb">
        <a href="/" class="hover:text-primary transition flex items-center gap-1">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          Home
        </a>
        <span>/</span>
        <span class="text-foreground font-medium">About Us</span>
      </nav>

      <!-- Page Header -->
      <div class="border-b border-border pb-6 space-y-3">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-primary/10 text-primary border border-primary/20">
          <span>🇮🇳 Built for Indian Aspirants &amp; Citizens</span>
        </div>
        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-foreground">
          About SignResize.in
        </h1>
        <p class="text-base text-muted-foreground leading-relaxed">
          Empowering millions of students and job applicants with instant, private, and mathematically precise signature resizing tools.
        </p>
      </div>

      <!-- Mission Overview -->
      <section class="space-y-4 text-sm sm:text-base leading-relaxed text-muted-foreground">
        <h2 class="text-xl font-bold text-foreground">Our Mission: Simplifying Sarkari Application Prep</h2>
        <p>
          Every year, millions of Indian applicants apply for competitive recruitment exams such as <strong>SSC (CGL, CHSL, GD, MTS)</strong>, <strong>UPSC</strong>, <strong>Banking (IBPS PO &amp; Clerk)</strong>, <strong>Railway (RRB NTPC, ALP, Group D)</strong>, and identity documents like <strong>PAN Cards (NSDL/UTIITSL)</strong>.
        </p>
        <p>
          Unfortunately, thousands of applications face rejection or server upload errors due to strict, unforgiving requirements: <em>"Signature must be between 10 KB to 20 KB"</em>, <em>"Width must be exactly 140 pixels and height 60 pixels"</em>, or <em>"Resolution must be 200 DPI on clean white paper"</em>.
        </p>
        <p>
          <strong>SignResize.in</strong> was founded with a singular purpose: to provide a completely free, lightning-fast, and 100% private web utility that eliminates technical friction for aspirants in every corner of India.
        </p>
      </section>

      <!-- Why We Are Different Grid -->
      <section class="space-y-4">
        <h2 class="text-xl font-bold text-foreground">Why SignResize is Different</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs sm:text-sm">
          
          <div class="p-5 rounded-2xl border border-border bg-card shadow-xs space-y-2">
            <div class="w-8 h-8 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold text-base">
              🔒
            </div>
            <h3 class="font-bold text-foreground text-sm">100% Client-Side Privacy</h3>
            <p class="text-muted-foreground leading-relaxed">
              Unlike traditional image converters that upload your personal signature to remote cloud databases, our engine processes every single byte inside your browser using HTML5 Canvas &amp; WebAssembly. Your signature never leaves your phone or laptop.
            </p>
          </div>

          <div class="p-5 rounded-2xl border border-border bg-card shadow-xs space-y-2">
            <div class="w-8 h-8 rounded-xl bg-primary/10 text-primary flex items-center justify-center font-bold text-base">
              ⚖️
            </div>
            <h3 class="font-bold text-foreground text-sm">Dual-Boundary Compression</h3>
            <p class="text-muted-foreground leading-relaxed">
              Standard compressors only let you reduce size. Our dual-boundary algorithm ensures your output file lands precisely between both minimum and maximum limits (e.g., strictly 10.0 KB to 20.0 KB) so portals never reject your upload.
            </p>
          </div>

          <div class="p-5 rounded-2xl border border-border bg-card shadow-xs space-y-2">
            <div class="w-8 h-8 rounded-xl bg-blue-500/10 text-blue-600 dark:text-blue-400 flex items-center justify-center font-bold text-base">
              📐
            </div>
            <h3 class="font-bold text-foreground text-sm">Centimeter to Pixel Precision</h3>
            <p class="text-muted-foreground leading-relaxed">
              Official notifications often specify sizes in Centimeters (e.g., 4.0 cm × 2.0 cm) or Inches. Our built-in unit converter automatically calculates exact pixel dimensions at 200 DPI standard scanning density.
            </p>
          </div>

          <div class="p-5 rounded-2xl border border-border bg-card shadow-xs space-y-2">
            <div class="w-8 h-8 rounded-xl bg-purple-500/10 text-purple-600 dark:text-purple-400 flex items-center justify-center font-bold text-base">
              ✍️
            </div>
            <h3 class="font-bold text-foreground text-sm">Digital Drawing Canvas</h3>
            <p class="text-muted-foreground leading-relaxed">
              No paper or scanner handy? Sign directly on your mobile screen with your finger or stylus, crop to dimensions, and download an official-compliant JPEG in seconds.
            </p>
          </div>

        </div>
      </section>

      <!-- Engineering Team & Verification Methodology (E-E-A-T) -->
      <section class="space-y-4">
        <h2 class="text-xl font-bold text-foreground">Engineering &amp; Document Verification Team</h2>
        
        <div class="p-5 sm:p-6 rounded-2xl border border-primary/20 bg-card shadow-xs space-y-4">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-border/60 pb-3">
            <div>
              <h3 class="text-base font-bold text-foreground">
                SignResize Technical &amp; Standards Team
              </h3>
              <p class="text-xs text-muted-foreground">
                Document Verification Lead &amp; Web Systems Engineering
              </p>
            </div>
            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
              ✓ Verified E-E-A-T Profile
            </span>
          </div>

          <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed">
            Our engineering team specializes in client-side computer graphics algorithms, in-browser JPEG quantization, and automated document compliance validation for Indian government recruitment infrastructure.
          </p>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-3.5 pt-1 text-xs">
            <div class="p-3.5 rounded-xl bg-muted/40 border border-border space-y-1.5">
              <div class="font-bold text-foreground flex items-center gap-1.5">
                <span class="text-primary font-mono text-sm">01</span>
                <span>Zero-Upload Guarantee</span>
              </div>
              <p class="text-[11px] text-muted-foreground leading-relaxed">
                All image processing runs in your device's browser memory via HTML5 Canvas. We maintain zero cloud upload servers for user images.
              </p>
            </div>

            <div class="p-3.5 rounded-xl bg-muted/40 border border-border space-y-1.5">
              <div class="font-bold text-foreground flex items-center gap-1.5">
                <span class="text-primary font-mono text-sm">02</span>
                <span>Portal Test Suite</span>
              </div>
              <p class="text-[11px] text-muted-foreground leading-relaxed">
                Outputs are rigorously tested against live validator constraints of SSC OTR, UPSC Online (upsconline.nic.in), NSDL Protean, and RRB.
              </p>
            </div>

            <div class="p-3.5 rounded-xl bg-muted/40 border border-border space-y-1.5">
              <div class="font-bold text-foreground flex items-center gap-1.5">
                <span class="text-primary font-mono text-sm">03</span>
                <span>Byte-Precision Floor</span>
              </div>
              <p class="text-[11px] text-muted-foreground leading-relaxed">
                Dual-boundary binary search ensures files strictly respect both floor limits (&ge; 10 KB, &ge; 20 KB) and ceiling caps (&le; 20 KB, &le; 50 KB).
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Commitment to Accessibility & Quality -->
      <section class="p-6 rounded-2xl bg-muted/30 border border-border space-y-3 text-xs sm:text-sm text-muted-foreground leading-relaxed">
        <h2 class="text-base font-bold text-foreground">Our Commitment to Quality and Accessibility</h2>
        <p>
          SignResize.in is designed to work smoothly on entry-level Android smartphones with low 3G/4G connectivity, as well as desktop workstations in cyber cafes and schools. We require no app installs, no registration, and no software licenses.
        </p>
        <p>
          Have questions, suggestions, or want to report an updated exam specification? Visit our <a href="/contact/" class="text-primary underline font-semibold">Contact Page</a> or reach our editorial team directly at <a href="mailto:support@signresize.in" class="text-primary underline font-semibold">support@signresize.in</a>.
        </p>
      </section>

      <!-- Back to Main Tool CTA -->
      <div class="pt-4 border-t border-border flex flex-col sm:flex-row items-center justify-between gap-4">
        <span class="text-xs text-muted-foreground">Ready to crop, resize, or compress your signature?</span>
        <a
          href="/"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-primary text-primary-foreground text-xs font-bold shadow-sm hover:opacity-90 transition active:scale-98"
        >
          <span>← Go to Main Signature Resizer Tool</span>
        </a>
      </div>

    </main>

    <Footer />
  </body>
</html>
