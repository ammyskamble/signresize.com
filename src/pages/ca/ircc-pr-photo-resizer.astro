---
// src/pages/ca/ircc-pr-photo-resizer.astro
import '../../styles/global.css';
import Header from '../../components/Header.astro';
import CAToolSwitcher from '../../components/CAToolSwitcher.astro';
import { SignatureTool } from '../../components/SignatureTool';
import FaqSection from '../../components/FaqSection.astro';
import Footer from '../../components/Footer.astro';
import GoogleAnalytics from '../../components/GoogleAnalytics.astro';
import GoogleFonts from '../../components/GoogleFonts.astro';
import ThemeScript from '../../components/ThemeScript.astro';

const pageTitle = "IRCC Express Entry & PR Photo Resizer (715×1000 px, 50×70 mm & 420 KB–4 MB) - SignResize";
const pageDescription = "Free IRCC Permanent Residency (PR) Card and Express Entry digital photo resizer. Crop and convert photos to 715×1000 px minimum (50×70 mm ratio), 420 KB to 4 MB in JPEG format for IRCC portal.";
const canonicalUrl = "https://signresize.in/ca/ircc-pr-photo-resizer/";
const ogImageUrl = "https://signresize.in/og-image.png";
const keywordsContent = "ircc pr photo resizer, express entry photo size 715x1000, canadian pr photo online crop, ircc digital photo converter free, 50x70 mm photo resizer canada";

const irccFaqs = [
  {
    q: "What are the exact pixel dimensions and frame size required for IRCC PR Card digital photos?",
    a: "For IRCC Permanent Resident (PR) Card and citizenship online portals, the digital photo must measure at least 715 pixels wide by 1000 pixels tall (up to 2000×2800 px), matching the 50 mm × 70 mm (2 × 2¾ inches) physical photo frame."
  },
  {
    q: "What is the allowed file size range for IRCC PR Card digital photo uploads?",
    a: "The digital photo file size must be 4 MB or less in JPEG (.jpg/.jpeg) format, with a minimum quality floor of 420 KB so the portal does not reject low-resolution uploads."
  },
  {
    q: "Are eyeglasses permitted in IRCC PR photos?",
    a: "Eyeglasses may be worn only if the eyes are clearly visible and there is no reflection or glare on the lenses. Tinted or dark glasses are prohibited."
  },
  {
    q: "What background color is required for IRCC digital PR photos?",
    a: "The photo must be taken against a plain, untextured white background providing clear contrast with the face, with no objects or wall shadows."
  }
];
---

<!doctype html>
<html lang="en-CA" class="scroll-smooth">
  <head>
    <ThemeScript />
    <GoogleAnalytics />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={keywordsContent} />
    <meta name="author" content="SignResize.in" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph (OG) Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="SignResize" />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Web Fonts & Favicons -->
    <GoogleFonts />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <meta name="theme-color" content="#dc2626" />

    <!-- Schema.org WebApplication JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "IRCC Express Entry & PR Photo Resizer",
      "url": canonicalUrl,
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "description": pageDescription,
      "featureList": [
        "715x1000 px Minimum (50x70 mm PR Frame) Crop",
        "420 KB to 4 MB JPEG Compression",
        "100% In-Browser Privacy Protection"
      ]
    })} />
  </head>

  <body class="min-h-screen bg-background text-foreground flex flex-col font-sans antialiased">
    <Header />

    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-8">
      <!-- Tool Page Header with Selector Dropdown -->
      <section class="space-y-4">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div class="space-y-2">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-red-500/10 text-red-600 dark:text-red-400 border border-red-500/20">
              <span>🇨🇦 IRCC Permanent Resident (PR) Card Standard</span>
            </div>
            <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-foreground">
              IRCC Express Entry &amp; PR Photo Resizer <span class="text-primary">(715×1000 px)</span>
            </h1>
            <p class="text-sm text-muted-foreground max-w-3xl">
              Format your digital photo to official IRCC PR Card standards (minimum 715×1000 pixels, 50×70 mm aspect ratio, 420 KB to 4 MB JPEG) for Permanent Residency confirmation and PR Card portals.
            </p>
            <p class="text-[11px] font-mono text-muted-foreground">
              Specs verified 26 Nov 2026 against canada.ca IRCC Permanent Resident Card digital photo guidelines.
            </p>
          </div>

          <!-- Dropdown Switcher to Other CA Tools -->
          <CAToolSwitcher currentTool="ircc" />
        </div>
      </section>

      <!-- Resizer Studio Tool Workspace initialized with IRCC PR Preset -->
      <section id="tool-workspace" class="scroll-mt-20">
        <SignatureTool client:idle initialPresetId="ca-ircc-pr" />
      </section>

      <!-- Technical Guidelines & Interlinking Section -->
      <section class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="md:col-span-2 space-y-4 bg-card border border-border p-6 rounded-2xl">
          <h2 class="text-xl font-bold text-foreground">
            Official IRCC PR Card &amp; Express Entry Photo Standard Specs
          </h2>
          <ul class="space-y-2.5 text-xs sm:text-sm text-muted-foreground">
            <li class="flex items-start gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span><strong>Dimensions:</strong> Minimum 715 × 1000 pixels (up to 2000 × 2800 px), matching the 50 × 70 mm (2 × 2¾ in) PR frame.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span><strong>File Weight:</strong> Between 420 KB (quality floor) and 4 MB maximum in JPEG (.jpg/.jpeg) format.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span><strong>Head Size &amp; Background:</strong> Chin to crown 31–36 mm on a plain, untextured white background with no shadows.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span><strong>Expression:</strong> Neutral facial expression with mouth closed and eyes fully visible.</span>
            </li>
          </ul>
        </div>

        <!-- Cross Interlinking Box -->
        <div class="space-y-4 bg-primary/5 border border-primary/20 p-6 rounded-2xl">
          <h3 class="text-base font-bold text-foreground">Related Canada Tools</h3>
          <div class="space-y-2 text-xs">
            <a href="/ca/study-work-permit-photo-resizer/" class="block p-2.5 rounded-xl bg-card border border-border hover:border-primary transition font-medium text-foreground">
              🎓 Study &amp; Work Permit Resizer (35×45 mm, 60–240 KB) →
            </a>
            <a href="/ca/canadian-passport-photo-resizer/" class="block p-2.5 rounded-xl bg-card border border-border hover:border-primary transition font-medium text-foreground">
              🛂 Canadian Passport Photo Resizer (50×70 mm) →
            </a>
            <a href="/ca/" class="block p-2.5 rounded-xl bg-primary text-primary-foreground text-center font-bold hover:opacity-90 transition mt-2">
              Back to Canada Tools Hub →
            </a>
          </div>
        </div>
      </section>

      <!-- FAQ Section -->
      <section class="space-y-6">
        <FaqSection faqs={irccFaqs} title="IRCC PR &amp; Express Entry Photo Resizer FAQs" />
      </section>
    </main>

    <Footer />
  </body>
</html>
