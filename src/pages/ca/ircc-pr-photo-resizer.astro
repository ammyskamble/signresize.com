---
// src/pages/ca/ircc-pr-photo-resizer.astro
import '../../styles/global.css';
import Header from '../../components/Header.astro';
import { SignatureTool } from '../../components/SignatureTool';
import FaqSection from '../../components/FaqSection.astro';
import Footer from '../../components/Footer.astro';
import GoogleAnalytics from '../../components/GoogleAnalytics.astro';
import GoogleFonts from '../../components/GoogleFonts.astro';
import ThemeScript from '../../components/ThemeScript.astro';

const pageTitle = "IRCC Express Entry & PR Photo Resizer (420x540 Pixels & 240KB to 4MB) - SignResize";
const pageDescription = "Free IRCC Permanent Residency (PR) and Express Entry digital visa photo resizer. Crop and convert photos to 420x540 pixels, 35x45 mm ratio, 240 KB to 4 MB in JPEG format for IRCC portal.";
const canonicalUrl = "https://signresize.in/ca/ircc-pr-photo-resizer/";
const ogImageUrl = "https://signresize.in/og-image.png";
const keywordsContent = "ircc pr photo resizer, express entry photo size 420x540, canadian pr photo online crop, ircc digital photo converter free, 35x45 mm photo resizer canada";

const irccFaqs = [
  {
    q: "What are the exact pixel dimensions required for IRCC PR and Express Entry digital photos?",
    a: "The digital photo for IRCC Permanent Residency (PR) must be vertically oriented, measuring at least 420 pixels wide by 540 pixels tall (a 35mm x 45mm aspect ratio)."
  },
  {
    q: "What is the allowed file size range for IRCC digital photo uploads?",
    a: "The digital photo file size must be strictly between 240 KB (minimum) and 4 MB (maximum) in JPEG (.jpg) format."
  },
  {
    q: "Are eyeglasses permitted in IRCC PR photos?",
    a: "Eyeglasses may be worn only if the eyes are clearly visible and there is no reflection or glare on the lenses. Tinted or dark glasses are prohibited."
  },
  {
    q: "What background color is required for IRCC digital visa photos?",
    a: "The photo must be taken against a plain, light-colored background (such as white or off-white) with no objects or wall shadows."
  }
];
---

<!doctype html>
<html lang="en-CA" class="scroll-smooth">
  <head>
    <ThemeScript />
    <GoogleAnalytics />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={keywordsContent} />
    <meta name="author" content="SignResize.in" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph (OG) Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="SignResize" />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Web Fonts & Favicons -->
    <GoogleFonts />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <meta name="theme-color" content="#dc2626" />

    <!-- Schema.org WebApplication JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "IRCC Express Entry & PR Photo Resizer",
      "url": canonicalUrl,
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "description": pageDescription,
      "featureList": [
        "420x540 px Aspect Ratio Crop",
        "240 KB to 4 MB JPEG Compression",
        "100% In-Browser Privacy Protection"
      ]
    })} />
  </head>

  <body class="min-h-screen bg-background text-foreground flex flex-col font-sans antialiased">
    <Header />

    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-8">
      <!-- Tool Page Header with Selector Dropdown -->
      <section class="space-y-4">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div class="space-y-2">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-red-500/10 text-red-600 dark:text-red-400 border border-red-500/20">
              <span>🇨🇦 IRCC Express Entry &amp; PR Photo Standard</span>
            </div>
            <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-foreground">
              IRCC Express Entry &amp; PR Photo Resizer <span class="text-primary">(420×540 px)</span>
            </h1>
            <p class="text-sm text-muted-foreground max-w-3xl">
              Format your digital photo to IRCC standards (minimum 420×540 pixels, 35×45 mm aspect ratio, 240 KB to 4 MB JPEG) for online Permanent Residency and Express Entry confirmation portals.
            </p>
          </div>

          <!-- Dropdown Switcher to Other CA Tools -->
          <div class="relative group shrink-0">
            <button
              type="button"
              class="w-full sm:w-auto inline-flex items-center justify-between gap-3 px-4 py-2 rounded-xl bg-card hover:bg-muted text-foreground text-xs font-bold transition border border-border cursor-pointer"
            >
              <span class="flex items-center gap-2">
                <span>🇨🇦 Switch Canada Tool</span>
              </span>
              <svg class="w-4 h-4 transition-transform group-hover:rotate-180 opacity-70" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </button>

            <div class="invisible group-hover:visible opacity-0 group-hover:opacity-100 transition-all duration-150 absolute right-0 top-full mt-1.5 w-72 bg-white dark:bg-slate-900 rounded-2xl shadow-2xl border-2 border-slate-200 dark:border-slate-700 p-2 z-50 space-y-1">
              <a href="/ca/study-work-permit-photo-resizer/" class="flex items-center gap-2.5 p-2 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 transition text-xs font-semibold text-foreground group/item">
                <span class="text-base p-1 rounded bg-amber-500/10 text-amber-600">🎓</span>
                <div>
                  <div class="group-hover/item:text-primary">Study &amp; Work Permit Resizer</div>
                  <div class="text-[10px] text-muted-foreground font-normal">420×540 px | Student/Work Visa</div>
                </div>
              </a>
              <a href="/ca/canadian-passport-photo-resizer/" class="flex items-center gap-2.5 p-2 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 transition text-xs font-semibold text-foreground group/item">
                <span class="text-base p-1 rounded bg-blue-500/10 text-blue-600">🛂</span>
                <div>
                  <div class="group-hover/item:text-primary">Canadian Passport Resizer</div>
                  <div class="text-[10px] text-muted-foreground font-normal">50×70 mm | 600×840 px</div>
                </div>
              </a>
              <a href="/ca/" class="flex items-center justify-between p-2 rounded-xl bg-primary/10 text-primary font-bold text-xs hover:bg-primary/20 transition">
                <span>🇨🇦 View All Canada Tools</span>
                <span>→</span>
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- Resizer Studio Tool Workspace initialized with IRCC PR Preset -->
      <section id="tool-workspace" class="scroll-mt-20">
        <SignatureTool client:load initialPresetId="ca-ircc-pr" />
      </section>

      <!-- Technical Guidelines & Interlinking Section -->
      <section class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="md:col-span-2 space-y-4 bg-card border border-border p-6 rounded-2xl">
          <h2 class="text-xl font-bold text-foreground">
            Official IRCC Express Entry &amp; PR Visa Photo Standard Specs
          </h2>
          <ul class="space-y-2.5 text-xs sm:text-sm text-muted-foreground">
            <li class="flex items-start gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span><strong>Dimensions:</strong> Minimum 420 × 540 pixels (35×45 mm aspect ratio, 7:9 ratio).</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span><strong>File Weight:</strong> Between 240 KB and 4 MB in JPEG format.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span><strong>Background:</strong> Plain white or off-white background with no background shadows.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span><strong>Expression:</strong> Neutral facial expression with mouth closed and eyes fully visible.</span>
            </li>
          </ul>
        </div>

        <!-- Cross Interlinking Box -->
        <div class="space-y-4 bg-primary/5 border border-primary/20 p-6 rounded-2xl">
          <h3 class="text-base font-bold text-foreground">Related Canada Tools</h3>
          <div class="space-y-2 text-xs">
            <a href="/ca/study-work-permit-photo-resizer/" class="block p-2.5 rounded-xl bg-card border border-border hover:border-primary transition font-medium text-foreground">
              🎓 Study &amp; Work Permit Resizer →
            </a>
            <a href="/ca/canadian-passport-photo-resizer/" class="block p-2.5 rounded-xl bg-card border border-border hover:border-primary transition font-medium text-foreground">
              🛂 Canadian Passport Photo Resizer (50×70 mm) →
            </a>
            <a href="/ca/" class="block p-2.5 rounded-xl bg-primary text-primary-foreground text-center font-bold hover:opacity-90 transition mt-2">
              Back to Canada Tools Hub →
            </a>
          </div>
        </div>
      </section>

      <!-- FAQ Section -->
      <section class="space-y-6">
        <FaqSection faqs={irccFaqs} title="IRCC PR &amp; Express Entry Photo Resizer FAQs" />
      </section>
    </main>

    <Footer />
  </body>
</html>
