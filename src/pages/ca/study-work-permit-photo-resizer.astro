---
// src/pages/ca/study-work-permit-photo-resizer.astro
import '../../styles/global.css';
import Header from '../../components/Header.astro';
import CAToolSwitcher from '../../components/CAToolSwitcher.astro';
import { SignatureTool } from '../../components/SignatureTool';
import FaqSection from '../../components/FaqSection.astro';
import Footer from '../../components/Footer.astro';
import GoogleAnalytics from '../../components/GoogleAnalytics.astro';
import GoogleFonts from '../../components/GoogleFonts.astro';
import ThemeScript from '../../components/ThemeScript.astro';

const pageTitle = "Canada Study & Work Permit Photo Resizer (420x540 Pixels & 240KB-4MB) - SignResize";
const pageDescription = "Free online Canada Study Permit and Work Permit digital photo resizer. Crop and convert photos to 420x540 pixels, 35x45 mm ratio, 240 KB to 4 MB in JPEG format for IRCC online portals.";
const canonicalUrl = "https://signresize.in/ca/study-work-permit-photo-resizer/";
const ogImageUrl = "https://signresize.in/og-image.png";
const keywordsContent = "study permit photo resizer canada, work permit photo size 420x540, ircc student visa photo crop, pgwp photo size converter, canadian permit photo resizer free";

const permitFaqs = [
  {
    q: "What photo specifications are required for a Canadian Study Permit?",
    a: "IRCC online portals mandate digital photographs measuring at least 420 pixels wide by 540 pixels tall (35mm x 45mm ratio), with a file size between 240 KB and 4 MB in JPEG format."
  },
  {
    q: "Does Post-Graduation Work Permit (PGWP) require the same photo size as Study Permits?",
    a: "Yes. PGWP, Co-op Work Permits, Open Work Permits, and Study Permit extensions all follow standard IRCC digital photo specifications (420x540 pixels minimum, 240 KB to 4 MB)."
  },
  {
    q: "What background color is required for Canadian permit photos?",
    a: "The photo must be taken against a plain white or off-white background. No dark shadows or patterns should be visible."
  },
  {
    q: "Can I take my Study Permit photo with a smartphone?",
    a: "Yes. Stand 4 to 6 feet away from a light-colored wall with even lighting. Frame your head and shoulders, ensure a neutral expression, and crop to 420x540 px using SignResize."
  }
];
---

<!doctype html>
<html lang="en-CA" class="scroll-smooth">
  <head>
    <ThemeScript />
    <GoogleAnalytics />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={keywordsContent} />
    <meta name="author" content="SignResize.in" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph (OG) Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="SignResize" />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Web Fonts & Favicons -->
    <GoogleFonts />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <meta name="theme-color" content="#dc2626" />

    <!-- Schema.org WebApplication JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "Canada Study & Work Permit Photo Resizer",
      "url": canonicalUrl,
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "description": pageDescription,
      "featureList": [
        "420x540 px Aspect Ratio Crop",
        "240 KB to 4 MB File Size Compression",
        "Client-Side Zero Server Upload Privacy"
      ]
    })} />
  </head>

  <body class="min-h-screen bg-background text-foreground flex flex-col font-sans antialiased">
    <Header />

    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-8">
      <!-- Tool Page Header with Selector Dropdown -->
      <section class="space-y-4">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div class="space-y-2">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20">
              <span>🎓 Canada Study &amp; Work Permit Photo Standard</span>
            </div>
            <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-foreground">
              Canada Study &amp; Work Permit Photo Resizer <span class="text-primary">(420×540 px)</span>
            </h1>
            <p class="text-sm text-muted-foreground max-w-3xl">
              Format your digital photo to IRCC standards (minimum 420×540 pixels, 35×45 mm ratio, 240 KB to 4 MB JPEG) for Canadian student visas, PGWP, and work permit application portals.
            </p>
          </div>

          <!-- Dropdown Switcher to Other CA Tools -->
          <CAToolSwitcher currentTool="study" />
        </div>
      </section>

      <!-- Resizer Studio Tool Workspace initialized with Permit Preset -->
      <section id="tool-workspace" class="scroll-mt-20">
        <SignatureTool client:idle initialPresetId="ca-permit" />
      </section>

      <!-- Technical Guidelines & Interlinking Section -->
      <section class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="md:col-span-2 space-y-4 bg-card border border-border p-6 rounded-2xl">
          <h2 class="text-xl font-bold text-foreground">
            Official Study &amp; Work Permit Photo Guidelines
          </h2>
          <ul class="space-y-2.5 text-xs sm:text-sm text-muted-foreground">
            <li class="flex items-start gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span><strong>Dimensions:</strong> Minimum 420 × 540 pixels (35×45 mm aspect ratio).</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span><strong>File Weight:</strong> 240 KB to 4 MB in JPEG format.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span><strong>Background:</strong> Plain white or off-white background with balanced lighting.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span><strong>Facial Fit:</strong> Head height chin to crown should occupy approximately 70-80% of the vertical frame.</span>
            </li>
          </ul>
        </div>

        <!-- Cross Interlinking Box -->
        <div class="space-y-4 bg-primary/5 border border-primary/20 p-6 rounded-2xl">
          <h3 class="text-base font-bold text-foreground">Related Canada Tools</h3>
          <div class="space-y-2 text-xs">
            <a href="/ca/ircc-pr-photo-resizer/" class="block p-2.5 rounded-xl bg-card border border-border hover:border-primary transition font-medium text-foreground">
              🍁 IRCC Express Entry &amp; PR Resizer →
            </a>
            <a href="/ca/canadian-passport-photo-resizer/" class="block p-2.5 rounded-xl bg-card border border-border hover:border-primary transition font-medium text-foreground">
              🛂 Canadian Passport Photo Resizer (50×70 mm) →
            </a>
            <a href="/ca/" class="block p-2.5 rounded-xl bg-primary text-primary-foreground text-center font-bold hover:opacity-90 transition mt-2">
              Back to Canada Tools Hub →
            </a>
          </div>
        </div>
      </section>

      <!-- FAQ Section -->
      <section class="space-y-6">
        <FaqSection faqs={permitFaqs} title="Canada Study &amp; Work Permit Photo Resizer FAQs" />
      </section>
    </main>

    <Footer />
  </body>
</html>
