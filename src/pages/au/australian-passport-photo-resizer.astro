---
// src/pages/au/australian-passport-photo-resizer.astro
import '../../styles/global.css';
import Header from '../../components/Header.astro';
import { SignatureTool } from '../../components/SignatureTool';
import FaqSection from '../../components/FaqSection.astro';
import Footer from '../../components/Footer.astro';
import GoogleAnalytics from '../../components/GoogleAnalytics.astro';
import GoogleFonts from '../../components/GoogleFonts.astro';
import ThemeScript from '../../components/ThemeScript.astro';

const pageTitle = "Australian Passport Photo Resizer (35x45 mm / 600x750 Pixels) - SignResize";
const pageDescription = "Free online Australian Passport Photo Resizer & Crop Tool. Format photos to 35x45 mm (600x750 pixels), head height 32-36 mm, 50 KB to 5 MB JPEG for passports.gov.au.";
const canonicalUrl = "https://signresize.in/au/australian-passport-photo-resizer/";
const ogImageUrl = "https://signresize.in/og-image.png";
const keywordsContent = "australian passport photo resizer, australia passport photo size 35x45 mm, passports.gov.au photo crop, 600x750 px passport photo australia, convert photo to australian passport";

const passportFaqs = [
  {
    q: "What are the exact dimensions for an Australian passport photo?",
    a: "Australian passport photos measure 35 mm wide by 45 mm high (600x750 pixels for digital uploads at 300 DPI). The file size must be between 50 KB and 5 MB in JPEG format."
  },
  {
    q: "What head height is required for Australian passport photos?",
    a: "The facial length from the bottom of the chin to the top of the head (crown) must measure strictly between 32 mm and 36 mm."
  },
  {
    q: "Are eyeglasses allowed in Australian passport photographs?",
    a: "No. The Australian Passport Office strictly forbids eyeglasses in passport photographs unless a signed medical certificate from a registered doctor is provided."
  },
  {
    q: "What background color is required for Australian passport photos?",
    a: "The background must be plain, uniform light gray or white with clear contrast between your head and the background."
  }
];
---

<!doctype html>
<html lang="en-AU" class="scroll-smooth">
  <head>
    <ThemeScript />
    <GoogleAnalytics />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={keywordsContent} />
    <meta name="author" content="SignResize.in" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph (OG) Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="SignResize" />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Web Fonts & Favicons -->
    <GoogleFonts />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <meta name="theme-color" content="#d97706" />

    <!-- Schema.org WebApplication JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "Australian Passport Photo Resizer",
      "url": canonicalUrl,
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "description": pageDescription,
      "featureList": [
        "35x45 mm Aspect Ratio Crop (4:5 Vertical)",
        "600x750 px Digital Pixel Standard",
        "Head Size Ratio 32-36 mm Alignment"
      ]
    })} />
  </head>

  <body class="min-h-screen bg-background text-foreground flex flex-col font-sans antialiased">
    <Header />

    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-8">
      <!-- Tool Page Header with Selector Dropdown -->
      <section class="space-y-4">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div class="space-y-2">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/20">
              <span>Passport Australian Passport Office Standard</span>
            </div>
            <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-foreground">
              Australian Passport Photo Resizer <span class="text-primary">(35×45 mm / 600×750 px)</span>
            </h1>
            <p class="text-sm text-muted-foreground max-w-3xl">
              Format your digital photo to official Australian Passport Office standards (35×45 mm, 600×750 pixels, head height 32-36 mm, 50 KB to 5 MB JPEG).
            </p>
          </div>

          <!-- Dropdown Switcher to Other AU Tools -->
          <div class="relative group shrink-0">
            <button
              type="button"
              class="w-full sm:w-auto inline-flex items-center justify-between gap-3 px-4 py-2 rounded-xl bg-card hover:bg-muted text-foreground text-xs font-bold transition border border-border cursor-pointer"
            >
              <span class="flex items-center gap-2">
                <span>🇦🇺 Switch Australia Tool</span>
              </span>
              <svg class="w-4 h-4 transition-transform group-hover:rotate-180 opacity-70" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </button>

            <div class="invisible group-hover:visible opacity-0 group-hover:opacity-100 transition-all duration-150 absolute right-0 top-full mt-1.5 w-72 bg-white dark:bg-slate-900 rounded-2xl shadow-2xl border-2 border-slate-200 dark:border-slate-700 p-2 z-50 space-y-1">
              <a href="/au/immiaccount-visa-photo-resizer/" class="flex items-center gap-2.5 p-2 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 transition text-xs font-semibold text-foreground group/item">
                <span class="text-base p-1 rounded bg-amber-500/10 text-amber-600">🦘</span>
                <div>
                  <div class="group-hover/item:text-primary">ImmiAccount Visa Resizer</div>
                  <div class="text-[10px] text-muted-foreground font-normal">600×750 px | Student, Skilled, Visitor</div>
                </div>
              </a>
              <a href="/au/" class="flex items-center justify-between p-2 rounded-xl bg-primary/10 text-primary font-bold text-xs hover:bg-primary/20 transition">
                <span>🇦🇺 View All Australia Tools</span>
                <span>→</span>
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- Resizer Studio Tool Workspace initialized with Australian Passport Preset -->
      <section id="tool-workspace" class="scroll-mt-20">
        <SignatureTool client:load initialPresetId="au-passport" />
      </section>

      <!-- Technical Guidelines & Interlinking Section -->
      <section class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="md:col-span-2 space-y-4 bg-card border border-border p-6 rounded-2xl">
          <h2 class="text-xl font-bold text-foreground">
            Official Australian Passport Office Photo Specs
          </h2>
          <ul class="space-y-2.5 text-xs sm:text-sm text-muted-foreground">
            <li class="flex items-start gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span><strong>Dimensions:</strong> 35 × 45 mm (600 × 750 pixels for digital uploads).</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span><strong>Head Size:</strong> Chin to crown height must measure between 32 mm and 36 mm.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span><strong>Glasses Policy:</strong> No eyeglasses allowed unless accompanied by a medical certificate.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span><strong>File Weight:</strong> 50 KB to 5 MB in JPEG format.</span>
            </li>
          </ul>
        </div>

        <!-- Cross Interlinking Box -->
        <div class="space-y-4 bg-primary/5 border border-primary/20 p-6 rounded-2xl">
          <h3 class="text-base font-bold text-foreground">Related Australia Tools</h3>
          <div class="space-y-2 text-xs">
            <a href="/au/immiaccount-visa-photo-resizer/" class="block p-2.5 rounded-xl bg-card border border-border hover:border-primary transition font-medium text-foreground">
              🦘 ImmiAccount Visa Photo Resizer →
            </a>
            <a href="/au/" class="block p-2.5 rounded-xl bg-primary text-primary-foreground text-center font-bold hover:opacity-90 transition mt-2">
              Back to Australia Tools Hub →
            </a>
          </div>
        </div>
      </section>

      <!-- FAQ Section -->
      <section class="space-y-6">
        <FaqSection faqs={passportFaqs} title="Australian Passport Photo Resizer FAQs" />
      </section>
    </main>

    <Footer />
  </body>
</html>
