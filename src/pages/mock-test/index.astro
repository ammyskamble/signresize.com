---
// src/pages/mock-test/index.astro
import '../../styles/global.css';
import '../../styles/minimal-borders.css';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import GoogleAnalytics from '../../components/GoogleAnalytics.astro';
import ThemeScript from '../../components/ThemeScript.astro';

const pageTitle = "Free Mock Tests Online — No Login, Real TCS iON Exam Interface | SignResize";
const pageDescription = "Start full mock tests instantly with zero registration, no phone number, and no paywalls. Exact TCS iON CBT screen with 5-state palette, -1/3 negative marking, instant weakness diagnosis, and worked solutions.";
const canonicalUrl = "https://signresize.in/mock-test/";
---

<!doctype html>
<html lang="en-IN" class="scroll-smooth">
  <head>
    <ThemeScript />
    <GoogleAnalytics />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- BreadcrumbList Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://signresize.in/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Mock Tests",
          "item": canonicalUrl
        }
      ]
    })} />

    <!-- FAQPage Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Are SignResize mock tests really 100% free without login?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Every mock test starts in one click. We never ask for your mobile number, email, OTP, or credit card. All tests and solutions are completely free and private."
          }
        },
        {
          "@type": "Question",
          "name": "Does the test screen match the real TCS iON examination hall?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. The interface features the authentic 5-color TCS iON question palette (Answered, Not Answered, Not Visited, Marked for Review, Answered & Marked for Review), section tabs, countdown timer, and bilingual English/Hindi toggle."
          }
        },
        {
          "@type": "Question",
          "name": "What happens if my internet disconnects or my browser closes during a mock test?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Your answers and timer are instantly saved to your browser's local storage on every click. When you return or refresh, you can resume your attempt exactly where you left off."
          }
        }
      ]
    })} />
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-800 antialiased dark:bg-slate-950 dark:text-slate-100">
    <Header />

    <main class="mx-auto max-w-6xl px-4 py-8 sm:py-12">
      {/* Breadcrumb */}
      <nav class="mb-6 flex items-center gap-2 text-xs text-slate-500">
        <a href="/" class="hover:text-sky-600">Home</a>
        <span>/</span>
        <span class="font-semibold text-slate-700 dark:text-slate-300">Mock Tests</span>
      </nav>

      {/* Hero Section */}
      <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-slate-900 via-sky-950 to-indigo-950 p-6 text-white shadow-xl sm:p-12">
        <div class="relative z-10 max-w-3xl">
          <div class="inline-flex items-center gap-2 rounded-full border border-sky-400/30 bg-sky-500/10 px-3.5 py-1 text-xs font-semibold text-sky-300 backdrop-blur-sm">
            <span>⚡ One-Click Start</span>
            <span>·</span>
            <span>Zero Login / No Phone Number</span>
            <span>·</span>
            <span>100% Free Forever</span>
          </div>

          <h1 class="mt-4 text-3xl font-black tracking-tight sm:text-5xl">
            Real Exam Mocks.<br />
            <span class="bg-gradient-to-r from-sky-400 to-indigo-300 bg-clip-text text-transparent">
              Exact TCS iON Hall Interface.
            </span>
          </h1>

          <p class="mt-4 text-sm leading-relaxed text-slate-300 sm:text-base">
            No registration bait. No paywalled solutions. No OTP verification. Take full-length official pattern mock tests with authentic negative marking, instant weakness diagnosis, and worked solutions — on the same platform where you prepared your application documents.
          </p>

          <div class="mt-8 flex flex-wrap gap-4">
            <a
              href="#exams"
              class="inline-flex items-center gap-2 rounded-xl bg-sky-500 px-6 py-3.5 text-sm font-bold text-white shadow-lg transition hover:bg-sky-400 active:scale-95"
            >
              Choose Your Exam Below ↓
            </a>
            <a
              href="/mock-test/ssc-cgl/"
              class="inline-flex items-center gap-2 rounded-xl border border-indigo-400/40 bg-indigo-500/20 px-4 py-3.5 text-sm font-bold text-indigo-200 transition hover:bg-indigo-500/30"
            >
              SSC CGL Tier-1 →
            </a>
            <a
              href="/mock-test/ssc-gd/"
              class="inline-flex items-center gap-2 rounded-xl border border-emerald-400/40 bg-emerald-500/20 px-4 py-3.5 text-sm font-bold text-emerald-200 transition hover:bg-emerald-500/30"
            >
              SSC GD Constable →
            </a>
            <a
              href="/mock-test/rrb-group-d/"
              class="inline-flex items-center gap-2 rounded-xl border border-amber-400/40 bg-amber-500/20 px-4 py-3.5 text-sm font-bold text-amber-200 transition hover:bg-amber-500/30"
            >
              RRB Group D →
            </a>
          </div>
        </div>
      </div>

      {/* 5 Core Pillars Grid */}
      <div class="mt-12">
        <h2 class="text-xl font-black text-slate-900 sm:text-2xl dark:text-white">
          Why SignResize Mock Tests Are Built Deliberately Different
        </h2>
        <p class="mt-1 text-xs text-slate-500">
          Incumbents use free tests as bait to capture your phone number. We give the entire test, solution, and analysis away anonymously.
        </p>

        <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-100 text-lg text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300">
              🔓
            </div>
            <h3 class="mt-3 text-base font-bold text-slate-900 dark:text-white">
              Zero Login & No Phone Wall
            </h3>
            <p class="mt-1.5 text-xs leading-relaxed text-slate-600 dark:text-slate-400">
              Start in one click. We never ask for your mobile number or email. No sales calls, no SMS spam, no WhatsApp course marketing.
            </p>
          </div>

          <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-sky-100 text-lg text-sky-700 dark:bg-sky-950 dark:text-sky-300">
              🖥️
            </div>
            <h3 class="mt-3 text-base font-bold text-slate-900 dark:text-white">
              Pixel-Faithful TCS iON Interface
            </h3>
            <p class="mt-1.5 text-xs leading-relaxed text-slate-600 dark:text-slate-400">
              The real 5-state question palette, section tabs, countdown clock, and per-question Hindi/English toggle. Exactly like the real CBT hall.
            </p>
          </div>

          <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-indigo-100 text-lg text-indigo-700 dark:bg-indigo-950 dark:text-indigo-300">
              🛡️
            </div>
            <h3 class="mt-3 text-base font-bold text-slate-900 dark:text-white">
              You Can't Lose Your Test
            </h3>
            <p class="mt-1.5 text-xs leading-relaxed text-slate-600 dark:text-slate-400">
              Every answer is auto-saved to your device on every click. If your 4G drops or your phone runs out of battery, simply reopen to resume.
            </p>
          </div>

          <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-purple-100 text-lg text-purple-700 dark:bg-purple-950 dark:text-purple-300">
              📊
            </div>
            <h3 class="mt-3 text-base font-bold text-slate-900 dark:text-white">
              Topic Weakness Diagnostics
            </h3>
            <p class="mt-1.5 text-xs leading-relaxed text-slate-600 dark:text-slate-400">
              Instant breakdown highlighting your weakest areas first. Know exactly which math or reasoning chapter cost you marks.
            </p>
          </div>

          <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-amber-100 text-lg text-amber-700 dark:bg-amber-950 dark:text-amber-300">
              🎯
            </div>
            <h3 class="mt-3 text-base font-bold text-slate-900 dark:text-white">
              Honest Cut-off Benchmarks
            </h3>
            <p class="mt-1.5 text-xs leading-relaxed text-slate-600 dark:text-slate-400">
              No fake All India Ranks or invented percentiles. Compare your net score against verified, published previous exam cut-offs.
            </p>
          </div>

          <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-rose-100 text-lg text-rose-700 dark:bg-rose-950 dark:text-rose-300">
              ⚖️
            </div>
            <h3 class="mt-3 text-base font-bold text-slate-900 dark:text-white">
              Apply Right · Then Prepare Right
            </h3>
            <p class="mt-1.5 text-xs leading-relaxed text-slate-600 dark:text-slate-400">
              Fixed your signature and live photo? Transition seamlessly into CBT preparation on the same platform you already trust.
            </p>
          </div>
        </div>
      </div>

      {/* Exam Cards Section */}
      <div id="exams" class="mt-16">
        <div class="flex items-center justify-between">
          <div>
            <h2 class="text-xl font-black text-slate-900 sm:text-2xl dark:text-white">
              Available Mock Tests (All 100% Free & No Login)
            </h2>
            <p class="text-xs text-slate-500">
              Full-length mocks and targeted sectional tests in authentic TCS iON CBT interface with complete bilingual solutions.
            </p>
          </div>
        </div>

        <div class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-2">
          {/* 1. RRB NTPC */}
          <div class="relative flex flex-col justify-between overflow-hidden rounded-3xl border-2 border-sky-500/40 bg-white p-6 shadow-md transition hover:border-sky-500 hover:shadow-lg dark:border-sky-500/30 dark:bg-slate-900">
            <div class="absolute right-4 top-4">
              <span class="rounded-full bg-emerald-100 px-3 py-1 text-xs font-bold text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">
                ● Live & Free
              </span>
            </div>

            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-sky-600 dark:text-sky-400">
                Railway Recruitment Boards
              </span>
              <h3 class="mt-1 text-2xl font-black text-slate-900 dark:text-white">
                RRB NTPC CBT-1 (Graduate & 12th)
              </h3>
              <p class="mt-2 text-xs text-slate-600 dark:text-slate-400">
                Official CEN 06/2025 pattern: 100 questions, 90 minutes, Maths (30), Reasoning (30), General Awareness (40). Exactly -1/3 negative marking.
              </p>

              <div class="mt-4 flex flex-wrap gap-2 text-xs">
                <span class="rounded bg-slate-100 px-2.5 py-1 font-semibold text-slate-700 dark:bg-slate-800 dark:text-slate-300">
                  1 Full 100-Q Mock
                </span>
                <span class="rounded bg-slate-100 px-2.5 py-1 font-semibold text-slate-700 dark:bg-slate-800 dark:text-slate-300">
                  3 Sectionals (Maths/Reasoning/GA)
                </span>
                <span class="rounded bg-slate-100 px-2.5 py-1 font-semibold text-slate-700 dark:bg-slate-800 dark:text-slate-300">
                  English + हिन्दी
                </span>
              </div>
            </div>

            <div class="mt-6 border-t border-slate-100 pt-4 dark:border-slate-800">
              <a
                href="/mock-test/rrb-ntpc/"
                class="flex w-full items-center justify-center rounded-xl bg-sky-600 py-3 text-sm font-bold text-white shadow transition hover:bg-sky-700 active:scale-95"
              >
                Open RRB NTPC Mock Test Hub →
              </a>
            </div>
          </div>

          {/* 2. SSC CGL Tier-1 */}
          <div class="relative flex flex-col justify-between overflow-hidden rounded-3xl border-2 border-indigo-500/40 bg-white p-6 shadow-md transition hover:border-indigo-500 hover:shadow-lg dark:border-indigo-500/30 dark:bg-slate-900">
            <div class="absolute right-4 top-4">
              <span class="rounded-full bg-emerald-100 px-3 py-1 text-xs font-bold text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">
                ● Live & Free
              </span>
            </div>

            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-indigo-600 dark:text-indigo-400">
                Staff Selection Commission
              </span>
              <h3 class="mt-1 text-2xl font-black text-slate-900 dark:text-white">
                SSC CGL Tier-1 Exam
              </h3>
              <p class="mt-2 text-xs text-slate-600 dark:text-slate-400">
                Official Staff Selection Commission Pattern: 100 questions, 60 minutes, 200 marks. Reasoning (25), GA (25), Quant (25), English (25). Exactly -0.50 negative marking.
              </p>

              <div class="mt-4 flex flex-wrap gap-2 text-xs">
                <span class="rounded bg-slate-100 px-2.5 py-1 font-semibold text-slate-700 dark:bg-slate-800 dark:text-slate-300">
                  Full 100-Q Mock (200 M)
                </span>
                <span class="rounded bg-slate-100 px-2.5 py-1 font-semibold text-slate-700 dark:bg-slate-800 dark:text-slate-300">
                  60 Mins · -0.50 Neg
                </span>
                <span class="rounded bg-slate-100 px-2.5 py-1 font-semibold text-slate-700 dark:bg-slate-800 dark:text-slate-300">
                  English + हिन्दी
                </span>
              </div>
            </div>

            <div class="mt-6 border-t border-slate-100 pt-4 dark:border-slate-800">
              <a
                href="/mock-test/ssc-cgl/"
                class="flex w-full items-center justify-center rounded-xl bg-indigo-600 py-3 text-sm font-bold text-white shadow transition hover:bg-indigo-700 active:scale-95"
              >
                Open SSC CGL Mock Test Hub →
              </a>
            </div>
          </div>

          {/* 3. SSC GD Constable */}
          <div class="relative flex flex-col justify-between overflow-hidden rounded-3xl border-2 border-emerald-500/40 bg-white p-6 shadow-md transition hover:border-emerald-500 hover:shadow-lg dark:border-emerald-500/30 dark:bg-slate-900">
            <div class="absolute right-4 top-4">
              <span class="rounded-full bg-emerald-100 px-3 py-1 text-xs font-bold text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">
                ● Live & Free
              </span>
            </div>

            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">
                Central Armed Police Forces & SSF
              </span>
              <h3 class="mt-1 text-2xl font-black text-slate-900 dark:text-white">
                SSC GD Constable CBT
              </h3>
              <p class="mt-2 text-xs text-slate-600 dark:text-slate-400">
                Official Revised Pattern: 80 questions, 60 minutes, 160 marks. Reasoning (20), GK/GA (20), Elementary Maths (20), Hindi/English (20). Strict -0.25 negative marking.
              </p>

              <div class="mt-4 flex flex-wrap gap-2 text-xs">
                <span class="rounded bg-slate-100 px-2.5 py-1 font-semibold text-slate-700 dark:bg-slate-800 dark:text-slate-300">
                  Full 80-Q Mock (160 M)
                </span>
                <span class="rounded bg-slate-100 px-2.5 py-1 font-semibold text-slate-700 dark:bg-slate-800 dark:text-slate-300">
                  60 Mins · -0.25 Neg
                </span>
                <span class="rounded bg-slate-100 px-2.5 py-1 font-semibold text-slate-700 dark:bg-slate-800 dark:text-slate-300">
                  English + हिन्दी
                </span>
              </div>
            </div>

            <div class="mt-6 border-t border-slate-100 pt-4 dark:border-slate-800">
              <a
                href="/mock-test/ssc-gd/"
                class="flex w-full items-center justify-center rounded-xl bg-emerald-600 py-3 text-sm font-bold text-white shadow transition hover:bg-emerald-700 active:scale-95"
              >
                Open SSC GD Mock Test Hub →
              </a>
            </div>
          </div>

          {/* 4. RRB Group D (RRC Level-1) */}
          <div class="relative flex flex-col justify-between overflow-hidden rounded-3xl border-2 border-amber-500/40 bg-white p-6 shadow-md transition hover:border-amber-500 hover:shadow-lg dark:border-amber-500/30 dark:bg-slate-900">
            <div class="absolute right-4 top-4">
              <span class="rounded-full bg-emerald-100 px-3 py-1 text-xs font-bold text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">
                ● Live & Free
              </span>
            </div>

            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-amber-600 dark:text-amber-400">
                Railway Recruitment Cells (RRC)
              </span>
              <h3 class="mt-1 text-2xl font-black text-slate-900 dark:text-white">
                RRB Group D (Level-1 Posts)
              </h3>
              <p class="mt-2 text-xs text-slate-600 dark:text-slate-400">
                Official RRC Pattern: 100 questions, 90 minutes, 100 marks. General Science (25), Mathematics (25), Reasoning (30), and General Awareness (20). Verified -1/3 negative marking.
              </p>

              <div class="mt-4 flex flex-wrap gap-2 text-xs">
                <span class="rounded bg-slate-100 px-2.5 py-1 font-semibold text-slate-700 dark:bg-slate-800 dark:text-slate-300">
                  Full 100-Q Mock (100 M)
                </span>
                <span class="rounded bg-slate-100 px-2.5 py-1 font-semibold text-slate-700 dark:bg-slate-800 dark:text-slate-300">
                  90 Mins · -1/3 Neg
                </span>
                <span class="rounded bg-slate-100 px-2.5 py-1 font-semibold text-slate-700 dark:bg-slate-800 dark:text-slate-300">
                  English + हिन्दी
                </span>
              </div>
            </div>

            <div class="mt-6 border-t border-slate-100 pt-4 dark:border-slate-800">
              <a
                href="/mock-test/rrb-group-d/"
                class="flex w-full items-center justify-center rounded-xl bg-amber-600 py-3 text-sm font-bold text-white shadow transition hover:bg-amber-700 active:scale-95"
              >
                Open RRB Group D Mock Test Hub →
              </a>
            </div>
          </div>
        </div>
      </div>

      {/* Cross-Link Back to Document Tools */}
      <div class="mt-16 rounded-3xl border border-sky-100 bg-sky-50/60 p-6 dark:border-sky-950 dark:bg-sky-950/20">
        <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center">
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-sky-700 dark:text-sky-300">
              Still Completing Your Application?
            </span>
            <h3 class="mt-1 text-lg font-bold text-slate-900 dark:text-white">
              Official RRB NTPC Signature & Photo Tools
            </h3>
            <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
              Resize your signature to 30–49 KB (280×160 px) and practice your live webcam photo upload according to CEN 06/2025 guidelines.
            </p>
          </div>
          <a
            href="/rrb-ntpc-signature-resize/"
            class="shrink-0 rounded-xl bg-white px-5 py-2.5 text-xs font-bold text-sky-800 shadow-sm hover:bg-sky-50 dark:bg-slate-800 dark:text-sky-200"
          >
            Open NTPC Signature Resizer →
          </a>
        </div>
      </div>
    </main>

    <Footer />
  </body>
</html>
