---
// src/pages/mock-test/rrb-ntpc/index.astro
import '../../../styles/global.css';
import '../../../styles/minimal-borders.css';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import GoogleAnalytics from '../../../components/GoogleAnalytics.astro';
import ThemeScript from '../../../components/ThemeScript.astro';
import { getNtpcTests } from '../../../data/mock-tests';

const tests = getNtpcTests();
const fullMocks = tests.filter(t => t.type === 'full');
const sectionals = tests.filter(t => t.type === 'sectional');

const pageTitle = "RRB NTPC CBT-1 Mock Test Free (No Login) — Real TCS iON Interface";
const pageDescription = "Practice official RRB NTPC CBT-1 mock tests free without login or mobile verification. 100 Qs, 90 mins, -1/3 negative marking, bilingual Hindi/English, and topic-wise weakness diagnosis.";
const canonicalUrl = "https://signresize.in/mock-test/rrb-ntpc/";
---

<!doctype html>
<html lang="en-IN" class="scroll-smooth">
  <head>
    <ThemeScript />
    <GoogleAnalytics />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- BreadcrumbList Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://signresize.in/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Mock Tests",
          "item": "https://signresize.in/mock-test/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "RRB NTPC CBT-1",
          "item": canonicalUrl
        }
      ]
    })} />
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-800 antialiased dark:bg-slate-950 dark:text-slate-100">
    <Header />

    <main class="mx-auto max-w-6xl px-4 py-8 sm:py-12">
      {/* Breadcrumb */}
      <nav class="mb-6 flex items-center gap-2 text-xs text-slate-500">
        <a href="/" class="hover:text-sky-600">Home</a>
        <span>/</span>
        <a href="/mock-test/" class="hover:text-sky-600">Mock Tests</a>
        <span>/</span>
        <span class="font-semibold text-slate-700 dark:text-slate-300">RRB NTPC CBT-1</span>
      </nav>

      {/* Header Banner */}
      <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8 dark:border-slate-800 dark:bg-slate-900">
        <div class="flex flex-col justify-between gap-4 md:flex-row md:items-center">
          <div>
            <div class="inline-flex items-center gap-2 rounded-full bg-sky-100 px-3 py-1 text-xs font-bold text-sky-800 dark:bg-sky-950 dark:text-sky-300">
              <span>Verified CEN 06/2025 Pattern</span>
              <span>·</span>
              <span>TCS iON CBT Simulator</span>
            </div>
            <h1 class="mt-3 text-2xl font-black text-slate-900 sm:text-4xl dark:text-white">
              RRB NTPC CBT-1 Mock Tests
            </h1>
            <p class="mt-2 text-xs leading-relaxed text-slate-600 sm:text-sm dark:text-slate-400">
              100 Questions · 90 Minutes · Exact 1/3 Negative Marking · Free, No Login, and Complete Bilingual Solutions.
            </p>
          </div>

          <a
            href="/mock-test/rrb-ntpc/cbt-1-mock-test-1/"
            class="inline-flex items-center justify-center rounded-xl bg-sky-600 px-6 py-3.5 text-sm font-bold text-white shadow-lg transition hover:bg-sky-500 active:scale-95"
          >
            Start Full Mock Test 1 →
          </a>
        </div>

        {/* Verified Official Pattern Table */}
        <div class="mt-8 overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800">
          <div class="bg-slate-100 px-4 py-2.5 text-xs font-bold text-slate-700 dark:bg-slate-800 dark:text-slate-200">
            Official Exam Pattern & Marking Scheme (CEN 06/2025 Clause 13.1)
          </div>
          <table class="w-full text-left text-xs">
            <thead class="border-b bg-white text-slate-500 dark:border-slate-800 dark:bg-slate-900">
              <tr>
                <th class="p-3">Section</th>
                <th class="p-3 text-center">Questions</th>
                <th class="p-3 text-center">Marks</th>
                <th class="p-3 text-center">Negative Marking</th>
                <th class="p-3 text-right">Time Allowed</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
              <tr>
                <td class="p-3 font-semibold text-slate-800 dark:text-white">General Awareness (GA)</td>
                <td class="p-3 text-center font-bold">40</td>
                <td class="p-3 text-center font-bold">40</td>
                <td class="p-3 text-center text-rose-600 font-bold">-0.33 (1/3 mark)</td>
                <td class="p-3 text-right text-slate-500" rowspan="3">
                  <div class="font-bold text-slate-800 dark:text-white">90 Minutes</div>
                  <div class="text-[10px] text-slate-400">(120m for PwBD)</div>
                </td>
              </tr>
              <tr>
                <td class="p-3 font-semibold text-slate-800 dark:text-white">Mathematics</td>
                <td class="p-3 text-center font-bold">30</td>
                <td class="p-3 text-center font-bold">30</td>
                <td class="p-3 text-center text-rose-600 font-bold">-0.33 (1/3 mark)</td>
              </tr>
              <tr>
                <td class="p-3 font-semibold text-slate-800 dark:text-white">General Intelligence & Reasoning</td>
                <td class="p-3 text-center font-bold">30</td>
                <td class="p-3 text-center font-bold">30</td>
                <td class="p-3 text-center text-rose-600 font-bold">-0.33 (1/3 mark)</td>
              </tr>
              <tr class="bg-slate-50 font-bold dark:bg-slate-800/60">
                <td class="p-3 text-slate-900 dark:text-white">Total</td>
                <td class="p-3 text-center">100</td>
                <td class="p-3 text-center">100</td>
                <td class="p-3 text-center text-rose-600">Strict -1/3 Deducted</td>
                <td class="p-3 text-right text-sky-600 dark:text-sky-400">Composite 90 Min</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      {/* Full Mock Tests Section */}
      <div class="mt-12">
        <h2 class="text-xl font-black text-slate-900 dark:text-white">
          Full-Length Mock Tests (100 Questions / 90 Minutes)
        </h2>
        <p class="mt-1 text-xs text-slate-500">
          Complete simulation of the CBT-1 stage with automatic scoring and diagnostic weakness reports.
        </p>

        <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
          {fullMocks.map((test) => (
            <div
              key={test.id}
              class="flex flex-col justify-between rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:border-sky-500/50 hover:shadow-md dark:border-slate-800 dark:bg-slate-900"
            >
              <div>
                <div class="flex items-center justify-between">
                  <span class="rounded-full bg-emerald-100 px-2.5 py-0.5 text-[10px] font-bold uppercase text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">
                    Full Exam Simulation
                  </span>
                  <span class="text-xs font-semibold text-slate-400">
                    ⏱️ 90 Minutes
                  </span>
                </div>

                <h3 class="mt-2 text-lg font-bold text-slate-900 dark:text-white">
                  {test.title.en}
                </h3>
                <p class="text-xs text-slate-500">
                  {test.title.hi}
                </p>

                <div class="mt-4 space-y-1 text-xs text-slate-600 dark:text-slate-400">
                  <p>• 100 questions (30 Maths / 30 Reasoning / 40 GA)</p>
                  <p>• Verified -1/3 negative marking</p>
                  <p>• Bilingual worked solutions included</p>
                </div>
              </div>

              <div class="mt-6 border-t border-slate-100 pt-4 dark:border-slate-800">
                <a
                  href={`/mock-test/rrb-ntpc/${test.slug}/`}
                  class="flex w-full items-center justify-center rounded-xl bg-sky-600 py-2.5 text-xs font-bold text-white shadow transition hover:bg-sky-700 active:scale-95"
                >
                  Start Mock Test (No Login) →
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>

      {/* Sectional Tests Section */}
      <div class="mt-12">
        <h2 class="text-xl font-black text-slate-900 dark:text-white">
          Subject-Wise Sectional Tests
        </h2>
        <p class="mt-1 text-xs text-slate-500">
          Target individual sections to build speed, accuracy, and confidence.
        </p>

        <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-3">
          {sectionals.map((test) => (
            <div
              key={test.id}
              class="flex flex-col justify-between rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-sky-500/50 hover:shadow-md dark:border-slate-800 dark:bg-slate-900"
            >
              <div>
                <span class="rounded-full bg-sky-100 px-2 py-0.5 text-[10px] font-bold uppercase text-sky-800 dark:bg-sky-950 dark:text-sky-300">
                  Sectional Test
                </span>
                <h3 class="mt-2 text-base font-bold text-slate-900 dark:text-white">
                  {test.title.en}
                </h3>
                <p class="mt-1 text-xs text-slate-500">
                  ⏱️ {test.durationMin} Minutes · {test.questions.length} Questions
                </p>
              </div>

              <div class="mt-6 border-t border-slate-100 pt-3 dark:border-slate-800">
                <a
                  href={`/mock-test/rrb-ntpc/${test.slug}/`}
                  class="flex w-full items-center justify-center rounded-lg bg-slate-800 py-2 text-xs font-bold text-white transition hover:bg-sky-600 active:scale-95 dark:bg-slate-700"
                >
                  Practice Section →
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>

      {/* Cross-Link Banner */}
      <div class="mt-16 rounded-3xl border border-sky-100 bg-sky-50/60 p-6 dark:border-sky-950 dark:bg-sky-950/20">
        <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center">
          <div>
            <h3 class="text-base font-bold text-slate-900 dark:text-white">
              Applying for RRB NTPC 2026?
            </h3>
            <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
              Prepare your application documents right before you take your exam.
            </p>
          </div>
          <div class="flex flex-wrap gap-2">
            <a
              href="/rrb-ntpc-signature-resize/"
              class="rounded-xl bg-white px-4 py-2 text-xs font-bold text-sky-800 shadow-sm hover:bg-sky-50 dark:bg-slate-800 dark:text-sky-200"
            >
              NTPC Signature Resizer (30–49 KB) →
            </a>
            <a
              href="/rrb-ntpc-undergraduate-document-guide/"
              class="rounded-xl border border-slate-200 bg-white px-4 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300"
            >
              NTPC Document Checklist →
            </a>
          </div>
        </div>
      </div>
    </main>

    <Footer />
  </body>
</html>
