---
// src/pages/layout-2.astro (Option 2: Pro Cockpit Dashboard Layout)
import '../styles/global.css';
import Header from '../components/Header.astro';
import LayoutComparisonBanner from '../components/LayoutComparisonBanner.astro';
import { SignatureTool } from '../components/SignatureTool';
import ExamSpecsTable from '../components/ExamSpecsTable.astro';
import GuideSection from '../components/GuideSection.astro';
import SeoContentSection from '../components/SeoContentSection.astro';
import FaqSection from '../components/FaqSection.astro';
import Footer from '../components/Footer.astro';

const pageTitle = "Option 2: Pro Cockpit Dashboard | Online Signature Resize (10 to 20 KB)";
const pageDescription = "Layout Option 2: Pro Cockpit Dashboard for SignResize. Full-width studio interface with instant preset bar and interactive tabbed documentation hub.";
const canonicalUrl = "https://signresize.com/layout-2";
const ogImageUrl = "https://signresize.com/og-image.png";
---

<!doctype html>
<html lang="en-IN" class="theme-emerald">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="noindex, follow" />

    <!-- Open Graph (OG) Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>

  <body class="bg-background text-foreground selection:bg-primary/20 selection:text-primary min-h-screen flex flex-col">
    <!-- Layout Comparison Banner -->
    <LayoutComparisonBanner activeOption="2" defaultTheme="theme-emerald" />

    <!-- Navigation Header -->
    <Header activeLayout="option2" />

    <!-- Main Cockpit Container -->
    <main class="flex-1 w-full max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-8">
      
      <!-- Option 2 Hero & Command Bar -->
      <section class="p-6 rounded-2xl border border-border bg-card/70 backdrop-blur shadow-sm space-y-4">
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
          <div class="space-y-1">
            <div class="flex items-center gap-2">
              <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-primary text-primary-foreground">
                Option 2: Pro Cockpit
              </span>
              <span class="text-xs text-muted-foreground font-mono">
                App-First Split-Screen Interface
              </span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-foreground">
              Pro Signature Resize Studio &amp; Compressor
            </h1>
            <p class="text-xs sm:text-sm text-muted-foreground max-w-2xl">
              High-density workspace engineered for rapid resizing. Crop to <strong>140×60 px, 10–20 KB</strong>, set dimensions in cm, and clean photo backgrounds with live compliance feedback.
            </p>
          </div>

          <!-- Quick Stats Badge -->
          <div class="flex items-center gap-3 shrink-0">
            <div class="px-3.5 py-2 rounded-xl bg-muted/60 border border-border text-center">
              <div class="text-[10px] uppercase font-bold text-muted-foreground">Privacy</div>
              <div class="text-xs font-bold text-emerald-600 dark:text-emerald-400">100% Client-Side</div>
            </div>
            <div class="px-3.5 py-2 rounded-xl bg-muted/60 border border-border text-center">
              <div class="text-[10px] uppercase font-bold text-muted-foreground">Compliance</div>
              <div class="text-xs font-bold text-primary font-mono">10 KB – 20 KB</div>
            </div>
            <div class="px-3.5 py-2 rounded-xl bg-muted/60 border border-border text-center">
              <div class="text-[10px] uppercase font-bold text-muted-foreground">Speed</div>
              <div class="text-xs font-bold text-cyan-600 dark:text-cyan-400">Zero Latency</div>
            </div>
          </div>
        </div>

        <!-- Quick-Launch Popular Exam Pills -->
        <div class="pt-2 border-t border-border/70 flex flex-wrap items-center gap-2 text-xs">
          <span class="font-semibold text-foreground text-[11px] uppercase tracking-wider pr-1">
            Quick Presets:
          </span>
          <a
            href="#tool-workspace"
            class="px-3 py-1 rounded-lg bg-muted hover:bg-primary/10 hover:text-primary border border-border transition font-medium"
          >
            SSC CGL / CHSL (140×60 px, 10-20 KB)
          </a>
          <a
            href="#tool-workspace"
            class="px-3 py-1 rounded-lg bg-muted hover:bg-primary/10 hover:text-primary border border-border transition font-medium"
          >
            PAN Card Signature (200 DPI, &lt;50 KB)
          </a>
          <a
            href="#tool-workspace"
            class="px-3 py-1 rounded-lg bg-muted hover:bg-primary/10 hover:text-primary border border-border transition font-medium"
          >
            RRB Railway NTPC (10-20 KB)
          </a>
          <a
            href="#tool-workspace"
            class="px-3 py-1 rounded-lg bg-muted hover:bg-primary/10 hover:text-primary border border-border transition font-medium"
          >
            Left Thumb Impression (3×3 cm)
          </a>
          <a
            href="#tool-workspace"
            class="px-3 py-1 rounded-lg bg-muted hover:bg-primary/10 hover:text-primary border border-border transition font-medium"
          >
            IBPS Bank PO / Clerk
          </a>
          <a
            href="#tool-workspace"
            class="px-3 py-1 rounded-lg bg-muted hover:bg-primary/10 hover:text-primary border border-border transition font-medium"
          >
            UPSC Civil Services (350×350 px)
          </a>
        </div>
      </section>

      <!-- Full-Width Workspace Shell -->
      <section id="tool-workspace" class="w-full">
        <SignatureTool client:load />
      </section>

      <!-- Option 2 Distinctive Feature: Tabbed Documentation Hub -->
      <!-- Instead of stacking 2000px of content, users can switch tabs directly -->
      <section class="space-y-4 pt-6">
        <div class="flex items-center justify-between">
          <div>
            <h2 class="text-xl font-bold tracking-tight text-foreground">
              Official Knowledge &amp; Guidelines Hub
            </h2>
            <p class="text-xs text-muted-foreground">
              Switch tabs to view official exam dimensions, rejection avoidance rules, or full aspirant guide.
            </p>
          </div>
        </div>

        <!-- Tab Navigation Bar -->
        <div class="flex flex-wrap gap-2 border-b border-border pb-2 text-xs font-semibold">
          <button
            type="button"
            class="tab-btn active px-4 py-2 rounded-xl bg-primary text-primary-foreground transition shadow-xs cursor-pointer"
            data-target="tab-specs"
          >
            Exam Specifications Table
          </button>
          <button
            type="button"
            class="tab-btn px-4 py-2 rounded-xl bg-muted text-muted-foreground hover:text-foreground hover:bg-muted/80 transition cursor-pointer"
            data-target="tab-guide"
          >
            Avoid Rejection Guide
          </button>
          <button
            type="button"
            class="tab-btn px-4 py-2 rounded-xl bg-muted text-muted-foreground hover:text-foreground hover:bg-muted/80 transition cursor-pointer"
            data-target="tab-seo"
          >
            Aspirant Guide (CM to Pixels &amp; DPI)
          </button>
          <button
            type="button"
            class="tab-btn px-4 py-2 rounded-xl bg-muted text-muted-foreground hover:text-foreground hover:bg-muted/80 transition cursor-pointer"
            data-target="tab-faq"
          >
            Frequently Asked Questions
          </button>
        </div>

        <!-- Tab Content Panels -->
        <div class="pt-2">
          <!-- Panel 1: Exam Specs Table -->
          <div id="tab-specs" class="tab-panel block">
            <ExamSpecsTable />
          </div>

          <!-- Panel 2: Avoid Rejection Guide -->
          <div id="tab-guide" class="tab-panel hidden">
            <GuideSection />
          </div>

          <!-- Panel 3: Aspirant SEO Guide -->
          <div id="tab-seo" class="tab-panel hidden">
            <SeoContentSection />
          </div>

          <!-- Panel 4: FAQs -->
          <div id="tab-faq" class="tab-panel hidden">
            <FaqSection />
          </div>
        </div>
      </section>

    </main>

    <!-- Global Footer -->
    <Footer />

    <!-- Client Script for Interactive Tabs -->
    <script is:inline>
      const tabButtons = document.querySelectorAll('.tab-btn');
      const tabPanels = document.querySelectorAll('.tab-panel');

      tabButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const targetId = btn.getAttribute('data-target');

          // Update active button classes
          tabButtons.forEach((b) => {
            b.classList.remove('bg-primary', 'text-primary-foreground', 'active');
            b.classList.add('bg-muted', 'text-muted-foreground');
          });
          btn.classList.add('bg-primary', 'text-primary-foreground', 'active');
          btn.classList.remove('bg-muted', 'text-muted-foreground');

          // Update visible panel
          tabPanels.forEach((panel) => {
            if (panel.id === targetId) {
              panel.classList.remove('hidden');
              panel.classList.add('block');
            } else {
              panel.classList.add('hidden');
              panel.classList.remove('block');
            }
          });
        });
      });
    </script>
  </body>
</html>
