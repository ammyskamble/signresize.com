---
// src/pages/uk/index.astro
import '../../styles/global.css';
import Header from '../../components/Header.astro';
import { SignatureTool } from '../../components/SignatureTool';
import FaqSection from '../../components/FaqSection.astro';
import Footer from '../../components/Footer.astro';
import GoogleAnalytics from '../../components/GoogleAnalytics.astro';
import GoogleFonts from '../../components/GoogleFonts.astro';
import ThemeScript from '../../components/ThemeScript.astro';

const pageTitle = "UK Visa & Passport Photo Resizer (UKVI, HM Passport Office, UCAS) - SignResize";
const pageDescription = "Free online UK Photo Resizer & Crop Tool. Resize images to 600x750 pixels (45x35 mm ratio), 50 KB to 6 MB, JPEG format for UK Visas and Immigration (UKVI), HM Passport Office digital renewals, and UCAS.";
const canonicalUrl = "https://signresize.in/uk/";
const ogImageUrl = "https://signresize.in/og-image.png";
const keywordsContent = "uk visa photo resizer, ukvi digital photo size 600x750, hm passport office photo resizer, ucas photo upload size, GOV.UK passport photo crop free, 45x35 mm photo resizer online, uk passport photo size in pixels";

const ukFaqs = [
  {
    q: "What are the exact digital photo dimensions required for UKVI visa applications?",
    a: "Your digital photo for UK Visas and Immigration (UKVI) must be a vertical orientation with minimum dimensions of 600 pixels wide by 750 pixels tall (45mm x 35mm aspect ratio). The file size must be between 50 KB and 6 MB in JPEG (.jpg) format."
  },
  {
    q: "What is the standard digital size for HM Passport Office online renewals?",
    a: "HM Passport Office digital passport renewals require a minimum pixel size of 600x750 pixels (45x35 mm aspect ratio) and a file size between 50 KB and 10 MB in JPEG format, taken against a plain light-colored or off-white background."
  },
  {
    q: "Can I wear eyeglasses or headwear in my UK visa or passport photo?",
    a: "Eyeglasses are strictly prohibited unless required for documented medical reasons. Head coverings are allowed only for daily religious or medical purposes, provided they do not obscure facial features from hairline to chin."
  },
  {
    q: "What are the UCAS student profile photo and document scan requirements?",
    a: "UCAS university applications and student visa verification portals require a passport-style headshot (600x750 pixels) and legibly compressed document scans (passports, IELTS, transcripts) under 2 MB in JPEG or PDF format."
  },
  {
    q: "Are my photos or identity documents stored on external servers?",
    a: "No. SignResize processes 100% of image crop and compression tasks locally inside your browser using HTML5 Canvas APIs. No images or identity data are ever uploaded to external servers."
  }
];
---

<!doctype html>
<html lang="en-GB" class="scroll-smooth">
  <head>
    <ThemeScript />
    <GoogleAnalytics />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={keywordsContent} />
    <meta name="author" content="SignResize.in" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph (OG) Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="SignResize" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Web Fonts & Favicons -->
    <GoogleFonts />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <meta name="theme-color" content="#4f46e5" />

    <!-- Schema.org WebApplication JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "SignResize UK - Official UKVI, HM Passport & UCAS Photo Resizer",
      "url": canonicalUrl,
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5 Canvas.",
      "inLanguage": "en-GB",
      "description": pageDescription,
      "featureList": [
        "UKVI Digital Visa Photo Resizer (600x750 px, 50KB-6MB)",
        "HM Passport Office Digital Photo Resizer (600x750 px)",
        "UCAS Student Photo & Document Scan Converter"
      ]
    })} />
  </head>

  <body class="min-h-screen bg-background text-foreground flex flex-col font-sans antialiased selection:bg-primary/20 selection:text-primary">
    <Header />

    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-8">
      <!-- UK Hero Header with Tools Interlinking Dropdown -->
      <section class="space-y-4">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div class="space-y-2">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/20">
              <span>🇬🇧 Official United Kingdom Standards (UKVI, GOV.UK, HM Passport, UCAS)</span>
            </div>
            <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-foreground">
              UK Visa &amp; Passport Photo Resizer <span class="text-primary">(600×750 px / 45×35 mm)</span>
            </h1>
            <p class="text-sm sm:text-base text-muted-foreground max-w-3xl">
              Free online tool to crop, format, and compress photographs to exact GOV.UK &amp; UKVI guidelines. Pre-configured for UK Visas &amp; Immigration, HM Passport Office digital renewals, and UCAS college uploads.
            </p>
          </div>
        </div>

        <!-- UK Tools Interlinking Dropdown Selector Bar -->
        <div class="p-3 rounded-2xl bg-card border border-border flex flex-col sm:flex-row sm:items-center justify-between gap-3 shadow-2xs">
          <div class="flex items-center gap-2">
            <span class="text-lg">🛠️</span>
            <div>
              <div class="text-xs font-bold text-foreground">UK Tools Quick Switch Dropdown:</div>
              <div class="text-[11px] text-muted-foreground">Jump directly to dedicated UK tool pages</div>
            </div>
          </div>

          <div class="relative group">
            <button
              type="button"
              class="w-full sm:w-auto inline-flex items-center justify-between gap-3 px-4 py-2 rounded-xl bg-primary/10 hover:bg-primary/20 text-primary text-xs font-bold transition border border-primary/20 cursor-pointer"
            >
              <span class="flex items-center gap-2">
                <span>🇬🇧 Select UK Dedicated Tool</span>
              </span>
              <svg class="w-4 h-4 transition-transform group-hover:rotate-180 opacity-70" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </button>

            <div class="invisible group-hover:visible opacity-0 group-hover:opacity-100 transition-all duration-150 absolute right-0 top-full mt-1.5 w-72 bg-white dark:bg-slate-900 rounded-2xl shadow-2xl border-2 border-slate-200 dark:border-slate-700 p-2 z-50 space-y-1">
              <a href="/uk/ukvi-visa-photo-resizer/" class="flex items-center gap-2.5 p-2 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 transition text-xs font-semibold text-foreground group/item">
                <span class="text-base p-1 rounded bg-blue-500/10 text-blue-600">🇬🇧</span>
                <div>
                  <div class="group-hover/item:text-primary">UKVI Digital Visa Photo</div>
                  <div class="text-[10px] text-muted-foreground font-normal">600×750 px | 50 KB – 6 MB</div>
                </div>
              </a>
              <a href="/uk/hm-passport-photo-resizer/" class="flex items-center gap-2.5 p-2 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 transition text-xs font-semibold text-foreground group/item">
                <span class="text-base p-1 rounded bg-indigo-500/10 text-indigo-600">🛂</span>
                <div>
                  <div class="group-hover/item:text-primary">HM Passport Office Digital</div>
                  <div class="text-[10px] text-muted-foreground font-normal">600×750 px | GOV.UK Renewals</div>
                </div>
              </a>
              <a href="/uk/ucas-photo-resizer/" class="flex items-center gap-2.5 p-2 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 transition text-xs font-semibold text-foreground group/item">
                <span class="text-base p-1 rounded bg-rose-500/10 text-rose-600">🎓</span>
                <div>
                  <div class="group-hover/item:text-primary">UCAS Photo &amp; Document Upload</div>
                  <div class="text-[10px] text-muted-foreground font-normal">UK Admissions (&lt;2 MB)</div>
                </div>
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- Resizer Studio Workspace preloaded with UKVI Preset -->
      <section id="tool-workspace" class="scroll-mt-20">
        <SignatureTool client:load initialPresetId="uk-ukvi" />
      </section>

      <!-- 3 Dedicated UK Tool Cards Grid -->
      <section class="space-y-4">
        <div class="border-b border-border/80 pb-3">
          <h2 class="text-xl font-bold text-foreground flex items-center gap-2">
            <span>🛠️</span>
            <span>Dedicated United Kingdom Photo &amp; Document Tools</span>
          </h2>
          <p class="text-xs sm:text-sm text-muted-foreground">
            Select a specialized tool tailored with precise GOV.UK aspect ratios, pixel targets, and KB limits.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <!-- Tool 1: UKVI -->
          <a
            href="/uk/ukvi-visa-photo-resizer/"
            class="group p-5 rounded-2xl bg-card border border-border hover:border-primary/50 hover:shadow-xl transition-all flex flex-col justify-between space-y-3"
          >
            <div class="space-y-2">
              <div class="w-10 h-10 rounded-xl bg-blue-500/10 text-blue-600 dark:text-blue-400 flex items-center justify-center text-xl font-bold">
                🇬🇧
              </div>
              <h3 class="font-bold text-base text-foreground group-hover:text-primary transition">
                UKVI Visa Photo Resizer
              </h3>
              <p class="text-xs text-muted-foreground leading-relaxed">
                Crop &amp; format digital photo for UK Visas and Immigration to 600×750 px (45×35 mm ratio), 50 KB–6 MB.
              </p>
            </div>
            <div class="pt-2 border-t border-border/60 flex items-center justify-between text-xs font-bold text-primary">
              <span>Use UKVI Tool</span>
              <span class="group-hover:translate-x-1 transition-transform">→</span>
            </div>
          </a>

          <!-- Tool 2: HM Passport Office -->
          <a
            href="/uk/hm-passport-photo-resizer/"
            class="group p-5 rounded-2xl bg-card border border-border hover:border-primary/50 hover:shadow-xl transition-all flex flex-col justify-between space-y-3"
          >
            <div class="space-y-2">
              <div class="w-10 h-10 rounded-xl bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 flex items-center justify-center text-xl font-bold">
                🛂
              </div>
              <h3 class="font-bold text-base text-foreground group-hover:text-primary transition">
                HM Passport Office Resizer
              </h3>
              <p class="text-xs text-muted-foreground leading-relaxed">
                Format digital passport photo to 600×750 px, plain light gray background, for online GOV.UK passport renewals.
              </p>
            </div>
            <div class="pt-2 border-t border-border/60 flex items-center justify-between text-xs font-bold text-primary">
              <span>Use HM Passport Tool</span>
              <span class="group-hover:translate-x-1 transition-transform">→</span>
            </div>
          </a>

          <!-- Tool 3: UCAS -->
          <a
            href="/uk/ucas-photo-resizer/"
            class="group p-5 rounded-2xl bg-card border border-border hover:border-primary/50 hover:shadow-xl transition-all flex flex-col justify-between space-y-3"
          >
            <div class="space-y-2">
              <div class="w-10 h-10 rounded-xl bg-rose-500/10 text-rose-600 dark:text-rose-400 flex items-center justify-center text-xl font-bold">
                🎓
              </div>
              <h3 class="font-bold text-base text-foreground group-hover:text-primary transition">
                UCAS Photo &amp; Document Resizer
              </h3>
              <p class="text-xs text-muted-foreground leading-relaxed">
                Resize student profile headshots and compress passport scan documents (&lt;2 MB) for UK University admissions.
              </p>
            </div>
            <div class="pt-2 border-t border-border/60 flex items-center justify-between text-xs font-bold text-primary">
              <span>Use UCAS Tool</span>
              <span class="group-hover:translate-x-1 transition-transform">→</span>
            </div>
          </a>
        </div>
      </section>

      <!-- 800 - 1200 WORDS COMPREHENSIVE UK SEO EDITORIAL GUIDE -->
      <article id="uk-seo-editorial-guide" class="space-y-8 pt-6 border-t border-border text-foreground">
        <div class="max-w-3xl space-y-2">
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-primary/10 text-primary border border-primary/20">
            Official UK Aspirants &amp; Applicants Guide
          </div>
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-foreground">
            Complete Technical Guide to UK Visas (UKVI), HM Passport Office &amp; UCAS Photo Specifications
          </h2>
          <p class="text-sm text-muted-foreground leading-relaxed">
            Everything you need to know about preparing compliant digital photographs and document scans for GOV.UK, UK Visas and Immigration (UKVI), HM Passport Office online renewals, and UCAS university admissions.
          </p>
        </div>

        <div class="space-y-6 text-sm leading-relaxed text-muted-foreground">
          <!-- Section 1 -->
          <section class="space-y-3 bg-card p-6 rounded-2xl border border-border">
            <h3 class="text-lg font-bold text-foreground flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-primary"></span>
              Why GOV.UK Portals Reject Self-Submitted Digital Photographs
            </h3>
            <p>
              When applying for a UK visa (Student Visa, Skilled Worker Visa, Youth Mobility, Visitor Visa) via <strong>UK Visas and Immigration (UKVI)</strong> or renewing a British passport online through <strong>HM Passport Office (GOV.UK)</strong>, uploading a non-compliant photo is the leading cause of application rejection and processing delays.
            </p>
            <p>
              The UK Government's automated facial recognition verification system scans uploaded JPEG files against strict biometric criteria: 4:5 vertical aspect ratio (minimum 600×750 pixels), file weight boundaries (50 KB to 6 MB for UKVI, up to 10 MB for passport renewals), plain light-gray or off-white background without shadows, and total prohibition of eyeglasses or glare.
            </p>
          </section>

          <!-- Section 2 -->
          <section class="space-y-3 bg-card p-6 rounded-2xl border border-border">
            <h3 class="text-lg font-bold text-foreground flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-primary"></span>
              1. UKVI Digital Visa Photo Specifications (600×750 px)
            </h3>
            <p>
              Applying for a UK visa online via the official GOV.UK UKVI portal mandates the following technical photo parameters:
            </p>
            <ul class="list-disc pl-5 space-y-1.5 text-xs sm:text-sm text-foreground/90">
              <li><strong>Dimensions:</strong> Minimum 600 pixels wide by 750 pixels tall (vertical 4:5 aspect ratio representing 45mm height × 35mm width).</li>
              <li><strong>File Size Limit:</strong> Must be between 50 KB and 6 MB in JPEG (`.jpg` / `.jpeg`) format.</li>
              <li><strong>Framing &amp; Position:</strong> Shows head, shoulders, and upper body facing forward directly into the camera with neutral expression.</li>
              <li><strong>Glasses &amp; Headwear:</strong> Eyeglasses are not permitted. Head coverings allowed only for daily religious or medical purposes without casting shadows over the face.</li>
              <li><strong>Background:</strong> Plain, light-colored background (light gray or cream) with no objects or shadows behind.</li>
            </ul>
            <p class="text-xs bg-muted/50 p-3 rounded-xl border border-border">
              Use our <a href="/uk/ukvi-visa-photo-resizer/" class="text-primary underline font-bold">UKVI Visa Photo Resizer</a> to automatically lock 600×750 px dimensions and tune file size under 6 MB.
            </p>
          </section>

          <!-- Section 3 -->
          <section class="space-y-3 bg-card p-6 rounded-2xl border border-border">
            <h3 class="text-lg font-bold text-foreground flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-primary"></span>
              2. HM Passport Office Digital Renewal Guidelines
            </h3>
            <p>
              For British citizens renewing a passport online via GOV.UK, photos can be taken using a smartphone or retrieved using a digital photo code from photo booths. Digital uploads must conform to the following specifications:
            </p>
            <div class="overflow-x-auto rounded-xl border border-border">
              <table class="w-full text-left text-xs">
                <thead class="bg-muted/80 text-foreground font-bold border-b border-border">
                  <tr>
                    <th class="py-2.5 px-3">Parameter</th>
                    <th class="py-2.5 px-3">HM Passport Office Requirement</th>
                    <th class="py-2.5 px-3">SignResize Preset</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-border/60">
                  <tr>
                    <td class="py-2 px-3 font-semibold text-foreground">Pixel Resolution</td>
                    <td class="py-2 px-3 font-mono">Minimum 600 × 750 px</td>
                    <td class="py-2 px-3 font-mono text-primary font-bold">600 × 750 px (300 DPI)</td>
                  </tr>
                  <tr>
                    <td class="py-2 px-3 font-semibold text-foreground">File Size Range</td>
                    <td class="py-2 px-3 font-mono">50 KB to 10 MB</td>
                    <td class="py-2 px-3 font-mono text-primary font-bold">Auto-optimized in 50KB–10MB range</td>
                  </tr>
                  <tr>
                    <td class="py-2 px-3 font-semibold text-foreground">Aspect Ratio</td>
                    <td class="py-2 px-3 font-mono">4:5 Vertical Aspect Ratio (45×35 mm)</td>
                    <td class="py-2 px-3 font-mono text-primary font-bold">Locked 4:5 Crop Overlay</td>
                  </tr>
                  <tr>
                    <td class="py-2 px-3 font-semibold text-foreground">Recency</td>
                    <td class="py-2 px-3 font-mono">Taken within the last 1 month</td>
                    <td class="py-2 px-3 font-mono text-primary font-bold">100% compliant rendering</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </section>

          <!-- Section 4 -->
          <section class="space-y-3 bg-card p-6 rounded-2xl border border-border">
            <h3 class="text-lg font-bold text-foreground flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-primary"></span>
              3. UCAS Student Profile &amp; Document Scan Upload Rules
            </h3>
            <p>
              Students applying to UK universities via **UCAS (Universities and Colleges Admissions Service)** require passport-style headshots for student ID cards and Tier 4 / Student Visa verification tabs. Additionally, scans of international passports, English language proficiency test certificates (IELTS/PTE), and academic transcripts must be compressed under 2 MB for portal uploads.
            </p>
            <p>
              Use our <a href="/uk/ucas-photo-resizer/" class="text-primary underline font-bold">UCAS Photo &amp; Document Resizer</a> to crop student photos to 600×750 pixels and compress legal documents under 2 MB cleanly.
            </p>
          </section>

          <!-- Section 5 -->
          <section class="space-y-3 bg-card p-6 rounded-2xl border border-border">
            <h3 class="text-lg font-bold text-foreground flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-primary"></span>
              How SignResize Guarantees 100% Client-Side Privacy
            </h3>
            <p>
              SignResize processes 100% of image rendering locally inside your web browser using HTML5 Canvas technology. No photographs, facial scans, or legal documents are ever uploaded or saved on external servers.
            </p>
          </section>
        </div>
      </article>

      <!-- Specifications Guide & FAQs -->
      <section class="space-y-6">
        <FaqSection faqs={ukFaqs} title="Frequently Asked Questions (UK Photo Specifications)" />
      </section>
    </main>

    <Footer />
  </body>
</html>
