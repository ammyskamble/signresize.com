---
// src/pages/uk/ucas-photo-resizer.astro
import '../../styles/global.css';
import Header from '../../components/Header.astro';
import { SignatureTool } from '../../components/SignatureTool';
import FaqSection from '../../components/FaqSection.astro';
import Footer from '../../components/Footer.astro';
import GoogleAnalytics from '../../components/GoogleAnalytics.astro';
import GoogleFonts from '../../components/GoogleFonts.astro';
import ThemeScript from '../../components/ThemeScript.astro';

const pageTitle = "UCAS Photo & Document Resizer (UK College Uploads) - SignResize";
const pageDescription = "Free UCAS student photo and document scan resizer. Crop student profile headshots, passport scans, and transcripts to <2 MB for UK university admissions via UCAS.";
const canonicalUrl = "https://signresize.in/uk/ucas-photo-resizer/";
const ogImageUrl = "https://signresize.in/og-image.png";
const keywordsContent = "ucas photo resizer, ucas student upload size limit, uk college application photo size, compress passport scan for ucas, ucas document compressor online free";

const ucasFaqs = [
  {
    q: "Does UCAS require a specific student photo size?",
    a: "UCAS university portals and student visa verification sections recommend a standard passport-style headshot measuring 600x750 pixels (45x35 mm aspect ratio) in JPEG format under 2 MB."
  },
  {
    q: "How to fix UCAS document upload size errors for transcripts and passports?",
    a: "If your scanned transcript or passport copy exceeds the portal limit (typically 2 MB), use SignResize to adjust resolution and compress file size cleanly without losing text legibility."
  },
  {
    q: "What resolution is recommended for UK university application scans?",
    a: "A resolution of 300 DPI is recommended for passport scans and academic transcripts to ensure all official stamps and signatures remain clear."
  }
];
---

<!doctype html>
<html lang="en-GB" class="scroll-smooth">
  <head>
    <ThemeScript />
    <GoogleAnalytics />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={keywordsContent} />
    <meta name="author" content="SignResize.in" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph (OG) Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="SignResize" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Web Fonts & Favicons -->
    <GoogleFonts />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <meta name="theme-color" content="#4f46e5" />

    <!-- Schema.org SoftwareApplication & HowTo JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": ["SoftwareApplication", "WebApplication"],
      "name": "UCAS Student Photo & Document Resizer",
      "url": canonicalUrl,
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "All",
      "description": pageDescription,
      "featureList": [
        "Resize student headshots for UCAS portals",
        "Compress passport & transcript scans under 2 MB",
        "Export in compliant JPEG format",
        "100% private browser Canvas processing"
      ]
    })} />
  </head>

  <body class="min-h-screen bg-background text-foreground flex flex-col font-sans antialiased selection:bg-primary/20 selection:text-primary">
    <Header />

    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-8">
      <!-- Breadcrumb Navigation -->
      <nav class="flex items-center gap-2 text-xs text-muted-foreground">
        <a href="/" class="hover:text-primary transition">Home</a>
        <span>/</span>
        <a href="/uk/" class="hover:text-primary transition">UK Hub</a>
        <span>/</span>
        <span class="text-foreground font-semibold">UCAS Photo &amp; Scan Resizer</span>
      </nav>

      <!-- Page Hero Header -->
      <section class="space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div class="space-y-1.5">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/20">
              <span>🎓 UCAS &amp; UK University Admissions Uploads</span>
            </div>
            <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-foreground">
              UCAS Photo &amp; Document Resizer <span class="text-primary">(&lt;2 MB Uploads)</span>
            </h1>
            <p class="text-sm sm:text-base text-muted-foreground max-w-3xl">
              Format your student headshots, passport scans, and academic transcripts for UK university applications via UCAS. Crop image dimensions and compress file sizes instantly.
            </p>
          </div>

          <!-- Quick Switch UK Tools Dropdown -->
          <div class="relative group shrink-0">
            <button
              type="button"
              class="inline-flex items-center justify-between gap-2 px-3.5 py-2 rounded-xl bg-card border border-border hover:border-primary/50 text-foreground text-xs font-bold shadow-2xs transition cursor-pointer"
            >
              <span>🇬🇧 Switch UK Tool</span>
              <svg class="w-4 h-4 text-muted-foreground transition-transform group-hover:rotate-180" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </button>
            <div class="invisible group-hover:visible opacity-0 group-hover:opacity-100 transition-all duration-150 absolute right-0 top-full mt-1 w-64 bg-white dark:bg-slate-900 rounded-2xl shadow-xl border border-border p-2 z-50 space-y-1">
              <a href="/uk/ukvi-visa-photo-resizer/" class="flex items-center gap-2 p-2 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 text-xs font-medium text-foreground">
                <span>🇬🇧 UKVI Digital Visa Photo</span>
              </a>
              <a href="/uk/hm-passport-photo-resizer/" class="flex items-center gap-2 p-2 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 text-xs font-medium text-foreground">
                <span>🛂 HM Passport Office Digital</span>
              </a>
              <a href="/uk/ucas-photo-resizer/" class="flex items-center gap-2 p-2 rounded-xl bg-primary/10 text-primary text-xs font-bold">
                <span>🎓 UCAS Photo Upload</span>
              </a>
              <a href="/uk/" class="flex items-center justify-between p-2 rounded-xl bg-slate-100 dark:bg-slate-800 text-xs font-bold text-primary mt-1">
                <span>Explore All UK Hub</span>
                <span>→</span>
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- Resizer Studio Tool Workspace initialized with UCAS Preset -->
      <section id="tool-workspace" class="scroll-mt-20">
        <SignatureTool client:load initialPresetId="uk-ucas" />
      </section>

      <!-- Guidelines & Cross Interlinking -->
      <section class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="md:col-span-2 space-y-4 bg-card border border-border p-6 rounded-2xl">
          <h2 class="text-xl font-bold text-foreground">
            UCAS Upload Optimization Guidelines
          </h2>
          <ul class="space-y-2.5 text-xs sm:text-sm text-muted-foreground">
            <li class="flex items-start gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span><strong>Headshots:</strong> 600 × 750 pixels, high resolution, plain lighting.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span><strong>Passport Scans:</strong> Clear legal scan compressed under 2 MB limit.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span><strong>Format:</strong> JPEG / JPG image format.</span>
            </li>
          </ul>
        </div>

        <!-- Cross Interlinking Box -->
        <div class="space-y-4 bg-primary/5 border border-primary/20 p-6 rounded-2xl">
          <h3 class="text-base font-bold text-foreground">Related UK Tools</h3>
          <div class="space-y-2 text-xs">
            <a href="/uk/ukvi-visa-photo-resizer/" class="block p-2.5 rounded-xl bg-card border border-border hover:border-primary transition font-medium text-foreground">
              🇬🇧 UKVI Digital Visa Photo Resizer →
            </a>
            <a href="/uk/hm-passport-photo-resizer/" class="block p-2.5 rounded-xl bg-card border border-border hover:border-primary transition font-medium text-foreground">
              🛂 HM Passport Office Digital Resizer →
            </a>
            <a href="/uk/" class="block p-2.5 rounded-xl bg-primary text-primary-foreground text-center font-bold hover:opacity-90 transition mt-2">
              Back to UK Tools Hub →
            </a>
          </div>
        </div>
      </section>

      <!-- FAQ Section -->
      <section class="space-y-6">
        <FaqSection faqs={ucasFaqs} title="UCAS Photo Upload FAQs" />
      </section>
    </main>

    <Footer />
  </body>
</html>
