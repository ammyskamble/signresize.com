---
// src/pages/contact.astro - Contact Us
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const pageTitle = "Contact Us | SignResize.in";
const pageDescription = "Contact the SignResize.in team for support, feature suggestions, new exam portal specifications, feedback, or grievance queries.";
---

<!doctype html>
<html lang="en-IN" class="scroll-smooth">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-1N3EF3HFPH"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-1N3EF3HFPH');
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href="https://signresize.in/contact" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- Favicon & PWA Icons -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="SignResize" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="min-h-screen flex flex-col bg-background text-foreground antialiased selection:bg-primary/20 selection:text-primary">
    <Header />

    <main class="flex-1 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-10">
      
      <!-- Page Header -->
      <div class="border-b border-border pb-6 space-y-2">
        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-foreground">
          Contact Us
        </h1>
        <p class="text-sm sm:text-base text-muted-foreground leading-relaxed">
          Have a question, feedback, or want to report updated exam guidelines? We’d love to hear from you.
        </p>
      </div>

      <!-- Contact Info & Channels Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <div class="p-5 rounded-2xl border border-border bg-card shadow-xs space-y-2">
          <div class="w-8 h-8 rounded-xl bg-primary/10 text-primary flex items-center justify-center font-bold text-base">
            📧
          </div>
          <h3 class="font-bold text-foreground text-sm">General Support</h3>
          <p class="text-xs text-muted-foreground leading-relaxed">
            For assistance using the tool or technical inquiries:
          </p>
          <div class="font-mono text-xs font-semibold text-primary">
            support@signresize.in
          </div>
        </div>

        <div class="p-5 rounded-2xl border border-border bg-card shadow-xs space-y-2">
          <div class="w-8 h-8 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold text-base">
            📋
          </div>
          <h3 class="font-bold text-foreground text-sm">Exam Specs &amp; Updates</h3>
          <p class="text-xs text-muted-foreground leading-relaxed">
            Suggest a new competitive exam preset or report size changes:
          </p>
          <div class="font-mono text-xs font-semibold text-primary">
            specs@signresize.in
          </div>
        </div>

        <div class="p-5 rounded-2xl border border-border bg-card shadow-xs space-y-2">
          <div class="w-8 h-8 rounded-xl bg-purple-500/10 text-purple-600 dark:text-purple-400 flex items-center justify-center font-bold text-base">
            🛡️
          </div>
          <h3 class="font-bold text-foreground text-sm">Privacy &amp; Legal</h3>
          <p class="text-xs text-muted-foreground leading-relaxed">
            For privacy inquiries, DMCA, and legal questions:
          </p>
          <div class="font-mono text-xs font-semibold text-primary">
            legal@signresize.in
          </div>
        </div>

      </div>

      <!-- Interactive Contact / Message Form -->
      <div class="p-6 sm:p-8 rounded-2xl border border-border bg-card shadow-sm space-y-6">
        <div>
          <h2 class="text-lg font-bold text-foreground">Send Us a Direct Message</h2>
          <p class="text-xs text-muted-foreground mt-1">
            Our support team typically responds within 24 to 48 business hours.
          </p>
        </div>

        <form class="space-y-4 text-xs" onsubmit="event.preventDefault(); alert('Thank you for contacting SignResize.in! We have received your message and will respond shortly.');">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="space-y-1.5">
              <label for="name" class="font-semibold text-foreground">Your Name</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                placeholder="e.g., Rahul Sharma"
                class="w-full px-3.5 py-2.5 rounded-xl border border-border bg-background text-foreground focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition"
              />
            </div>

            <div class="space-y-1.5">
              <label for="email" class="font-semibold text-foreground">Your Email Address</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="name@example.com"
                class="w-full px-3.5 py-2.5 rounded-xl border border-border bg-background text-foreground focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition"
              />
            </div>
          </div>

          <div class="space-y-1.5">
            <label for="subject" class="font-semibold text-foreground">Subject / Exam Category</label>
            <input
              type="text"
              id="subject"
              name="subject"
              required
              placeholder="e.g., SSC GD 2026 Signature Dimension Query"
              class="w-full px-3.5 py-2.5 rounded-xl border border-border bg-background text-foreground focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition"
            />
          </div>

          <div class="space-y-1.5">
            <label for="message" class="font-semibold text-foreground">Your Message or Feedback</label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              placeholder="Describe your question or suggestion in detail..."
              class="w-full px-3.5 py-2.5 rounded-xl border border-border bg-background text-foreground focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition"
            ></textarea>
          </div>

          <button
            type="submit"
            class="px-6 py-3 rounded-xl bg-primary text-primary-foreground font-bold hover:opacity-90 transition shadow-md shadow-primary/25"
          >
            Send Message →
          </button>
        </form>
      </div>

    </main>

    <Footer />
  </body>
</html>
