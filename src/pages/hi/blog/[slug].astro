---
// src/pages/hi/blog/[slug].astro
import '../../../styles/global.css';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import GoogleAnalytics from '../../../components/GoogleAnalytics.astro';
import GoogleFonts from '../../../components/GoogleFonts.astro';
import ThemeScript from '../../../components/ThemeScript.astro';
import SocialShare from '../../../components/SocialShare.astro';
import { BLOG_POSTS, type BlogPost, getBlogPostTitle, getBlogPostExcerpt, getBlogPostContent } from '../../../data/blogPostsData';
import { EXAM_PRESETS } from '../../../data/examPresets';
import { EXAM_PAGES_DATA } from '../../../data/examPagesData';

export function getStaticPaths() {
  return BLOG_POSTS.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;

const translatedTitle = getBlogPostTitle(post, 'hi');
const translatedExcerpt = getBlogPostExcerpt(post, 'hi');
const translatedContent = getBlogPostContent(post, 'hi');

const pageTitle = post.metaTitle_hi || `${translatedTitle} | SignResize हिंदी`;
const pageDescription = post.metaDescription_hi || translatedExcerpt;
const canonicalUrl = `https://signresize.in/hi/blog/${post.slug}/`;

const relatedPreset = post.relatedExamPreset
  ? EXAM_PRESETS.find(p => p.id === post.relatedExamPreset)
  : null;

let relatedExamSlug = 'ssc-signature-resize';
if (post.country === 'BD') relatedExamSlug = 'teletalk-photo-signature-resize';
else if (post.country === 'PK') relatedExamSlug = 'ppsc-signature-resize';
else if (post.country === 'PH') relatedExamSlug = 'prc-photo-signature-resize-philippines';
else if (post.country === 'NP') relatedExamSlug = 'lok-sewa-photo-resize-nepal';
else if (post.relatedExamPreset) {
  const matchedPage = EXAM_PAGES_DATA.find(p => p.presetId === post.relatedExamPreset || p.slug === post.relatedExamPreset);
  if (matchedPage) relatedExamSlug = matchedPage.slug;
}

const scoredPosts = BLOG_POSTS.filter(p => p.slug !== post.slug).map(other => {
  let score = 0;
  if (other.category === post.category) score += 3;
  if (other.relatedExamPreset && post.relatedExamPreset && other.relatedExamPreset === post.relatedExamPreset) score += 5;
  return { post: other, score };
});

scoredPosts.sort((a, b) => b.score - a.score);
const relatedPosts = scoredPosts.slice(0, 3).map(s => s.post);
---

<!doctype html>
<html lang="hi" class="scroll-smooth">
  <head>
    <ThemeScript />
    <GoogleAnalytics />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="SignResize" />
    <link rel="manifest" href="/site.webmanifest" />
    <GoogleFonts />

    <!-- Open Graph -->
    <meta property="og:type" content="article" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="SignResize" />
  </head>

  <body class="min-h-screen flex flex-col bg-background text-foreground antialiased selection:bg-primary/20 selection:text-primary">
    <Header />

    <main class="flex-1 max-w-4xl mx-auto px-3 sm:px-6 lg:px-8 py-4 sm:py-8 space-y-6 w-full min-w-0 overflow-x-hidden">
      
      <!-- Top Navigation & Language Switcher Bar -->
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-border/60 pb-3">
        <nav class="flex flex-wrap items-center gap-1.5 text-xs text-muted-foreground" aria-label="Breadcrumb">
          <a href="/hi/" class="hover:text-primary transition flex items-center gap-1">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
            होम
          </a>
          <span>/</span>
          <a href="/hi/blog/" class="hover:text-primary transition">हिंदी ब्लॉग</a>
          <span>/</span>
          <span class="text-foreground font-medium truncate max-w-[200px]">{translatedTitle}</span>
        </nav>

        <!-- Dynamic Language Switcher Bar -->
        <div class="flex items-center gap-1.5 text-xs bg-muted/60 p-1 rounded-xl border border-border/60">
          <span class="text-[10px] font-bold uppercase tracking-wider text-muted-foreground px-2">📖 भाषा बदले:</span>
          <a href={`/blog/${post.slug}/`} class="px-2.5 py-1 rounded-lg hover:bg-card text-muted-foreground hover:text-foreground font-medium transition">🇬🇧 English</a>
          <a href={`/hi/blog/${post.slug}/`} class="px-2.5 py-1 rounded-lg bg-primary text-primary-foreground font-bold shadow-2xs">🇮🇳 हिंदी</a>
          <a href={`/mr/blog/${post.slug}/`} class="px-2.5 py-1 rounded-lg hover:bg-card text-muted-foreground hover:text-foreground font-medium transition">🚩 मराठी</a>
        </div>
      </div>

      <!-- Article Header -->
      <article class="space-y-6">
        <header class="space-y-3">
          <div class="flex flex-wrap items-center gap-2 text-xs">
            <span class="px-2.5 py-0.5 rounded-full font-bold bg-primary/10 text-primary border border-primary/20">{post.category}</span>
            <span class="text-muted-foreground font-mono">• {post.publishDate}</span>
            <span class="text-muted-foreground font-mono">• {post.readTime_hi || post.readTime}</span>
          </div>

          <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-foreground tracking-tight leading-tight">
            {translatedTitle}
          </h1>

          <p class="text-sm sm:text-base text-muted-foreground leading-relaxed italic border-l-4 border-primary/40 pl-3 py-1 bg-muted/20 rounded-r-xl">
            {translatedExcerpt}
          </p>

          <div class="flex items-center justify-between pt-2 text-xs border-t border-border/60">
            <div class="flex items-center gap-2">
              <span class="font-bold text-foreground">{post.author}</span>
              <span class="text-muted-foreground">• {post.authorRole_hi || post.authorRole}</span>
            </div>
            <SocialShare title={translatedTitle} url={canonicalUrl} />
          </div>
        </header>

        <!-- Fast Tool Callout Banner -->
        <div class="p-4 rounded-2xl bg-gradient-to-r from-card to-primary/10 border border-primary/30 flex flex-col sm:flex-row items-center justify-between gap-3 shadow-xs">
          <div>
            <h3 class="font-bold text-sm text-foreground">क्या आपको फोटो या हस्ताक्षर रिसाइझ करना है?</h3>
            <p class="text-xs text-muted-foreground">100% मुफ्त और सुरक्षित - बिना किसी सर्वर अपलोड के तुरंत आकार बदलें।</p>
          </div>
          <a href={`/${relatedExamSlug}/`} class="px-4 py-2 rounded-xl bg-primary text-primary-foreground font-bold text-xs hover:opacity-90 transition whitespace-nowrap shadow-2xs">
            रिसाइझर टूल खोलें &rarr;
          </a>
        </div>

        <!-- Main Body Content -->
        <div class="prose dark:prose-invert max-w-none prose-sm sm:prose-base space-y-4">
          <Fragment set:html={translatedContent} />
        </div>
      </article>

      <!-- Related Posts Section -->
      {relatedPosts.length > 0 && (
        <section class="space-y-4 pt-8 border-t border-border">
          <h3 class="text-lg font-bold text-foreground">संबंधित लेख (Related Articles)</h3>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            {relatedPosts.map(rel => (
              <a href={`/hi/blog/${rel.slug}/`} class="p-4 rounded-2xl bg-card border border-border hover:border-primary transition space-y-2 group">
                <span class="text-[10px] font-bold uppercase tracking-wider text-primary">{rel.category}</span>
                <h4 class="font-bold text-xs sm:text-sm text-foreground group-hover:text-primary transition line-clamp-2">
                  {getBlogPostTitle(rel, 'hi')}
                </h4>
              </a>
            ))}
          </div>
        </section>
      )}

    </main>

    <Footer />
  </body>
</html>
