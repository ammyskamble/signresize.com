---
// src/pages/hi/index.astro
import '../../styles/global.css';
import Header from '../../components/Header.astro';
import { SignatureTool } from '../../components/SignatureTool';
import ExamDayToolkit from '../../components/ExamDayToolkit.astro';
import ExamSpecsTable from '../../components/ExamSpecsTable.astro';
import GuideSection from '../../components/GuideSection.astro';
import FaqSection from '../../components/FaqSection.astro';
import AuthorBioSection from '../../components/AuthorBioSection.astro';
import Footer from '../../components/Footer.astro';
import GoogleAnalytics from '../../components/GoogleAnalytics.astro';
import GoogleFonts from '../../components/GoogleFonts.astro';
import ThemeScript from '../../components/ThemeScript.astro';

const pageTitle = "सिग्नेचर व फोटो रिसाइज़र (10–20 KB, 20–50 KB) | साइज कम/बढ़ाएं - SignResize";
const pageDescription = "फोटो व सिग्नेचर का साइज कम करें या बढ़ाएं (10–20 KB, 20–50 KB, 100 KB)। फोटो का साइज कैसे कम करें, सिग्नेचर साइज और हिंदी एरर समाधान देखें।";
const canonicalUrl = "https://signresize.in/hi/";
const ogImageUrl = "https://signresize.in/og-image.png";
const keywordsContent = "फोटो का साइज कैसे कम करें, photo ka size kaise kam kare, photo ka size kaise badhaye, signature ka size kya hota hai, signature size kitna hona chahiye, सिग्नेचर रिसाइज 10 से 20 kb, photo size reducer in kb, signature size should be at least 20kb meaning in hindi, photo size should be maximum 100kb meaning in hindi";

const hindiFaqs = [
  {
    q: "फोटो का साइज कैसे कम करें (Photo ka size kaise kam kare — 20 KB, 50 KB या 100 KB में)?",
    a: "SignResize पर अपनी फोटो अपलोड करें, 'Photo' मोड चुनें और Max KB में 50 KB या 100 KB (या SSC/Exam अनुसार 20–50 KB) सेट करें। बिना क्रॉप किए केवल KB कम करने के लिए 'Photo Size Reducer & KB Tool' (/compress-image-to-kb/) खोलें — 'Reduce Size (Max KB)' में फोटो का साइज सेकंडों में कम हो जाता है।"
  },
  {
    q: "फोटो या सिग्नेचर का साइज कैसे बढ़ाएं (Photo / Signature ka size kaise badhaye in KB)?",
    a: "अगर आपकी फोटो 8 KB या 12 KB की है और फॉर्म कम से कम 20 KB या 30 KB मांग रहा है, तो ऊपर टूल में 'Min KB (Increase Floor)' में 20 या 30 लिखें (या /compress-image-to-kb/ पर 'Increase Size (Min KB)' टैब चुनें) और JPG डाउनलोड करें। SignResize बिना पिक्सेल खींचे सुरक्षित तरीके से JPG फाइल का KB साइज बढ़ा देता है।"
  },
  {
    q: "सिग्नेचर का साइज कितना होना चाहिए (Signature ka size kya hota hai / kitna hona chahiye)?",
    a: "हर परीक्षा का नियम अलग होता है — ज्यादातर सरकारी फॉर्म (SSC, RRB, IBPS) 10 KB से 20 KB JPG मांगते हैं, जबकि PAN कार्ड (50 KB तक), CTET (3–30 KB, 3.5×1.5 cm) और IIT JAM (50–150 KB) की सीमा अलग है। अपने आधिकारिक नोटिफिकेशन में Pixels, CM और Min–Max KB जरूर जांचें।"
  },
  {
    q: "\"Signature size should be at least 20kb\" (Meaning in Hindi) — इसका मतलब और समाधान?",
    a: "Meaning in Hindi: आपके हस्ताक्षर की फाइल का साइज कम से कम 20 KB होना चाहिए (आपकी फाइल 20 KB से छोटी है)। समाधान: SignResize में Min KB = 20 और Max KB = 35 या 50 सेट करके JPG एक्सपोर्ट करें, टूल फाइल को सुरक्षित रूप से 20 KB से ऊपर बढ़ा देगा।"
  },
  {
    q: "\"Signature size should be between 10 kb and 20 kb\" (Meaning in Hindi) — इसे कैसे ठीक करें?",
    a: "Meaning in Hindi: सिग्नेचर का फाइल साइज 10 KB से 20 KB के बीच ही होना चाहिए (न 10 से कम, न 20 से ज्यादा)। समाधान: Min KB = 10 और Max KB = 20 सेट करें या /resize-signature-to-10kb-20kb/ उपयोग करके 15 KB के आसपास सटीक JPG डाउनलोड करें।"
  },
  {
    q: "\"Photo size should be maximum 100kb\" (Meaning in Hindi) — 100 KB से कम कैसे करें?",
    a: "Meaning in Hindi: अपलोड की जाने वाली फोटो अधिकतम 100 KB की हो सकती है (आपकी फाइल 100 KB से बड़ी है)। समाधान: Photo mode या /compress-image-to-kb/ में Max KB = 95 या 100 सेट करके JPG डाउनलोड करें और अपलोड से पहले फाइल साइज जांच लें।"
  }
];
---

<!doctype html>
<html lang="hi-IN" class="scroll-smooth">
  <head>
    <ThemeScript />
    <GoogleAnalytics />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={keywordsContent} />
    <meta name="author" content="SignResize.in" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Multilingual Alternate Language Tags for SEO (hreflang) -->
    <link rel="alternate" hreflang="en" href="https://signresize.in/" />
    <link rel="alternate" hreflang="en-IN" href="https://signresize.in/" />
    <link rel="alternate" hreflang="hi" href="https://signresize.in/hi/" />
    <link rel="alternate" hreflang="hi-IN" href="https://signresize.in/hi/" />
    <link rel="alternate" hreflang="mr" href="https://signresize.in/mr/" />
    <link rel="alternate" hreflang="mr-IN" href="https://signresize.in/mr/" />
    <link rel="alternate" hreflang="x-default" href="https://signresize.in/" />

    <!-- Open Graph (OG) Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="SignResize" />
    <meta property="og:locale" content="hi_IN" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Web Fonts -->
    <GoogleFonts />

    <!-- Favicon & PWA Icons -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#4f46e5" />

    <!-- Schema.org WebApplication JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "SignResize - ऑनलाइन सिग्नेचर रिसाइज़र",
      "url": "https://signresize.in/hi/",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5 Canvas.",
      "inLanguage": "hi",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "INR"
      },
      "description": "सरकारी प्रतियोगी परीक्षाओं (SSC, UPSC, UPPSC, BPSC, RRB) के लिए 10 से 20 KB में ऑनलाइन हस्ताक्षर और फोटो रिसाइज करने का मुफ्त टूल।"
    })} />
  </head>

  <body class="min-h-screen bg-background text-foreground flex flex-col font-sans antialiased selection:bg-primary/20 selection:text-primary">
    <!-- Header with Language Switcher -->
    <Header />

    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-8">
      <!-- Hindi Hero Section -->
      <section class="space-y-4">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div class="space-y-1.5">
            <div class="flex items-center gap-2 flex-wrap">
              <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-primary/10 text-primary border border-primary/20">
                <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
                नया अपडेट 2026 दिशानिर्देश
              </span>
              <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md text-[11px] font-mono text-emerald-700 dark:text-emerald-300 font-semibold bg-emerald-500/10 border border-emerald-500/20">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                0 बाइट्स अपलोड • 100% ब्राउज़र में सुरक्षित
              </span>
            </div>
            <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-foreground leading-[1.2]">
              ऑनलाइन <span class="text-primary">सिग्नेचर व फोटो रिसाइज़र</span> (साइज कम करें या बढ़ाएं)
            </h1>
            <p class="text-xs sm:text-sm text-muted-foreground max-w-3xl leading-relaxed">
              <strong>SSC, UPSC, UPPSC, BPSC, CTET, RRB व पैन कार्ड</strong> के लिए हस्ताक्षर व फोटो को <strong>10–20 KB</strong>, <strong>20–50 KB</strong> या <strong>100 KB</strong> में सेट करें। आप पिक्सेल/सेमी बदलने के साथ-साथ कम KB वाली JPG फाइल का साइज <strong>बढ़ा</strong> भी सकते हैं — या केवल KB बदलने के लिए <a href="/compress-image-to-kb/" class="text-primary underline font-semibold">Photo Size Reducer &amp; KB Tool</a> उपयोग करें।
            </p>
          </div>

          <!-- Quick Badges -->
          <div class="flex items-center gap-2 flex-wrap shrink-0">
            <div class="px-3.5 py-2 rounded-xl bg-card border border-border text-center shadow-xs">
              <div class="text-[9px] uppercase font-bold text-muted-foreground">मानक आयाम</div>
              <div class="text-xs font-bold text-foreground font-mono">140×60 PX</div>
            </div>
            <div class="px-3.5 py-2 rounded-xl bg-card border border-border text-center shadow-xs">
              <div class="text-[9px] uppercase font-bold text-muted-foreground">लक्षित साइज</div>
              <div class="text-xs font-bold text-primary font-mono">10 KB – 20 KB</div>
            </div>
            <div class="px-3.5 py-2 rounded-xl bg-card border border-border text-center shadow-xs">
              <div class="text-[9px] uppercase font-bold text-muted-foreground">रिज़ॉल्यूशन</div>
              <div class="text-xs font-bold text-foreground font-mono">200 DPI</div>
            </div>
          </div>
        </div>
      </section>

      <!-- Main Interactive Resizer Studio initialized in Hindi -->
      <section class="bg-card border border-border rounded-2xl p-3 sm:p-5 shadow-sm min-h-[920px] sm:min-h-[820px] lg:min-h-[680px]">
        <ExamDayToolkit lang="hi" />
        <SignatureTool client:idle initialLang="hi" />
      </section>

      <!-- Pan-India Govt Jobs Live Link -->
      <section class="rounded-2xl border border-emerald-500/30 bg-gradient-to-r from-emerald-500/10 via-card to-primary/5 p-4 sm:p-5 shadow-xs flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div class="flex items-start gap-3.5">
          <div class="w-10 h-10 rounded-xl bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-xl shrink-0 font-bold">
            🏛️
          </div>
          <div class="space-y-1">
            <div class="flex items-center gap-2">
              <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/15 text-emerald-700 dark:text-emerald-300 border border-emerald-500/30">
                1.8 लाख+ पद
              </span>
              <span class="text-xs font-semibold text-foreground">अखिल भारतीय व सभी 28 राज्यों की नौकरियाँ</span>
            </div>
            <h2 class="text-base sm:text-lg font-extrabold text-foreground">
              क्या आप सरकारी नौकरी (SSC, RRB, UPPSC, BPSC) के लिए आवेदन कर रहे हैं?
            </h2>
            <p class="text-xs text-muted-foreground max-w-2xl leading-relaxed">
              सभी चालू भर्तियों की सूची, आवेदन लिंक और फोटो-हस्ताक्षर के सटीक नियम एक ही स्थान पर देखें।
            </p>
          </div>
        </div>
        <a
          href="/government-jobs/"
          class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold transition shadow-xs shrink-0 cursor-pointer"
        >
          <span>सरकारी नौकरी पोर्टल देखें</span>
          <span>→</span>
        </a>
      </section>

      <!-- 40+ Exam Specs Table -->
      <ExamSpecsTable />

      <!-- Step-by-Step Guide Section -->
      <GuideSection />

      <!-- FAQ Section (Hindi & Hinglish) -->
      <FaqSection
        faqs={hindiFaqs}
        title="अक्सर पूछे जाने वाले प्रश्न (Hindi & Hinglish FAQ)"
        description="फोटो का साइज कैसे कम करें या बढ़ाएं (Min/Max KB), सिग्नेचर का साइज कितना होना चाहिए और पोर्टल एरर का हिंदी अर्थ।"
      />

      <!-- Author Bio Section -->
      <AuthorBioSection />
    </main>

    <!-- Footer -->
    <Footer />
  </body>
</html>
