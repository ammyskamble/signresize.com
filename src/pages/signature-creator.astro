---
// src/pages/signature-creator.astro
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SignatureCreatorTool } from '../components/SignatureCreatorTool';

const pageTitle = "Online Signature Creator & Generator (Cursive Handwriting & Draw Pad) - SignResize";
const pageDescription = "Free online digital signature creator and generator. Type your name in beautiful cursive calligraphy fonts or draw smoothly on screen. Download transparent PNG or white JPG.";
const canonicalUrl = "https://signresize.in/signature-creator";
const ogImageUrl = "https://signresize.in/og-image.png";
const keywordsContent = "signature creator, online signature creator, signature generator, cursive signature generator, digital signature maker, draw signature online, create signature online free, sign on screen, electronic signature generator";

const faqs = [
  {
    q: "How can I create a digital signature online?",
    a: "You can create a signature in two ways on SignResize: (1) 'Type Signature' allows you to enter your name and choose from multiple cursive calligraphy fonts, or (2) 'Draw Signature' lets you sign directly on your touchscreen, tablet, or with a mouse. You can customize ink color (black or blue) and download as a transparent PNG or white JPG."
  },
  {
    q: "Can I use a typed cursive signature for competitive exam applications (SSC, UPSC)?",
    a: "Most exam recruitment portals (like SSC, UPSC, and IBPS) strictly require a scanned copy of your genuine wet-ink handwritten signature on paper rather than a computer-font generated graphic. You can use our 'Draw Signature' tab or sign on physical paper and upload it to our Signature Resizer to remain 100% compliant."
  },
  {
    q: "Is my signature kept private and secure?",
    a: "Yes, completely. All rendering is executed 100% client-side inside your browser's HTML5 canvas. No signature images or personal names are ever transmitted to or stored on our servers."
  },
  {
    q: "How to export signature with transparent background?",
    a: "Check the 'Transparent Background (PNG)' toggle on the Signature Creator and click 'Download PNG'. The resulting PNG image has an alpha channel without any white background, suitable for overlaying onto PDFs and digital documents."
  }
];
---

<!doctype html>
<html lang="en-IN" class="scroll-smooth">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-1N3EF3HFPH"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-1N3EF3HFPH');
    </script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={keywordsContent} />
    <meta name="author" content="SignResize.in" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph (OG) Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="SignResize" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- PWA & Mobile Meta Tags -->
    <meta name="theme-color" content="#4f46e5" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="SignResize" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- High-Performance Async Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      />
    </noscript>

    <!-- WebApplication Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "Online Signature Creator & Generator",
      "url": canonicalUrl,
      "applicationCategory": "DesignApplication",
      "operatingSystem": "All (Android, iOS, Windows, macOS, Linux)",
      "browserRequirements": "Requires JavaScript. Requires HTML5 Canvas support.",
      "description": pageDescription,
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "INR"
      },
      "featureList": [
        "Type signature in 6+ cursive calligraphy fonts",
        "Smooth digital touch/stylus draw pad",
        "Black, dark navy, and royal blue ink choices",
        "Transparent PNG and clean white JPG downloads",
        "100% private in-browser generation"
      ]
    })} />

    <!-- BreadcrumbList Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://signresize.in/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Signature Creator",
          "item": canonicalUrl
        }
      ]
    })} />

    <!-- FAQPage Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": f.a
        }
      }))
    })} />
  </head>

  <body class="bg-background text-foreground selection:bg-primary/20 selection:text-primary min-h-screen flex flex-col antialiased">
    <Header />

    <main class="flex-1 w-full max-w-[1480px] mx-auto px-3 sm:px-6 lg:px-8 py-6 space-y-8">
      
      <!-- Breadcrumb Bar -->
      <nav class="flex items-center gap-2 text-xs text-muted-foreground" aria-label="Breadcrumb">
        <a href="/" class="hover:text-primary transition">Home</a>
        <span>/</span>
        <span class="text-foreground font-medium">Signature Creator</span>
      </nav>

      <!-- Hero Header Banner -->
      <section class="rounded-2xl border border-primary/20 bg-gradient-to-r from-card via-card/90 to-primary/5 p-4 sm:p-6 shadow-sm backdrop-blur">
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
          <div class="space-y-1.5">
            <div class="flex items-center gap-2 flex-wrap">
              <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-primary/10 text-primary border border-primary/20">
                <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
                Digital Signature Studio
              </span>
              <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md text-[11px] font-mono text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 border border-emerald-500/20">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                0 Bytes Uploaded • 100% Private
              </span>
            </div>
            <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-foreground leading-[1.15]">
              Online <span class="text-primary">Signature Creator</span> &amp; Generator
            </h1>
            <p class="text-xs sm:text-sm text-muted-foreground max-w-3xl leading-relaxed">
              Create smooth, professional digital signatures for documents, emails, and forms. Type your name in stylish cursive calligraphy handwriting or draw on screen with finger, mouse, or stylus.
            </p>
          </div>

          <!-- Feature Badges -->
          <div class="flex items-center gap-2 flex-wrap shrink-0">
            <div class="px-3 py-2 rounded-xl bg-card border border-border text-center">
              <div class="text-[9px] uppercase font-bold text-muted-foreground">Styles</div>
              <div class="text-xs font-bold text-primary font-mono">6 Cursive Fonts</div>
            </div>
            <div class="px-3 py-2 rounded-xl bg-card border border-border text-center">
              <div class="text-[9px] uppercase font-bold text-muted-foreground">Export</div>
              <div class="text-xs font-bold text-foreground font-mono">PNG / JPG</div>
            </div>
            <div class="px-3 py-2 rounded-xl bg-card border border-border text-center">
              <div class="text-[9px] uppercase font-bold text-muted-foreground">Ink</div>
              <div class="text-xs font-bold text-foreground font-mono">Black / Blue</div>
            </div>
          </div>
        </div>
      </section>

      <!-- Main Layout: Creator Tool + Guidelines -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        <div class="lg:col-span-8 space-y-6">
          <SignatureCreatorTool client:idle />

          <!-- Aspirant Guidance Note -->
          <div class="bg-card border border-border rounded-2xl p-5 shadow-sm space-y-4">
            <h2 class="text-base font-bold text-foreground flex items-center gap-2">
              <span>💡</span> Important Notice for Indian Govt Exam Aspirants
            </h2>
            <div class="space-y-3 text-xs text-muted-foreground leading-relaxed">
              <p>
                Staff Selection Commission (SSC), Union Public Service Commission (UPSC), and Railway Recruitment Boards (RRB) mandate that candidates upload a <strong>scanned wet-ink running hand signature</strong> signed on physical paper.
              </p>
              <p>
                Do not submit computer-font generated signatures for formal government exams as they can be detected as typed fonts and rejected. For official exam forms, please write your signature on white paper with a black ballpoint pen, photograph it with your phone, and resize it with our <a href="/#tool-workspace" class="text-primary underline font-medium">Signature Resizer Tool</a>.
              </p>
            </div>

            <!-- FAQ Section -->
            <div class="pt-4 border-t border-border space-y-3">
              <h3 class="text-sm font-bold text-foreground">Frequently Asked Questions</h3>
              <div class="space-y-2">
                {faqs.map((f) => (
                  <details class="group p-3.5 rounded-xl border border-border bg-muted/20 open:bg-card transition">
                    <summary class="flex items-center justify-between font-semibold text-foreground text-xs cursor-pointer select-none">
                      <span>{f.q}</span>
                      <span class="text-primary group-open:rotate-180 transition-transform ml-2">▼</span>
                    </summary>
                    <p class="pt-2 text-xs text-muted-foreground leading-relaxed">{f.a}</p>
                  </details>
                ))}
              </div>
            </div>
          </div>
        </div>

        <!-- Sidebar -->
        <aside class="lg:col-span-4 space-y-4 sticky top-16">
          <div class="bg-card border border-border rounded-2xl p-5 shadow-sm space-y-3 text-xs">
            <div class="font-bold text-foreground">Where to Use Your Created Signature?</div>
            <ul class="space-y-2 text-[11px] text-muted-foreground">
              <li class="flex items-start gap-2">
                <span class="text-emerald-500 font-bold">✓</span>
                <span><strong>PDF Documents:</strong> Insert into job offer letters, agreements, and invoices.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-emerald-500 font-bold">✓</span>
                <span><strong>Email Signatures:</strong> Add personalized cursive sign-off to Gmail or Outlook.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-emerald-500 font-bold">✓</span>
                <span><strong>Online Forms:</strong> Upload to portals that support transparent PNG e-signatures.</span>
              </li>
            </ul>
          </div>

          <div class="bg-card border border-border rounded-2xl p-5 shadow-sm space-y-3 text-xs">
            <div class="font-bold text-foreground">Exam Portal Resizer</div>
            <p class="text-[11px] text-muted-foreground">
              Need strict 10–20 KB bounds with 140×60 px dimensions for SSC, PAN, or RRB?
            </p>
            <a
              href="/#tool-workspace"
              class="block w-full text-center py-2 px-3 rounded-xl bg-primary text-primary-foreground font-bold text-xs hover:bg-primary/90 transition shadow-xs"
            >
              Open Signature Resizer →
            </a>
          </div>
        </aside>
      </div>

    </main>

    <Footer />
  </body>
</html>
