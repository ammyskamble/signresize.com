---
// src/pages/pk/ppsc-kppsc-spsc-bpsc-photo-resizer.astro
import '../../styles/global.css';
import Header from '../../components/Header.astro';
import { SignatureTool } from '../../components/SignatureTool';
import FaqSection from '../../components/FaqSection.astro';
import Footer from '../../components/Footer.astro';
import GoogleAnalytics from '../../components/GoogleAnalytics.astro';
import GoogleFonts from '../../components/GoogleFonts.astro';
import ThemeScript from '../../components/ThemeScript.astro';

const pageTitle = "Provincial PSC Photo Resizer (PPSC, KPPSC, SPSC, BPSC 25 KB) - SignResize";
const pageDescription = "Free online Provincial Public Service Commission photo resizer. Crop and compress photos to 200x230 px, under 25 KB JPG for PPSC Punjab, KPPSC, SPSC Sindh & BPSC Balochistan.";
const canonicalUrl = "https://signresize.in/pk/ppsc-kppsc-spsc-bpsc-photo-resizer/";
const ogImageUrl = "https://signresize.in/og-image.png";
const keywordsContent = "ppsc photo resizer 25kb, kppsc photo resizer online, spsc photo crop 25kb, bpsc balochistan photo size 200x230, provincial psc signature crop pakistan";

const pscFaqs = [
  {
    q: "What is the file size limit for PPSC Punjab Public Service Commission online applications?",
    a: "PPSC Punjab strictly limits candidate photographs and signature uploads to under 25 KB (200x230 pixels, JPG format)."
  },
  {
    q: "What are the photograph specifications for KPPSC, SPSC, and BPSC?",
    a: "KPPSC (Khyber Pakhtunkhwa), SPSC (Sindh), and BPSC (Balochistan) accept passport photos between 15 KB and 25 KB in size, formatted to 200x230 pixels with a white or light blue background."
  },
  {
    q: "Why is my signature upload rejected on the PPSC online portal?",
    a: "Signatures are rejected if the scanned file exceeds 25 KB, is signed with light blue ink instead of dark black/blue ballpoint, or has dark mobile phone shadows around the text."
  }
];
---

<!doctype html>
<html lang="en-PK" class="scroll-smooth">
  <head>
    <ThemeScript />
    <GoogleAnalytics />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={keywordsContent} />
    <meta name="author" content="SignResize.in" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph (OG) Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="SignResize" />
    <meta property="og:locale" content="en_PK" />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Web Fonts & Favicons -->
    <GoogleFonts />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <meta name="theme-color" content="#059669" />

    <!-- Schema.org WebApplication JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "Provincial PSC Photo & Signature Resizer",
      "url": canonicalUrl,
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "description": pageDescription,
      "featureList": [
        "200x230 px Photo & Signature Crop",
        "Under 25 KB File Compression",
        "PPSC, KPPSC, SPSC, BPSC Portal Ready"
      ]
    })} />
  </head>

  <body class="min-h-screen bg-background text-foreground flex flex-col font-sans antialiased">
    <Header />

    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-8">
      <!-- Tool Page Header with Selector Dropdown -->
      <section class="space-y-4">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div class="space-y-2">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
              <span>🇵🇰 Provincial PSC Suite (PPSC, KPPSC, SPSC, BPSC)</span>
            </div>
            <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-foreground">
              Provincial PSC Photo &amp; Signature Resizer
            </h1>
            <p class="text-muted-foreground text-sm sm:text-base max-w-3xl">
              Crop and compress photo &amp; signature scans to 200x230 px (under 25 KB) for PPSC Punjab, KPPSC, SPSC Sindh, and BPSC Balochistan recruitment applications.
            </p>
          </div>

          <!-- Quick Dropdown Hub Selector -->
          <div class="w-full md:w-auto min-w-[280px] bg-card p-3 rounded-xl border border-border shadow-sm">
            <label for="tool-select" class="block text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-1.5">
              Select Pakistan Portal Tool:
            </label>
            <select
              id="tool-select"
              class="w-full bg-background border border-input text-foreground rounded-lg px-3 py-2 text-sm font-medium focus:ring-2 focus:ring-primary focus:outline-none cursor-pointer"
              onchange="if(this.value) window.location.href=this.value;"
            >
              <option value="/pk/">🇵🇰 Pakistan Main Hub</option>
              <option value="/pk/fpsc-photo-resizer/">FPSC Federal Exams (200x230 px / ≤30 KB)</option>
              <option value="/pk/css-exam-photo-resizer/">CSS Competitive Exam (200x230 px / ≤30 KB)</option>
              <option value="/pk/ppsc-kppsc-spsc-bpsc-photo-resizer/" selected>Provincial PSCs (PPSC, KPPSC, SPSC, BPSC)</option>
              <option value="/pk/nadra-passport-cnic-photo-resizer/">NADRA CNIC & Passport Renewals</option>
            </select>
          </div>
        </div>
      </section>

      <!-- Signature Tool Canvas Widget -->
      <section class="bg-card rounded-2xl p-4 sm:p-6 border border-border shadow-sm">
        <SignatureTool client:load initialPresetId="ppsc-pk" />
      </section>

      <!-- SEO Educational Guide Section -->
      <section class="space-y-6 pt-6 border-t border-border">
        <div class="bg-card rounded-2xl p-6 sm:p-8 border border-border space-y-6">
          <h2 class="text-2xl font-bold text-foreground">
            Provincial Public Service Commission (PPSC, KPPSC, SPSC, BPSC) Guidelines
          </h2>
          <p class="text-muted-foreground leading-relaxed">
            All four provincial commissions of Pakistan—<strong>PPSC (Punjab)</strong>, <strong>KPPSC (Khyber Pakhtunkhwa)</strong>, <strong>SPSC (Sindh)</strong>, and <strong>BPSC (Balochistan)</strong>—require applicants to submit digital photographs and signatures within a strict <strong>15 KB to 25 KB</strong> window. SignResize processes your files safely in-browser with pixel-perfect ratio compliance.
          </p>
        </div>
      </section>

      <!-- FAQ Section -->
      <FaqSection faqs={pscFaqs} />
    </main>

    <Footer />
  </body>
</html>
