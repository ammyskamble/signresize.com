---
// src/pages/layout-4.astro (Option 4: Interactive Stepper & Exam Portal Bento Grid Layout)
import '../styles/global.css';
import Header from '../components/Header.astro';
import LayoutComparisonBanner from '../components/LayoutComparisonBanner.astro';
import { SignatureTool } from '../components/SignatureTool';
import ExamSpecsTable from '../components/ExamSpecsTable.astro';
import GuideSection from '../components/GuideSection.astro';
import SeoContentSection from '../components/SeoContentSection.astro';
import FaqSection from '../components/FaqSection.astro';
import Footer from '../components/Footer.astro';

const pageTitle = "Option 4: Stepper & Exam Bento Portal | Online Signature Resize";
const pageDescription = "Layout Option 4: Interactive step-by-step guided workflow with visual Exam Portal Bento Grid, one-click portal configuration, and modular card inspection hub.";
const canonicalUrl = "https://signresize.com/layout-4";
const ogImageUrl = "https://signresize.com/og-image.png";
---

<!doctype html>
<html lang="en-IN" class="theme-purple">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="noindex, follow" />

    <!-- Open Graph (OG) Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>

  <body class="bg-background text-foreground selection:bg-primary/20 selection:text-primary min-h-screen flex flex-col antialiased">
    <!-- Layout Comparison Banner -->
    <LayoutComparisonBanner activeOption="4" defaultTheme="theme-purple" />

    <!-- Navigation Header -->
    <Header activeLayout="option4" />

    <!-- Main Container -->
    <main class="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-12">
      
      <!-- Option 4 Stepper Hero -->
      <section class="text-center max-w-3xl mx-auto space-y-4">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-xs font-semibold bg-primary/15 text-primary border border-primary/30 shadow-xs">
          <span class="w-2 h-2 rounded-full bg-primary animate-ping"></span>
          <span>Option 4: Stepper &amp; Exam Bento Portal</span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-foreground leading-[1.15]">
          3-Step Guided <span class="text-primary">Signature &amp; Thumb</span> Resizer
        </h1>

        <p class="text-sm sm:text-base text-muted-foreground max-w-2xl mx-auto leading-relaxed">
          Select your target examination portal, load your image, clean paper shadows, and download your <strong>100% compliant 10–20 KB JPG</strong> in seconds.
        </p>

        <!-- Interactive 3-Step Guided Bar -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-3 text-left">
          <div class="p-3 rounded-xl bg-card border border-primary/40 shadow-xs flex items-center gap-3">
            <div class="w-8 h-8 rounded-lg bg-primary text-primary-foreground font-bold flex items-center justify-center shrink-0 text-sm">
              1
            </div>
            <div>
              <div class="text-xs font-bold text-foreground">Select Target Portal</div>
              <div class="text-[11px] text-muted-foreground">SSC, PAN, RRB, or Custom CM</div>
            </div>
          </div>

          <div class="p-3 rounded-xl bg-card border border-border shadow-xs flex items-center gap-3">
            <div class="w-8 h-8 rounded-lg bg-muted text-foreground font-bold flex items-center justify-center shrink-0 text-sm">
              2
            </div>
            <div>
              <div class="text-xs font-bold text-foreground">Crop &amp; Clean Paper</div>
              <div class="text-[11px] text-muted-foreground">Auto-whitens phone photo background</div>
            </div>
          </div>

          <div class="p-3 rounded-xl bg-card border border-border shadow-xs flex items-center gap-3">
            <div class="w-8 h-8 rounded-lg bg-muted text-foreground font-bold flex items-center justify-center shrink-0 text-sm">
              3
            </div>
            <div>
              <div class="text-xs font-bold text-foreground">Download Portal JPG</div>
              <div class="text-[11px] text-muted-foreground">Guaranteed 10 KB to 20 KB</div>
            </div>
          </div>
        </div>
      </section>

      <!-- Step 1 Visual Exam Bento Grid -->
      <section class="space-y-3">
        <div class="flex items-center justify-between">
          <h2 class="text-sm font-bold uppercase tracking-wider text-muted-foreground flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-primary"></span>
            Popular Exam &amp; Government Form Presets (1-Click Selection)
          </h2>
          <span class="text-xs text-primary font-medium">Click to configure tool below ↓</span>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
          <!-- Bento Card 1: SSC -->
          <a
            href="#tool-workspace"
            class="group p-4 rounded-2xl bg-card border border-border hover:border-primary/50 hover:bg-primary/5 transition shadow-xs flex flex-col justify-between"
          >
            <div>
              <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-primary/10 text-primary">SSC 2026</span>
              <div class="font-bold text-foreground text-sm pt-2 group-hover:text-primary transition">SSC CGL / CHSL</div>
              <div class="text-[11px] text-muted-foreground">140 × 60 px (7:3)</div>
            </div>
            <div class="pt-3 font-mono font-bold text-xs text-primary">10–20 KB</div>
          </a>

          <!-- Bento Card 2: PAN Card -->
          <a
            href="#tool-workspace"
            class="group p-4 rounded-2xl bg-card border border-border hover:border-primary/50 hover:bg-primary/5 transition shadow-xs flex flex-col justify-between"
          >
            <div>
              <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">NSDL / UTI</span>
              <div class="font-bold text-foreground text-sm pt-2 group-hover:text-primary transition">PAN Card Sign</div>
              <div class="text-[11px] text-muted-foreground">4.5 × 2.0 cm (200 DPI)</div>
            </div>
            <div class="pt-3 font-mono font-bold text-xs text-emerald-600 dark:text-emerald-400">&lt; 50 KB</div>
          </a>

          <!-- Bento Card 3: RRB Railway -->
          <a
            href="#tool-workspace"
            class="group p-4 rounded-2xl bg-card border border-border hover:border-primary/50 hover:bg-primary/5 transition shadow-xs flex flex-col justify-between"
          >
            <div>
              <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-cyan-500/10 text-cyan-600 dark:text-cyan-400">RAILWAYS</span>
              <div class="font-bold text-foreground text-sm pt-2 group-hover:text-primary transition">RRB NTPC / ALP</div>
              <div class="text-[11px] text-muted-foreground">140 × 60 px</div>
            </div>
            <div class="pt-3 font-mono font-bold text-xs text-cyan-600 dark:text-cyan-400">10–20 KB</div>
          </a>

          <!-- Bento Card 4: Left Thumb -->
          <a
            href="#tool-workspace"
            class="group p-4 rounded-2xl bg-card border border-border hover:border-primary/50 hover:bg-primary/5 transition shadow-xs flex flex-col justify-between"
          >
            <div>
              <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-500/10 text-amber-600 dark:text-amber-400">THUMB IMPRESSION</span>
              <div class="font-bold text-foreground text-sm pt-2 group-hover:text-primary transition">Left Thumb</div>
              <div class="text-[11px] text-muted-foreground">3 × 3 cm (Square 1:1)</div>
            </div>
            <div class="pt-3 font-mono font-bold text-xs text-amber-600 dark:text-amber-400">10–20 KB</div>
          </a>

          <!-- Bento Card 5: IBPS Bank -->
          <a
            href="#tool-workspace"
            class="group p-4 rounded-2xl bg-card border border-border hover:border-primary/50 hover:bg-primary/5 transition shadow-xs flex flex-col justify-between"
          >
            <div>
              <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-purple-500/10 text-purple-600 dark:text-purple-400">BANKING</span>
              <div class="font-bold text-foreground text-sm pt-2 group-hover:text-primary transition">IBPS PO / Clerk</div>
              <div class="text-[11px] text-muted-foreground">140 × 60 px (Black Ink)</div>
            </div>
            <div class="pt-3 font-mono font-bold text-xs text-purple-600 dark:text-purple-400">10–20 KB</div>
          </a>

          <!-- Bento Card 6: UPSC -->
          <a
            href="#tool-workspace"
            class="group p-4 rounded-2xl bg-card border border-border hover:border-primary/50 hover:bg-primary/5 transition shadow-xs flex flex-col justify-between"
          >
            <div>
              <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-red-500/10 text-red-600 dark:text-red-400">CIVIL SERVICES</span>
              <div class="font-bold text-foreground text-sm pt-2 group-hover:text-primary transition">UPSC CSE / NDA</div>
              <div class="text-[11px] text-muted-foreground">350 × 350 px</div>
            </div>
            <div class="pt-3 font-mono font-bold text-xs text-red-600 dark:text-red-400">20–300 KB</div>
          </a>
        </div>
      </section>

      <!-- The Resizer Studio Workspace Container -->
      <section id="tool-workspace" class="bg-card/60 backdrop-blur border border-border rounded-3xl p-4 sm:p-8 shadow-sm">
        <SignatureTool client:load />
      </section>

      <!-- Modular Bento Card Hub for Documentation -->
      <section class="space-y-6">
        <div class="text-center max-w-2xl mx-auto space-y-1">
          <h2 class="text-2xl font-bold tracking-tight text-foreground">
            Aspirant Knowledge &amp; Portal Compliance Hub
          </h2>
          <p class="text-xs text-muted-foreground">
            Comprehensive dimensions, rejection avoidance checklist, and technical DPI conversion formulas.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Card 1: Specs Matrix -->
          <div class="bg-card border border-border rounded-2xl p-6 shadow-sm space-y-4">
            <div class="flex items-center gap-2 border-b border-border pb-3">
              <span class="w-8 h-8 rounded-lg bg-primary/10 text-primary flex items-center justify-center font-bold">📋</span>
              <div>
                <h3 class="font-bold text-sm text-foreground">Official Examination Dimension Specs</h3>
                <p class="text-[11px] text-muted-foreground">Pixel &amp; KB matrix across Indian recruitment bodies</p>
              </div>
            </div>
            <ExamSpecsTable />
          </div>

          <!-- Card 2: Rejection Avoidance -->
          <div class="bg-card border border-border rounded-2xl p-6 shadow-sm space-y-4">
            <div class="flex items-center gap-2 border-b border-border pb-3">
              <span class="w-8 h-8 rounded-lg bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold">🛡️</span>
              <div>
                <h3 class="font-bold text-sm text-foreground">Signature Rejection Avoidance Protocol</h3>
                <p class="text-[11px] text-muted-foreground">Critical dos and don'ts for smartphone photo uploads</p>
              </div>
            </div>
            <GuideSection />
          </div>
        </div>

        <!-- Full-Width In-Depth Guide & SEO Section -->
        <div class="bg-card border border-border rounded-2xl p-6 sm:p-8 shadow-sm">
          <SeoContentSection />
        </div>

        <!-- FAQ Matrix -->
        <div class="bg-card border border-border rounded-2xl p-6 sm:p-8 shadow-sm">
          <FaqSection />
        </div>
      </section>

    </main>

    <!-- Global Footer -->
    <Footer />
  </body>
</html>
