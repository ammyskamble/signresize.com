---

<style is:global>
  [data-switcher-group][data-open="true"] .us-tool-switcher-panel {
    visibility: visible !important;
    opacity: 1 !important;
    pointer-events: auto !important;
  }
  [data-switcher-group][data-open="true"] .us-switcher-chevron {
    transform: rotate(180deg) !important;
  }
</style>

<div class="relative group shrink-0" data-switcher-group>
  <button
    type="button"
    class="us-tool-switcher-btn inline-flex items-center justify-between gap-2 px-3.5 py-2 rounded-xl bg-card border border-border hover:border-primary/50 text-foreground text-xs font-bold shadow-2xs transition cursor-pointer select-none"
    aria-expanded="false"
    aria-haspopup="true"
    aria-label="Switch US Tool Menu"
  >
    <span>🇺🇸 Switch US Tool</span>
    <svg class="us-switcher-chevron w-4 h-4 text-muted-foreground transition-transform duration-200 group-hover:rotate-180" viewBox="0 0 20 20" fill="currentColor">
      <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
    </svg>
  </button>

  <div class="us-tool-switcher-panel invisible group-hover:visible opacity-0 group-hover:opacity-100 transition-all duration-150 absolute right-0 top-full pt-1.5 w-72 sm:w-80 max-h-[85vh] z-50 pointer-events-none group-hover:pointer-events-auto before:content-[''] before:absolute before:-top-3 before:inset-x-0 before:h-3">
    <div class="max-h-[calc(85vh-1rem)] overflow-y-auto bg-white dark:bg-slate-900 rounded-2xl shadow-2xl border-2 border-slate-200 dark:border-slate-700 p-2 z-50 space-y-2 pointer-events-auto ring-1 ring-black/5 dark:ring-white/10">
      {tools.map((section, sIdx) => (
        <div class={sIdx > 0 ? "pt-1.5 border-t border-slate-200 dark:border-slate-800" : ""}>
          <div class="px-2 py-0.5 text-[10px] font-bold text-muted-foreground uppercase tracking-wider">
            {section.category}
          </div>
          <div class="space-y-0.5 mt-0.5">
            {section.items.map((item) => {
              const isActive = currentTool === item.id;
              return (
                <a
                  href={item.href}
                  class={`flex items-center gap-2.5 p-2 rounded-xl transition text-xs font-semibold ${
                    isActive
                      ? 'bg-primary/10 text-primary font-bold'
                      : 'text-foreground hover:bg-slate-100 dark:hover:bg-slate-800'
                  } group/item`}
                >
                  <span class="text-base p-1 rounded bg-slate-100 dark:bg-slate-800 shrink-0">
                    {item.icon}
                  </span>
                  <div class="truncate">
                    <div class={`truncate ${isActive ? 'text-primary' : 'group-hover/item:text-primary'}`}>
                      {item.name}
                    </div>
                    <div class="text-[10px] text-muted-foreground font-normal truncate">
                      {item.desc}
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      ))}

      <div class="pt-2 border-t border-slate-200 dark:border-slate-800 space-y-1">
        <a
          href="/us/exams/"
          class="flex items-center justify-between p-2 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-750 text-xs font-bold text-primary transition"
        >
          <span>Browse All US Exams Hub</span>
          <span>→</span>
        </a>
        <a
          href="/us/"
          class="flex items-center justify-between p-2 rounded-xl bg-primary/10 hover:bg-primary/20 text-xs font-bold text-primary transition"
        >
          <span>Explore All US Hub</span>
          <span>→</span>
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  (() => {
    function setupSwitchers() {
      document.querySelectorAll('[data-switcher-group]').forEach((group) => {
        if (group.hasAttribute('data-switcher-initialized')) return;
        group.setAttribute('data-switcher-initialized', 'true');

        const btn = group.querySelector('.us-tool-switcher-btn');
        const panel = group.querySelector('.us-tool-switcher-panel');
        if (!btn || !panel) return;

        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const isPinned = group.getAttribute('data-open') === 'true';
          if (isPinned) {
            group.removeAttribute('data-open');
            btn.setAttribute('aria-expanded', 'false');
          } else {
            // Close other switchers if any
            document.querySelectorAll('[data-switcher-group][data-open="true"]').forEach((other) => {
              if (other !== group) {
                other.removeAttribute('data-open');
                other.querySelector('.us-tool-switcher-btn')?.setAttribute('aria-expanded', 'false');
              }
            });
            group.setAttribute('data-open', 'true');
            btn.setAttribute('aria-expanded', 'true');
          }
        });

        panel.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', () => {
            group.removeAttribute('data-open');
            btn.setAttribute('aria-expanded', 'false');
          });
        });
      });
    }

    setupSwitchers();
    document.addEventListener('astro:page-load', setupSwitchers);

    document.addEventListener('click', (e) => {
      document.querySelectorAll('[data-switcher-group][data-open="true"]').forEach((group) => {
        if (!group.contains(e.target)) {
          group.removeAttribute('data-open');
          group.querySelector('.us-tool-switcher-btn')?.setAttribute('aria-expanded', 'false');
        }
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        document.querySelectorAll('[data-switcher-group][data-open="true"]').forEach((group) => {
          group.removeAttribute('data-open');
          const btn = group.querySelector('.us-tool-switcher-btn');
          btn?.setAttribute('aria-expanded', 'false');
          btn?.focus();
        });
      }
    });
  })();
</script>
