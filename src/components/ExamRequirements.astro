---
import type { ExamGuidance } from '../data/examGuidance';
import { GUIDANCE_REVIEWED_ON } from '../data/examGuidance';
interface Props {
  guidance: ExamGuidance;
  sources: Array<{ label: string; url: string }>;
}
const { guidance, sources } = Astro.props;
---
<section class="rounded-2xl border border-border bg-card p-4 sm:p-6 space-y-4" aria-labelledby="exam-requirements-heading">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div class="space-y-1">
      <p class="text-xs font-semibold text-primary">{guidance.cycle}</p>
      <h2 id="exam-requirements-heading" class="text-lg sm:text-xl font-bold text-foreground">{guidance.title}</h2>
    </div>
    <a href="#exam-tool" class="inline-flex min-h-11 items-center rounded-lg bg-primary px-4 text-sm font-semibold text-primary-foreground">Open preparation tool</a>
  </div>
  <p class="text-sm text-muted-foreground">{guidance.summary}</p>
  <div class="overflow-x-auto rounded-xl border border-border">
    <table class="w-full text-left text-sm">
      <caption class="sr-only">Published requirements and tool defaults for {guidance.cycle}</caption>
      <thead class="bg-muted">
        <tr><th scope="col" class="p-3">Item</th><th scope="col" class="p-3">Requirement / setting</th><th scope="col" class="p-3">Source or limitation</th></tr>
      </thead>
      <tbody class="divide-y divide-border">
        {guidance.rows.map(row => <tr>
          <th scope="row" class="p-3 font-semibold align-top">{row.label}</th>
          <td class="p-3 align-top">{row.value}</td>
          <td class="p-3 text-muted-foreground align-top">{row.evidence}</td>
        </tr>)}
      </tbody>
    </table>
  </div>
  <p class="rounded-xl border border-amber-500/30 bg-amber-500/10 p-3 text-sm text-amber-950 dark:text-amber-100"><strong>Before uploading:</strong> {guidance.caution}</p>
  <div class="space-y-2 text-sm">
    <p class="font-semibold">Official sources · reviewed <time datetime={GUIDANCE_REVIEWED_ON}>{GUIDANCE_REVIEWED_ON}</time></p>
    <ul class="space-y-2">
      {sources.map(source => <li><a href={source.url} target="_blank" rel="noopener noreferrer" class="text-primary underline underline-offset-4">{source.label} ↗</a></li>)}
    </ul>
    <p class="text-xs text-muted-foreground">Independent preparation guidance. SignResize is not affiliated with the examining authority.</p>
  </div>
  <nav class="flex flex-wrap gap-2" aria-label="Exam guidance and preparation tools">
    {guidance.links.map(link => <a href={link.href} class="inline-flex min-h-11 items-center rounded-lg border border-border px-3 py-2 text-sm font-medium text-primary hover:bg-muted">{link.label} →</a>)}
  </nav>
  <details class="border-t border-border pt-3 text-sm">
    <summary class="cursor-pointer font-medium py-2">What changed in this review?</summary>
    <p class="pt-2 text-muted-foreground">{guidance.changes}</p>
  </details>
</section>
