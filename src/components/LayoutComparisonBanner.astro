---
// src/components/LayoutComparisonBanner.astro
interface Props {
  activeOption: '1' | '2' | '3' | '4';
  defaultTheme?: string;
}
const { activeOption, defaultTheme } = Astro.props;
---

<div class="bg-card/95 border-b border-border/80 py-2 px-3 sm:px-4 text-xs shadow-xs sticky top-0 z-50 backdrop-blur-md">
  <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-2.5">
    <!-- Left: Layout Description -->
    <div class="flex items-center gap-2">
      <span class="flex h-2 w-2 relative">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-primary"></span>
      </span>
      <span class="font-bold text-foreground whitespace-nowrap">
        Preview Mode:
      </span>
      <span class="text-muted-foreground hidden sm:inline text-[11px] truncate">
        {activeOption === '1' && 'Original Layout (Classic Studio Flow)'}
        {activeOption === '2' && 'Option 2: Pro Cockpit (Tabbed Split Hub)'}
        {activeOption === '3' && 'Option 3: Command Center (Dual Column & Assistant)'}
        {activeOption === '4' && 'Option 4: Guided Stepper & Bento (Visual Portal Workflow)'}
      </span>
    </div>

    <!-- Center: Live 4-Color Palette Switcher -->
    <div class="flex items-center gap-1 bg-muted/60 p-1 rounded-xl border border-border">
      <span class="text-[10px] font-bold uppercase tracking-wider text-muted-foreground px-1.5 hidden lg:inline">
        Theme:
      </span>
      
      <!-- Blue Swatch -->
      <button
        type="button"
        data-theme=""
        class="theme-color-btn flex items-center gap-1.5 px-2 py-0.5 rounded-lg text-xs font-semibold hover:bg-card transition cursor-pointer"
        title="Electric Indigo Blue"
      >
        <span class="w-2.5 h-2.5 rounded-full bg-blue-600 shadow-xs"></span>
        <span class="text-[11px]">Blue</span>
      </button>

      <!-- Emerald Swatch -->
      <button
        type="button"
        data-theme="theme-emerald"
        class="theme-color-btn flex items-center gap-1.5 px-2 py-0.5 rounded-lg text-xs font-semibold hover:bg-card transition cursor-pointer"
        title="Official Emerald Green (Govt Trust)"
      >
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-600 shadow-xs"></span>
        <span class="text-[11px]">Emerald</span>
      </button>

      <!-- Amber Swatch -->
      <button
        type="button"
        data-theme="theme-amber"
        class="theme-color-btn flex items-center gap-1.5 px-2 py-0.5 rounded-lg text-xs font-semibold hover:bg-card transition cursor-pointer"
        title="Sunset Saffron / Warm Amber"
      >
        <span class="w-2.5 h-2.5 rounded-full bg-amber-500 shadow-xs"></span>
        <span class="text-[11px]">Amber</span>
      </button>

      <!-- Purple Swatch -->
      <button
        type="button"
        data-theme="theme-purple"
        class="theme-color-btn flex items-center gap-1.5 px-2 py-0.5 rounded-lg text-xs font-semibold hover:bg-card transition cursor-pointer"
        title="Royal Violet / Purple Studio"
      >
        <span class="w-2.5 h-2.5 rounded-full bg-purple-600 shadow-xs"></span>
        <span class="text-[11px]">Violet</span>
      </button>
    </div>

    <!-- Right: Layout Switcher Links -->
    <div class="flex items-center gap-1 bg-muted/60 p-1 rounded-xl border border-border overflow-x-auto max-w-full">
      <a
        href="/"
        class={`px-2.5 py-1 rounded-lg text-[11px] font-semibold whitespace-nowrap transition ${
          activeOption === '1'
            ? 'bg-primary text-primary-foreground shadow-xs'
            : 'text-muted-foreground hover:text-foreground'
        }`}
        title="Original Layout: Classic Studio Flow"
      >
        Original Layout
      </a>
      <a
        href="/layout-2"
        class={`px-2.5 py-1 rounded-lg text-[11px] font-semibold whitespace-nowrap transition ${
          activeOption === '2'
            ? 'bg-primary text-primary-foreground shadow-xs'
            : 'text-muted-foreground hover:text-foreground'
        }`}
        title="Option 2: Pro Cockpit Dashboard"
      >
        Option 2 (Cockpit)
      </a>
      <a
        href="/layout-3"
        class={`px-2.5 py-1 rounded-lg text-[11px] font-semibold whitespace-nowrap transition ${
          activeOption === '3'
            ? 'bg-primary text-primary-foreground shadow-xs'
            : 'text-muted-foreground hover:text-foreground'
        }`}
        title="Option 3: Command Center & Assistant"
      >
        Option 3 (Command)
      </a>
      <a
        href="/layout-4"
        class={`px-2.5 py-1 rounded-lg text-[11px] font-semibold whitespace-nowrap transition ${
          activeOption === '4'
            ? 'bg-primary text-primary-foreground shadow-xs'
            : 'text-muted-foreground hover:text-foreground'
        }`}
        title="Option 4: Stepper & Bento Portal"
      >
        Option 4 (Stepper)
      </a>
    </div>
  </div>
</div>

<!-- Inline Client Script for Instant Color Palette Switching -->
<script is:inline define:vars={{ defaultTheme }}>
  function applyColorTheme(themeClass) {
    const html = document.documentElement;
    html.classList.remove('theme-emerald', 'theme-amber', 'theme-purple');
    if (themeClass) {
      html.classList.add(themeClass);
    }
    localStorage.setItem('site_color_theme', themeClass || '');

    // Update active button indicators
    document.querySelectorAll('.theme-color-btn').forEach((btn) => {
      const btnTheme = btn.getAttribute('data-theme') || '';
      if (btnTheme === (themeClass || '')) {
        btn.classList.add('bg-card', 'shadow-xs', 'ring-1', 'ring-primary/50');
      } else {
        btn.classList.remove('bg-card', 'shadow-xs', 'ring-1', 'ring-primary/50');
      }
    });
  }

  // Check URL query param, defaultTheme prop, or localStorage
  const urlParams = new URLSearchParams(window.location.search);
  const paramTheme = urlParams.get('theme');
  const storedTheme = localStorage.getItem('site_color_theme');
  const initialTheme = paramTheme !== null ? paramTheme : (defaultTheme || storedTheme || '');

  applyColorTheme(initialTheme);

  // Bind click listeners
  document.querySelectorAll('.theme-color-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const themeClass = btn.getAttribute('data-theme') || '';
      applyColorTheme(themeClass);
    });
  });
</script>
