        <p class="text-muted-foreground">
          Toggle <strong>Clean White Paper</strong> to whiten the background to #FFFFFF, check live KB preview, and tap Download to get your portal-ready JPG.
        </p>
      </div>
    </div>
  </div>

  <!-- Interactive Walkthrough Player Logic -->
  <script is:inline>
    (function () {
      const stepCaptions = [
        "Step 1: Sign on plain paper & capture in bright light",
        "Step 2: Auto-crop to official 140×60 px / 4×2 cm frame",
        "Step 3: Clean White Paper 3.0 whitens background to #FFFFFF",
        "Step 4: Dual-boundary compression guarantees 10–20 KB bound"
      ];
      const timeStamps = ["0:08 / 0:35", "0:17 / 0:35", "0:26 / 0:35", "0:35 / 0:35"];
      const progressWidths = ["25%", "50%", "75%", "100%"];

      let currentStep = 0;
      let isPlaying = true;
      let timer = null;

      const stages = [
        document.getElementById('demo-stage-0'),
        document.getElementById('demo-stage-1'),
        document.getElementById('demo-stage-2'),
        document.getElementById('demo-stage-3')
      ];
      const stepBtns = document.querySelectorAll('.walkthrough-step-btn');
      const progressBar = document.getElementById('walkthrough-progress-bar');
      const captionEl = document.getElementById('demo-stage-caption');
      const timeIndicator = document.getElementById('walkthrough-time-indicator');
      const playToggle = document.getElementById('walkthrough-play-toggle');
      const playIcon = document.getElementById('walkthrough-play-icon');
      const pauseIcon = document.getElementById('walkthrough-pause-icon');
      const playText = document.getElementById('walkthrough-play-text');

      function showStep(index) {
        currentStep = index;
        stages.forEach((st, i) => {
          if (!st) return;
          if (i === index) {
            st.classList.remove('opacity-0', 'pointer-events-none');
            st.classList.add('opacity-100');
          } else {
            st.classList.remove('opacity-100');
            st.classList.add('opacity-0', 'pointer-events-none');
          }
        });

        stepBtns.forEach((btn, i) => {
          if (i === index) {
            btn.className = 'walkthrough-step-btn px-2.5 py-1 rounded-md text-xs font-medium border border-primary bg-primary/10 text-primary transition';
          } else {
            btn.className = 'walkthrough-step-btn px-2.5 py-1 rounded-md text-xs font-medium border border-border bg-background text-muted-foreground hover:text-foreground transition';
          }
        });

        if (progressBar) progressBar.style.width = progressWidths[index];
        if (captionEl) captionEl.textContent = stepCaptions[index];
        if (timeIndicator) timeIndicator.textContent = timeStamps[index];
      }

      function nextStep() {
        const next = (currentStep + 1) % 4;
        showStep(next);
      }

      function startCycle() {
        if (timer) clearInterval(timer);
        timer = setInterval(nextStep, 3500);
      }

      function stopCycle() {
        if (timer) clearInterval(timer);
        timer = null;
      }

      stepBtns.forEach((btn) => {
        btn.addEventListener('click', (e) => {
          const step = parseInt(e.currentTarget.getAttribute('data-step') || '0', 10);
          showStep(step);
        });
      });

      playToggle?.addEventListener('click', () => {
        isPlaying = !isPlaying;
        if (isPlaying) {
          playIcon?.classList.add('hidden');
          pauseIcon?.classList.remove('hidden');
          if (playText) playText.textContent = 'Pause Demo';
          startCycle();
        } else {
          playIcon?.classList.remove('hidden');
          pauseIcon?.classList.add('hidden');
          if (playText) playText.textContent = 'Resume Demo';
          stopCycle();
        }
      });

      // Start autoplay by default
      startCycle();
    })();
  </script>
</section>
