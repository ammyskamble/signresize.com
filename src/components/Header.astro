<!-- Pass All Exam Presets and Whole Website Search Data safely to Script -->
<script id="exam-presets-dataset" type="application/json" set:html={JSON.stringify(searchablePresets)} />
<script id="website-search-dataset" type="application/json" set:html={JSON.stringify(websiteSearchIndex)} />

<script is:inline>
(() => {
  // Theme Toggle logic
  const themeToggle = document.getElementById('theme-toggle');
  const sunIcon = document.getElementById('theme-icon-sun');
  const moonIcon = document.getElementById('theme-icon-moon');

  function updateThemeUI(isDark) {
    if (isDark) {
      document.documentElement.classList.add('dark');
      sunIcon?.classList.remove('hidden');
      moonIcon?.classList.add('hidden');
    } else {
      document.documentElement.classList.remove('dark');
      sunIcon?.classList.add('hidden');
      moonIcon?.classList.remove('hidden');
    }
  }

  const savedTheme = localStorage.getItem('theme');
  const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
  const isDark = savedTheme === 'dark' || (!savedTheme && prefersDark);
  updateThemeUI(isDark);

  themeToggle?.addEventListener('click', () => {
    const isCurrentlyDark = document.documentElement.classList.contains('dark');
    const newTheme = isCurrentlyDark ? 'light' : 'dark';
    localStorage.setItem('theme', newTheme);
    updateThemeUI(!isCurrentlyDark);
  });

  // -------------------------------------------------------------------------
  // 🌐 Multilingual Language Switcher Logic (EN, HI, MR)
  // -------------------------------------------------------------------------
  const langTrigger = document.getElementById('language-selector-trigger');
  const langMenu = document.getElementById('language-dropdown-menu');
  const langLabel = document.getElementById('header-current-lang-label');

  // Detect current path or saved language
  const currentPathname = window.location.pathname;
  let activeLang = 'en';
  if (currentPathname.startsWith('/hi/') || currentPathname === '/hi') activeLang = 'hi';
  else if (currentPathname.startsWith('/mr/') || currentPathname === '/mr') activeLang = 'mr';
  else {
    const saved = localStorage.getItem('signresize_lang');
    if (saved === 'hi' || saved === 'mr') activeLang = saved;
  }

  function updateLangUI(lang) {
    if (langLabel) langLabel.textContent = lang.toUpperCase();
    document.querySelectorAll('.lang-option').forEach((opt) => {
      const optLang = opt.getAttribute('data-lang');
      const check = opt.querySelector('.lang-check');
      if (optLang === lang) {
        opt.classList.add('bg-primary/10', 'text-primary');
        check?.classList.remove('hidden');
      } else {
        opt.classList.remove('bg-primary/10', 'text-primary');
        check?.classList.add('hidden');
      }
    });
    document.querySelectorAll('.mobile-lang-pill').forEach((pill) => {
      const pillLang = pill.getAttribute('data-lang');
      if (pillLang === lang) {
        pill.classList.add('bg-white', 'dark:bg-slate-700', 'text-slate-900', 'dark:text-white', 'font-bold', 'shadow-2xs');
        pill.classList.remove('text-muted-foreground');
      } else {
        pill.classList.remove('bg-white', 'dark:bg-slate-700', 'text-slate-900', 'dark:text-white', 'font-bold', 'shadow-2xs');
        pill.classList.add('text-muted-foreground');
      }
    });
  }

  updateLangUI(activeLang);

  langTrigger?.addEventListener('click', (e) => {
    e.stopPropagation();
    langMenu?.classList.toggle('hidden');
    langTrigger.setAttribute('aria-expanded', String(!langMenu?.classList.contains('hidden')));
  });

  document.addEventListener('click', (e) => {
    if (langMenu && !langMenu.classList.contains('hidden') && !langMenu.contains(e.target) && !langTrigger?.contains(e.target)) {
      langMenu.classList.add('hidden');
      langTrigger?.setAttribute('aria-expanded', 'false');
    }
  });

  // Track clicks on language choices to persist in localStorage and dispatch custom event
  document.querySelectorAll('.lang-option, .mobile-lang-pill').forEach((el) => {
    el.addEventListener('click', () => {
      const selected = el.getAttribute('data-lang');
      if (selected) {
        localStorage.setItem('signresize_lang', selected);
        window.dispatchEvent(new CustomEvent('signresize-lang-change', { detail: { lang: selected } }));
      }
    });
  });

  // Register Service Worker for PWA & Offline Support
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('/sw.js').catch((err) => {
        console.debug('SW registration notice:', err);
      });
    });
  }

  // Preset Selection Core Handler
  function handlePresetSelection(examKey, slug) {
    if (!examKey) return;
    const studio = document.getElementById('tool-workspace') || document.getElementById('studio-container');
    if (studio) {
      window.dispatchEvent(new CustomEvent('select-exam-preset', { detail: examKey }));
      const url = new URL(window.location.href);
      url.searchParams.set('preset', examKey);
      window.history.replaceState({}, '', url.toString());
      studio.scrollIntoView({ behavior: 'smooth' });
    } else if (slug) {
      window.location.href = `/${slug}/`;
    } else {
      window.location.href = `/?preset=${encodeURIComponent(examKey)}#tool-workspace`;
    }
  }

  // Attach Preset Handlers on all preset-btn elements inside or outside header
  function attachPresetListeners(container) {
    (container || document).querySelectorAll('.preset-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const examKey = e.currentTarget.getAttribute('data-exam');
        const slug = e.currentTarget.getAttribute('data-slug');
        handlePresetSelection(examKey, slug);
        closeSearchPopover();
      });
    });
  }
  attachPresetListeners(document);

  // -------------------------------------------------------------------------
  // 🔍 Top Search Tab & Whole Website Search Engine
  // -------------------------------------------------------------------------
  const searchContainer = document.getElementById('header-search-container');
  const searchTrigger = document.getElementById('header-search-trigger');
  const searchPopover = document.getElementById('header-search-popover');
  const searchBackdrop = document.getElementById('header-search-backdrop');
  const headerSearchInput = document.getElementById('header-exam-search');
  const searchClear = document.getElementById('header-search-clear');
  const searchClose = document.getElementById('header-search-close');
  const searchFooterClose = document.getElementById('header-search-footer-close');
  const searchResults = document.getElementById('header-search-results');
  const searchCategories = document.getElementById('header-search-categories');
  const searchTabs = document.getElementById('header-search-tabs');
  const tabButtons = searchTabs?.querySelectorAll('.search-tab-btn') || [];
  const tabCountAll = document.getElementById('tab-count-all');
  const tabCountExam = document.getElementById('tab-count-exam');
  const tabCountBlog = document.getElementById('tab-count-blog');
  const tabCountJob = document.getElementById('tab-count-job');

  let websiteSearchData = [];
  try {
    const siteDataEl = document.getElementById('website-search-dataset') || document.getElementById('exam-presets-dataset');
    if (siteDataEl) websiteSearchData = JSON.parse(siteDataEl.textContent || '[]');
  } catch (err) {
    console.error('Failed to parse website search dataset', err);
  }

  let activeFilterTab = 'all';

  function setActiveTab(filter) {
    activeFilterTab = filter;
    tabButtons.forEach((btn) => {
      const f = btn.getAttribute('data-filter');
      if (f === filter) {
        btn.classList.add('active', 'bg-primary', 'text-white', 'shadow-2xs');
        btn.classList.remove('bg-slate-100', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-300');
      } else {
        btn.classList.remove('active', 'bg-primary', 'text-white', 'shadow-2xs');
        btn.classList.add('bg-slate-100', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-300');
      }
    });
    renderFilteredResults(headerSearchInput?.value || '');
  }

  tabButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const f = btn.getAttribute('data-filter') || 'all';
      setActiveTab(f);
    });
  });

  // Quick Popular Searches click listeners
  document.querySelectorAll('.quick-suggest-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const query = btn.getAttribute('data-query') || '';
      if (headerSearchInput) {
        headerSearchInput.value = query;
        headerSearchInput.focus();
        renderFilteredResults(query);
      }
    });
  });

  function openSearchPopover() {
    searchBackdrop?.classList.remove('hidden');
    searchPopover?.classList.remove('hidden');
    searchPopover?.classList.add('flex');
    searchTrigger?.setAttribute('aria-expanded', 'true');
    // Delayed focus avoids stutter on mobile virtual keyboards
    setTimeout(() => {
      headerSearchInput?.focus();
      headerSearchInput?.select();
    }, 50);
  }

  function closeSearchPopover() {
    searchBackdrop?.classList.add('hidden');
    searchPopover?.classList.add('hidden');
    searchPopover?.classList.remove('flex');
    searchTrigger?.setAttribute('aria-expanded', 'false');
  }

  function toggleSearchPopover() {
    if (searchPopover?.classList.contains('hidden')) {
      openSearchPopover();
    } else {
      closeSearchPopover();
    }
  }

  searchTrigger?.addEventListener('click', (e) => {
    e.stopPropagation();
    toggleSearchPopover();
  });

  searchBackdrop?.addEventListener('click', () => {
    closeSearchPopover();
  });

  searchClose?.addEventListener('click', (e) => {
    e.stopPropagation();
    closeSearchPopover();
  });

  searchFooterClose?.addEventListener('click', (e) => {
    e.stopPropagation();
    closeSearchPopover();
  });

  document.getElementById('header-search-view-all')?.addEventListener('click', () => {
    closeSearchPopover();
  });

  // Close when clicking outside
  document.addEventListener('click', (e) => {
    if (
      searchPopover &&
      !searchPopover.classList.contains('hidden') &&
      !searchPopover.contains(e.target) &&
      !searchTrigger?.contains(e.target)
    ) {
      closeSearchPopover();
    }
  });

  // Global Keyboard Shortcuts: '/' and 'Ctrl+K' / 'Cmd+K'
  document.addEventListener('keydown', (e) => {
    const active = document.activeElement;
    const isEditing =
      active &&
      (active.tagName === 'INPUT' ||
        active.tagName === 'TEXTAREA' ||
        active.isContentEditable);

    // Ctrl+K or Cmd+K
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      openSearchPopover();
      return;
    }

    // '/' shortcut when not already typing
    if (e.key === '/' && !isEditing) {
      e.preventDefault();
      openSearchPopover();
      return;
    }

    // ESC to close
    if (e.key === 'Escape' && !searchPopover?.classList.contains('hidden')) {
      e.preventDefault();
      closeSearchPopover();
    }
  });

  function calculateRelevance(item, query, tokens) {
    const title = (item.title || item.name || '').toLowerCase();
    const shortCode = (item.shortCode || '').toLowerCase();
    const keywords = (item.keywords || '').toLowerCase();
    const category = (item.category || '').toLowerCase();

    let score = 0;
    if (shortCode === query) score += 100;
    if (title === query) score += 90;

    if (shortCode.startsWith(query)) score += 60;
    if (title.startsWith(query)) score += 50;

    if (title.includes(query)) score += 40;
    if (shortCode.includes(query)) score += 35;
    if (keywords.includes(query)) score += 20;
    if (category.includes(query)) score += 15;

    tokens.forEach((tok) => {
      if (title.includes(tok)) score += 12;
      if (shortCode.includes(tok)) score += 12;
      if (keywords.includes(tok)) score += 8;
    });

    return score;
  }

  // Whole Website Fast Filter Search logic
  function renderFilteredResults(query) {
    const q = query.trim().toLowerCase();
    if (!q) {
      searchResults?.classList.add('hidden');
      searchCategories?.classList.remove('hidden');
      searchClear?.classList.add('hidden');
      if (tabCountAll) tabCountAll.textContent = '';
      if (tabCountExam) tabCountExam.textContent = '';
      if (tabCountBlog) tabCountBlog.textContent = '';
      if (tabCountJob) tabCountJob.textContent = '';
      return;
    }

    searchClear?.classList.remove('hidden');
    searchCategories?.classList.add('hidden');
    searchResults?.classList.remove('hidden');

    const tokens = q.split(/\s+/).filter(Boolean);

    // Score and filter all items across whole website
    const scoredItems = [];
    let countExam = 0;
    let countBlog = 0;
    let countJob = 0;

    websiteSearchData.forEach((item) => {
      const score = calculateRelevance(item, q, tokens);
      if (score > 0) {
        scoredItems.push({ item, score });
        if (item.type === 'exam' || item.type === 'tool') countExam++;
        else if (item.type === 'blog') countBlog++;
        else if (item.type === 'job') countJob++;
      }
    });

    scoredItems.sort((a, b) => b.score - a.score);

    // Update Tab Counters
    if (tabCountAll) tabCountAll.textContent = scoredItems.length ? `(${scoredItems.length})` : '';
    if (tabCountExam) tabCountExam.textContent = countExam ? `(${countExam})` : '';
    if (tabCountBlog) tabCountBlog.textContent = countBlog ? `(${countBlog})` : '';
    if (tabCountJob) tabCountJob.textContent = countJob ? `(${countJob})` : '';

    // Apply Active Tab Filter
    const activeItems = scoredItems.filter(({ item }) => {
      if (activeFilterTab === 'all') return true;
      if (activeFilterTab === 'exam') return item.type === 'exam' || item.type === 'tool';
      if (activeFilterTab === 'blog') return item.type === 'blog';
      if (activeFilterTab === 'job') return item.type === 'job';
      return true;
    });

    if (activeItems.length === 0) {
      searchResults.innerHTML = `
        <div class="p-6 text-center text-xs text-slate-500 dark:text-slate-400 space-y-3">
          <p>No results found for "<strong>${query.replace(/</g, '&lt;')}</strong>" in <strong>${activeFilterTab === 'all' ? 'whole website' : activeFilterTab}</strong>.</p>
          <div class="flex flex-wrap items-center justify-center gap-1.5 pt-1">
            <span class="text-[11px] text-muted-foreground">Try searching:</span>
            <button type="button" class="quick-suggest-btn text-xs px-2 py-0.5 rounded bg-primary/10 hover:bg-primary/20 text-primary font-medium" data-query="UP Police">UP Police</button>
            <button type="button" class="quick-suggest-btn text-xs px-2 py-0.5 rounded bg-primary/10 hover:bg-primary/20 text-primary font-medium" data-query="UP Police Syllabus">UP Police Syllabus</button>
            <button type="button" class="quick-suggest-btn text-xs px-2 py-0.5 rounded bg-primary/10 hover:bg-primary/20 text-primary font-medium" data-query="Photo">Photo</button>
            <button type="button" class="quick-suggest-btn text-xs px-2 py-0.5 rounded bg-primary/10 hover:bg-primary/20 text-primary font-medium" data-query="SSC">SSC</button>
          </div>
        </div>
      `;
      searchResults.querySelectorAll('.quick-suggest-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const newQ = btn.getAttribute('data-query') || '';
          if (headerSearchInput) {
            headerSearchInput.value = newQ;
            headerSearchInput.focus();
            renderFilteredResults(newQ);
          }
        });
      });
      return;
    }

    const itemsHtml = activeItems
      .map(({ item }) => {
        // 1. Core Tool Result
        if (item.type === 'tool') {
          return `
            <a
              href="${item.url}"
              class="search-nav-item w-full text-left p-2.5 rounded-xl border border-indigo-200/80 dark:border-indigo-900/60 bg-indigo-50/40 hover:bg-white dark:bg-slate-800/90 dark:hover:bg-slate-750 hover:border-indigo-500/50 transition flex items-center justify-between gap-3 group cursor-pointer shadow-2xs"
            >
              <div class="min-w-0 flex-1">
                <div class="flex items-center gap-1.5 flex-wrap">
                  <span class="px-1.5 py-0.2 rounded text-[9px] font-bold uppercase bg-indigo-100 dark:bg-indigo-950/70 text-indigo-700 dark:text-indigo-300 border border-indigo-300 dark:border-indigo-800">${item.badge || 'TOOL'}</span>
                  <span class="font-bold text-slate-900 dark:text-slate-100 group-hover:text-primary">${item.title}</span>
                  <span class="text-[10px] text-muted-foreground">• ${item.category}</span>
                </div>
                <div class="text-[11px] text-slate-600 dark:text-slate-300 line-clamp-1 mt-0.5">${item.desc}</div>
              </div>
              <span class="text-xs text-indigo-600 dark:text-indigo-400 font-bold shrink-0">Open Tool →</span>
            </a>
          `;
        }

        // 2. Exam Preset / Tool Page Result
        if (item.type === 'exam') {
          return `
            <button
              type="button"
              class="preset-btn w-full text-left p-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50/90 hover:bg-white dark:bg-slate-800/90 dark:hover:bg-slate-750 hover:border-primary/50 dark:hover:border-primary/50 transition flex items-center justify-between gap-3 group cursor-pointer shadow-2xs"
              data-exam="${item.id}"
              data-slug="${item.slug || ''}"
            >
              <div class="min-w-0 flex-1">
                <div class="flex items-center gap-1.5 flex-wrap">
                  <span class="px-1.5 py-0.2 rounded text-[9px] font-bold uppercase bg-blue-100 dark:bg-blue-950/70 text-blue-700 dark:text-blue-300 border border-blue-300 dark:border-blue-800">EXAM PRESET</span>
                  <span class="font-bold text-slate-900 dark:text-slate-100 group-hover:text-primary">${item.shortCode}</span>
                  <span class="text-[10px] text-muted-foreground">• ${item.category}</span>
                </div>
                <div class="text-[11px] text-slate-600 dark:text-slate-300 truncate mt-0.5">${item.title}</div>
              </div>
              <div class="text-right shrink-0">
                <div class="font-mono text-primary font-bold text-xs">${item.widthPx}×${item.heightPx} px</div>
                <div class="text-[10px] font-mono text-slate-500 dark:text-slate-400">${item.minKb}–${item.maxKb} KB</div>
              </div>
            </button>
          `;
        }

        // 3. Blog Article & Syllabus Guide Result
        if (item.type === 'blog') {
          return `
            <a
              href="${item.url}"
              class="search-nav-item w-full text-left p-2.5 rounded-xl border border-amber-200/80 dark:border-amber-900/60 bg-amber-50/40 hover:bg-white dark:bg-slate-800/90 dark:hover:bg-slate-750 hover:border-amber-500/50 transition flex items-center justify-between gap-3 group cursor-pointer shadow-2xs"
            >
              <div class="min-w-0 flex-1">
                <div class="flex items-center gap-1.5 flex-wrap">
                  <span class="px-1.5 py-0.2 rounded text-[9px] font-bold uppercase bg-amber-100 dark:bg-amber-950/70 text-amber-800 dark:text-amber-300 border border-amber-300 dark:border-amber-800">ARTICLE &amp; GUIDE</span>
                  <span class="text-[10px] text-amber-700 dark:text-amber-400 font-medium">${item.category}</span>
                  <span class="text-[10px] text-muted-foreground">• ${item.readTime}</span>
                </div>
                <div class="text-xs font-bold text-slate-900 dark:text-slate-100 group-hover:text-primary line-clamp-1 mt-0.5">${item.title}</div>
                <div class="text-[10px] text-slate-500 dark:text-slate-400 line-clamp-1">${item.excerpt}</div>
              </div>
              <span class="text-xs text-amber-600 dark:text-amber-400 font-bold shrink-0">Read →</span>
            </a>
          `;
        }

        // 4. Government Job Notification Result
        if (item.type === 'job') {
          return `
            <a
              href="${item.url}"
              class="search-nav-item w-full text-left p-2.5 rounded-xl border border-emerald-200/80 dark:border-emerald-900/60 bg-emerald-50/40 hover:bg-white dark:bg-slate-800/90 dark:hover:bg-slate-750 hover:border-emerald-500/50 transition flex items-center justify-between gap-3 group cursor-pointer shadow-2xs"
            >
              <div class="min-w-0 flex-1">
                <div class="flex items-center gap-1.5 flex-wrap">
                  <span class="px-1.5 py-0.2 rounded text-[9px] font-bold uppercase bg-emerald-100 dark:bg-emerald-950/70 text-emerald-800 dark:text-emerald-300 border border-emerald-300 dark:border-emerald-800">GOVT JOB</span>
                  <span class="font-bold text-slate-900 dark:text-slate-100 group-hover:text-primary">${item.shortCode || item.title}</span>
                  <span class="text-[10px] text-muted-foreground">• ${item.organization}</span>
                </div>
                <div class="text-xs text-slate-800 dark:text-slate-200 line-clamp-1 mt-0.5">${item.title}</div>
                <div class="flex items-center gap-2 text-[10px] text-emerald-700 dark:text-emerald-400 font-medium mt-0.5">
                  <span>Vacancies: <strong>${item.vacancies}</strong></span>
                  <span>•</span>
                  <span>Qual: ${item.qualification}</span>
                  <span>•</span>
                  <span>Last Date: ${item.lastDate}</span>
                </div>
              </div>
              <span class="text-xs text-emerald-600 dark:text-emerald-400 font-bold shrink-0">View Details →</span>
            </a>
          `;
        }

        return '';
      })
      .join('');

    searchResults.innerHTML = `
      <div class="text-[10px] uppercase font-bold text-slate-500 dark:text-slate-400 px-1 pb-1 flex justify-between">
        <span>Website Results (${activeFilterTab.toUpperCase()})</span>
        <span class="font-mono">${activeItems.length} found</span>
      </div>
      <div class="space-y-1.5">${itemsHtml}</div>
    `;

    attachPresetListeners(searchResults);
    searchResults.querySelectorAll('.search-nav-item').forEach((link) => {
      link.addEventListener('click', () => {
        closeSearchPopover();
      });
    });
  }

  headerSearchInput?.addEventListener('input', (e) => {
    renderFilteredResults(e.target.value);
  });

  searchClear?.addEventListener('click', () => {
    if (headerSearchInput) {
      headerSearchInput.value = '';
      headerSearchInput.focus();
      renderFilteredResults('');
    }
  });

  // Listen for custom trigger event from page buttons (like "Change Preset")
  window.addEventListener('open-header-preset-search', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
    openSearchPopover();
  });

  // -------------------------------------------------------------------------
  // 📱 Mobile Navigation Drawer Toggle & Interaction
  // -------------------------------------------------------------------------
  const mobileToggle = document.getElementById('mobile-menu-toggle');
  const mobileDrawer = document.getElementById('mobile-menu-drawer');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  function openMobileMenu() {
    mobileDrawer?.classList.remove('hidden');
    mobileToggle?.setAttribute('aria-expanded', 'true');
    hamburgerIcon?.classList.add('hidden');
    closeIcon?.classList.remove('hidden');
  }

  function closeMobileMenu() {
    mobileDrawer?.classList.add('hidden');
    mobileToggle?.setAttribute('aria-expanded', 'false');
    hamburgerIcon?.classList.remove('hidden');
    closeIcon?.classList.add('hidden');
  }

  function toggleMobileMenu() {
    if (mobileDrawer?.classList.contains('hidden')) {
      openMobileMenu();
    } else {
      closeMobileMenu();
    }
  }

  mobileToggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    toggleMobileMenu();
  });

  // Close mobile drawer when clicking any navigation link inside it
  mobileDrawer?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      closeMobileMenu();
    });
  });

  // Mobile "Search 40+ Exams" button opens the search popover
  document.getElementById('mobile-search-exam-btn')?.addEventListener('click', (e) => {
    e.stopPropagation();
    closeMobileMenu();
    openSearchPopover();
  });

  // Signature Dropdown Click & Touch Handler
  const signBtn = document.getElementById('signature-menu-btn');
  const signPanel = document.getElementById('signature-dropdown-panel');
  const signGroup = document.getElementById('signature-nav-group');

  function toggleSignDropdown(show) {
    if (show) {
      signPanel?.classList.add('!visible', '!opacity-100', '!pointer-events-auto');
      signBtn?.setAttribute('aria-expanded', 'true');
    } else {
      signPanel?.classList.remove('!visible', '!opacity-100', '!pointer-events-auto');
      signBtn?.setAttribute('aria-expanded', 'false');
    }
  }

  signBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isCurrentlyOpen = signPanel?.classList.contains('!visible');
    toggleSignDropdown(!isCurrentlyOpen);
  });

  // Close signature menu when clicking any link inside it
  signPanel?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      toggleSignDropdown(false);
    });
  });

  // Close mobile menu or signature dropdown if clicked outside
  document.addEventListener('click', (e) => {
    if (
      mobileDrawer &&
      !mobileDrawer.classList.contains('hidden') &&
      !mobileDrawer.contains(e.target) &&
      !mobileToggle?.contains(e.target)
    ) {
      closeMobileMenu();
    }

    if (signGroup && !signGroup.contains(e.target)) {
      toggleSignDropdown(false);
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      toggleSignDropdown(false);
      closeMobileMenu();
    }
  });
})();
</script>

