---
// Header.astro
import Logo from './Logo.astro';
import ExamNewsTicker from './ExamNewsTicker.astro';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHome = currentPath === '/';
const isPhoto = currentPath.startsWith('/photo-resizer');
const isDoc = currentPath.startsWith('/document-resizer');
const isCompress = currentPath.startsWith('/compress-image-to-kb');
const isCreator = currentPath.startsWith('/signature-creator');
const isGenerator = currentPath.startsWith('/signature-generator');
const isESign = currentPath.startsWith('/electronic-signature');
const isSign = isHome || isCreator || isGenerator || isESign || currentPath.includes('-signature-resize') || currentPath.includes('thumb-impression');
const isBlog = currentPath.startsWith('/blog');
const isJobs = currentPath.startsWith('/government-jobs') || currentPath.startsWith('/jobs');
---

<header class="sticky top-0 z-40 w-full max-w-full border-b border-border/80 bg-card/95 backdrop-blur-md transition-colors">
  <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-2 sm:gap-3">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-2 sm:gap-2.5 group shrink-0" aria-label="SignResize Home">
      <Logo class="w-8 h-8 sm:w-9 sm:h-9 rounded-xl shadow-md shadow-indigo-500/20 group-hover:scale-105 transition" />
      <div class="flex items-center gap-1 sm:gap-1.5">
        <span class="font-bold text-base sm:text-lg tracking-tight text-foreground">SignResize</span>
        <span class="px-1 sm:px-1.5 py-0.5 rounded text-[9px] sm:text-[10px] font-mono font-bold bg-primary/10 text-primary border border-primary/20">
          .in
        </span>
      </div>
    </a>

    <!-- Nav Links (Desktop & Large Screens) -->
    <nav class="hidden lg:flex items-center gap-1 lg:gap-1.5 text-xs">
      <!-- 1. Home -->
      <a
        href="/"
        class:list={[
          "px-2 lg:px-2.5 py-1.5 rounded-xl whitespace-nowrap transition-all duration-150 flex items-center gap-1 font-semibold",
          isHome
            ? "bg-primary/10 text-primary border border-primary/25 shadow-2xs"
            : "text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800"
        ]}
      >
        <span>Home</span>
      </a>

      <!-- 2. Photo Resizer -->

      <a
        href="/photo-resizer/"
        class:list={[
          "px-2 lg:px-2.5 py-1.5 rounded-xl whitespace-nowrap transition-all duration-150 flex items-center gap-1 font-semibold",
          isPhoto
            ? "bg-primary/10 text-primary border border-primary/25 shadow-2xs"
            : "text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800"
        ]}
      >
        <span>Photo Resizer</span>
      </a>

      <!-- 3. Document Resizer -->
      <a
        href="/document-resizer/"
        class:list={[
          "px-2 lg:px-2.5 py-1.5 rounded-xl whitespace-nowrap transition-all duration-150 flex items-center gap-1 font-semibold",
          isDoc
            ? "bg-primary/10 text-primary border border-primary/25 shadow-2xs"
            : "text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800"
        ]}
      >
        <span>Document Resizer</span>
      </a>

      <!-- 4. Signature Tab (Generator Tools Only) -->
      <div class="relative group py-2" id="signature-nav-group">
        <button
          type="button"
          id="signature-menu-btn"
          class:list={[
            "px-2.5 lg:px-3 py-1.5 rounded-xl whitespace-nowrap transition-all duration-150 flex items-center gap-1 font-semibold cursor-pointer",
            isSign
              ? "bg-primary/10 text-primary border border-primary/25 shadow-2xs"
              : "text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800"
          ]}
          aria-expanded="false"
          aria-haspopup="true"
        >
          <span>Signature</span>
          <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:rotate-180 opacity-70" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </button>

        <!-- Dropdown: All Signature Generator & Editing Tools -->
        <div
          id="signature-dropdown-panel"
          class="invisible group-hover:visible opacity-0 group-hover:opacity-100 transition-all duration-150 absolute left-0 top-full pt-1 z-50 pointer-events-none group-hover:pointer-events-auto"
          style="width: 360px; max-width: calc(100vw - 2rem);"
        >
          <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-[0_20px_50px_rgba(0,0,0,0.25)] dark:shadow-[0_25px_60px_rgba(0,0,0,0.85)] border-2 border-slate-200 dark:border-slate-700 p-3.5 ring-1 ring-black/5 dark:ring-white/10 pointer-events-auto space-y-3">
            <div class="flex items-center justify-between text-[10px] font-bold uppercase tracking-wider text-primary px-1 border-b border-slate-100 dark:border-slate-800 pb-1.5">
              <span>Signature Tools &amp; Generators</span>
              <span class="font-mono text-[9px] bg-primary/10 text-primary px-1.5 py-0.5 rounded">SUITE</span>
            </div>

            <div class="space-y-1">
              <!-- 1. Signature Resizer -->
              <a
                href="/resize-signature-to-10kb-20kb/"
                class="flex items-start gap-2.5 p-2 rounded-xl text-slate-800 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition group/item"
              >
                <span class="text-base p-1 rounded-lg bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 shrink-0">✍️</span>
                <div>
                  <div class="font-bold text-xs group-hover/item:text-primary">Signature Resizer (10–20 KB)</div>
                  <div class="text-[10px] text-muted-foreground leading-tight">Crop &amp; compress signature for SSC, Bank, Railway exams</div>
                </div>
              </a>

              <!-- 2. Signature Generator -->
              <a
                href="/signature-generator/"
                class="flex items-start gap-2.5 p-2 rounded-xl text-slate-800 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition group/item"
              >
                <span class="text-base p-1 rounded-lg bg-purple-500/10 text-purple-600 dark:text-purple-400 shrink-0">✨</span>
                <div>
                  <div class="font-bold text-xs group-hover/item:text-primary">Signature Generator</div>
                  <div class="text-[10px] text-muted-foreground leading-tight">Type name → instant cursive &amp; calligraphy fonts</div>
                </div>
              </a>

              <!-- 3. Electronic Signature Pad -->
              <a
                href="/electronic-signature/"
                class="flex items-start gap-2.5 p-2 rounded-xl text-slate-800 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition group/item"
              >
                <span class="text-base p-1 rounded-lg bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 shrink-0">🖋️</span>
                <div>
                  <div class="font-bold text-xs group-hover/item:text-primary">Electronic Signature (eSign Pad)</div>
                  <div class="text-[10px] text-muted-foreground leading-tight">Draw digital signature for PDFs, contracts &amp; forms</div>
                </div>
              </a>

              <!-- 4. Signature Creator & Maker -->
              <a
                href="/ssc-signature-resize/"
                class="flex items-start gap-2.5 p-2 rounded-xl text-slate-800 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition group/item"
              >
                <span class="text-base p-1 rounded-lg bg-blue-500/10 text-blue-600 dark:text-blue-400 shrink-0">🎨</span>
                <div>
                  <div class="font-bold text-xs group-hover/item:text-primary">SSC Signature Resizer (140×60)</div>
                  <div class="text-[10px] text-muted-foreground leading-tight">Official 10–20 KB preset for SSC CGL, CHSL, MTS</div>
                </div>
              </a>

              <!-- 5. Background Shadow Cleaner -->
              <a
                href="/make-signature-background-white/"
                class="flex items-start gap-2.5 p-2 rounded-xl text-slate-800 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition group/item"
              >
                <span class="text-base p-1 rounded-lg bg-amber-500/10 text-amber-600 dark:text-amber-400 shrink-0">🧹</span>
                <div>
                  <div class="font-bold text-xs group-hover/item:text-primary">Make Background 100% White</div>
                  <div class="text-[10px] text-muted-foreground leading-tight">Remove paper yellow tint &amp; camera shadows</div>
                </div>
              </a>
            </div>

            <!-- Outlook Signature Guide Featured Banner in Dropdown -->
            <div class="pt-2 border-t border-slate-200 dark:border-slate-700/60">
              <a
                href="/blog/how-to-change-signature-in-outlook/"
                class="flex items-center justify-between p-2 rounded-xl bg-gradient-to-r from-primary/10 via-primary/5 to-transparent border border-primary/20 hover:border-primary/40 transition group/guide"
              >
                <div class="flex items-center gap-2">
                  <span class="text-sm">📧</span>
                  <div>
                    <div class="text-[11px] font-bold text-primary group-hover/guide:underline">How to Change Signature in Outlook</div>
                    <div class="text-[9px] text-muted-foreground">Complete 2025 Desktop, Web &amp; Mobile Guide</div>
                  </div>
                </div>
                <span class="text-xs text-primary font-bold">→</span>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- 5. EXAMS & JOBS MERGED MEGA MENU -->
      <div class="relative group py-2">
        <button
          type="button"
          class="px-2 lg:px-2.5 py-1.5 rounded-xl whitespace-nowrap transition-all duration-150 flex items-center gap-1 text-xs font-semibold text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 cursor-pointer"
          aria-expanded="false"
          aria-haspopup="true"
        >
          <span>Exams &amp; Jobs</span>
          <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:rotate-180 opacity-70" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </button>

        <!-- Dropdown Panel (Compact High-Density Mega Menu) -->
        <div class="invisible group-hover:visible opacity-0 group-hover:opacity-100 transition-all duration-150 absolute left-1/2 -translate-x-1/2 mt-1 w-[680px] max-w-[94vw] bg-white dark:bg-slate-900 rounded-2xl shadow-[0_20px_45px_rgba(0,0,0,0.2)] dark:shadow-[0_25px_50px_rgba(0,0,0,0.8)] border border-slate-200 dark:border-slate-800 p-3 sm:p-3.5 z-50 ring-1 ring-black/5 dark:ring-white/10">
          <div class="grid grid-cols-2 md:grid-cols-4 gap-2.5 sm:gap-3 text-xs">
            
            <!-- Column 1: Central & Banking -->
            <div class="space-y-1">
              <div class="font-bold text-[10px] text-primary uppercase tracking-wider px-1 pb-1 border-b border-slate-100 dark:border-slate-800/80 flex items-center gap-1">
                <span>Central &amp; Banking</span>
              </div>
              <ul class="space-y-0.5">
                <li>
                  <button type="button" class="preset-btn text-left text-slate-800 dark:text-slate-200 hover:text-primary hover:bg-slate-100 dark:hover:bg-slate-800 px-2 py-1.5 rounded-lg w-full transition flex items-center justify-between gap-1 group/item cursor-pointer text-[11px]" data-exam="ssc">
                    <span class="truncate font-medium">SSC (CGL, CHSL, MTS)</span>
                    <span class="text-[9px] font-mono px-1 py-0.5 rounded bg-muted/60 text-muted-foreground group-hover/item:text-primary group-hover/item:bg-primary/10 shrink-0">140×60</span>
                  </button>
                </li>
                <li>
                  <button type="button" class="preset-btn text-left text-slate-800 dark:text-slate-200 hover:text-primary hover:bg-slate-100 dark:hover:bg-slate-800 px-2 py-1.5 rounded-lg w-full transition flex items-center justify-between gap-1 group/item cursor-pointer text-[11px]" data-exam="ibps">
                    <span class="truncate font-medium">IBPS PO &amp; Clerk</span>
                    <span class="text-[9px] font-mono px-1 py-0.5 rounded bg-muted/60 text-muted-foreground group-hover/item:text-primary group-hover/item:bg-primary/10 shrink-0">10–20K</span>
                  </button>
                </li>
                <li>
                  <a href="/sbi-signature-resize/" class="text-left text-slate-800 dark:text-slate-200 hover:text-primary hover:bg-muted px-2 py-1.5 rounded-lg w-full transition flex items-center justify-between gap-1 text-[11px]">
                    <span class="truncate font-medium">SBI Signature Resizer</span>
                    <span class="text-[9px] font-mono px-1 py-0.5 rounded bg-muted/60 text-muted-foreground group-hover/item:text-primary group-hover/item:bg-primary/10 shrink-0">10?20 KB</span>
                  </a>
                </li>
                <li>
                  <button type="button" class="preset-btn text-left text-slate-800 dark:text-slate-200 hover:text-primary hover:bg-slate-100 dark:hover:bg-slate-800 px-2 py-1.5 rounded-lg w-full transition flex items-center justify-between gap-1 group/item cursor-pointer text-[11px]" data-exam="upsc">
                    <span class="truncate font-medium">UPSC (IAS, NDA, CDS)</span>
                    <span class="text-[9px] font-mono px-1 py-0.5 rounded bg-muted/60 text-muted-foreground group-hover/item:text-primary group-hover/item:bg-primary/10 shrink-0">350×350</span>
                  </button>
                </li>
                <li>
                  <button type="button" class="preset-btn text-left text-slate-800 dark:text-slate-200 hover:text-primary hover:bg-slate-100 dark:hover:bg-slate-800 px-2 py-1.5 rounded-lg w-full transition flex items-center justify-between gap-1 group/item cursor-pointer text-[11px]" data-exam="rbi">
                    <span class="truncate font-medium">RBI Grade B &amp; Asst</span>
                    <span class="text-[9px] font-mono px-1 py-0.5 rounded bg-muted/60 text-muted-foreground group-hover/item:text-primary group-hover/item:bg-primary/10 shrink-0">10–20K</span>
                  </button>
                </li>
              </ul>
            </div>

            <!-- Column 2: Railways & Defense -->
            <div class="space-y-1">
              <div class="font-bold text-[10px] text-primary uppercase tracking-wider px-1 pb-1 border-b border-slate-100 dark:border-slate-800/80 flex items-center gap-1">
                <span>Railways &amp; Defense</span>
              </div>
              <ul class="space-y-0.5">
                <li>
                  <button type="button" class="preset-btn text-left text-slate-800 dark:text-slate-200 hover:text-primary hover:bg-slate-100 dark:hover:bg-slate-800 px-2 py-1.5 rounded-lg w-full transition flex items-center justify-between gap-1 group/item cursor-pointer text-[11px]" data-exam="rrb">
                    <span class="truncate font-medium">RRB (NTPC, ALP, D)</span>
                    <span class="text-[9px] font-mono px-1 py-0.5 rounded bg-muted/60 text-muted-foreground group-hover/item:text-primary group-hover/item:bg-primary/10 shrink-0">140×60</span>
                  </button>
                </li>
                <li>
                  <button type="button" class="preset-btn text-left text-slate-800 dark:text-slate-200 hover:text-primary hover:bg-slate-100 dark:hover:bg-slate-800 px-2 py-1.5 rounded-lg w-full transition flex items-center justify-between gap-1 group/item cursor-pointer text-[11px]" data-exam="afcat">
                    <span class="truncate font-medium">AFCAT (Air Force)</span>
                    <span class="text-[9px] font-mono px-1 py-0.5 rounded bg-muted/60 text-muted-foreground group-hover/item:text-primary group-hover/item:bg-primary/10 shrink-0">10–50K</span>
                  </button>
                </li>
                <li>
                  <button type="button" class="preset-btn text-left text-slate-800 dark:text-slate-200 hover:text-primary hover:bg-slate-100 dark:hover:bg-slate-800 px-2 py-1.5 rounded-lg w-full transition flex items-center justify-between gap-1 group/item cursor-pointer text-[11px]" data-exam="agniveer">
                    <span class="truncate font-medium">Agniveer Rally</span>
                    <span class="text-[9px] font-mono px-1 py-0.5 rounded bg-muted/60 text-muted-foreground group-hover/item:text-primary group-hover/item:bg-primary/10 shrink-0">10–20K</span>
                  </button>
                </li>
                <li>
                  <button type="button" class="preset-btn text-left text-slate-800 dark:text-slate-200 hover:text-primary hover:bg-slate-100 dark:hover:bg-slate-800 px-2 py-1.5 rounded-lg w-full transition flex items-center justify-between gap-1 group/item cursor-pointer text-[11px]" data-exam="coastguard">
                    <span class="truncate font-medium">Coast Guard Navik</span>
                    <span class="text-[9px] font-mono px-1 py-0.5 rounded bg-muted/60 text-muted-foreground group-hover/item:text-primary group-hover/item:bg-primary/10 shrink-0">10–20K</span>
                  </button>
                </li>
              </ul>
            </div>

            <!-- Column 3: Entrance & Law -->
            <div class="space-y-1">
              <div class="font-bold text-[10px] text-primary uppercase tracking-wider px-1 pb-1 border-b border-slate-100 dark:border-slate-800/80 flex items-center gap-1">
                <span>Entrance &amp; Law</span>
              </div>
              <ul class="space-y-0.5">
                <li>
                  <button type="button" class="preset-btn text-left text-slate-800 dark:text-slate-200 hover:text-primary hover:bg-slate-100 dark:hover:bg-slate-800 px-2 py-1.5 rounded-lg w-full transition flex items-center justify-between gap-1 group/item cursor-pointer text-[11px]" data-exam="neet">
                    <span class="truncate font-medium">NEET / JEE Main</span>
                    <span class="text-[9px] font-mono px-1 py-0.5 rounded bg-muted/60 text-muted-foreground group-hover/item:text-primary group-hover/item:bg-primary/10 shrink-0">4–30K</span>
                  </button>
                </li>
                <li>
                  <button type="button" class="preset-btn text-left text-slate-800 dark:text-slate-200 hover:text-primary hover:bg-slate-100 dark:hover:bg-slate-800 px-2 py-1.5 rounded-lg w-full transition flex items-center justify-between gap-1 group/item cursor-pointer text-[11px]" data-exam="gate">
                    <span class="truncate font-medium">GATE 2027</span>
                    <span class="text-[9px] font-mono px-1 py-0.5 rounded bg-muted/60 text-muted-foreground group-hover/item:text-primary group-hover/item:bg-primary/10 shrink-0">5–200K</span>
                  </button>
                </li>
                <li>
                  <a href="/iit-jam-signature-resize/" class="text-left text-slate-800 dark:text-slate-200 hover:text-primary hover:bg-muted px-2 py-1.5 rounded-lg w-full transition flex items-center justify-between gap-1 text-[11px]">
                    <span class="truncate font-medium">IIT JAM 2027</span>
                    <span class="text-[9px] font-mono px-1 py-0.5 rounded bg-muted/60 text-muted-foreground group-hover/item:text-primary group-hover/item:bg-primary/10 shrink-0">50?150 KB</span>
                  </a>
                </li>
                <li>
                  <button type="button" class="preset-btn text-left text-slate-800 dark:text-slate-200 hover:text-primary hover:bg-slate-100 dark:hover:bg-slate-800 px-2 py-1.5 rounded-lg w-full transition flex items-center justify-between gap-1 group/item cursor-pointer text-[11px]" data-exam="cat">
                    <span class="truncate font-medium">CAT (IIMs)</span>
                    <span class="text-[9px] font-mono px-1 py-0.5 rounded bg-muted/60 text-muted-foreground group-hover/item:text-primary group-hover/item:bg-primary/10 shrink-0">10–80K</span>
                  </button>
                </li>
                <li>
                  <button type="button" class="preset-btn text-left text-slate-800 dark:text-slate-200 hover:text-primary hover:bg-slate-100 dark:hover:bg-slate-800 px-2 py-1.5 rounded-lg w-full transition flex items-center justify-between gap-1 group/item cursor-pointer text-[11px]" data-exam="clat">
                    <span class="truncate font-medium">CLAT &amp; AILET Law</span>
                    <span class="text-[9px] font-mono px-1 py-0.5 rounded bg-muted/60 text-muted-foreground group-hover/item:text-primary group-hover/item:bg-primary/10 shrink-0">10–50K</span>
                  </button>
                </li>
              </ul>
            </div>

            <!-- Column 4: Police & State PSC -->
            <div class="space-y-1">
              <div class="font-bold text-[10px] text-primary uppercase tracking-wider px-1 pb-1 border-b border-slate-100 dark:border-slate-800/80 flex items-center gap-1">
                <span>Police &amp; State PSC</span>
              </div>
              <ul class="space-y-0.5">
                <li>
                  <button type="button" class="preset-btn text-left text-slate-800 dark:text-slate-200 hover:text-primary hover:bg-slate-100 dark:hover:bg-slate-800 px-2 py-1.5 rounded-lg w-full transition flex items-center justify-between gap-1 group/item cursor-pointer text-[11px]" data-exam="pan">
                    <span class="truncate font-medium">PAN Card (NSDL/UTI)</span>
                    <span class="text-[9px] font-mono px-1 py-0.5 rounded bg-muted/60 text-muted-foreground group-hover/item:text-primary group-hover/item:bg-primary/10 shrink-0">400×200</span>
                  </button>
                </li>
                <li>
                  <button type="button" class="preset-btn text-left text-slate-800 dark:text-slate-200 hover:text-primary hover:bg-slate-100 dark:hover:bg-slate-800 px-2 py-1.5 rounded-lg w-full transition flex items-center justify-between gap-1 group/item cursor-pointer text-[11px]" data-exam="thumb">
                    <span class="truncate font-medium">Thumb Impression</span>
                    <span class="text-[9px] font-mono px-1 py-0.5 rounded bg-muted/60 text-muted-foreground group-hover/item:text-primary group-hover/item:bg-primary/10 shrink-0">10–50K</span>
                  </button>
                </li>
                <li>
                  <button type="button" class="preset-btn text-left text-slate-800 dark:text-slate-200 hover:text-primary hover:bg-slate-100 dark:hover:bg-slate-800 px-2 py-1.5 rounded-lg w-full transition flex items-center justify-between gap-1 group/item cursor-pointer text-[11px]" data-exam="uppsc">
                    <span class="truncate font-medium">UPPSC / BPSC / RPSC</span>
                    <span class="text-[9px] font-mono px-1 py-0.5 rounded bg-muted/60 text-muted-foreground group-hover/item:text-primary group-hover/item:bg-primary/10 shrink-0">PSC</span>
                  </button>
                </li>
                <li>
                  <button type="button" class="preset-btn text-left text-slate-800 dark:text-slate-200 hover:text-primary hover:bg-slate-100 dark:hover:bg-slate-800 px-2 py-1.5 rounded-lg w-full transition flex items-center justify-between gap-1 group/item cursor-pointer text-[11px]" data-exam="mpsc">
                    <span class="truncate font-medium">MPSC / Police Bharti</span>
