---
// Header.astro
import Logo from './Logo.astro';
import ExamNewsTicker from './ExamNewsTicker.astro';
import { EXAM_PRESETS } from '../data/examPresets';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHome = currentPath === '/';
const isPhoto = currentPath.startsWith('/photo-resizer');
const isDoc = currentPath.startsWith('/document-resizer');
const isCompress = currentPath.startsWith('/compress-image-to-kb');
const isCreator = currentPath.startsWith('/signature-creator');
const isGenerator = currentPath.startsWith('/signature-generator');
const isESign = currentPath.startsWith('/electronic-signature');
const isSign = isHome || isCreator || isGenerator || isESign || currentPath.includes('-signature-resize') || currentPath.includes('thumb-impression');
const isBlog = currentPath.startsWith('/blog');
const isJobs = currentPath.startsWith('/government-jobs') || currentPath.startsWith('/jobs');

// Compact JSON of all presets for instant client-side searching & dropdown display
const searchablePresets = EXAM_PRESETS.map((p) => ({
  id: p.id,
  name: p.name,
  shortCode: p.shortCode,
  category: p.category,
  widthPx: p.widthPx,
  heightPx: p.heightPx,
  minKb: p.minKb,
  maxKb: p.maxKb,
  inkRequirement: p.inkRequirement
}));
---

<header class="sticky top-0 z-40 w-full max-w-full border-b border-border/80 bg-card/95 backdrop-blur-md transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-3">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-2.5 group shrink-0" aria-label="SignResize Home">
      <Logo class="w-9 h-9 rounded-xl shadow-md shadow-indigo-500/20 group-hover:scale-105 transition" />
      <div class="flex items-center gap-1.5">
        <span class="font-bold text-lg tracking-tight text-foreground">SignResize</span>
        <span class="px-1.5 py-0.5 rounded text-[10px] font-mono font-bold bg-primary/10 text-primary border border-primary/20">
          .in
        </span>
      </div>
    </a>

    <!-- Nav Links (Desktop & Tablet) -->
    <nav class="hidden md:flex items-center gap-1 lg:gap-1.5 text-xs">
      <!-- 1. Home -->
      <a
        href="/"
        class:list={[
          "px-2 lg:px-2.5 py-1.5 rounded-xl whitespace-nowrap transition-all duration-150 flex items-center gap-1 font-semibold",
          isHome
            ? "bg-primary/10 text-primary border border-primary/25 shadow-2xs"
            : "text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800"
        ]}
      >
        <span>Home</span>
      </a>

      <!-- 2. Photo Resizer -->

      <a
        href="/photo-resizer/"
        class:list={[
          "px-2 lg:px-2.5 py-1.5 rounded-xl whitespace-nowrap transition-all duration-150 flex items-center gap-1 font-semibold",
          isPhoto
            ? "bg-primary/10 text-primary border border-primary/25 shadow-2xs"
            : "text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800"
        ]}
      >
        <span>Photo Resizer</span>
      </a>

      <!-- 3. Document Resizer -->
      <a
        href="/document-resizer/"
        class:list={[
          "px-2 lg:px-2.5 py-1.5 rounded-xl whitespace-nowrap transition-all duration-150 flex items-center gap-1 font-semibold",
          isDoc
            ? "bg-primary/10 text-primary border border-primary/25 shadow-2xs"
            : "text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800"
        ]}
      >
        <span>Document Resizer</span>
      </a>

      <!-- 4. Signature Tab (Generator Tools Only) -->
      <div class="relative group py-2" id="signature-nav-group">
        <button
          type="button"
          id="signature-menu-btn"
          class:list={[
            "px-2.5 lg:px-3 py-1.5 rounded-xl whitespace-nowrap transition-all duration-150 flex items-center gap-1 font-semibold cursor-pointer",
            isSign
              ? "bg-primary/10 text-primary border border-primary/25 shadow-2xs"
              : "text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800"
          ]}
          aria-expanded="false"
          aria-haspopup="true"
        >
          <span>Signature</span>
          <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:rotate-180 opacity-70" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </button>

        <!-- Dropdown: All Signature Generator & Editing Tools -->
        <div
          id="signature-dropdown-panel"
          class="invisible group-hover:visible opacity-0 group-hover:opacity-100 transition-all duration-150 absolute left-0 top-full pt-1 z-50 pointer-events-none group-hover:pointer-events-auto"
          style="width: 360px; max-width: calc(100vw - 2rem);"
        >
          <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-[0_20px_50px_rgba(0,0,0,0.25)] dark:shadow-[0_25px_60px_rgba(0,0,0,0.85)] border-2 border-slate-200 dark:border-slate-700 p-3.5 ring-1 ring-black/5 dark:ring-white/10 pointer-events-auto space-y-3">
            <div class="flex items-center justify-between text-[10px] font-bold uppercase tracking-wider text-primary px-1 border-b border-slate-100 dark:border-slate-800 pb-1.5">
              <span>Signature Tools &amp; Generators</span>
              <span class="font-mono text-[9px] bg-primary/10 text-primary px-1.5 py-0.5 rounded">SUITE</span>
            </div>

            <div class="space-y-1">
              <!-- 1. Signature Resizer -->
              <a
                href="/#tool-workspace"
                class="flex items-start gap-2.5 p-2 rounded-xl text-slate-800 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition group/item"
              >
                <span class="text-base p-1 rounded-lg bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 shrink-0">✍️</span>
                <div>
                  <div class="font-bold text-xs group-hover/item:text-primary">Signature Resizer (10–20 KB)</div>
                  <div class="text-[10px] text-muted-foreground leading-tight">Crop &amp; compress signature for SSC, Bank, Railway exams</div>
                </div>
              </a>

              <!-- 2. Signature Generator -->
              <a
                href="/signature-generator/"
                class="flex items-start gap-2.5 p-2 rounded-xl text-slate-800 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition group/item"
              >
                <span class="text-base p-1 rounded-lg bg-purple-500/10 text-purple-600 dark:text-purple-400 shrink-0">✨</span>
                <div>
                  <div class="font-bold text-xs group-hover/item:text-primary">Signature Generator</div>
                  <div class="text-[10px] text-muted-foreground leading-tight">Type name → instant cursive &amp; calligraphy fonts</div>
                </div>
              </a>

              <!-- 3. Electronic Signature Pad -->
              <a
                href="/electronic-signature/"
                class="flex items-start gap-2.5 p-2 rounded-xl text-slate-800 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition group/item"
              >
                <span class="text-base p-1 rounded-lg bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 shrink-0">🖋️</span>
                <div>
                  <div class="font-bold text-xs group-hover/item:text-primary">Electronic Signature (eSign Pad)</div>
                  <div class="text-[10px] text-muted-foreground leading-tight">Draw digital signature for PDFs, contracts &amp; forms</div>
                </div>
              </a>

              <!-- 4. Signature Creator & Maker -->
              <a
                href="/signature-creator/"
                class="flex items-start gap-2.5 p-2 rounded-xl text-slate-800 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition group/item"
              >
                <span class="text-base p-1 rounded-lg bg-blue-500/10 text-blue-600 dark:text-blue-400 shrink-0">🎨</span>
                <div>
                  <div class="font-bold text-xs group-hover/item:text-primary">Signature Creator &amp; Maker</div>
                  <div class="text-[10px] text-muted-foreground leading-tight">Design, draw &amp; export transparent signature PNG</div>
                </div>
              </a>

              <!-- 5. Background Shadow Cleaner -->
              <a
                href="/?filter=clean#tool-workspace"
                class="flex items-start gap-2.5 p-2 rounded-xl text-slate-800 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition group/item"
              >
                <span class="text-base p-1 rounded-lg bg-amber-500/10 text-amber-600 dark:text-amber-400 shrink-0">🧹</span>
                <div>
                  <div class="font-bold text-xs group-hover/item:text-primary">Make Background 100% White</div>
                  <div class="text-[10px] text-muted-foreground leading-tight">Remove paper yellow tint &amp; camera shadows</div>
                </div>
              </a>
            </div>

            <!-- Outlook Signature Guide Featured Banner in Dropdown -->
            <div class="pt-2 border-t border-slate-200 dark:border-slate-700/60">
              <a
                href="/blog/how-to-change-signature-in-outlook/"
                class="flex items-center justify-between p-2 rounded-xl bg-gradient-to-r from-primary/10 via-primary/5 to-transparent border border-primary/20 hover:border-primary/40 transition group/guide"
              >
                <div class="flex items-center gap-2">
                  <span class="text-sm">📧</span>
                  <div>
                    <div class="text-[11px] font-bold text-primary group-hover/guide:underline">How to Change Signature in Outlook</div>
                    <div class="text-[9px] text-muted-foreground">Complete 2025 Desktop, Web &amp; Mobile Guide</div>
                  </div>
                </div>
                <span class="text-xs text-primary font-bold">→</span>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- 5. EXAMS & JOBS MERGED MEGA MENU -->
      <div class="relative group py-2">
        <button
          type="button"
          class="px-2 lg:px-2.5 py-1.5 rounded-xl whitespace-nowrap transition-all duration-150 flex items-center gap-1 text-xs font-semibold text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 cursor-pointer"
          aria-expanded="false"
          aria-haspopup="true"
        >
          <span>Exams &amp; Jobs</span>
          <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:rotate-180 opacity-70" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </button>

        <!-- Dropdown Panel (Solid Opaque High-Contrast Mega Menu) -->
        <div class="invisible group-hover:visible opacity-0 group-hover:opacity-100 transition-all duration-150 absolute left-1/2 -translate-x-1/2 mt-1 w-[820px] max-w-[92vw] bg-white dark:bg-slate-900 rounded-2xl shadow-[0_20px_50px_rgba(0,0,0,0.25)] dark:shadow-[0_25px_60px_rgba(0,0,0,0.85)] border-2 border-slate-300 dark:border-slate-700 p-5 z-50 ring-1 ring-black/5 dark:ring-white/10">
          <div class="grid grid-cols-2 md:grid-cols-4 gap-5 text-xs">
            
            <!-- Column 1: Central & Banking -->
            <div>
              <div class="font-bold text-[11px] text-primary uppercase tracking-wider mb-2 flex items-center gap-1">
                <span>Central &amp; Banking</span>
              </div>
              <ul class="space-y-1">
                <li><button type="button" class="preset-btn text-left text-slate-800 dark:text-slate-200 hover:text-primary hover:bg-slate-100 dark:hover:bg-slate-800 px-3 py-2.5 min-h-[44px] rounded-lg w-full transition flex items-center justify-between group/item cursor-pointer" data-exam="ssc"><span>SSC (CGL, CHSL, MTS)</span><span class="text-[10px] text-muted-foreground group-hover/item:text-primary">140×60</span></button></li>
                <li><button type="button" class="preset-btn text-left text-slate-800 dark:text-slate-200 hover:text-primary hover:bg-slate-100 dark:hover:bg-slate-800 px-3 py-2.5 min-h-[44px] rounded-lg w-full transition flex items-center justify-between group/item cursor-pointer" data-exam="ibps"><span>IBPS / SBI PO &amp; Clerk</span><span class="text-[10px] text-muted-foreground group-hover/item:text-primary">10–20KB</span></button></li>
                <li><button type="button" class="preset-btn text-left text-slate-800 dark:text-slate-200 hover:text-primary hover:bg-slate-100 dark:hover:bg-slate-800 px-3 py-2.5 min-h-[44px] rounded-lg w-full transition flex items-center justify-between group/item cursor-pointer" data-exam="upsc"><span>UPSC (IAS, NDA, CDS)</span><span class="text-[10px] text-muted-foreground group-hover/item:text-primary">350×350</span></button></li>
                <li><button type="button" class="preset-btn text-left text-slate-800 dark:text-slate-200 hover:text-primary hover:bg-slate-100 dark:hover:bg-slate-800 px-3 py-2.5 min-h-[44px] rounded-lg w-full transition flex items-center justify-between group/item cursor-pointer" data-exam="rbi"><span>RBI Grade B &amp; Assistant</span><span class="text-[10px] text-muted-foreground group-hover/item:text-primary">10–20KB</span></button></li>
              </ul>
            </div>

            <!-- Column 2: Railways & Defense -->
            <div>
              <div class="font-bold text-[11px] text-primary uppercase tracking-wider mb-2 flex items-center gap-1">
                <span>Railways &amp; Defense</span>
              </div>
              <ul class="space-y-1">
                <li><button type="button" class="preset-btn text-left text-slate-800 dark:text-slate-200 hover:text-primary hover:bg-slate-100 dark:hover:bg-slate-800 px-3 py-2.5 min-h-[44px] rounded-lg w-full transition flex items-center justify-between group/item cursor-pointer" data-exam="rrb"><span>RRB (NTPC, ALP, Group D)</span><span class="text-[10px] text-muted-foreground group-hover/item:text-primary">140×60</span></button></li>
                <li><button type="button" class="preset-btn text-left text-slate-800 dark:text-slate-200 hover:text-primary hover:bg-slate-100 dark:hover:bg-slate-800 px-3 py-2.5 min-h-[44px] rounded-lg w-full transition flex items-center justify-between group/item cursor-pointer" data-exam="afcat"><span>AFCAT (Air Force)</span><span class="text-[10px] text-muted-foreground group-hover/item:text-primary">10–50KB</span></button></li>
                <li><button type="button" class="preset-btn text-left text-slate-800 dark:text-slate-200 hover:text-primary hover:bg-slate-100 dark:hover:bg-slate-800 px-3 py-2.5 min-h-[44px] rounded-lg w-full transition flex items-center justify-between group/item cursor-pointer" data-exam="agniveer"><span>Agniveer Recruitment</span><span class="text-[10px] text-muted-foreground group-hover/item:text-primary">10–20KB</span></button></li>
                <li><button type="button" class="preset-btn text-left text-slate-800 dark:text-slate-200 hover:text-primary hover:bg-slate-100 dark:hover:bg-slate-800 px-3 py-2.5 min-h-[44px] rounded-lg w-full transition flex items-center justify-between group/item cursor-pointer" data-exam="coastguard"><span>Indian Coast Guard</span><span class="text-[10px] text-muted-foreground group-hover/item:text-primary">10–20KB</span></button></li>
              </ul>
            </div>

            <!-- Column 3: Entrance & Law -->
            <div>
              <div class="font-bold text-[11px] text-primary uppercase tracking-wider mb-2 flex items-center gap-1">
                <span>Entrance &amp; Law</span>
              </div>
              <ul class="space-y-1">
                <li><button type="button" class="preset-btn text-left text-slate-800 dark:text-slate-200 hover:text-primary hover:bg-slate-100 dark:hover:bg-slate-800 px-3 py-2.5 min-h-[44px] rounded-lg w-full transition flex items-center justify-between group/item cursor-pointer" data-exam="neet"><span>NEET / JEE Main (NTA)</span><span class="text-[10px] text-muted-foreground group-hover/item:text-primary">4–30KB</span></button></li>
                <li><button type="button" class="preset-btn text-left text-slate-800 dark:text-slate-200 hover:text-primary hover:bg-slate-100 dark:hover:bg-slate-800 px-3 py-2.5 min-h-[44px] rounded-lg w-full transition flex items-center justify-between group/item cursor-pointer" data-exam="gate"><span>GATE &amp; IIT JAM</span><span class="text-[10px] text-muted-foreground group-hover/item:text-primary">5–200KB</span></button></li>
                <li><button type="button" class="preset-btn text-left text-slate-800 dark:text-slate-200 hover:text-primary hover:bg-slate-100 dark:hover:bg-slate-800 px-3 py-2.5 min-h-[44px] rounded-lg w-full transition flex items-center justify-between group/item cursor-pointer" data-exam="cat"><span>CAT (IIMs)</span><span class="text-[10px] text-muted-foreground group-hover/item:text-primary">10–80KB</span></button></li>
                <li><button type="button" class="preset-btn text-left text-slate-800 dark:text-slate-200 hover:text-primary hover:bg-slate-100 dark:hover:bg-slate-800 px-3 py-2.5 min-h-[44px] rounded-lg w-full transition flex items-center justify-between group/item cursor-pointer" data-exam="clat"><span>CLAT &amp; AILET (Law)</span><span class="text-[10px] text-muted-foreground group-hover/item:text-primary">10–50KB</span></button></li>
              </ul>
            </div>

            <!-- Column 4: Identity & State PSC -->
            <div>
              <div class="font-bold text-[11px] text-primary uppercase tracking-wider mb-2 flex items-center gap-1">
                <span>Identity &amp; State PSC</span>
              </div>
              <ul class="space-y-1">
                <li><button type="button" class="preset-btn text-left text-slate-800 dark:text-slate-200 hover:text-primary hover:bg-slate-100 dark:hover:bg-slate-800 px-3 py-2.5 min-h-[44px] rounded-lg w-full transition flex items-center justify-between group/item cursor-pointer" data-exam="pan"><span>PAN Card (NSDL/UTI)</span><span class="text-[10px] text-muted-foreground group-hover/item:text-primary">400×200</span></button></li>
                <li><button type="button" class="preset-btn text-left text-slate-800 dark:text-slate-200 hover:text-primary hover:bg-slate-100 dark:hover:bg-slate-800 px-3 py-2.5 min-h-[44px] rounded-lg w-full transition flex items-center justify-between group/item cursor-pointer" data-exam="thumb"><span>Thumb Impression (1:1)</span><span class="text-[10px] text-muted-foreground group-hover/item:text-primary">10–50KB</span></button></li>
                <li><button type="button" class="preset-btn text-left text-slate-800 dark:text-slate-200 hover:text-primary hover:bg-slate-100 dark:hover:bg-slate-800 px-3 py-2.5 min-h-[44px] rounded-lg w-full transition flex items-center justify-between group/item cursor-pointer" data-exam="uppsc"><span>UPPSC / BPSC</span><span class="text-[10px] text-muted-foreground group-hover/item:text-primary">State PSC</span></button></li>
                <li><button type="button" class="preset-btn text-left text-slate-800 dark:text-slate-200 hover:text-primary hover:bg-slate-100 dark:hover:bg-slate-800 px-3 py-2.5 min-h-[44px] rounded-lg w-full transition flex items-center justify-between group/item cursor-pointer" data-exam="mpsc"><span>MPSC / TNPSC</span><span class="text-[10px] text-muted-foreground group-hover/item:text-primary">State PSC</span></button></li>
              </ul>
            </div>

          </div>

          <!-- Mega Menu Footer -->
          <div class="mt-4 pt-3 border-t border-slate-200 dark:border-slate-800 flex items-center justify-between text-xs text-muted-foreground">
            <a href="/government-jobs/" class:list={["text-primary font-bold hover:underline flex items-center gap-1", isJobs ? "text-primary" : ""]}>
              <span>🏛️ Govt Jobs Board</span>
            </a>
            <a href="/#exam-specs" class="text-primary font-bold hover:underline flex items-center gap-1">
              <span>View Full 40+ Exam Table</span>
              <span>↓</span>
            </a>
          </div>
        </div>
      </div>
      <!-- 6. Blog -->
      <a
        href="/blog/"
        class:list={[
          "px-2 lg:px-2.5 py-1.5 rounded-xl whitespace-nowrap transition-all duration-150 flex items-center gap-1.5 font-semibold",
          isBlog
            ? "bg-primary/10 text-primary border border-primary/25 shadow-2xs"
            : "text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800"
        ]}
        title="Daily Exam Alerts & Blog"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-amber-500 shrink-0"></span>
        <span>Blog</span>
      </a>
    </nav>

    <!-- Right Controls: Language Selector, Dark Mode Toggle, Search Bar & Mobile Hamburger -->
    <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
      <!-- 🌐 Language Selector Dropdown (English | हिंदी | मराठी) -->
      <div id="language-selector-container" class="relative">
        <button
          type="button"
          id="language-selector-trigger"
          class="flex items-center gap-1.5 px-2.5 sm:px-3 py-2 min-h-[44px] rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 hover:border-primary/60 text-foreground transition text-xs shadow-2xs group focus:outline-none focus:ring-2 focus:ring-primary/40 cursor-pointer shrink-0 font-medium"
          aria-expanded="false"
          aria-haspopup="listbox"
          title="Change language / भाषा बदलें / भाषा बदला"
        >
          <span class="text-sm">🌐</span>
          <span id="header-current-lang-label" class="font-bold text-slate-800 dark:text-slate-200 text-xs">EN</span>
          <svg class="w-3 h-3 text-slate-400 group-hover:text-primary transition-transform duration-150" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <!-- Dropdown Menu -->
        <div
          id="language-dropdown-menu"
          class="hidden absolute right-0 top-full mt-2 w-44 bg-white dark:bg-slate-900 rounded-2xl shadow-[0_15px_40px_rgba(0,0,0,0.2)] dark:shadow-[0_20px_50px_rgba(0,0,0,0.8)] border border-slate-200 dark:border-slate-700 p-1.5 z-50 flex flex-col space-y-1"
          role="listbox"
        >
          <a
            href="/"
            data-lang="en"
            class="lang-option flex items-center justify-between px-3 py-2 rounded-xl text-xs font-semibold hover:bg-slate-100 dark:hover:bg-slate-800 transition cursor-pointer text-slate-700 dark:text-slate-200"
          >
            <div class="flex items-center gap-2">
              <span>🇬🇧</span>
              <span>English</span>
            </div>
            <span class="lang-check hidden text-primary font-bold">✓</span>
          </a>
          <a
            href="/hi/"
            data-lang="hi"
            class="lang-option flex items-center justify-between px-3 py-2 rounded-xl text-xs font-semibold hover:bg-slate-100 dark:hover:bg-slate-800 transition cursor-pointer text-slate-700 dark:text-slate-200"
          >
            <div class="flex items-center gap-2">
