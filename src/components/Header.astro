---
// Header.astro
import Logo from './Logo.astro';
import { EXAM_PRESETS } from '../data/examPresets';

// Compact JSON of all presets for instant client-side searching & dropdown display
const searchablePresets = EXAM_PRESETS.map((p) => ({
  id: p.id,
  name: p.name,
  shortCode: p.shortCode,
  category: p.category,
  widthPx: p.widthPx,
  heightPx: p.heightPx,
  minKb: p.minKb,
  maxKb: p.maxKb,
  inkRequirement: p.inkRequirement
}));
---

<header class="sticky top-0 z-40 w-full border-b border-border/80 bg-card/85 backdrop-blur-md transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-2.5 group shrink-0">
      <Logo class="w-9 h-9 rounded-xl shadow-md shadow-indigo-500/20 group-hover:scale-105 transition" />
      <div>
        <div class="flex items-center gap-1.5">
          <span class="font-bold text-lg tracking-tight text-foreground">SignResize</span>
          <span class="px-1.5 py-0.5 rounded text-[10px] font-mono font-bold bg-primary/10 text-primary border border-primary/20">
            .in
          </span>
        </div>
        <p class="text-[10px] text-muted-foreground hidden sm:block">Govt Exam Signature Resizer</p>
      </div>
    </a>

    <!-- Nav Links (Desktop) -->
    <nav class="hidden md:flex items-center gap-5 text-xs font-semibold text-muted-foreground">
      <a href="/#tool-workspace" class="hover:text-primary transition flex items-center gap-1">
        <span>Resizer</span>
      </a>
      <a href="/compress-image-to-kb" class="hover:text-primary transition flex items-center gap-1">
        <span class="text-primary font-bold">Compress Image</span>
      </a>
      <a href="/signature-creator" class="hover:text-primary transition">
        <span>Signature Creator</span>
      </a>

      <!-- EXAMS & PORTALS DEDICATED MEGA MENU -->
      <div class="relative group py-2">
        <button
          type="button"
          class="hover:text-primary transition flex items-center gap-1.5 text-xs font-semibold text-muted-foreground group-hover:text-primary focus:outline-none cursor-pointer"
          aria-expanded="false"
          aria-haspopup="true"
        >
          <span>All Exams &amp; Portals</span>
          <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:rotate-180" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </button>

        <!-- Dropdown Panel (4-Column Mega Menu) -->
        <div class="invisible group-hover:visible opacity-0 group-hover:opacity-100 transition-all duration-150 absolute left-1/2 -translate-x-1/2 mt-1 w-[820px] max-w-[92vw] bg-card/95 backdrop-blur-md rounded-2xl shadow-2xl border border-border p-5 z-50">
          <div class="grid grid-cols-2 md:grid-cols-4 gap-5 text-xs">
            
            <!-- Column 1: Central & Banking -->
            <div>
              <h4 class="font-bold text-[11px] text-primary uppercase tracking-wider mb-2 flex items-center gap-1">
                <span>Central &amp; Banking</span>
              </h4>
              <ul class="space-y-1">
                <li><button type="button" class="preset-btn text-left text-foreground hover:text-primary hover:bg-muted/60 px-2 py-1.5 rounded-lg w-full transition flex items-center justify-between group/item cursor-pointer" data-exam="ssc"><span>SSC (CGL, CHSL, MTS)</span><span class="text-[10px] text-muted-foreground group-hover/item:text-primary">140×60</span></button></li>
                <li><button type="button" class="preset-btn text-left text-foreground hover:text-primary hover:bg-muted/60 px-2 py-1.5 rounded-lg w-full transition flex items-center justify-between group/item cursor-pointer" data-exam="ibps"><span>IBPS / SBI PO &amp; Clerk</span><span class="text-[10px] text-muted-foreground group-hover/item:text-primary">10–20KB</span></button></li>
                <li><button type="button" class="preset-btn text-left text-foreground hover:text-primary hover:bg-muted/60 px-2 py-1.5 rounded-lg w-full transition flex items-center justify-between group/item cursor-pointer" data-exam="upsc"><span>UPSC (IAS, NDA, CDS)</span><span class="text-[10px] text-muted-foreground group-hover/item:text-primary">350×350</span></button></li>
                <li><button type="button" class="preset-btn text-left text-foreground hover:text-primary hover:bg-muted/60 px-2 py-1.5 rounded-lg w-full transition flex items-center justify-between group/item cursor-pointer" data-exam="rbi"><span>RBI Grade B &amp; Assistant</span><span class="text-[10px] text-muted-foreground group-hover/item:text-primary">10–20KB</span></button></li>
              </ul>
            </div>

            <!-- Column 2: Railways & Defense -->
            <div>
              <h4 class="font-bold text-[11px] text-primary uppercase tracking-wider mb-2 flex items-center gap-1">
                <span>Railways &amp; Defense</span>
              </h4>
              <ul class="space-y-1">
                <li><button type="button" class="preset-btn text-left text-foreground hover:text-primary hover:bg-muted/60 px-2 py-1.5 rounded-lg w-full transition flex items-center justify-between group/item cursor-pointer" data-exam="rrb"><span>RRB (NTPC, ALP, Group D)</span><span class="text-[10px] text-muted-foreground group-hover/item:text-primary">140×60</span></button></li>
                <li><button type="button" class="preset-btn text-left text-foreground hover:text-primary hover:bg-muted/60 px-2 py-1.5 rounded-lg w-full transition flex items-center justify-between group/item cursor-pointer" data-exam="afcat"><span>AFCAT (Air Force)</span><span class="text-[10px] text-muted-foreground group-hover/item:text-primary">10–50KB</span></button></li>
                <li><button type="button" class="preset-btn text-left text-foreground hover:text-primary hover:bg-muted/60 px-2 py-1.5 rounded-lg w-full transition flex items-center justify-between group/item cursor-pointer" data-exam="agniveer"><span>Agniveer Recruitment</span><span class="text-[10px] text-muted-foreground group-hover/item:text-primary">10–20KB</span></button></li>
                <li><button type="button" class="preset-btn text-left text-foreground hover:text-primary hover:bg-muted/60 px-2 py-1.5 rounded-lg w-full transition flex items-center justify-between group/item cursor-pointer" data-exam="coastguard"><span>Indian Coast Guard</span><span class="text-[10px] text-muted-foreground group-hover/item:text-primary">10–20KB</span></button></li>
              </ul>
            </div>

            <!-- Column 3: Entrance & Law -->
            <div>
              <h4 class="font-bold text-[11px] text-primary uppercase tracking-wider mb-2 flex items-center gap-1">
                <span>Entrance &amp; Law</span>
              </h4>
              <ul class="space-y-1">
                <li><button type="button" class="preset-btn text-left text-foreground hover:text-primary hover:bg-muted/60 px-2 py-1.5 rounded-lg w-full transition flex items-center justify-between group/item cursor-pointer" data-exam="neet"><span>NEET / JEE Main (NTA)</span><span class="text-[10px] text-muted-foreground group-hover/item:text-primary">4–30KB</span></button></li>
                <li><button type="button" class="preset-btn text-left text-foreground hover:text-primary hover:bg-muted/60 px-2 py-1.5 rounded-lg w-full transition flex items-center justify-between group/item cursor-pointer" data-exam="gate"><span>GATE &amp; IIT JAM</span><span class="text-[10px] text-muted-foreground group-hover/item:text-primary">5–200KB</span></button></li>
                <li><button type="button" class="preset-btn text-left text-foreground hover:text-primary hover:bg-muted/60 px-2 py-1.5 rounded-lg w-full transition flex items-center justify-between group/item cursor-pointer" data-exam="cat"><span>CAT (IIMs)</span><span class="text-[10px] text-muted-foreground group-hover/item:text-primary">10–80KB</span></button></li>
                <li><button type="button" class="preset-btn text-left text-foreground hover:text-primary hover:bg-muted/60 px-2 py-1.5 rounded-lg w-full transition flex items-center justify-between group/item cursor-pointer" data-exam="clat"><span>CLAT &amp; AILET (Law)</span><span class="text-[10px] text-muted-foreground group-hover/item:text-primary">10–50KB</span></button></li>
              </ul>
            </div>

            <!-- Column 4: Identity & State PSC -->
            <div>
              <h4 class="font-bold text-[11px] text-primary uppercase tracking-wider mb-2 flex items-center gap-1">
                <span>Identity &amp; State PSC</span>
              </h4>
              <ul class="space-y-1">
                <li><button type="button" class="preset-btn text-left text-foreground hover:text-primary hover:bg-muted/60 px-2 py-1.5 rounded-lg w-full transition flex items-center justify-between group/item cursor-pointer" data-exam="pan"><span>PAN Card (NSDL/UTI)</span><span class="text-[10px] text-muted-foreground group-hover/item:text-primary">400×200</span></button></li>
                <li><button type="button" class="preset-btn text-left text-foreground hover:text-primary hover:bg-muted/60 px-2 py-1.5 rounded-lg w-full transition flex items-center justify-between group/item cursor-pointer" data-exam="thumb"><span>Thumb Impression (1:1)</span><span class="text-[10px] text-muted-foreground group-hover/item:text-primary">10–50KB</span></button></li>
                <li><button type="button" class="preset-btn text-left text-foreground hover:text-primary hover:bg-muted/60 px-2 py-1.5 rounded-lg w-full transition flex items-center justify-between group/item cursor-pointer" data-exam="uppsc"><span>UPPSC / BPSC</span><span class="text-[10px] text-muted-foreground group-hover/item:text-primary">State PSC</span></button></li>
                <li><button type="button" class="preset-btn text-left text-foreground hover:text-primary hover:bg-muted/60 px-2 py-1.5 rounded-lg w-full transition flex items-center justify-between group/item cursor-pointer" data-exam="mpsc"><span>MPSC / TNPSC</span><span class="text-[10px] text-muted-foreground group-hover/item:text-primary">State PSC</span></button></li>
              </ul>
            </div>

          </div>

          <!-- Mega Menu Footer Link to 40+ Exam Table -->
          <div class="mt-4 pt-3 border-t border-border flex items-center justify-between text-xs text-muted-foreground">
            <span>Need detailed technical guidelines for all exams?</span>
            <a href="/#exam-specs" class="text-primary font-bold hover:underline flex items-center gap-1">
              <span>View Full 40+ Exam Table</span>
              <span>↓</span>
            </a>
          </div>
        </div>
      </div>
    </nav>

    <!-- Right Controls: Privacy Badge, Dark Mode Toggle & Search Bar in Right Corner -->
    <div class="flex items-center gap-2.5">
      <div class="hidden sm:flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 text-xs font-semibold border border-emerald-500/20">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>100% Private</span>
      </div>

      <!-- Theme Toggle Button -->
      <button
        id="theme-toggle"
        type="button"
        class="p-2 rounded-xl border border-border bg-card text-foreground hover:bg-muted transition cursor-pointer shrink-0"
        aria-label="Toggle theme"
      >
        <!-- Sun Icon -->
        <svg id="theme-icon-sun" class="w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <circle cx="12" cy="12" r="4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32l1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41m14.14-14.14l-1.41 1.41" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <!-- Moon Icon -->
        <svg id="theme-icon-moon" class="w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <!-- 🔍 SMALL SEARCH BAR AT RIGHT SIDE CORNER AFTER THEME TOGGLE -->
      <div id="header-search-container" class="relative">
        <button
          type="button"
          id="header-search-trigger"
          class="flex items-center gap-1.5 sm:gap-2 px-2.5 sm:px-3 py-1.5 rounded-xl border border-border bg-card/90 hover:bg-muted/70 hover:border-primary/40 text-foreground transition text-xs shadow-2xs group focus:outline-none focus:ring-2 focus:ring-primary/40 cursor-pointer shrink-0"
          aria-expanded="false"
          aria-haspopup="dialog"
          title="Search all exams (Press / or Ctrl+K)"
        >
          <svg class="w-3.5 h-3.5 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <span class="font-medium text-muted-foreground group-hover:text-foreground hidden sm:inline">
            Search Exam
          </span>
          <kbd class="hidden xl:inline-flex items-center gap-0.5 px-1.5 py-0.2 text-[9px] font-mono font-semibold text-muted-foreground bg-muted border border-border/80 rounded">
            Ctrl K
          </kbd>
          <svg class="w-3 h-3 text-muted-foreground group-hover:text-primary transition-transform duration-150 hidden sm:inline-block" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </button>

        <!-- Search Combobox Popover Dropdown Panel (Aligned to the Right) -->
        <div
          id="header-search-popover"
          class="hidden absolute right-0 mt-2 w-[92vw] sm:w-[580px] md:w-[640px] bg-card/95 backdrop-blur-md rounded-2xl shadow-2xl border border-border p-4 z-50 flex-col space-y-3"
          style="max-height: calc(85vh - 4rem);"
        >
          <!-- Search Input Toolbar inside Popover -->
          <div class="relative flex items-center shrink-0">
            <svg class="w-4 h-4 text-primary absolute left-3 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input
              type="text"
              id="header-exam-search"
              placeholder="Filter 40+ exams (e.g. UPSC, SSC, GATE, PAN, RRB, MPSC, CAT)..."
              class="w-full pl-9 pr-14 py-2 text-xs rounded-xl border border-border bg-background text-foreground focus:outline-none focus:ring-2 focus:ring-primary/50"
              autocomplete="off"
            />
            <div class="absolute right-2 flex items-center gap-1">
              <button
                type="button"
                id="header-search-clear"
                class="hidden text-[10px] px-1.5 py-0.5 rounded text-muted-foreground hover:text-foreground bg-muted hover:bg-muted/80 cursor-pointer"
                title="Clear search"
              >
                ✕
              </button>
              <kbd class="hidden sm:inline-block text-[9px] font-mono px-1 py-0.5 rounded bg-muted text-muted-foreground border border-border">ESC</kbd>
            </div>
          </div>

          <!-- Dynamic Real-Time Filter Results (shown when searching) -->
          <div id="header-search-results" class="hidden overflow-y-auto max-h-[55vh] pr-1 space-y-1.5 text-xs">
            <!-- Dynamically populated via JS -->
          </div>

          <!-- All Available Exams Dropdown View (Shown by default on click) -->
          <div id="header-search-categories" class="overflow-y-auto max-h-[55vh] pr-1 space-y-4 text-xs">
            
            <!-- Category 1: Trending / Common -->
            <div>
              <div class="flex items-center justify-between mb-2">
                <span class="font-bold text-[11px] text-amber-500 uppercase tracking-wider flex items-center gap-1.5">
                  <span>🔥</span> Trending / Common
                </span>
                <span class="text-[10px] text-muted-foreground font-mono font-medium">Top Applied</span>
              </div>
              <div class="grid grid-cols-2 sm:grid-cols-3 gap-1.5">
                <button type="button" class="preset-btn text-left p-2 rounded-xl bg-muted/40 hover:bg-primary/10 hover:border-primary/30 border border-border/70 transition flex flex-col justify-between group cursor-pointer" data-exam="ssc">
                  <span class="font-bold text-foreground group-hover:text-primary">SSC (CGL, CHSL)</span>
                  <span class="text-[10px] text-muted-foreground font-mono">140×60 • 10–20 KB</span>
                </button>
                <button type="button" class="preset-btn text-left p-2 rounded-xl bg-muted/40 hover:bg-primary/10 hover:border-primary/30 border border-border/70 transition flex flex-col justify-between group cursor-pointer" data-exam="upsc">
                  <span class="font-bold text-foreground group-hover:text-primary">UPSC (IAS, NDA)</span>
                  <span class="text-[10px] text-muted-foreground font-mono">350×350 • 20–300 KB</span>
                </button>
                <button type="button" class="preset-btn text-left p-2 rounded-xl bg-muted/40 hover:bg-primary/10 hover:border-primary/30 border border-border/70 transition flex flex-col justify-between group cursor-pointer" data-exam="ibps">
                  <span class="font-bold text-foreground group-hover:text-primary">IBPS / SBI Bank</span>
                  <span class="text-[10px] text-muted-foreground font-mono">140×60 • 10–20 KB</span>
                </button>
                <button type="button" class="preset-btn text-left p-2 rounded-xl bg-muted/40 hover:bg-primary/10 hover:border-primary/30 border border-border/70 transition flex flex-col justify-between group cursor-pointer" data-exam="gate">
                  <span class="font-bold text-foreground group-hover:text-primary">GATE &amp; JAM</span>
                  <span class="text-[10px] text-muted-foreground font-mono">400×160 • 5–200 KB</span>
                </button>
                <button type="button" class="preset-btn text-left p-2 rounded-xl bg-muted/40 hover:bg-primary/10 hover:border-primary/30 border border-border/70 transition flex flex-col justify-between group cursor-pointer" data-exam="rrb">
                  <span class="font-bold text-foreground group-hover:text-primary">RRB Railway</span>
                  <span class="text-[10px] text-muted-foreground font-mono">140×60 • 10–20 KB</span>
                </button>
                <button type="button" class="preset-btn text-left p-2 rounded-xl bg-muted/40 hover:bg-primary/10 hover:border-primary/30 border border-border/70 transition flex flex-col justify-between group cursor-pointer" data-exam="neet">
                  <span class="font-bold text-foreground group-hover:text-primary">NEET / JEE</span>
                  <span class="text-[10px] text-muted-foreground font-mono">NTA • 4–30 KB</span>
                </button>
              </div>
            </div>

            <!-- Category 2: State PSCs -->
            <div>
              <div class="flex items-center justify-between mb-2">
                <span class="font-bold text-[11px] text-primary uppercase tracking-wider flex items-center gap-1.5">
                  <span>🏛️</span> State PSCs
                </span>
                <span class="text-[10px] text-muted-foreground font-mono font-medium">State Commissions</span>
              </div>
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-1.5">
                <button type="button" class="preset-btn text-left p-2 rounded-xl bg-muted/40 hover:bg-primary/10 hover:border-primary/30 border border-border/70 transition flex flex-col justify-between group cursor-pointer" data-exam="mpsc">
                  <span class="font-bold text-foreground group-hover:text-primary">MPSC</span>
                  <span class="text-[10px] text-muted-foreground font-mono">Maharashtra</span>
                </button>
                <button type="button" class="preset-btn text-left p-2 rounded-xl bg-muted/40 hover:bg-primary/10 hover:border-primary/30 border border-border/70 transition flex flex-col justify-between group cursor-pointer" data-exam="uppsc">
                  <span class="font-bold text-foreground group-hover:text-primary">UPPSC</span>
                  <span class="text-[10px] text-muted-foreground font-mono">Uttar Pradesh</span>
                </button>
                <button type="button" class="preset-btn text-left p-2 rounded-xl bg-muted/40 hover:bg-primary/10 hover:border-primary/30 border border-border/70 transition flex flex-col justify-between group cursor-pointer" data-exam="bpsc">
                  <span class="font-bold text-foreground group-hover:text-primary">BPSC</span>
                  <span class="text-[10px] text-muted-foreground font-mono">Bihar</span>
                </button>
                <button type="button" class="preset-btn text-left p-2 rounded-xl bg-muted/40 hover:bg-primary/10 hover:border-primary/30 border border-border/70 transition flex flex-col justify-between group cursor-pointer" data-exam="tnpsc">
                  <span class="font-bold text-foreground group-hover:text-primary">TNPSC</span>
                  <span class="text-[10px] text-muted-foreground font-mono">Tamil Nadu</span>
                </button>
                <button type="button" class="preset-btn text-left p-2 rounded-xl bg-muted/40 hover:bg-primary/10 hover:border-primary/30 border border-border/70 transition flex flex-col justify-between group cursor-pointer" data-exam="kpsc-karnataka">
                  <span class="font-bold text-foreground group-hover:text-primary">KPSC</span>
                  <span class="text-[10px] text-muted-foreground font-mono">Karnataka</span>
                </button>
                <button type="button" class="preset-btn text-left p-2 rounded-xl bg-muted/40 hover:bg-primary/10 hover:border-primary/30 border border-border/70 transition flex flex-col justify-between group cursor-pointer" data-exam="wbpsc-west-bengal">
                  <span class="font-bold text-foreground group-hover:text-primary">WBPSC</span>
                  <span class="text-[10px] text-muted-foreground font-mono">West Bengal</span>
                </button>
                <button type="button" class="preset-btn text-left p-2 rounded-xl bg-muted/40 hover:bg-primary/10 hover:border-primary/30 border border-border/70 transition flex flex-col justify-between group cursor-pointer" data-exam="rpsc-ras">
                  <span class="font-bold text-foreground group-hover:text-primary">RPSC (RAS)</span>
                  <span class="text-[10px] text-muted-foreground font-mono">Rajasthan</span>
                </button>
                <button type="button" class="preset-btn text-left p-2 rounded-xl bg-muted/40 hover:bg-primary/10 hover:border-primary/30 border border-border/70 transition flex flex-col justify-between group cursor-pointer" data-exam="gpsc-ojas">
                  <span class="font-bold text-foreground group-hover:text-primary">GPSC (OJAS)</span>
                  <span class="text-[10px] text-muted-foreground font-mono">Gujarat</span>
                </button>
              </div>
            </div>

            <!-- Category 3: Management & Law -->
            <div>
              <div class="flex items-center justify-between mb-2">
                <span class="font-bold text-[11px] text-emerald-600 dark:text-emerald-400 uppercase tracking-wider flex items-center gap-1.5">
                  <span>⚖️</span> Management &amp; Law
                </span>
                <span class="text-[10px] text-muted-foreground font-mono font-medium">Entrance Exams</span>
              </div>
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-1.5">
                <button type="button" class="preset-btn text-left p-2 rounded-xl bg-muted/40 hover:bg-primary/10 hover:border-primary/30 border border-border/70 transition flex flex-col justify-between group cursor-pointer" data-exam="cat">
                  <span class="font-bold text-foreground group-hover:text-primary">CAT (IIMs)</span>
                  <span class="text-[10px] text-muted-foreground font-mono">10–80 KB</span>
                </button>
                <button type="button" class="preset-btn text-left p-2 rounded-xl bg-muted/40 hover:bg-primary/10 hover:border-primary/30 border border-border/70 transition flex flex-col justify-between group cursor-pointer" data-exam="clat">
