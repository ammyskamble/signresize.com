            ? "bg-primary/10 text-primary border border-primary/20 shadow-2xs"
            : "hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-800 dark:text-slate-200"
        ]}
      >
        <span class="w-8 h-8 rounded-lg bg-blue-500/10 text-blue-600 dark:text-blue-400 flex items-center justify-center text-sm font-bold shrink-0">
          📄
        </span>
        <div>
          <div class="font-bold">Document Resizer</div>
          <div class="text-[10px] text-muted-foreground font-normal">Marksheets, Caste, ID • 100–300 KB</div>
        </div>
      </a>

      <a
        href="/compress-image-to-kb/"
        class:list={[
          "flex items-center gap-3 p-3 min-h-[48px] rounded-xl text-xs font-semibold transition",
          isCompress
            ? "bg-primary/10 text-primary border border-primary/20 shadow-2xs"
            : "hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-800 dark:text-slate-200"
        ]}
      >
        <span class="w-8 h-8 rounded-lg bg-amber-500/10 text-amber-600 dark:text-amber-400 flex items-center justify-center text-sm font-bold shrink-0">
          ⚡
        </span>
        <div>
          <div class="font-bold">Compress Image to KB</div>
          <div class="text-[10px] text-muted-foreground font-normal">Reduce file to exact KB limit</div>
        </div>
      </a>

      <a
        href="/signature-creator/"
        class:list={[
          "flex items-center gap-3 p-3 min-h-[48px] rounded-xl text-xs font-semibold transition",
          isCreator
            ? "bg-primary/10 text-primary border border-primary/20 shadow-2xs"
            : "hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-800 dark:text-slate-200"
        ]}
      >
        <span class="w-8 h-8 rounded-lg bg-purple-500/10 text-purple-600 dark:text-purple-400 flex items-center justify-center text-sm font-bold shrink-0">
          🖋️
        </span>
        <div>
          <div class="font-bold">Signature Creator</div>
          <div class="text-[10px] text-muted-foreground font-normal">Draw and download transparent signature</div>
        </div>
      </a>

      <a
        href="/#exam-specs"
        class="flex items-center gap-3 p-3 min-h-[48px] rounded-xl text-xs font-semibold hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-800 dark:text-slate-200 transition"
      >
        <span class="w-8 h-8 rounded-lg bg-slate-500/10 text-slate-600 dark:text-slate-400 flex items-center justify-center text-sm font-bold shrink-0">
          📋
        </span>
        <div>
          <div class="font-bold">40+ Exam Specs Matrix</div>
          <div class="text-[10px] text-muted-foreground font-normal">Official requirements comparison table</div>
        </div>
      </a>
    </div>

    <!-- Mobile Footer Badges -->
    <div class="pt-3 border-t border-border/60 flex items-center justify-between text-xs text-muted-foreground">
      <div class="flex items-center gap-1.5 text-emerald-600 dark:text-emerald-400 font-semibold">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>100% In-Browser Private</span>
      </div>
      <button
        type="button"
        id="mobile-search-exam-btn"
        class="text-primary font-bold hover:underline cursor-pointer min-h-[44px] inline-flex items-center px-2 py-1"
      >
        🔍 Search 40+ Exams
      </button>
    </div>
  </div>
</header>

<!-- Pass All Exam Presets safely to Script for Instant Filtering -->
<script id="exam-presets-dataset" type="application/json" set:html={JSON.stringify(searchablePresets)} />

<script is:inline>
  // Theme Toggle logic
  const themeToggle = document.getElementById('theme-toggle');
  const sunIcon = document.getElementById('theme-icon-sun');
  const moonIcon = document.getElementById('theme-icon-moon');

  function updateThemeUI(isDark) {
    if (isDark) {
      document.documentElement.classList.add('dark');
      sunIcon?.classList.remove('hidden');
      moonIcon?.classList.add('hidden');
    } else {
      document.documentElement.classList.remove('dark');
      sunIcon?.classList.add('hidden');
      moonIcon?.classList.remove('hidden');
    }
  }

  const savedTheme = localStorage.getItem('theme');
  const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
  const isDark = savedTheme === 'dark' || (!savedTheme && prefersDark);
  updateThemeUI(isDark);

  themeToggle?.addEventListener('click', () => {
    const isCurrentlyDark = document.documentElement.classList.contains('dark');
    const newTheme = isCurrentlyDark ? 'light' : 'dark';
    localStorage.setItem('theme', newTheme);
    updateThemeUI(!isCurrentlyDark);
  });

  // Register Service Worker for PWA & Offline Support
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('/sw.js').catch((err) => {
        console.debug('SW registration notice:', err);
      });
    });
  }

  // Preset Selection Core Handler
  function handlePresetSelection(examKey) {
    if (!examKey) return;
    const studio = document.getElementById('tool-workspace') || document.getElementById('studio-container');
    if (studio) {
      window.dispatchEvent(new CustomEvent('select-exam-preset', { detail: examKey }));
      const url = new URL(window.location.href);
      url.searchParams.set('preset', examKey);
      window.history.replaceState({}, '', url.toString());
      studio.scrollIntoView({ behavior: 'smooth' });
    } else {
      window.location.href = `/?preset=${encodeURIComponent(examKey)}#tool-workspace`;
    }
  }

  // Attach Preset Handlers on all header preset-btn elements
  function attachPresetListeners(container) {
    (container || document).querySelectorAll('header .preset-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const examKey = e.currentTarget.getAttribute('data-exam');
        handlePresetSelection(examKey);
        closeSearchPopover();
      });
    });
  }
  attachPresetListeners(document);

  // -------------------------------------------------------------------------
  // 🔍 Right-Corner Small Search Bar & All Available Exams Dropdown
  // -------------------------------------------------------------------------
  const searchContainer = document.getElementById('header-search-container');
  const searchTrigger = document.getElementById('header-search-trigger');
  const searchPopover = document.getElementById('header-search-popover');
  const searchInput = document.getElementById('header-exam-search');
  const searchClear = document.getElementById('header-search-clear');
  const searchResults = document.getElementById('header-search-results');
  const searchCategories = document.getElementById('header-search-categories');

  let allPresets = [];
  try {
    const dataEl = document.getElementById('exam-presets-dataset');
    if (dataEl) allPresets = JSON.parse(dataEl.textContent || '[]');
  } catch (err) {
    console.error('Failed to parse exam presets dataset', err);
  }

  function openSearchPopover() {
    searchPopover?.classList.remove('hidden');
    searchPopover?.classList.add('flex');
    searchTrigger?.setAttribute('aria-expanded', 'true');
    searchInput?.focus();
    searchInput?.select();
  }

  function closeSearchPopover() {
    searchPopover?.classList.add('hidden');
    searchPopover?.classList.remove('flex');
    searchTrigger?.setAttribute('aria-expanded', 'false');
  }

  function toggleSearchPopover() {
    if (searchPopover?.classList.contains('hidden')) {
      openSearchPopover();
    } else {
      closeSearchPopover();
    }
  }

  searchTrigger?.addEventListener('click', (e) => {
    e.stopPropagation();
    toggleSearchPopover();
  });

  // Close when clicking outside
  document.addEventListener('click', (e) => {
    if (searchContainer && !searchContainer.contains(e.target)) {
      closeSearchPopover();
    }
  });

  // Global Keyboard Shortcuts: '/' and 'Ctrl+K' / 'Cmd+K'
  document.addEventListener('keydown', (e) => {
    const active = document.activeElement;
    const isEditing =
      active &&
      (active.tagName === 'INPUT' ||
        active.tagName === 'TEXTAREA' ||
        active.isContentEditable);

    // Ctrl+K or Cmd+K
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      openSearchPopover();
      return;
    }

    // '/' shortcut when not already typing
    if (e.key === '/' && !isEditing) {
      e.preventDefault();
      openSearchPopover();
      return;
    }

    // ESC to close
    if (e.key === 'Escape' && !searchPopover?.classList.contains('hidden')) {
      e.preventDefault();
      closeSearchPopover();
    }
  });

  // Fast Filter Search logic
  function renderFilteredResults(query) {
    const q = query.trim().toLowerCase();
    if (!q) {
      searchResults?.classList.add('hidden');
      searchCategories?.classList.remove('hidden');
      searchClear?.classList.add('hidden');
      return;
    }

    searchClear?.classList.remove('hidden');
    searchCategories?.classList.add('hidden');
    searchResults?.classList.remove('hidden');

    const filtered = allPresets.filter((p) => {
      return (
        p.name.toLowerCase().includes(q) ||
        p.shortCode.toLowerCase().includes(q) ||
        p.id.toLowerCase().includes(q) ||
        p.category.toLowerCase().includes(q)
      );
    });

    if (filtered.length === 0) {
      searchResults.innerHTML = `
        <div class="p-6 text-center text-xs text-slate-500 dark:text-slate-400 space-y-2">
          <p>No exams found for "<strong>${query.replace(/</g, '&lt;')}</strong>".</p>
          <p class="text-[11px]">Try searching by portal name like <em>UPSC</em>, <em>SSC</em>, <em>GATE</em>, or <em>PAN</em>.</p>
        </div>
      `;
      return;
    }

    const itemsHtml = filtered
      .map(
        (p) => `
        <button
          type="button"
          class="preset-btn w-full text-left p-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-100/90 hover:bg-white dark:bg-slate-800/90 dark:hover:bg-slate-750 hover:border-primary/50 dark:hover:border-primary/50 transition flex items-center justify-between gap-2 group cursor-pointer shadow-2xs"
          data-exam="${p.id}"
        >
          <div class="min-w-0">
            <div class="flex items-center gap-2">
              <span class="font-bold text-slate-900 dark:text-slate-100 group-hover:text-primary">${p.shortCode}</span>
              <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-300 font-medium">${p.category}</span>
            </div>
            <div class="text-[11px] text-slate-600 dark:text-slate-400 truncate mt-0.5">${p.name}</div>
          </div>
          <div class="text-right shrink-0">
            <div class="font-mono text-primary font-bold text-xs">${p.widthPx}×${p.heightPx} px</div>
            <div class="text-[10px] font-mono text-slate-500 dark:text-slate-400">${p.minKb}–${p.maxKb} KB</div>
          </div>
        </button>
      `
      )
      .join('');

    searchResults.innerHTML = `
      <div class="text-[10px] uppercase font-bold text-slate-500 dark:text-slate-400 px-1 pb-1 flex justify-between">
        <span>Matching Exams</span>
        <span class="font-mono">${filtered.length} found</span>
      </div>
      <div class="space-y-1.5">${itemsHtml}</div>
    `;

    attachPresetListeners(searchResults);
  }

  searchInput?.addEventListener('input', (e) => {
    renderFilteredResults(e.target.value);
  });

  searchClear?.addEventListener('click', () => {
    if (searchInput) {
      searchInput.value = '';
      searchInput.focus();
      renderFilteredResults('');
    }
  });

  // Listen for custom trigger event from page buttons (like "Change Preset")
  window.addEventListener('open-header-preset-search', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
    openSearchPopover();
  });

  // -------------------------------------------------------------------------
  // 📱 Mobile Navigation Drawer Toggle & Interaction
  // -------------------------------------------------------------------------
  const mobileToggle = document.getElementById('mobile-menu-toggle');
  const mobileDrawer = document.getElementById('mobile-menu-drawer');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  function openMobileMenu() {
    mobileDrawer?.classList.remove('hidden');
    mobileToggle?.setAttribute('aria-expanded', 'true');
    hamburgerIcon?.classList.add('hidden');
    closeIcon?.classList.remove('hidden');
  }

  function closeMobileMenu() {
    mobileDrawer?.classList.add('hidden');
    mobileToggle?.setAttribute('aria-expanded', 'false');
    hamburgerIcon?.classList.remove('hidden');
    closeIcon?.classList.add('hidden');
  }

  function toggleMobileMenu() {
    if (mobileDrawer?.classList.contains('hidden')) {
      openMobileMenu();
    } else {
      closeMobileMenu();
    }
  }

  mobileToggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    toggleMobileMenu();
  });

  // Close mobile drawer when clicking any navigation link inside it
  mobileDrawer?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      closeMobileMenu();
    });
  });

  // Mobile "Search 40+ Exams" button opens the search popover
  document.getElementById('mobile-search-exam-btn')?.addEventListener('click', (e) => {
    e.stopPropagation();
    closeMobileMenu();
    openSearchPopover();
  });

  // Close mobile menu if clicked outside
  document.addEventListener('click', (e) => {
    if (
      mobileDrawer &&
      !mobileDrawer.classList.contains('hidden') &&
      !mobileDrawer.contains(e.target) &&
      !mobileToggle?.contains(e.target)
    ) {
      closeMobileMenu();
    }
  });
</script>

