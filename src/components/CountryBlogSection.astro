---
// CountryBlogSection.astro
import { BLOG_POSTS } from '../data/blogPostsData';

interface Props {
  country: 'PK' | 'PH' | 'BD' | 'NP';
}

const { country } = Astro.props;

const countryTitles = {
  PK: "Pakistan Recruitment & Document Preparation Guides",
  PH: "Philippines Board Exam & Civil Service Guides",
  BD: "Bangladesh Teletalk & BPSC Preparation Guides",
  NP: "Nepal Lok Sewa Aayog & PSC Upload Guides",
};

const countryPosts = BLOG_POSTS.filter((post) => post.country === country);
---

{countryPosts.length > 0 && (
  <section class="space-y-4 pt-6 border-t border-border">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-foreground">
          {countryTitles[country]}
        </h2>
        <p class="text-xs sm:text-sm text-muted-foreground">
          Verified guides for regional recruitment portals and document upload rules.
        </p>
      </div>
      <a href="/blog/" class="text-xs font-semibold text-primary hover:underline">
        All Guides →
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {countryPosts.map((post) => (
        <article class="p-5 rounded-2xl border border-border bg-card shadow-xs hover:border-primary/40 transition flex flex-col justify-between space-y-3">
          <div class="space-y-2">
            <div class="flex items-center justify-between text-xs text-muted-foreground">
              <span class="px-2 py-0.5 rounded-full bg-primary/10 text-primary font-semibold text-[11px] border border-primary/20">
                {post.category}
              </span>
              <span>{post.readTime}</span>
            </div>
            <h3 class="text-base font-bold text-foreground hover:text-primary transition line-clamp-2">
              <a href={`/blog/${post.slug}/`}>{post.title}</a>
            </h3>
            <p class="text-xs text-muted-foreground line-clamp-3">
              {post.excerpt}
            </p>
          </div>
          <div class="pt-2 border-t border-border/60 flex items-center justify-between text-xs">
            <span class="text-muted-foreground font-medium">{post.author}</span>
            <a href={`/blog/${post.slug}/`} class="font-bold text-primary hover:underline">
              Read Guide →
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>
)}
