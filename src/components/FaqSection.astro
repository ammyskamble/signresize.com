---
// FaqSection.astro
const faqs = [
  {
    q: "How do I perform signature resize 10 to 20 kb for SSC and RRB exams?",
    a: "To resize signature 10 to 20 kb, upload your image to SignResize.com, select the 'SSC' or 'RRB' preset (which sets 140 × 60 pixels and 4.0 cm × 2.0 cm), ensure the target slider is set between 10 KB and 20 KB (recommended: 15 KB), and click Download JPG. The tool automatically ensures your file lands within the strict 10 KB to 20 KB window."
  },
  {
    q: "How to set signature resize width and height in cm?",
    a: "Select your desired physical dimensions in centimeters (such as 4.0 cm × 2.0 cm for SSC or 4.5 cm × 2.0 cm for PAN cards). At 200 DPI scanner resolution, 1 cm equals approximately 79 pixels. SignResize automatically calculates the precise pixel aspect ratio (e.g. 140 × 60 px) to match the official centimeter guidelines."
  },
  {
    q: "What should I do if an exam portal says 'signature size should be at least 20kb'?",
    a: "Certain exams like UPSC Civil Services or state recruitments enforce a minimum limit where the signature size should be at least 20kb (e.g. 20 KB to 50 KB or 20 KB to 300 KB). In SignResize, set the 'Min KB' to 20 KB and 'Max KB' to 50 KB. The engine dynamically tunes compression quality to keep the output securely above 20 KB without exceeding the upper threshold."
  },
  {
    q: "What are the requirements for NSDL PAN card signature resize and photo resize?",
    a: "For NSDL (Protean) and UTIITSL PAN card signature resize, the signature must be in JPEG format, scanned at 200 DPI resolution, with dimensions of 2 cm × 4.5 cm (400 × 200 pixels) and file size under 50 KB. For PAN card photo resize, dimensions are 3.5 cm × 2.5 cm (213 × 213 pixels) with file size under 50 KB."
  },
  {
    q: "Can I resize and compress a thumb impression for IBPS, SSC, or NEET?",
    a: "Yes. SignResize includes a dedicated Thumb Impression preset. Candidate left-hand thumb impressions should be taken on unruled white paper using blue or black stamp ink. You can crop it to a 1:1 square ratio (3 cm × 3 cm or 240 × 240 pixels) and compress it to between 10 KB and 20 KB or 20 KB and 50 KB."
  },
  {
    q: "How does SignResize compare to pi7, pdf pi7 org, or pi7 image tool?",
    a: "Unlike tools like pi7, pdf pi7 org, or pi7 image tool that upload your personal documents to external servers, SignResize is 100% client-side. Your signature is processed entirely in your web browser using HTML5 Canvas—no files are uploaded to any server, offering complete privacy and instant zero-latency downloads."
  },
  {
    q: "Why do SSC, IBPS, and RRB reject signatures in capital letters?",
    a: "Staff Selection Commission (SSC), IBPS, and Railway Recruitment Boards (RRB) mandate that an applicant must sign in their customary running cursive handwriting. Writing your name in ALL CAPS / BLOCK LETTERS is treated as typed text rather than a valid legal signature and leads to automatic rejection."
  },
  {
    q: "Can I use blue ink or is black ink mandatory for Sarkari exam signatures?",
    a: "SSC, IBPS, and SBI explicitly mandate black ink pen on clean white paper. While GATE, IIT JAM, and certain universities permit dark blue ink, we strongly recommend signing with a black ballpoint or gel pen for guaranteed acceptance across all Indian application portals."
  }
];
---

<section id="faq" class="space-y-6 pt-12 border-t border-border">
  <div class="max-w-2xl mx-auto text-center space-y-2">
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-primary/10 text-primary border border-primary/20">
      Got Questions?
    </div>
    <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-foreground">
      Frequently Asked Questions (FAQ)
    </h2>
    <p class="text-sm text-muted-foreground">
      Authoritative answers regarding signature resize, 10–20 KB rules, centimeter dimensions, and portal compliance.
    </p>
  </div>

  <div class="max-w-3xl mx-auto space-y-3">
    {faqs.map((faq) => (
      <details class="group p-4 rounded-xl border border-border bg-card shadow-xs transition-all open:ring-1 open:ring-primary/40">
        <summary class="flex items-center justify-between font-semibold text-foreground text-sm cursor-pointer list-none select-none">
          <span>{faq.q}</span>
          <span class="w-5 h-5 flex items-center justify-center rounded-full bg-muted text-muted-foreground group-open:rotate-180 transition-transform shrink-0 ml-2">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </span>
        </summary>
        <p class="pt-3 text-xs sm:text-sm text-muted-foreground leading-relaxed">
          {faq.a}
        </p>
      </details>
    ))}
  </div>

  <!-- FAQ Schema for SEO -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map(f => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": f.a
      }
    }))
  })} />
</section>
