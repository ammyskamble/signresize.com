---
// FaqSection.astro
const faqs = [
  {
    q: "How to resize signature?",
    summary: "To resize a signature, upload your photo to SignResize, select your target dimensions or exam preset, toggle the Clean White Paper filter, and download your compliant JPG in seconds.",
    details: "Our in-browser canvas engine allows you to specify exact dimensions in pixels or centimeters (such as 140×60 px or 4×2 cm) and lock file weight strictly between 10 KB and 20 KB with zero server uploads."
  },
  {
    q: "What are the exact SSC signature dimensions?",
    summary: "The exact SSC signature dimensions are 140 pixels width by 60 pixels height (approx 4.0 cm × 2.0 cm) with a file size strictly between 10 KB and 20 KB in JPG format.",
    details: "The signature must be signed using a black ink pen on clean unruled white paper in natural running cursive handwriting. Signatures written in ALL CAPS / BLOCK letters are automatically disqualified by SSC OTR gateways."
  },
  {
    q: "How to resize photo and signature?",
    summary: "Resize photos to 3.5 × 4.5 cm (20–50 KB) and signatures to 4.0 × 2.0 cm (10–20 KB) using the one-click exam presets on SignResize.",
    details: "For Indian government portals like SSC, UPSC, PAN card, and RRB, photographs and signatures use distinct aspect ratios and file constraints. SignResize provides dedicated presets for both documents to ensure first-attempt acceptance."
  },
  {
    q: "How to resize signature for SSC?",
    summary: "To resize signature for SSC, select the 'SSC' preset on SignResize to instantly lock dimensions to 140 × 60 pixels and the file size between 10 KB and 20 KB.",
    details: "This preset meets all 2026 Staff Selection Commission guidelines for CGL, CHSL, MTS, GD, CPO, and Stenographer online application portals."
  },
  {
    q: "How to resize signature in 20 KB?",
    summary: "To resize a signature under 20 KB, upload your image to SignResize and select the 10–20 KB preset to automatically compress the file without losing stroke sharpness.",
    details: "Our real-time canvas compression engine iteratively calculates optimal JPEG quantization factors so your file never exceeds 20.0 KB while preserving crisp handwriting edges."
  },
  {
    q: "Signature resize 10 to 20 KB: How does it work?",
    summary: "Signature resize 10 to 20 KB uses dual-boundary binary search quantization inside your browser to guarantee the final file lands strictly between 10.0 KB and 19.9 KB.",
    details: "This eliminates rejection from strict recruitment servers that enforce both a 10 KB floor (to prevent unreadable blur) and a 20 KB ceiling (to conserve gateway bandwidth)."
  },
  {
    q: "Signature resize 10 to 20 KB JPG format: How to convert?",
    summary: "Upload any PNG, WebP, HEIC, or scanned photo to SignResize, select the 10–20 KB boundary, and click Download to get an official baseline JPG file.",
    details: "The exported file is a standard baseline JPEG fully compatible with all Indian state and central government recruitment upload gateways."
  },
  {
    q: "SSC signature resize 10 to 20 KB: What are the strict rules?",
    summary: "The official SSC rules mandate 140 × 60 px (4×2 cm), file size between 10 KB and 20 KB, JPG format, black ink on clean white paper, and running cursive handwriting.",
    details: "Signatures must not contain shadows, dark yellow background tints, or typed block letters, all of which trigger automated gate rejection."
  },
  {
    q: "How do I change the width and height of my signature?",
    summary: "To change width and height, choose your preferred unit (px, cm, mm, or inches) under Custom Dimensions in SignResize and type your target measurements.",
    details: "You can toggle 'Lock Aspect Ratio' or drag the interactive crop box handles directly on the canvas workspace to frame your signature with precision."
  },
  {
    q: "What is the required size for an SSC GD signature in CM format?",
    summary: "The required size for an SSC GD signature in CM format is 4.0 cm width × 2.0 cm height, which corresponds to 140 × 60 pixels at standard 200 DPI scanning resolution.",
    details: "The file size must strictly remain between 10 KB and 20 KB in JPG format on plain white paper with black ink."
  },
  {
    q: "How can I resize my signature online?",
    summary: "You can resize your signature online for free by uploading your photo to SignResize.in, choosing your exam preset, and clicking Download.",
    details: "The entire process takes under 10 seconds and processes 100% inside your browser memory with zero files sent to external servers."
  },
  {
    q: "How can I resize my signature to 300x80 pixels?",
    summary: "In SignResize, set the unit selector to 'px', enter 300 Width and 80 Height, adjust your crop box, and click Download to export an exact 300 × 80 pixel JPG.",
    details: "Our tool locks pixel aspect ratio while simultaneously compressing the file into your chosen kilobyte target range."
  },
  {
    q: "Can I resize and compress a thumb impression for IBPS, SSC, or NEET?",
    summary: "Yes, SignResize includes a dedicated 1:1 square Thumb Impression preset (3 × 3 cm or 240 × 240 px) compressed to 10–20 KB or 20–50 KB.",
    details: "Candidate thumb impressions should be made using blue or black ink on unruled white paper; our high-contrast filter sharpens biometric whorls and ridges for machine scanning."
  },
  {
    q: "Why do SSC, IBPS, and RRB reject signatures in capital letters?",
    summary: "Signatures in capital letters are rejected because recruitment bodies legally require customary running cursive handwriting to verify candidate authenticity.",
    details: "Writing your name in ALL CAPS / BLOCK LETTERS is treated as printed typography rather than a legally valid signature, causing automatic disqualification."
  }
];
---

<section id="faq" class="space-y-6 pt-12 border-t border-border">
  <div class="max-w-2xl mx-auto text-center space-y-2">
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-primary/10 text-primary border border-primary/20">
      Got Questions?
    </div>
    <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-foreground">
      Frequently Asked Questions (FAQ)
    </h2>
    <p class="text-sm text-muted-foreground">
      Authoritative answers regarding signature resize, 10–20 KB rules, centimeter dimensions, and portal compliance.
    </p>
  </div>

  <div class="max-w-3xl mx-auto space-y-3">
    {faqs.map((faq) => (
      <details class="group p-4 rounded-xl border border-border bg-card shadow-xs transition-all open:ring-1 open:ring-primary/40">
        <summary class="flex items-center justify-between font-semibold text-foreground text-sm cursor-pointer list-none select-none">
          <span>{faq.q}</span>
          <span class="w-5 h-5 flex items-center justify-center rounded-full bg-muted text-muted-foreground group-open:rotate-180 transition-transform shrink-0 ml-2">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </span>
        </summary>
        <p class="pt-3 text-xs sm:text-sm leading-relaxed">
          <strong class="text-foreground font-semibold block sm:inline">{faq.summary}</strong>{" "}
          <span class="text-muted-foreground">{faq.details}</span>
        </p>
      </details>
    ))}
  </div>

  <!-- FAQ Schema for SEO -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map(f => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `${f.summary} ${f.details}`
      }
    }))
  })} />
</section>
