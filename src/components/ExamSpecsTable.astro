---
// ExamSpecsTable.astro
import { EXAM_PRESETS, CATEGORIES } from '../data/examPresets';
import { EXAM_PAGES_DATA } from '../data/examPagesData';

const presetSlugMap = new Map(EXAM_PAGES_DATA.map((p) => [p.presetId, p.slug]));
---

<section id="exam-specs" class="space-y-6 pt-6">
  <div class="space-y-2 text-center max-w-2xl mx-auto">
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-primary/10 text-primary border border-primary/20">
      Official Guidelines 2026
    </div>
    <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-foreground">
      Official Signature Dimensions &amp; Size Guidelines
    </h2>
    <p class="text-sm text-muted-foreground">
      Verified technical requirements across all major Indian competitive exams and government application portals.
    </p>
  </div>

  <!-- Quick Specification Matrix Across Major Entrance Exams -->
  <div class="rounded-2xl border-2 border-primary/25 bg-card shadow-sm overflow-hidden space-y-3 p-4 sm:p-5">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-border/70 pb-3">
      <div class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-primary animate-pulse"></span>
        <h3 class="font-bold text-sm sm:text-base text-foreground">
          Quick Specification Matrix Across Major Entrance Exams
        </h3>
      </div>
      <span class="text-xs text-muted-foreground font-mono">Standard Portal Parameters 2026</span>
    </div>

    <div class="overflow-x-auto rounded-xl border border-border/80">
      <table class="w-full text-left text-xs sm:text-sm">
        <thead class="bg-muted/70 text-muted-foreground font-bold uppercase text-[11px] tracking-wider border-b border-border">
          <tr>
            <th class="py-3 px-3.5">Exam / Category</th>
            <th class="py-3 px-3.5">Pixel Dimensions</th>
            <th class="py-3 px-3.5">Physical Dimensions</th>
            <th class="py-3 px-3.5">File Size Range</th>
            <th class="py-3 px-3.5">Ink &amp; Paper Rules</th>
            <th class="py-3 px-3.5 text-right">Instant Preset</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border/60 font-medium">
          <tr class="hover:bg-muted/40 transition">
            <td class="py-3 px-3.5">
              <div class="font-bold text-foreground">CAT (IIMs)</div>
              <div class="text-[10px] text-muted-foreground">Management Entrances</div>
            </td>
            <td class="py-3 px-3.5 font-mono text-foreground font-bold">300 × 132 px</td>
            <td class="py-3 px-3.5 font-mono text-muted-foreground">8.0 × 3.5 cm</td>
            <td class="py-3 px-3.5 font-mono font-bold text-primary">10 KB – 80 KB</td>
            <td class="py-3 px-3.5 text-xs text-muted-foreground">Black or Blue ink; clean white paper</td>
            <td class="py-3 px-3.5 text-right">
              <a href="#tool-workspace" data-preset-id="cat-iim" class="apply-preset-btn inline-flex items-center px-3 py-1.5 rounded-lg text-xs font-bold bg-primary text-primary-foreground hover:opacity-90 shadow-2xs transition">
                Apply CAT
              </a>
            </td>
          </tr>
          <tr class="hover:bg-muted/40 transition">
            <td class="py-3 px-3.5">
              <div class="font-bold text-foreground">SSC (CGL, CHSL, MTS)</div>
              <div class="text-[10px] text-muted-foreground">Staff Selection Commission</div>
            </td>
            <td class="py-3 px-3.5 font-mono text-foreground font-bold">140 × 60 px</td>
            <td class="py-3 px-3.5 font-mono text-muted-foreground">4.0 × 2.0 cm</td>
            <td class="py-3 px-3.5 font-mono font-bold text-primary">10 KB – 20 KB</td>
            <td class="py-3 px-3.5 text-xs text-muted-foreground">Black ink strictly; running cursive only</td>
            <td class="py-3 px-3.5 text-right">
              <a href="#tool-workspace" data-preset-id="ssc-general" class="apply-preset-btn inline-flex items-center px-3 py-1.5 rounded-lg text-xs font-bold bg-primary text-primary-foreground hover:opacity-90 shadow-2xs transition">
                Apply SSC
              </a>
            </td>
          </tr>
          <tr class="hover:bg-muted/40 transition">
            <td class="py-3 px-3.5">
              <div class="font-bold text-foreground">IBPS / SBI (PO &amp; Clerk)</div>
              <div class="text-[10px] text-muted-foreground">Banking Personnel Selection</div>
            </td>
            <td class="py-3 px-3.5 font-mono text-foreground font-bold">140 × 60 px</td>
            <td class="py-3 px-3.5 font-mono text-muted-foreground">4.0 × 2.0 cm</td>
            <td class="py-3 px-3.5 font-mono font-bold text-primary">10 KB – 20 KB</td>
            <td class="py-3 px-3.5 text-xs text-muted-foreground">Black ink strictly; unruled white paper</td>
            <td class="py-3 px-3.5 text-right">
              <a href="#tool-workspace" data-preset-id="ibps-sbi" class="apply-preset-btn inline-flex items-center px-3 py-1.5 rounded-lg text-xs font-bold bg-primary text-primary-foreground hover:opacity-90 shadow-2xs transition">
                Apply IBPS
              </a>
            </td>
          </tr>
          <tr class="hover:bg-muted/40 transition">
            <td class="py-3 px-3.5">
              <div class="font-bold text-foreground">UPSC (Civil Services, NDA)</div>
              <div class="text-[10px] text-muted-foreground">Union Public Service Commission</div>
            </td>
            <td class="py-3 px-3.5 font-mono text-foreground font-bold">350 × 350 px</td>
            <td class="py-3 px-3.5 font-mono text-muted-foreground">Square (3:3 ratio)</td>
            <td class="py-3 px-3.5 font-mono font-bold text-primary">20 KB – 300 KB</td>
            <td class="py-3 px-3.5 text-xs text-muted-foreground">Black ink preferred; min 20 KB floor</td>
            <td class="py-3 px-3.5 text-right">
              <a href="#tool-workspace" data-preset-id="upsc-civil-services" class="apply-preset-btn inline-flex items-center px-3 py-1.5 rounded-lg text-xs font-bold bg-primary text-primary-foreground hover:opacity-90 shadow-2xs transition">
                Apply UPSC
              </a>
            </td>
          </tr>
          <tr class="hover:bg-muted/40 transition">
            <td class="py-3 px-3.5">
              <div class="font-bold text-foreground">GATE / IIT JAM</div>
              <div class="text-[10px] text-muted-foreground">IITs / IISc Engineering Entrances</div>
            </td>
            <td class="py-3 px-3.5 font-mono text-foreground font-bold">~400 × 160 px</td>
            <td class="py-3 px-3.5 font-mono text-muted-foreground">5.0 × 2.0 cm</td>
            <td class="py-3 px-3.5 font-mono font-bold text-primary">5 KB – 200 KB</td>
            <td class="py-3 px-3.5 text-xs text-muted-foreground">Dark blue or black ink; clean background</td>
            <td class="py-3 px-3.5 text-right">
              <a href="#tool-workspace" data-preset-id="gate-jam" class="apply-preset-btn inline-flex items-center px-3 py-1.5 rounded-lg text-xs font-bold bg-primary text-primary-foreground hover:opacity-90 shadow-2xs transition">
                Apply GATE
              </a>
            </td>
          </tr>
          <tr class="hover:bg-muted/40 transition">
            <td class="py-3 px-3.5">
              <div class="font-bold text-foreground">NEET / JEE (NTA)</div>
              <div class="text-[10px] text-muted-foreground">National Testing Agency</div>
            </td>
            <td class="py-3 px-3.5 font-mono text-foreground font-bold">140 × 60 px</td>
            <td class="py-3 px-3.5 font-mono text-muted-foreground">3.5 × 1.5 cm</td>
            <td class="py-3 px-3.5 font-mono font-bold text-primary">4 KB – 30 KB</td>
            <td class="py-3 px-3.5 text-xs text-muted-foreground">Black ballpoint pen; high contrast</td>
            <td class="py-3 px-3.5 text-right">
              <a href="#tool-workspace" data-preset-id="nta-neet-jee" class="apply-preset-btn inline-flex items-center px-3 py-1.5 rounded-lg text-xs font-bold bg-primary text-primary-foreground hover:opacity-90 shadow-2xs transition">
                Apply NEET
              </a>
            </td>
          </tr>
          <tr class="hover:bg-muted/40 transition">
            <td class="py-3 px-3.5">
              <div class="font-bold text-foreground">Left Thumb Impressions</div>
              <div class="text-[10px] text-muted-foreground">IBPS, SSC, RRB &amp; NTA Portals</div>
            </td>
            <td class="py-3 px-3.5 font-mono text-foreground font-bold">240 × 240 px</td>
            <td class="py-3 px-3.5 font-mono text-muted-foreground">3.0 × 3.0 cm</td>
            <td class="py-3 px-3.5 font-mono font-bold text-primary">10 KB – 50 KB</td>
            <td class="py-3 px-3.5 text-xs text-muted-foreground">Blue/Black stamp pad ink; clear ridges</td>
            <td class="py-3 px-3.5 text-right">
              <a href="#tool-workspace" data-preset-id="thumb-impression-general" class="apply-preset-btn inline-flex items-center px-3 py-1.5 rounded-lg text-xs font-bold bg-primary text-primary-foreground hover:opacity-90 shadow-2xs transition">
                Apply Thumb
              </a>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Search & Category Filter Toolbar for Exam Specs Table -->
  <div class="p-4 rounded-2xl border border-border bg-card shadow-xs space-y-3">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <div class="text-xs font-bold text-foreground flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>Filter {EXAM_PRESETS.length} Official Exam Guidelines:</span>
      </div>
      <div class="relative w-full sm:w-72">
        <input
          id="exam-specs-search"
          type="text"
          placeholder="Search by exam name or authority..."
          class="w-full px-3.5 py-2 text-xs rounded-xl border border-border bg-background text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary/40 transition"
        />
      </div>
    </div>

    <!-- Category Pills -->
    <div class="flex items-center gap-1.5 overflow-x-auto pb-1 scrollbar-none text-xs" id="exam-specs-category-bar">
      <button
        type="button"
        data-category="All"
        class="exam-cat-filter-btn px-3 py-1 rounded-lg text-xs font-bold bg-primary text-primary-foreground shadow-xs transition shrink-0"
      >
        All Exams
      </button>
      {CATEGORIES.filter((c) => c !== 'All' && c !== 'Popular').map((cat) => (
        <button
          type="button"
          data-category={cat}
          class="exam-cat-filter-btn px-3 py-1 rounded-lg text-xs font-medium bg-muted/60 text-muted-foreground hover:text-foreground hover:bg-muted transition shrink-0"
        >
          {cat}
        </button>
      ))}
    </div>
  </div>

  <div class="overflow-x-auto rounded-xl border border-border bg-card shadow-sm">
    <table class="w-full text-left text-xs sm:text-sm" id="exam-specs-table">
      <thead class="bg-muted/60 border-b border-border text-muted-foreground font-semibold uppercase tracking-wider text-[11px]">
        <tr>
          <th class="py-3.5 px-4">Exam / Portal</th>
          <th class="py-3.5 px-4">Required Dimensions</th>
          <th class="py-3.5 px-4">Print Size (cm)</th>
          <th class="py-3.5 px-4">Allowed File Size</th>
          <th class="py-3.5 px-4">Ink &amp; Paper Rules</th>
          <th class="py-3.5 px-4 text-right">Action</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-border/60">
        {EXAM_PRESETS.map((preset) => {
          const dedicatedSlug = presetSlugMap.get(preset.id);
          return (
            <tr
              class="hover:bg-muted/30 transition-colors exam-spec-row"
              data-name={preset.name.toLowerCase()}
              data-code={preset.shortCode.toLowerCase()}
              data-authority={preset.authority.toLowerCase()}
              data-category={preset.category}
            >
              <td class="py-3 px-4">
                {dedicatedSlug ? (
                  <a
                    href={`/${dedicatedSlug}`}
                    class="font-semibold text-foreground hover:text-primary hover:underline transition-colors inline-flex items-center gap-1 group"
                  >
                    <span>{preset.name}</span>
                    <span class="text-[10px] text-primary opacity-60 group-hover:opacity-100 transition-opacity">→</span>
                  </a>
                ) : (
                  <div class="font-semibold text-foreground">{preset.name}</div>
                )}
                <div class="text-[11px] text-muted-foreground flex items-center gap-1.5 pt-0.5">
                  <span>{preset.authority}</span>
                  <span class="inline-block px-1.5 py-0.2 rounded text-[10px] bg-muted border border-border font-medium">
                    {preset.category}
                  </span>
                </div>
              </td>
              <td class="py-3 px-4 font-mono font-medium text-foreground">
                {preset.widthPx} × {preset.heightPx} px
              </td>
              <td class="py-3 px-4 font-mono text-muted-foreground">
                {preset.widthCm} × {preset.heightCm} cm
              </td>
              <td class="py-3 px-4">
                <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-mono font-bold bg-primary/10 text-primary border border-primary/20">
                  {preset.minKb} KB – {preset.maxKb} KB
                </span>
              </td>
              <td class="py-3 px-4 text-xs text-muted-foreground max-w-xs">
                <span class="font-medium text-foreground">{preset.inkRequirement}</span>: {preset.notes}
              </td>
              <td class="py-3 px-4 text-right">
                <div class="flex items-center justify-end gap-2">
                  {dedicatedSlug && (
                    <a
                      href={`/${dedicatedSlug}`}
                      class="hidden sm:inline-flex items-center justify-center min-h-[44px] px-2.5 py-2 rounded-lg text-xs font-medium text-muted-foreground hover:text-primary transition"
                    >
                      Guide →
                    </a>
                  )}
                  <a
                    href="#tool-workspace"
                    data-preset-id={preset.id}
                    class="apply-preset-btn inline-flex items-center justify-center min-h-[44px] min-w-[44px] px-3.5 py-2.5 rounded-lg text-xs font-semibold bg-muted hover:bg-primary hover:text-primary-foreground border border-border transition active:scale-95 cursor-pointer"
                  >
                    Apply Preset
                  </a>
                </div>
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
</section>

<script>
  function initExamSpecsTable() {
    const searchInput = document.getElementById('exam-specs-search') as HTMLInputElement | null;
    const catButtons = document.querySelectorAll('.exam-cat-filter-btn');
    const rows = document.querySelectorAll('.exam-spec-row') as NodeListOf<HTMLTableRowElement>;
    let activeCategory = 'All';

    function filterRows() {
      const query = (searchInput?.value || '').toLowerCase().trim();

      rows.forEach((row) => {
        const name = row.getAttribute('data-name') || '';
        const code = row.getAttribute('data-code') || '';
        const auth = row.getAttribute('data-authority') || '';
        const cat = row.getAttribute('data-category') || '';

        const matchesSearch = !query || name.includes(query) || code.includes(query) || auth.includes(query);
        const matchesCategory = activeCategory === 'All' || cat === activeCategory;

        if (matchesSearch && matchesCategory) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });
    }

    searchInput?.addEventListener('input', filterRows);

    catButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        catButtons.forEach((b) => {
          b.classList.remove('bg-primary', 'text-primary-foreground', 'font-bold', 'shadow-xs');
          b.classList.add('bg-muted/60', 'text-muted-foreground');
        });
        btn.classList.remove('bg-muted/60', 'text-muted-foreground');
        btn.classList.add('bg-primary', 'text-primary-foreground', 'font-bold', 'shadow-xs');

        activeCategory = btn.getAttribute('data-category') || 'All';
        filterRows();
      });
    });

    // Apply Preset button handler
    document.querySelectorAll('.apply-preset-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const presetId = btn.getAttribute('data-preset-id');
        if (presetId) {
          window.dispatchEvent(new CustomEvent('select-exam-preset', { detail: presetId }));
          const url = new URL(window.location.href);
          url.searchParams.set('preset', presetId);
          window.history.replaceState({}, '', url.toString());

          const target = document.getElementById('tool-workspace');
          if (target) {
            target.scrollIntoView({ behavior: 'smooth' });
          }
        }
      });
    });
  }

  // Initialize on load and on client-side navigation
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initExamSpecsTable);
  } else {
    initExamSpecsTable();
  }
</script>
