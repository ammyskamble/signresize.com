---
// ExamSpecsTable.astro
import { EXAM_PRESETS } from '../data/examPresets';
import { EXAM_PAGES_DATA } from '../data/examPagesData';

const presetSlugMap = new Map(EXAM_PAGES_DATA.map((p) => [p.presetId, p.slug]));
---

<section id="exam-specs" class="space-y-6 pt-6">
  <div class="space-y-2 text-center max-w-2xl mx-auto">
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-primary/10 text-primary border border-primary/20">
      Official Guidelines 2026
    </div>
    <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-foreground">
      Official Signature Dimensions &amp; Size Guidelines
    </h2>
    <p class="text-sm text-muted-foreground">
      Verified technical requirements across major Indian competitive exams and government application portals.
    </p>
  </div>

  <div class="overflow-x-auto rounded-xl border border-border bg-card shadow-sm">
    <table class="w-full text-left text-xs sm:text-sm">
      <thead class="bg-muted/60 border-b border-border text-muted-foreground font-semibold uppercase tracking-wider text-[11px]">
        <tr>
          <th class="py-3.5 px-4">Exam / Portal</th>
          <th class="py-3.5 px-4">Required Dimensions</th>
          <th class="py-3.5 px-4">Print Size (cm)</th>
          <th class="py-3.5 px-4">Allowed File Size</th>
          <th class="py-3.5 px-4">Ink &amp; Paper Rules</th>
          <th class="py-3.5 px-4 text-right">Action</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-border/60">
        {EXAM_PRESETS.map((preset) => {
          const dedicatedSlug = presetSlugMap.get(preset.id);
          return (
            <tr class="hover:bg-muted/30 transition-colors">
              <td class="py-3 px-4">
                {dedicatedSlug ? (
                  <a
                    href={`/${dedicatedSlug}`}
                    class="font-semibold text-foreground hover:text-primary hover:underline transition-colors inline-flex items-center gap-1 group"
                  >
                    <span>{preset.name}</span>
                    <span class="text-[10px] text-primary opacity-60 group-hover:opacity-100 transition-opacity">→</span>
                  </a>
                ) : (
                  <div class="font-semibold text-foreground">{preset.name}</div>
                )}
                <div class="text-[11px] text-muted-foreground">{preset.authority}</div>
              </td>
              <td class="py-3 px-4 font-mono font-medium text-foreground">
                {preset.widthPx} × {preset.heightPx} px
              </td>
              <td class="py-3 px-4 font-mono text-muted-foreground">
                {preset.widthCm} × {preset.heightCm} cm
              </td>
              <td class="py-3 px-4">
                <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-mono font-bold bg-primary/10 text-primary border border-primary/20">
                  {preset.minKb} KB – {preset.maxKb} KB
                </span>
              </td>
              <td class="py-3 px-4 text-xs text-muted-foreground max-w-xs">
                <span class="font-medium text-foreground">{preset.inkRequirement}</span>: {preset.notes}
              </td>
              <td class="py-3 px-4 text-right">
                <div class="flex items-center justify-end gap-2">
                  {dedicatedSlug && (
                    <a
                      href={`/${dedicatedSlug}`}
                      class="hidden sm:inline-flex items-center justify-center min-h-[44px] px-2.5 py-2 rounded-lg text-xs font-medium text-muted-foreground hover:text-primary transition"
                    >
                      Guide →
                    </a>
                  )}
                  <a
                    href="#tool-workspace"
                    class="inline-flex items-center justify-center min-h-[44px] min-w-[44px] px-3.5 py-2.5 rounded-lg text-xs font-semibold bg-muted hover:bg-primary hover:text-primary-foreground border border-border transition active:scale-95"
                  >
                    Apply Preset
                  </a>
                </div>
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
</section>
