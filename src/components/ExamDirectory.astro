---
import { ALL_COMBINED_PRESETS } from '../data/examPresets';
import { EXAM_PAGES_DATA } from '../data/examPagesData';
import { presetMode } from '../utils/presetMode';

const links = new Map(EXAM_PAGES_DATA.map(page => [page.presetId, `/${page.slug}/`]));
const featured = ['ssc-cgl', 'ssc-general', 'ssc-cgl-photo', 'ssc-photo', 'rrb-railway', 'upsc-civil-services', 'ibps-sbi', 'iit-jam', 'gate-jam', 'iit-jam-photo', 'gate-photo', 'pan-card-nsdl', 'neet-photo', 'pan-card-photo-nsdl', 'uti-photo-crop', 'handwritten-declaration'];
const presets = [...new Map(ALL_COMBINED_PRESETS.map(p => [p.id, { ...p, targetType: presetMode(p) }])).values()].sort((a, b) => {
  const rank = (p: typeof a) => { const index = featured.indexOf(p.id); return index >= 0 ? index : 100 + (p.country && p.country !== 'IN' ? 100 : 0) + (p.isPopular ? 0 : 10); };
  return rank(a) - rank(b);
});
const groupFor = (p: typeof presets[number]) => p.country && p.country !== 'IN' ? 'international' : ['SSC', 'UPSC', 'Railways'].includes(p.category) ? 'central' : p.category === 'Banking' || /\b(IBPS|SBI)\b/.test(p.name) ? 'banking' : p.category === 'State PSC' ? 'state' : ['Engineering', 'Law', 'Management'].includes(p.category) || /NEET|GATE|CAT|JEE/.test(p.shortCode) ? 'entrance' : 'other';
const tabs = [['all', 'All'], ['central', 'Central'], ['banking', 'Banking'], ['state', 'State PSCs'], ['entrance', 'Entrance exams'], ['international', 'International']];
const tabIcons: Record<string, string> = {
  all: 'M3 3h6v6H3zM15 3h6v6h-6zM3 15h6v6H3zM15 15h6v6h-6z', central: 'M3 10h18L12 3 3 10ZM5 10v9m7-9v9m7-9v9M3 21h18', banking: 'M3 7h18v14H3zM7 7V3h10v4M3 12h18M10 12v3h4v-3', state: 'm3 5 6-2 6 2 6-2v16l-6 2-6-2-6 2V5Zm6-2v16m6-14v16', entrance: 'm2 9 10-5 10 5-10 5L2 9Zm4 2v6l6 3 6-3v-6m4-2v8', international: 'M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0ZM3 12h18M12 3c5 5 5 13 0 18c-5-5-13 0-18 0Z',
};
const directoryPresets = presets.map(p => ({
  id: p.id, name: p.name, authority: p.authority, category: groupFor(p), targetType: p.targetType || 'signature', widthPx: p.widthPx, heightPx: p.heightPx, minKb: p.minKb, maxKb: p.maxKb, format: p.format,
  dimensions: p.widthCm && p.heightCm ? `${p.widthCm} × ${p.heightCm} cm` : `${(p.widthPx / p.dpi * 2.54).toFixed(2)} × ${(p.heightPx / p.dpi * 2.54).toFixed(2)} cm at ${p.dpi} DPI`,
  search: `${p.name} ${p.shortCode || ''} ${p.id} ${p.authority} ${p.category} ${p.targetType || 'signature'}`.toLowerCase(),
  href: links.get(p.id) || (p.country && !['IN', 'GLOBAL'].includes(p.country) ? `/${p.country.toLowerCase()}/` : p.targetType === 'photo' ? '/photo-resizer/' : p.targetType === 'document' ? '/document-resizer/' : '/resize-signature-to-10kb-20kb/'),
}));
const initialPresets = directoryPresets.slice(0, 10);
---
<section id="exam-specs" class="home-directory rounded-xl border border-border bg-card p-4 space-y-3">
  <script type="application/json" id="directory-presets-data" set:html={JSON.stringify(directoryPresets)} />
  <div id="exam-directory" class="flex flex-wrap items-center justify-between gap-3">
    <div><h2 class="text-lg font-bold">Find your exam preset</h2><p class="text-xs text-muted-foreground">Search signature, photo and document requirements. Follow your current exam notice.</p></div>
    <label class="text-xs font-semibold">Search exams<input id="exam-directory-search" type="search" placeholder="SSC CGL, UPSC, IBPS, marksheet…" class="block mt-1 rounded-lg border border-input bg-background px-3 py-2 text-sm w-full sm:w-72" /></label>
  </div>
  <div class="flex flex-wrap gap-2" role="group" aria-label="Filter exam directory">{tabs.map(([key, label]) => <button type="button" data-directory-tab={key} aria-pressed={key === 'all'} class="min-h-[44px] inline-flex items-center rounded-lg border border-border px-3 py-2 text-xs font-semibold"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={tabIcons[key]} /></svg>{label}</button>)}</div>
  <p id="exam-directory-count" role="status" class="text-xs text-muted-foreground">Showing {initialPresets.length} of {directoryPresets.length} presets</p>
  <div class="max-h-[380px] overflow-auto rounded-lg border border-border" tabIndex="0" aria-label="Exam preset table">
    <table class="w-full text-left text-xs min-w-[650px]">
      <thead class="sticky top-0 bg-muted text-muted-foreground"><tr><th class="p-3">Exam / authority</th><th class="p-3">Type</th><th class="p-3">Dimensions (px / cm)</th><th class="p-3">File limit</th><th class="p-3">Action</th></tr></thead>
      <tbody data-directory-body>{initialPresets.map(p => <tr data-directory-row data-category={p.category} data-search={p.search} class="border-t border-border"><td class="p-3"><a class="font-semibold text-primary hover:underline" href={p.href}>{p.name}</a><div class="text-muted-foreground mt-1">{p.authority}</div></td><td class="p-3 capitalize">{p.targetType}</td><td class="p-3 whitespace-nowrap">{p.widthPx} × {p.heightPx} px<div class="text-muted-foreground">{p.dimensions}</div></td><td class="p-3 whitespace-nowrap">{p.minKb}–{p.maxKb} KB<div class="text-muted-foreground">{p.format}</div></td><td class="p-3"><button type="button" data-use-preset={p.id} class="min-h-[44px] rounded-lg bg-primary text-primary-foreground px-3 py-2 font-semibold whitespace-nowrap" aria-label={`Use ${p.name} preset`}>Use preset</button></td></tr>)}</tbody>
    </table>
    <p id="exam-directory-empty" hidden class="p-4 text-sm">No matching presets. Try another exam name or choose All.</p>
  </div>
  <button id="exam-directory-expand" type="button" aria-expanded="false" class="min-h-[44px] min-w-[44px] rounded-lg border border-border p-2.5 text-xs font-semibold">View all {directoryPresets.length} presets</button>
</section>
<script>
  type DirectoryPreset = { id: string; name: string; authority: string; category: string; targetType: string; widthPx: number; heightPx: number; minKb: number; maxKb: number; format: string; dimensions: string; search: string; href: string };
  const directory = document.getElementById('exam-specs') as HTMLElement | null;
  const presetsDataEl = document.getElementById('directory-presets-data');
  const presets: DirectoryPreset[] = presetsDataEl ? JSON.parse(presetsDataEl.textContent || '[]') : [];
  const search = document.getElementById('exam-directory-search') as HTMLInputElement | null;
  const body = directory?.querySelector<HTMLTableSectionElement>('[data-directory-body]') || null;
  const tabs = Array.from(directory?.querySelectorAll<HTMLButtonElement>('[data-directory-tab]') || []);
  const expand = document.getElementById('exam-directory-expand') as HTMLButtonElement | null;
  let category = 'all'; let showAll = false;
  const renderRow = (preset: DirectoryPreset) => {
    const row = document.createElement('tr'); row.className = 'border-t border-border'; row.dataset.directoryRow = ''; row.dataset.category = preset.category; row.dataset.search = preset.search;
    const exam = document.createElement('td'); exam.className = 'p-3';
    const link = document.createElement('a'); link.className = 'font-semibold text-primary hover:underline'; link.href = preset.href; link.textContent = preset.name;
    const authority = document.createElement('div'); authority.className = 'text-muted-foreground mt-1'; authority.textContent = preset.authority; exam.append(link, authority);
    const type = document.createElement('td'); type.className = 'p-3 capitalize'; type.textContent = preset.targetType;
    const dimensions = document.createElement('td'); dimensions.className = 'p-3 whitespace-nowrap'; dimensions.append(`${preset.widthPx} × ${preset.heightPx} px`); const cm = document.createElement('div'); cm.className = 'text-muted-foreground'; cm.textContent = preset.dimensions; dimensions.append(cm);
    const size = document.createElement('td'); size.className = 'p-3 whitespace-nowrap'; size.append(`${preset.minKb}–${preset.maxKb} KB`); const format = document.createElement('div'); format.className = 'text-muted-foreground'; format.textContent = preset.format; size.append(format);
    const action = document.createElement('td'); action.className = 'p-3'; const button = document.createElement('button'); button.type = 'button'; button.dataset.usePreset = preset.id; button.className = 'min-h-[44px] rounded-lg bg-primary text-primary-foreground px-3 py-2 font-semibold whitespace-nowrap'; button.setAttribute('aria-label', `Use ${preset.name} preset`); button.textContent = 'Use preset'; action.append(button);
    row.append(exam, type, dimensions, size, action); return row;
  };
  function filterRows() {
    const query = search?.value.trim().toLowerCase() || '';
    const matched = presets.filter(preset => (category === 'all' || preset.category === category) && preset.search.includes(query));
    const visible = showAll ? matched : matched.slice(0, 10);
    if (body) body.replaceChildren(...visible.map(renderRow));
    const count = document.getElementById('exam-directory-count'); if (count) count.textContent = `Showing ${visible.length} of ${matched.length} matching presets`;
    const empty = document.getElementById('exam-directory-empty'); if (empty) empty.hidden = visible.length !== 0;
    if (expand) { expand.hidden = matched.length <= 10; expand.textContent = showAll ? 'Show top 10 presets' : `View all ${matched.length} presets`; expand.setAttribute('aria-expanded', String(showAll)); }
  }
  search?.addEventListener('input', filterRows);
  expand?.addEventListener('click', () => { showAll = !showAll; filterRows(); });
  tabs.forEach(tab => tab.addEventListener('click', () => { category = tab.dataset.directoryTab || 'all'; showAll = false; tabs.forEach(button => button.setAttribute('aria-pressed', String(button === tab))); filterRows(); }));
  body?.addEventListener('click', event => { const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-use-preset]'); if (!button) return; window.dispatchEvent(new CustomEvent('select-exam-preset', { detail: button.dataset.usePreset })); document.getElementById('studio-container')?.scrollIntoView({ behavior: 'smooth', block: 'start' }); document.getElementById('workspace-exam-select')?.focus({ preventScroll: true }); });
</script>
