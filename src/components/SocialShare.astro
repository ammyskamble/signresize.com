---
// src/components/SocialShare.astro
// Premium, Uniform-Sized Social Media Share Component for All Viewports

interface Props {
  url?: string;
  title?: string;
  description?: string;
  variant?: 'inline' | 'card';
  badgeText?: string;
}

const {
  url = "https://signresize.in/",
  title = "SignResize: Free Online Photo & Signature Resizer for Govt Exams",
  description = "Resize and compress photos and signatures for SSC, RRB, IBPS, UPSC, and State PSC exams to official KB & pixel guidelines.",
  variant = 'card',
  badgeText = "Share with Friends & Study Groups"
} = Astro.props;

const shareMessage = `${title}\n\n${description}`;
const encodedUrl = encodeURIComponent(url);
const encodedText = encodeURIComponent(shareMessage);
const encodedTitleOnly = encodeURIComponent(`${title} — Free Online Tool for Aspirants`);

const shareLinks = [
  {
    name: "WhatsApp",
    href: `https://api.whatsapp.com/send?text=${encodedText}%20${encodedUrl}`,
    colorClass: "bg-[#25D366] text-white hover:bg-[#20bd5a] border border-[#25D366]/60 shadow-xs",
    inlineClass: "bg-[#25D366] text-white hover:bg-[#20bd5a] border border-[#25D366]/60 shadow-xs",
    svgPath: "M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.275.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824zm-3.394-10.416c-5.522 0-10 4.477-10 10 0 1.77.463 3.491 1.341 5.011l-1.425 5.213 5.334-1.399c1.47.801 3.13 1.226 4.75 1.227 5.523 0 10-4.478 10-10 0-5.523-4.477-10-10-10z"
  },
  {
    name: "Telegram",
    href: `https://t.me/share/url?url=${encodedUrl}&text=${encodedTitleOnly}`,
    colorClass: "bg-[#0088cc] text-white hover:bg-[#0077b5] border border-[#0088cc]/60 shadow-xs",
    inlineClass: "bg-[#0088cc] text-white hover:bg-[#0077b5] border border-[#0088cc]/60 shadow-xs",
    svgPath: "M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.75-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"
  },
  {
    name: "Twitter / X",
    shortName: "X",
    href: `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitleOnly}`,
    colorClass: "bg-black dark:bg-zinc-900 text-white hover:bg-zinc-800 dark:hover:bg-zinc-800 border border-zinc-700 dark:border-zinc-600 shadow-xs",
    inlineClass: "bg-zinc-950 dark:bg-zinc-900 text-white hover:bg-black dark:hover:bg-zinc-800 border border-zinc-700 dark:border-zinc-600 shadow-xs",
    svgPath: "M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
  },
  {
    name: "LinkedIn",
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`,
    colorClass: "bg-[#0A66C2] text-white hover:bg-[#084e96] border border-[#0A66C2]/60 shadow-xs",
    inlineClass: "bg-[#0A66C2] text-white hover:bg-[#084e96] border border-[#0A66C2]/60 shadow-xs",
    svgPath: "M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.24c-.95 0-1.72.77-1.72 1.72s.77 1.72 1.72 1.72 1.72-.77 1.72-1.72-.77-1.72-1.72-1.72z"
  },
  {
    name: "Facebook",
    href: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
    colorClass: "bg-[#1877F2] text-white hover:bg-[#1464cc] border border-[#1877F2]/60 shadow-xs",
    inlineClass: "bg-[#1877F2] text-white hover:bg-[#1464cc] border border-[#1877F2]/60 shadow-xs",
    svgPath: "M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
  }
];
---

{variant === 'card' && (
  <div class="my-6 p-4 sm:p-6 rounded-2xl bg-card dark:bg-zinc-900/90 border border-border dark:border-zinc-800 shadow-md space-y-3.5">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-border/80 dark:border-zinc-800 pb-3">
      <div class="flex items-center gap-2.5">
        <span class="w-8 h-8 rounded-xl bg-primary/10 dark:bg-primary/25 text-primary dark:text-indigo-400 border border-primary/20 dark:border-primary/40 flex items-center justify-center text-sm font-bold shadow-xs">
          📢
        </span>
        <div>
          <h4 class="font-bold text-sm sm:text-base text-foreground dark:text-zinc-100 leading-tight">{badgeText}</h4>
          <p class="text-xs text-muted-foreground dark:text-zinc-400 mt-0.5">Help fellow candidates avoid application rejections on official exam portals.</p>
        </div>
      </div>
      <span class="hidden sm:inline-flex items-center gap-1 text-[11px] font-mono text-primary dark:text-indigo-300 font-semibold px-2.5 py-1 rounded-full bg-primary/10 dark:bg-primary/20 border border-primary/20 dark:border-primary/40 shrink-0">
        <span>⚡</span> 1-Click Share
      </span>
    </div>

    <!-- Uniform Grid: Exact 6 Columns on desktop, 3 on tablet, 2 on mobile -->
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-2 sm:gap-2.5 pt-1">
      {shareLinks.map(link => (
        <a
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Share on ${link.name}`}
          class={`h-10 px-3 rounded-xl text-xs font-semibold flex items-center justify-center gap-2 transition-all shadow-xs hover:scale-[1.02] active:scale-[0.98] ${link.colorClass}`}
        >
          <svg class="w-4 h-4 shrink-0 fill-current" viewBox="0 0 24 24">
            <path d={link.svgPath} />
          </svg>
          <span class="truncate">{link.shortName || link.name}</span>
        </a>
      ))}

      <!-- Copy Link Button (High Contrast on Both Light & Dark Theme) -->
      <button
        type="button"
        data-copy-url={url}
        class="copy-share-link-btn h-10 px-3 rounded-xl text-xs font-semibold text-zinc-900 dark:text-zinc-100 bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 border border-zinc-300 dark:border-zinc-600 flex items-center justify-center gap-2 transition-all shadow-xs hover:scale-[1.02] active:scale-[0.98] cursor-pointer"
        aria-label="Copy Link"
      >
        <svg class="w-4 h-4 shrink-0 text-zinc-700 dark:text-zinc-300 copy-default-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
        </svg>
        <svg class="w-4 h-4 shrink-0 text-emerald-400 copy-success-icon hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
        </svg>
        <span class="copy-text truncate">Copy Link</span>
      </button>
    </div>
  </div>
)}

{variant === 'inline' && (
  <div class="flex flex-wrap items-center gap-2">
    <span class="text-xs font-bold text-muted-foreground dark:text-zinc-300 mr-1 flex items-center gap-1">
      <span>📢</span> Share:
    </span>

    {shareLinks.map(link => (
      <a
        href={link.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Share on ${link.name}`}
        title={`Share on ${link.name}`}
        class={`w-8 h-8 rounded-xl flex items-center justify-center transition-all hover:scale-110 active:scale-95 shadow-sm ${link.inlineClass}`}
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path d={link.svgPath} />
        </svg>
      </a>
    ))}

    <!-- Copy Link Button (High Contrast Solid Pill on Black Theme) -->
    <button
      type="button"
      data-copy-url={url}
      class="copy-share-link-btn w-8 h-8 rounded-xl border border-zinc-300 dark:border-zinc-600 bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 text-zinc-700 dark:text-zinc-200 flex items-center justify-center transition-all hover:scale-110 active:scale-95 shadow-sm cursor-pointer relative group"
      title="Copy Link to Clipboard"
      aria-label="Copy Link to Clipboard"
    >
      <svg class="w-4 h-4 text-zinc-700 dark:text-zinc-200 copy-default-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
      </svg>
      <svg class="w-4 h-4 text-emerald-400 copy-success-icon hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
      </svg>

      <!-- Floating Tooltip -->
      <span class="copy-tooltip absolute -top-8 left-1/2 -translate-x-1/2 px-2 py-0.5 rounded-md bg-zinc-900 dark:bg-zinc-100 text-white dark:text-zinc-900 text-[10px] font-bold pointer-events-none opacity-0 transition-opacity whitespace-nowrap shadow-lg border border-zinc-700 dark:border-zinc-300">
        Copied!
      </span>
    </button>
  </div>
)}

<script>
  function setupCopyButtons() {
    document.querySelectorAll('.copy-share-link-btn').forEach(btn => {
      if ((btn as HTMLElement).dataset.listenerAdded) return;
      (btn as HTMLElement).dataset.listenerAdded = 'true';

      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        const copyBtn = btn as HTMLButtonElement;
        const urlToCopy = copyBtn.dataset.copyUrl || window.location.href;
        const defaultIcon = copyBtn.querySelector('.copy-default-icon') as SVGElement | null;
        const successIcon = copyBtn.querySelector('.copy-success-icon') as SVGElement | null;
        const textSpan = copyBtn.querySelector('.copy-text') as HTMLElement | null;
        const tooltip = copyBtn.querySelector('.copy-tooltip') as HTMLElement | null;

        try {
          await navigator.clipboard.writeText(urlToCopy);

          // Visual feedback
          if (defaultIcon && successIcon) {
            defaultIcon.classList.add('hidden');
            successIcon.classList.remove('hidden');
          }
          if (textSpan) {
            textSpan.innerText = 'Copied! ✓';
          }
          if (tooltip) {
            tooltip.classList.remove('opacity-0');
            tooltip.classList.add('opacity-100');
          }
          copyBtn.classList.add('border-emerald-500/50', 'bg-emerald-500/10', 'text-emerald-600', 'dark:text-emerald-400');

          setTimeout(() => {
            if (defaultIcon && successIcon) {
              defaultIcon.classList.remove('hidden');
              successIcon.classList.add('hidden');
            }
            if (textSpan) {
              textSpan.innerText = 'Copy Link';
            }
            if (tooltip) {
              tooltip.classList.add('opacity-0');
              tooltip.classList.remove('opacity-100');
            }
            copyBtn.classList.remove('border-emerald-500/50', 'bg-emerald-500/10', 'text-emerald-600', 'dark:text-emerald-400');
          }, 2000);
        } catch (err) {
          window.prompt('Copy this link:', urlToCopy);
        }
      });
    });
  }

  setupCopyButtons();
  document.addEventListener('astro:page-load', setupCopyButtons);
</script>
