    <!-- Complete 65+ Exam & Portal Directory (Collapsible Accordion) -->
    <div class="border-t border-border/70 pt-4">
      <details class="group select-none rounded-xl border border-border/60 bg-muted/20 hover:bg-muted/30 transition-colors p-3 sm:p-3.5">
        <summary class="flex items-center justify-between cursor-pointer list-none text-muted-foreground hover:text-foreground transition-colors">
          <div class="flex items-center gap-2.5 text-xs font-semibold">
