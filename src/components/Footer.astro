              <span class="truncate font-semibold text-primary">Govt Jobs Calendar</span>
              <span class="text-[9px] font-mono font-bold px-1.5 py-0.5 rounded bg-rose-500/15 text-rose-600 dark:text-rose-400 group-hover:scale-105 transition-transform">LIVE</span>
            </a>
          </li>
          <li>
            <a href="/rrb-signature-resize/" class="flex items-center justify-between py-1 px-1.5 rounded-md hover:bg-muted/60 hover:text-foreground transition-all group">
              <span class="truncate">RRB NTPC CEN 06</span>
              <span class="text-[9px] font-mono font-bold px-1.5 py-0.5 rounded bg-amber-500/15 text-amber-700 dark:text-amber-300 group-hover:scale-105 transition-transform">OCT 8</span>
            </a>
          </li>
          <li>
            <a href="/rrb-alp-signature-resize/" class="flex items-center justify-between py-1 px-1.5 rounded-md hover:bg-muted/60 hover:text-foreground transition-all group">
              <span class="truncate">RRB ALP &amp; Tech</span>
              <span class="text-[9px] font-mono font-bold px-1.5 py-0.5 rounded bg-purple-500/15 text-purple-600 dark:text-purple-400 group-hover:scale-105 transition-transform">140×60</span>
            </a>
          </li>
          <li>
            <a href="/rrb-group-d-photo-resize/" class="flex items-center justify-between py-1 px-1.5 rounded-md hover:bg-muted/60 hover:text-foreground transition-all group">
              <span class="truncate">RRB Group D Photo</span>
              <span class="text-[9px] font-mono font-bold px-1.5 py-0.5 rounded bg-sky-500/15 text-sky-600 dark:text-sky-400 group-hover:scale-105 transition-transform">30–70K</span>
            </a>
          </li>
          <li>
            <a href="/ssc-signature-resize/" class="flex items-center justify-between py-1 px-1.5 rounded-md hover:bg-muted/60 hover:text-foreground transition-all group">
              <span class="truncate">SSC CGL Tier-1</span>
              <span class="text-[9px] font-mono font-bold px-1.5 py-0.5 rounded bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 group-hover:scale-105 transition-transform">Active</span>
            </a>
          </li>
          <li>
            <a href="/ssc-gd-signature-resize/" class="flex items-center justify-between py-1 px-1.5 rounded-md hover:bg-muted/60 hover:text-foreground transition-all group">
              <span class="truncate">SSC GD Constable</span>
              <span class="text-[9px] font-mono font-bold px-1.5 py-0.5 rounded bg-blue-500/15 text-blue-600 dark:text-blue-400 group-hover:scale-105 transition-transform">2026</span>
            </a>
          </li>
          <li>
            <a href="/up-police-signature-resize/" class="flex items-center justify-between py-1 px-1.5 rounded-md hover:bg-muted/60 hover:text-foreground transition-all group">
              <span class="truncate">UP Police Bharti</span>
              <span class="text-[9px] font-mono font-bold px-1.5 py-0.5 rounded bg-purple-500/15 text-purple-600 dark:text-purple-400 group-hover:scale-105 transition-transform">60K+</span>
            </a>
          </li>
          <li>
            <a href="/neet-photo-resize/" class="flex items-center justify-between py-1 px-1.5 rounded-md hover:bg-muted/60 hover:text-foreground transition-all group">
              <span class="truncate">NEET Photo (Name/Date)</span>
              <span class="text-[9px] font-mono font-bold px-1.5 py-0.5 rounded bg-rose-500/15 text-rose-600 dark:text-rose-400 group-hover:scale-105 transition-transform">10–200K</span>
            </a>
          </li>
        </ul>
      </div>

      {/* Column 4: Authority Guides & FAQs (Span 3 of 12) */}
      <div class="space-y-2.5 lg:col-span-3 sm:col-span-1">
        <div class="flex items-center gap-1.5 border-b-2 border-emerald-500/80 pb-1.5">
          <span class="text-xs">📚</span>
          <h3 class="font-bold text-foreground text-xs uppercase tracking-wider">Knowledge Hub</h3>
        </div>
        <ul class="space-y-1">
          <li>
            <a href="/blog/ssc-live-photo-webcam-guidelines-troubleshooting-2026/" class="flex items-center justify-between py-1 px-1.5 rounded-md hover:bg-muted/60 hover:text-foreground transition-all group">
              <span class="truncate">SSC Live Webcam Fix</span>
              <span class="text-[9px] font-mono font-bold px-1.5 py-0.5 rounded bg-rose-500/15 text-rose-600 dark:text-rose-400 group-hover:scale-105 transition-transform">New</span>
            </a>
          </li>
          <li>
            <a href="/blog/blue-ink-vs-black-ink-signature-guidelines-govt-exams/" class="flex items-center justify-between py-1 px-1.5 rounded-md hover:bg-muted/60 hover:text-foreground transition-all group">
              <span class="truncate">Blue vs Black Ink Rules</span>
              <span class="text-[9px] font-mono font-bold px-1.5 py-0.5 rounded bg-sky-500/15 text-sky-600 dark:text-sky-400 group-hover:scale-105 transition-transform">Guide</span>
            </a>
          </li>
          <li>
            <a href="/blog/rrb-ntpc-cen-06-2026-photo-signature-guidelines/" class="flex items-center justify-between py-1 px-1.5 rounded-md hover:bg-muted/60 hover:text-foreground transition-all group">
              <span class="truncate">CEN 06/2026 Rules</span>
              <span class="text-[9px] font-mono font-bold px-1.5 py-0.5 rounded bg-amber-500/15 text-amber-700 dark:text-amber-300 group-hover:scale-105 transition-transform">RRB</span>
            </a>
          </li>
          <li>
            <a href="/blog/top-5-mistakes-photo-signature-rejection-govt-exams/" class="flex items-center justify-between py-1 px-1.5 rounded-md hover:bg-muted/60 hover:text-foreground transition-all group">
              <span class="truncate">Top 5 Rejections</span>
              <span class="text-[9px] font-mono font-bold px-1.5 py-0.5 rounded bg-rose-500/15 text-rose-600 dark:text-rose-400 group-hover:scale-105 transition-transform">Alert</span>
            </a>
          </li>
          <li>
            <a href="/blog/ibps-po-clerk-2026-photo-signature-thumb-declaration-guidelines/" class="flex items-center justify-between py-1 px-1.5 rounded-md hover:bg-muted/60 hover:text-foreground transition-all group">
              <span class="truncate">IBPS Declaration Text</span>
              <span class="text-[9px] font-mono font-bold px-1.5 py-0.5 rounded bg-purple-500/15 text-purple-600 dark:text-purple-400 group-hover:scale-105 transition-transform">Thumb</span>
            </a>
          </li>
          <li>
            <a href="/blog/state-psc-otr-registration-photo-signature-guidelines/" class="flex items-center justify-between py-1 px-1.5 rounded-md hover:bg-muted/60 hover:text-foreground transition-all group">
              <span class="truncate">State PSC OTR Guide</span>
              <span class="text-[9px] font-mono font-bold px-1.5 py-0.5 rounded bg-indigo-500/15 text-indigo-600 dark:text-indigo-400 group-hover:scale-105 transition-transform">OTR</span>
            </a>
          </li>
          <li>
            <a href="/blog/how-to-change-signature-in-outlook/" class="flex items-center justify-between py-1 px-1.5 rounded-md hover:bg-muted/60 hover:text-foreground transition-all group">
              <span class="truncate">Change Outlook Sign</span>
              <span class="text-[9px] font-mono font-bold px-1.5 py-0.5 rounded bg-blue-500/15 text-blue-600 dark:text-blue-400 group-hover:scale-105 transition-transform">Office</span>
            </a>
          </li>
          <li>
