      </div>
    </div>

    <!-- Complete 65+ Exam & Portal Directory (Categorized 4-Column Grid) -->
    <div class="border-t border-border/70 pt-6">
      <details class="group select-none" open>
        <summary class="flex items-center justify-between cursor-pointer list-none py-1 text-muted-foreground hover:text-foreground transition-colors">
          <div class="flex items-center gap-2 text-xs font-semibold">
            <span class="w-2 h-2 rounded-full bg-primary"></span>
            <span class="text-foreground font-bold text-sm">Supported Exam &amp; Portal Presets</span>
            <span class="text-muted-foreground font-normal hidden sm:inline">— 65+ Official Portals with Verified Specs</span>
          </div>
          <div class="flex items-center gap-1.5 text-xs font-semibold text-primary">
            <span class="group-open:hidden flex items-center gap-1">Browse All 65+ Exams <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg></span>
            <span class="hidden group-open:inline-flex items-center gap-1">Collapse Directory <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" /></svg></span>
          </div>
        </summary>

        {/* Directory Content (Balanced 4-Column Grid) */}
        <div class="pt-6 pb-2 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 text-[11px]">
          
          <!-- Category 1: Central Govt & Railways -->
          <div class="space-y-2">
            <div class="font-bold text-foreground text-xs border-b border-border/70 pb-1.5 flex items-center gap-1.5">
              <span>🏛️</span> Central Govt &amp; Railways
            </div>
            <ul class="space-y-1.5">
              <li><a href="/ssc-signature-resize/" class="hover:text-primary transition-colors">SSC CGL, CHSL, MTS (140×60)</a></li>
              <li><a href="/ssc-gd-signature-resize/" class="hover:text-primary transition-colors">SSC GD Constable (10–20 KB)</a></li>
              <li><a href="/ssc-chsl-signature-resize/" class="hover:text-primary transition-colors">SSC CHSL 10+2 Portal</a></li>
              <li><a href="/upsc-signature-resize/" class="hover:text-primary transition-colors">UPSC Civil Services (350×350)</a></li>
              <li><a href="/rrb-signature-resize/" class="hover:text-primary transition-colors">RRB Railway Recruitment</a></li>
              <li><a href="/rrb-alp-signature-resize/" class="hover:text-primary transition-colors font-medium text-primary">RRB ALP &amp; Technician Sign</a></li>
              <li><a href="/rrb-group-d-photo-resize/" class="hover:text-primary transition-colors font-medium text-primary">RRB Group D Photo (30–70 KB)</a></li>
              <li><a href="/dsssb-signature-resize/" class="hover:text-primary transition-colors">DSSSB Delhi OARS Upload</a></li>
              <li><a href="/ctet-signature-resize/" class="hover:text-primary transition-colors">CTET Signature Resize</a></li>
              <li><a href="/ctet-photo-resize/" class="hover:text-primary transition-colors">CTET Photo Resize (3.5×4.5 cm)</a></li>
              <li><a href="/state-tet-signature-resize/" class="hover:text-primary transition-colors">State TET (UPTET, REET, MahaTET)</a></li>
              <li><a href="/ugc-net-signature-resize/" class="hover:text-primary transition-colors">UGC NET &amp; JRF Assistant</a></li>
