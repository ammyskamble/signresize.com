---
// src/components/Footer.astro
// Modern 5-Column High-Density Engineered Footer inspired by DevSubnet.com
// Features: Accent-bar headings, micro-tag pills, Fast Lanes shortcuts, live trust indicators & complete 65+ exam directory.
import Logo from './Logo.astro';
import SocialShare from './SocialShare.astro';
import ChatBot from './ChatBot.tsx';
import ScrollToTop from './ScrollToTop.astro';
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-border/80 bg-gradient-to-b from-card/80 via-card/90 to-card text-xs text-muted-foreground mt-16 pt-10 pb-8 relative z-10" role="contentinfo">
  <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
    
    <!-- Sarkari Exam Alert & Newsletter Subscription Card -->
    <div class="relative overflow-hidden rounded-2xl border border-primary/20 bg-gradient-to-r from-primary/10 via-card to-purple-500/10 p-5 sm:p-6 shadow-xs">
      <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-5 relative z-10">
        <div class="space-y-1.5 max-w-xl">
          <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-primary/15 text-primary text-[10px] font-mono font-bold tracking-wide">
            <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>
            FREE SARKARI EXAM ALERTS
          </div>
          <h3 class="text-sm sm:text-base font-bold text-foreground tracking-tight">
            Never miss a 2026 photo rule change or application deadline
          </h3>
          <p class="text-xs text-muted-foreground leading-relaxed">
            Get instant email alerts when SSC, RRB, UPSC, or State PSCs modify upload specs, launch live webcam verification, or release new admit card guidelines.
          </p>
        </div>

        <!-- Subscribe Form -->
        <div class="w-full lg:w-auto min-w-[320px] max-w-md">
          <form id="footer-subscribe-form" class="space-y-1.5">
            <div class="flex items-center gap-1 p-1 rounded-xl bg-background border border-border focus-within:border-primary focus-within:ring-1 focus-within:ring-primary shadow-xs transition-all">
              <span class="pl-2.5 text-muted-foreground text-xs">✉️</span>
              <input
                type="email"
                id="subscriber-email"
                required
                placeholder="Enter email for exam updates..."
                class="w-full px-2 py-1.5 text-xs bg-transparent text-foreground placeholder:text-muted-foreground focus:outline-none"
              />
              <button
                type="submit"
                id="subscribe-btn"
                class="px-4 py-2 rounded-lg bg-primary hover:bg-primary/90 text-primary-foreground font-bold text-xs shadow-xs transition-all whitespace-nowrap flex items-center gap-1"
              >
                <span>Subscribe</span>
                <span>→</span>
              </button>
            </div>
            <div id="subscribe-status" class="hidden text-[11px] font-medium text-emerald-600 dark:text-emerald-400 pl-1">
              ✓ Subscribed! You will receive 2026 exam photo &amp; signature notifications.
            </div>
            <div class="flex items-center justify-between px-1 text-[10px] text-muted-foreground">
              <span>🔒 100% In-Browser. No Spam.</span>
              <span>⚡ 12,000+ Aspirants Joined</span>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- 5-Column Master Grid (3 + 2 + 2 + 3 + 2 = 12 cols, zero blank space) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-12 gap-7 lg:gap-8 items-start">
      
      {/* Column 1: Brand & Fast Lanes (Span 3.5 on desktop) */}
      <div class="space-y-3.5 sm:col-span-2 lg:col-span-3">
        <a href="/" class="inline-flex items-center gap-2 group hover:opacity-90 transition">
          <Logo class="w-7 h-7 rounded-lg shadow-xs group-hover:scale-105 transition-transform" />
          <span class="font-extrabold text-base tracking-tight text-foreground group-hover:text-primary transition-colors">
            Sign<span class="text-primary">Resize</span><span class="text-muted-foreground font-normal text-xs">.in</span>
          </span>
        </a>

        <div class="text-[10px] font-mono tracking-widest text-primary font-bold uppercase">
          100% In-Browser Document Engine
        </div>

        <p class="text-xs leading-relaxed text-muted-foreground">
          Precision photo, signature, and marksheet compression engine for Indian competitive exams (SSC, UPSC, RRB, IBPS, NTA) and state recruitment portals. Zero server storage.
        </p>

        <!-- Fast Lanes: Quick Category Navigation Pills -->
        <div class="pt-1 space-y-1.5">
          <div class="text-[10px] font-mono uppercase tracking-wider text-muted-foreground font-bold">Fast Lanes:</div>
          <div class="flex flex-wrap gap-1.5">
            <a href="/ssc-signature-resize/" class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-primary/10 text-primary border border-primary/20 hover:bg-primary/20 hover:-translate-y-0.5 transition-all" title="SSC CGL, CHSL, MTS & GD Presets">
              <span>✍️ SSC &amp; Railways</span>
            </a>
            <a href="/ibps-signature-resize/" class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-purple-500/10 text-purple-700 dark:text-purple-300 border border-purple-500/20 hover:bg-purple-500/20 hover:-translate-y-0.5 transition-all" title="IBPS Banking Presets">
              <span>🏦 Banking &amp; Police</span>
            </a>
            <a href="/photo-resizer/" class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 border border-emerald-500/20 hover:bg-emerald-500/20 hover:-translate-y-0.5 transition-all" title="Passport Photo Resizer">
              <span>📸 Passport Photos</span>
            </a>
            <a href="/document-resizer/" class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-amber-500/10 text-amber-700 dark:text-amber-300 border border-amber-500/20 hover:bg-amber-500/20 hover:-translate-y-0.5 transition-all" title="Certificate PDF & Marksheet Resizer">
              <span>📄 PDF Export</span>
            </a>
          </div>
        </div>

        {/* Integrated Study Circle Share */}
        <div class="pt-1.5 space-y-1.5">
          <div class="text-[10px] font-mono uppercase tracking-wider text-muted-foreground font-bold">Share With Study Groups:</div>
          <SocialShare
            url="https://signresize.in/"
            title="SignResize: Free Online Photo & Signature Resizer for Govt Exams"
            description="Fast, free, 100% in-browser photo and signature resizer for SSC, RRB, IBPS, UPSC, and State PSC exams."
            variant="inline"
          />
        </div>
      </div>

      {/* Column 2: Core Tools & Utilities (Span 2.5) */}
      <div class="space-y-2.5 lg:col-span-2 sm:col-span-1">
        <div class="flex items-center gap-1.5 border-b-2 border-sky-500/80 pb-1.5">
          <span class="text-xs">🧮</span>
          <h3 class="font-bold text-foreground text-xs uppercase tracking-wider">Core Tools</h3>
        </div>
        <ul class="space-y-1">
          <li>
            <a href="/resize-signature-to-10kb-20kb/" class="flex items-center justify-between py-1 px-1.5 rounded-md hover:bg-muted/60 hover:text-foreground transition-all group">
              <span class="truncate">Signature Resizer</span>
              <span class="text-[9px] font-mono font-bold px-1.5 py-0.5 rounded bg-sky-500/15 text-sky-600 dark:text-sky-400 group-hover:scale-105 transition-transform">10–20 KB</span>
            </a>
          </li>
          <li>
            <a href="/photo-resizer/" class="flex items-center justify-between py-1 px-1.5 rounded-md hover:bg-muted/60 hover:text-foreground transition-all group">
              <span class="truncate">Passport Photo</span>
              <span class="text-[9px] font-mono font-bold px-1.5 py-0.5 rounded bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 group-hover:scale-105 transition-transform">3.5×4.5</span>
            </a>
          </li>
          <li>
            <a href="/document-resizer/" class="flex items-center justify-between py-1 px-1.5 rounded-md hover:bg-muted/60 hover:text-foreground transition-all group">
              <span class="truncate">Document Resizer</span>
              <span class="text-[9px] font-mono font-bold px-1.5 py-0.5 rounded bg-amber-500/15 text-amber-700 dark:text-amber-300 group-hover:scale-105 transition-transform">PDF &lt;300K</span>
            </a>
          </li>
          <li>
            <a href="/compress-image-to-kb/" class="flex items-center justify-between py-1 px-1.5 rounded-md hover:bg-muted/60 hover:text-foreground transition-all group">
              <span class="truncate">Compress to KB</span>
              <span class="text-[9px] font-mono font-bold px-1.5 py-0.5 rounded bg-purple-500/15 text-purple-600 dark:text-purple-400 group-hover:scale-105 transition-transform">Custom</span>
            </a>
          </li>
          <li>
            <a href="/thumb-impression-resize/" class="flex items-center justify-between py-1 px-1.5 rounded-md hover:bg-muted/60 hover:text-foreground transition-all group">
              <span class="truncate">Thumb Impression</span>
              <span class="text-[9px] font-mono font-bold px-1.5 py-0.5 rounded bg-blue-500/15 text-blue-600 dark:text-blue-400 group-hover:scale-105 transition-transform">20–50 KB</span>
            </a>
          </li>
          <li>
            <a href="/ssc-signature-resize/" class="flex items-center justify-between py-1 px-1.5 rounded-md hover:bg-muted/60 hover:text-foreground transition-all group">
              <span class="truncate">SSC Signature (140×60)</span>
              <span class="text-[9px] font-mono font-bold px-1.5 py-0.5 rounded bg-indigo-500/15 text-indigo-600 dark:text-indigo-400 group-hover:scale-105 transition-transform">10–20 KB</span>
            </a>
          </li>
          <li>
            <a href="/signature-generator/" class="flex items-center justify-between py-1 px-1.5 rounded-md hover:bg-muted/60 hover:text-foreground transition-all group">
              <span class="truncate">Font Generator</span>
              <span class="text-[9px] font-mono font-bold px-1.5 py-0.5 rounded bg-rose-500/15 text-rose-600 dark:text-rose-400 group-hover:scale-105 transition-transform">Handwriting</span>
            </a>
          </li>
          <li>
            <a href="/electronic-signature/" class="flex items-center justify-between py-1 px-1.5 rounded-md hover:bg-muted/60 hover:text-foreground transition-all group">
              <span class="truncate">E-Sign Pad</span>
              <span class="text-[9px] font-mono font-bold px-1.5 py-0.5 rounded bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 group-hover:scale-105 transition-transform">Draw</span>
            </a>
          </li>
          <li>
            <a href="/make-signature-background-white/" class="flex items-center justify-between py-1 px-1.5 rounded-md hover:bg-muted/60 hover:text-foreground transition-all group">
              <span class="truncate">White Background</span>
              <span class="text-[9px] font-mono font-bold px-1.5 py-0.5 rounded bg-amber-500/15 text-amber-600 dark:text-amber-400 group-hover:scale-105 transition-transform">#FFFFFF</span>
            </a>
          </li>
        </ul>
      </div>

      {/* Column 3: Active Recruitment 2026 (Span 2.5) */}
      <div class="space-y-2.5 lg:col-span-2 sm:col-span-1">
        <div class="flex items-center gap-1.5 border-b-2 border-purple-500/80 pb-1.5">
          <span class="text-xs">⚡</span>
