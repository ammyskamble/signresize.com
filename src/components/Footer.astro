              <span class="truncate">Contact</span>
            </a>
          </li>
          <li>
            <a href="/privacy/" class="flex items-center justify-between py-1 px-1.5 rounded-md text-slate-300 hover:bg-slate-900 hover:text-white transition-all group">
              <span class="truncate">Privacy</span>
              <span class="text-[9px] font-mono font-bold px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">Zero Logs</span>
            </a>
          </li>
          <li>
            <a href="/terms/" class="flex items-center justify-between py-1 px-1.5 rounded-md text-slate-300 hover:bg-slate-900 hover:text-white transition-all">
