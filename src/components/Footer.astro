              <li><a href="/lic-signature-resize/" class="hover:text-primary transition-colors">LIC AAO, ADO &amp; Insurance</a></li>
              <li><a href="/thumb-impression-resize/" class="hover:text-primary transition-colors font-semibold text-primary">Left Thumb Impression (20–50 KB)</a></li>
              <li><a href="/pan-card-signature-resize/" class="hover:text-primary transition-colors">PAN Card Signature (NSDL/UTI)</a></li>
              <li><a href="/pan-card-photo-resize/" class="hover:text-primary transition-colors">PAN Card Photo (213×213 px)</a></li>
              <li><a href="/passport-seva-signature-resize/" class="hover:text-primary transition-colors">Passport Seva Kendra Upload</a></li>
              <li><a href="/sarathi-dl-signature-resize/" class="hover:text-primary transition-colors">Sarathi Parivahan DL / LL</a></li>
            </ul>
          </div>

          <!-- Category 3: Police & Defense Forces -->
          <div class="space-y-2">
            <div class="font-bold text-foreground text-xs border-b border-border/70 pb-1.5 flex items-center gap-1.5">
              <span>👮</span> Police &amp; Defense Forces
            </div>
            <ul class="space-y-1.5">
              <li><a href="/up-police-signature-resize/" class="hover:text-primary transition-colors font-medium text-primary">UP Police Constable &amp; SI Sign</a></li>
              <li><a href="/rajasthan-police-signature-resize/" class="hover:text-primary transition-colors font-medium text-primary">Rajasthan Police Signature (SSO)</a></li>
