          </li>
          <li>
            <a href="/terms/" class="flex items-center justify-between py-1 px-1.5 rounded-md hover:bg-muted/60 hover:text-foreground transition-all">
              <span class="truncate">Terms</span>
            </a>
          </li>
          <li>
            <a href="/disclaimer/" class="flex items-center justify-between py-1 px-1.5 rounded-md hover:bg-muted/60 hover:text-foreground transition-all">
              <span class="truncate">Disclaimer</span>
