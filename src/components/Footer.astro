              <span class="truncate">Top 5 Rejections</span>
              <span class="text-[9px] font-mono font-bold px-1.5 py-0.5 rounded bg-rose-500/20 text-rose-300 border border-rose-500/30 group-hover:scale-105 transition-transform">Alert</span>
            </a>
          </li>
          <li>
            <a href="/blog/ibps-po-clerk-2026-photo-signature-thumb-declaration-guidelines/" class="flex items-center justify-between py-1 px-1.5 rounded-md text-slate-300 hover:bg-slate-900 hover:text-purple-300 transition-all group">
              <span class="truncate">IBPS Declaration Text</span>
              <span class="text-[9px] font-mono font-bold px-1.5 py-0.5 rounded bg-purple-500/20 text-purple-300 border border-purple-500/30 group-hover:scale-105 transition-transform">Thumb</span>
            </a>
          </li>
          <li>
            <a href="/blog/state-psc-otr-registration-photo-signature-guidelines/" class="flex items-center justify-between py-1 px-1.5 rounded-md text-slate-300 hover:bg-slate-900 hover:text-indigo-300 transition-all group">
              <span class="truncate">State PSC OTR Guide</span>
              <span class="text-[9px] font-mono font-bold px-1.5 py-0.5 rounded bg-indigo-500/20 text-indigo-300 border border-indigo-500/30 group-hover:scale-105 transition-transform">OTR</span>
            </a>
          </li>
          <li>
            <a href="/blog/how-to-change-signature-in-outlook/" class="flex items-center justify-between py-1 px-1.5 rounded-md text-slate-300 hover:bg-slate-900 hover:text-blue-300 transition-all group">
              <span class="truncate">Change Outlook Sign</span>
              <span class="text-[9px] font-mono font-bold px-1.5 py-0.5 rounded bg-blue-500/20 text-blue-300 border border-blue-500/30 group-hover:scale-105 transition-transform">Office</span>
            </a>
          </li>
          <li>
            <a href="/blog/" class="flex items-center justify-between py-1 px-1.5 rounded-md text-cyan-400 font-bold hover:bg-slate-900 transition-all group">
              <span class="truncate">View All 30+ Guides</span>
              <span class="text-[9px] font-mono font-bold">&rarr;</span>
