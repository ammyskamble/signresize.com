---
// src/components/Footer.astro
// Modern, Organized, High-Density Footer (Linear / Vercel Aesthetic)
// Featuring Complete 65+ Exam Directory, Multilingual Navigation, Core Tools & Verified Authority Guides
import Logo from './Logo.astro';
import SocialShare from './SocialShare.astro';
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-border/80 bg-card/60 dark:bg-zinc-950/60 mt-16 pt-12 pb-8 text-xs text-muted-foreground backdrop-blur-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
    
    <!-- Top 4-Column Grid: Brand, Tools, Authority Guides & Legal -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-8 lg:gap-10">
      
      {/* Col 1: Brand, Privacy Guarantee & Integrated Social Share (Span 4) */}
      <div class="space-y-4 sm:col-span-2 lg:col-span-4">
        <a href="/" class="flex items-center gap-2 group hover:opacity-90 transition">
          <Logo class="w-7 h-7 rounded-lg shadow-xs group-hover:scale-105 transition-transform" />
          <span class="font-bold text-base text-foreground tracking-tight group-hover:text-primary transition-colors">SignResize.in</span>
        </a>
        <p class="text-xs leading-relaxed text-muted-foreground max-w-sm">
          Privacy-first photo, signature, and marksheet compressor engineered specifically for Indian competitive exams (SSC, IBPS, UPSC, Railway RRB, NTA) and state recruitment portals.
        </p>

        <!-- Privacy & Security Pill Badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 border border-emerald-500/20 text-[11px] font-semibold">
          <svg class="w-3.5 h-3.5 shrink-0 text-emerald-600 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          <span>100% In-Browser • Zero Server Storage</span>
        </div>

        {/* Seamlessly Integrated Social Share Bar */}
        <div class="pt-2 space-y-2">
          <div class="text-[10px] font-bold text-foreground/70 uppercase tracking-wider">Share With Study Circles</div>
          <SocialShare
            url="https://signresize.in/"
            title="SignResize: Free Online Photo & Signature Resizer for Govt Exams"
            description="Fast, free, 100% in-browser photo and signature resizer for SSC, RRB, IBPS, UPSC, and State PSC exams."
            variant="inline"
          />
        </div>
      </div>

      {/* Col 2: Online Tools & Generators (Span 3) */}
      <div class="space-y-3 lg:col-span-3">
        <div class="font-bold text-foreground text-xs uppercase tracking-wider flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
          Free Web Tools
        </div>
        <ul class="space-y-2 text-xs">
          <li><a href="/" class="hover:text-primary transition-colors font-medium">Signature Resizer (10–20 KB)</a></li>
          <li><a href="/photo-resizer/" class="hover:text-primary transition-colors font-medium">Passport Photo Resizer</a></li>
          <li><a href="/document-resizer/" class="hover:text-primary transition-colors font-medium">Document &amp; Marksheet Resizer <span class="px-1.5 py-0.5 rounded text-[10px] bg-amber-500/15 text-amber-700 dark:text-amber-300 font-bold ml-1">PDF</span></a></li>
          <li><a href="/compress-image-to-kb/" class="hover:text-primary transition-colors font-medium">Compress Image to KB</a></li>
          <li><a href="/thumb-impression-resize/" class="hover:text-primary transition-colors font-medium">Thumb Impression Resizer</a></li>
          <li><a href="/signature-creator/" class="hover:text-primary transition-colors font-medium">Online Signature Creator</a></li>
          <li><a href="/signature-generator/" class="hover:text-primary transition-colors font-medium">Signature Font Generator</a></li>
          <li><a href="/electronic-signature/" class="hover:text-primary transition-colors font-medium">Digital E-Signature Pad</a></li>
          <li><a href="/government-jobs/" class="hover:text-primary transition-colors font-semibold text-primary">Pan-India Govt Jobs 2026</a></li>
        </ul>
      </div>

      {/* Col 3: Authority Guides & Editorial Articles (Span 3) */}
      <div class="space-y-3 lg:col-span-3">
        <div class="font-bold text-foreground text-xs uppercase tracking-wider flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
          Authority Guides
        </div>
        <ul class="space-y-2 text-xs">
          <li><a href="/blog/ssc-live-photo-webcam-guidelines-troubleshooting-2026/" class="hover:text-primary transition-colors font-medium">SSC Live Webcam Photo Fixes</a></li>
          <li><a href="/blog/blue-ink-vs-black-ink-signature-guidelines-govt-exams/" class="hover:text-primary transition-colors font-medium">Blue vs Black Ink Rules Matrix</a></li>
          <li><a href="/blog/rrb-ntpc-cen-06-2026-photo-signature-guidelines/" class="hover:text-primary transition-colors font-medium">RRB NTPC CEN 06/2026 Rules</a></li>
          <li><a href="/blog/top-5-mistakes-photo-signature-rejection-govt-exams/" class="hover:text-primary transition-colors font-medium">Top 5 Rejection Mistakes</a></li>
          <li><a href="/blog/ibps-po-clerk-2026-photo-signature-thumb-declaration-guidelines/" class="hover:text-primary transition-colors font-medium">IBPS Declaration &amp; Thumb Rules</a></li>
          <li><a href="/blog/state-psc-otr-registration-photo-signature-guidelines/" class="hover:text-primary transition-colors font-medium">State PSC OTR Guidelines</a></li>
          <li><a href="/blog/how-to-change-signature-in-outlook/" class="hover:text-primary transition-colors font-medium">Change Signature in Outlook</a></li>
          <li><a href="/blog/" class="hover:text-primary transition-colors font-semibold text-primary">All 30+ Preparation Guides &rarr;</a></li>
        </ul>
      </div>

      {/* Col 4: Legal & Company (Span 2) */}
      <div class="space-y-3 lg:col-span-2">
        <div class="font-bold text-foreground text-xs uppercase tracking-wider flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
          Trust &amp; Legal
        </div>
        <ul class="space-y-2 text-xs">
          <li><a href="/about/" class="hover:text-primary transition-colors font-medium">About SignResize</a></li>
          <li><a href="/contact/" class="hover:text-primary transition-colors font-medium">Contact Support</a></li>
          <li><a href="/privacy/" class="hover:text-primary transition-colors font-medium">Privacy Policy</a></li>
          <li><a href="/terms/" class="hover:text-primary transition-colors font-medium">Terms &amp; Conditions</a></li>
          <li><a href="/disclaimer/" class="hover:text-primary transition-colors font-medium">Disclaimer</a></li>
          <li><a href="/sitemap.xml" class="hover:text-primary transition-colors font-medium">XML Sitemap</a></li>
        </ul>
