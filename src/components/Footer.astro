    </div>

    <!-- Multilingual Regional Language Switcher Bar -->
    <div class="border-t border-border/70 pt-4 flex flex-wrap items-center justify-between gap-3 text-xs">
      <div class="flex items-center gap-2">
        <span class="text-foreground font-semibold">🌐 SignResize Regional Portals:</span>
        <span class="text-muted-foreground text-[11px]">Select your regional language</span>
      </div>
      <div class="flex items-center gap-2">
        <a href="/" class="px-3 py-1 rounded-full bg-primary/10 text-primary font-bold border border-primary/20 hover:bg-primary/20 transition-all text-xs flex items-center gap-1.5">
