        <div class="flex items-center gap-1.5 border-b-2 border-purple-400 pb-1.5">
          <span class="text-xs">⚡</span>
          <h3 class="font-extrabold text-purple-300 text-xs uppercase tracking-wider">Active 2026 Hub</h3>
        </div>
        <ul class="space-y-1">
          <li>
            <a href="/government-jobs/" class="flex items-center justify-between py-1 px-1.5 rounded-md text-slate-300 hover:bg-slate-900 hover:text-rose-300 transition-all group">
              <span class="truncate font-semibold text-cyan-400">Govt Jobs Calendar</span>
              <span class="text-[9px] font-mono font-bold px-1.5 py-0.5 rounded bg-rose-500/20 text-rose-300 border border-rose-500/30 group-hover:scale-105 transition-transform">LIVE</span>
            </a>
          </li>
          <li>
            <a href="/rrb-signature-resize/" class="flex items-center justify-between py-1 px-1.5 rounded-md text-slate-300 hover:bg-slate-900 hover:text-amber-300 transition-all group">
              <span class="truncate">RRB NTPC CEN 06</span>
              <span class="text-[9px] font-mono font-bold px-1.5 py-0.5 rounded bg-amber-500/20 text-amber-300 border border-amber-500/30 group-hover:scale-105 transition-transform">OCT 8</span>
            </a>
          </li>
          <li>
            <a href="/rrb-alp-signature-resize/" class="flex items-center justify-between py-1 px-1.5 rounded-md text-slate-300 hover:bg-slate-900 hover:text-purple-300 transition-all group">
              <span class="truncate">RRB ALP &amp; Tech</span>
              <span class="text-[9px] font-mono font-bold px-1.5 py-0.5 rounded bg-purple-500/20 text-purple-300 border border-purple-500/30 group-hover:scale-105 transition-transform">140×60</span>
            </a>
          </li>
          <li>
            <a href="/rrb-group-d-photo-resize/" class="flex items-center justify-between py-1 px-1.5 rounded-md text-slate-300 hover:bg-slate-900 hover:text-sky-300 transition-all group">
              <span class="truncate">RRB Group D Photo</span>
              <span class="text-[9px] font-mono font-bold px-1.5 py-0.5 rounded bg-sky-500/20 text-sky-300 border border-sky-500/30 group-hover:scale-105 transition-transform">30–70K</span>
            </a>
          </li>
          <li>
            <a href="/ssc-signature-resize/" class="flex items-center justify-between py-1 px-1.5 rounded-md text-slate-300 hover:bg-slate-900 hover:text-emerald-300 transition-all group">
              <span class="truncate">SSC CGL Tier-1</span>
              <span class="text-[9px] font-mono font-bold px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 group-hover:scale-105 transition-transform">Active</span>
            </a>
          </li>
          <li>
            <a href="/ssc-gd-signature-resize/" class="flex items-center justify-between py-1 px-1.5 rounded-md text-slate-300 hover:bg-slate-900 hover:text-blue-300 transition-all group">
              <span class="truncate">SSC GD Constable</span>
              <span class="text-[9px] font-mono font-bold px-1.5 py-0.5 rounded bg-blue-500/20 text-blue-300 border border-blue-500/30 group-hover:scale-105 transition-transform">2026</span>
            </a>
          </li>
          <li>
            <a href="/up-police-signature-resize/" class="flex items-center justify-between py-1 px-1.5 rounded-md text-slate-300 hover:bg-slate-900 hover:text-purple-300 transition-all group">
              <span class="truncate">UP Police Bharti</span>
              <span class="text-[9px] font-mono font-bold px-1.5 py-0.5 rounded bg-purple-500/20 text-purple-300 border border-purple-500/30 group-hover:scale-105 transition-transform">60K+</span>
            </a>
          </li>
          <li>
            <a href="/neet-photo-resize/" class="flex items-center justify-between py-1 px-1.5 rounded-md text-slate-300 hover:bg-slate-900 hover:text-rose-300 transition-all group">
              <span class="truncate">NEET Photo (Name/Date)</span>
              <span class="text-[9px] font-mono font-bold px-1.5 py-0.5 rounded bg-rose-500/20 text-rose-300 border border-rose-500/30 group-hover:scale-105 transition-transform">10–200K</span>
            </a>
          </li>
        </ul>
      </div>

      {/* Column 4: Authority Guides & FAQs (Span 3 of 12) */}
      <div class="space-y-2.5 lg:col-span-3 sm:col-span-1">
        <div class="flex items-center gap-1.5 border-b-2 border-emerald-400 pb-1.5">
          <span class="text-xs">📚</span>
          <h3 class="font-extrabold text-emerald-300 text-xs uppercase tracking-wider">Knowledge Hub</h3>
        </div>
        <ul class="space-y-1">
          <li>
            <a href="/blog/ssc-live-photo-webcam-guidelines-troubleshooting-2026/" class="flex items-center justify-between py-1 px-1.5 rounded-md text-slate-300 hover:bg-slate-900 hover:text-rose-300 transition-all group">
              <span class="truncate">SSC Live Webcam Fix</span>
              <span class="text-[9px] font-mono font-bold px-1.5 py-0.5 rounded bg-rose-500/20 text-rose-300 border border-rose-500/30 group-hover:scale-105 transition-transform">New</span>
            </a>
          </li>
          <li>
            <a href="/blog/blue-ink-vs-black-ink-signature-guidelines-govt-exams/" class="flex items-center justify-between py-1 px-1.5 rounded-md text-slate-300 hover:bg-slate-900 hover:text-sky-300 transition-all group">
              <span class="truncate">Blue vs Black Ink Rules</span>
              <span class="text-[9px] font-mono font-bold px-1.5 py-0.5 rounded bg-sky-500/20 text-sky-300 border border-sky-500/30 group-hover:scale-105 transition-transform">Guide</span>
            </a>
          </li>
          <li>
            <a href="/blog/rrb-ntpc-cen-06-2026-photo-signature-guidelines/" class="flex items-center justify-between py-1 px-1.5 rounded-md text-slate-300 hover:bg-slate-900 hover:text-amber-300 transition-all group">
              <span class="truncate">CEN 06/2026 Rules</span>
              <span class="text-[9px] font-mono font-bold px-1.5 py-0.5 rounded bg-amber-500/20 text-amber-300 border border-amber-500/30 group-hover:scale-105 transition-transform">RRB</span>
