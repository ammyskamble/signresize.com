        <div class="flex items-center gap-1.5 border-b-2 border-amber-400 pb-1.5">
          <span class="text-xs">🛡️</span>
          <h3 class="font-extrabold text-amber-300 text-xs uppercase tracking-wider">Platform</h3>
        </div>
