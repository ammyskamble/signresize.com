      {/* Column 5: Platform & Legal (Span 2 of 12) */}
      <div class="space-y-2.5 lg:col-span-2 sm:col-span-1">
        <div class="flex items-center gap-1.5 border-b-2 border-indigo-500/80 pb-1.5">
          <span class="text-xs">🛡️</span>
          <h3 class="font-bold text-foreground text-xs uppercase tracking-wider">Platform</h3>
        </div>
        <ul class="space-y-1">
          <li>
            <a href="/about/" class="flex items-center justify-between py-1 px-1.5 rounded-md hover:bg-muted/60 hover:text-foreground transition-all">
              <span class="truncate">About Us</span>
            </a>
          </li>
          <li>
            <a href="/contact/" class="flex items-center justify-between py-1 px-1.5 rounded-md hover:bg-muted/60 hover:text-foreground transition-all">
              <span class="truncate">Contact</span>
            </a>
          </li>
          <li>
            <a href="/privacy/" class="flex items-center justify-between py-1 px-1.5 rounded-md hover:bg-muted/60 hover:text-foreground transition-all group">
              <span class="truncate">Privacy</span>
              <span class="text-[9px] font-mono font-bold px-1.5 py-0.5 rounded bg-emerald-500/15 text-emerald-600 dark:text-emerald-400">Zero Logs</span>
