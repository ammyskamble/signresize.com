      <div class="flex items-center gap-2">
        <span class="text-foreground font-semibold">Available Languages:</span>
        <span class="text-muted-foreground text-[11px]">(SignResize Regional Portals)</span>
      </div>
      <div class="flex items-center gap-2">
        <a href="/" class="px-2.5 py-1 rounded-lg bg-primary/10 text-primary font-bold border border-primary/20 hover:bg-primary/20 transition">English (Default)</a>
        <a href="/hi/" class="px-2.5 py-1 rounded-lg bg-card hover:bg-muted text-foreground font-medium border border-border transition">हिंदी (Hindi)</a>
