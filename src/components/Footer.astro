  {/* Client-side Newsletter Form Script */}
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('footer-subscribe-form');
      const input = document.getElementById('subscriber-email');
      const status = document.getElementById('subscribe-status');
      const btn = document.getElementById('subscribe-btn');

      if (form && input && status && btn) {
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          const email = input.value.trim();
          if (email) {
            try {
              const subs = JSON.parse(localStorage.getItem('signresize_subs') || '[]');
              if (!subs.includes(email)) {
                subs.push(email);
                localStorage.setItem('signresize_subs', JSON.stringify(subs));
              }
            } catch (err) {}

            status.classList.remove('hidden');
            btn.innerHTML = '<span>Subscribed! ✓</span>';
            btn.classList.add('bg-emerald-600', 'text-white');
            input.disabled = true;
          }
        });
      }
    });
  </script>
