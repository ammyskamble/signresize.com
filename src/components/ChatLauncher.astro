<div id="help-launcher" class="copilot-launcher fixed bottom-5 right-5 max-sm:bottom-4 max-sm:right-3 z-20 transition-all duration-300">
  <button type="button" aria-label="Open exam help" aria-expanded="false" class="rounded-full border border-border bg-card/95 backdrop-blur-xs text-foreground px-3 py-1.5 text-xs font-semibold shadow-md hover:bg-muted/80 focus-visible:outline-2 focus-visible:outline-primary cursor-pointer transition">Exam help</button>
  <span role="status" class="block text-xs bg-card"></span>
</div>
<div id="help-root"></div>
<script>
  const launcher = document.getElementById('help-launcher');
  const button = launcher?.querySelector('button');
  const status = launcher?.querySelector('[role="status"]');
  const host = document.getElementById('help-root');
  let loading = false, mounted = false;
  const footer = document.querySelector('footer');
  const workspace = document.getElementById('tool-workspace') ||
    document.getElementById('exam-tool') ||
    document.getElementById('studio-container') ||
    document.querySelector('.signature-tool-wrapper') ||
    document.querySelector('main > section:has(div.signature-tool)') ||
    document.querySelector('main > section:nth-of-type(2)');

  const observer = new IntersectionObserver(entries => {
    if (launcher) launcher.hidden = mounted || Boolean(entries[0]?.isIntersecting);
  });
  if (footer) observer.observe(footer);

  // Avoid overlapping the resizer workspace cards on any device viewport
  if (workspace) {
    const wsObserver = new IntersectionObserver(entries => {
      if (launcher && !mounted) {
        if (entries[0]?.isIntersecting) {
          launcher.classList.add('opacity-0', 'pointer-events-none');
        } else {
          launcher.classList.remove('opacity-0', 'pointer-events-none');
        }
      }
    }, { threshold: 0.15 });
    wsObserver.observe(workspace);
  }
  async function openHelp() {
    if (loading || mounted || !host || !button) return;
    loading = true; button.disabled = true;
    if (status) status.textContent = 'Loading help...';
    try {
      // Pages without Astro React islands need the development refresh preamble too.
      if (import.meta.env.DEV) await import('@vitejs/plugin-react/preamble');
      const { mountChat } = await import('../utils/mountChat');
      mountChat(host);
      mounted = true; observer.disconnect();
      if (launcher) launcher.hidden = true;
      window.removeEventListener('open-exam-help', openHelp);
    } catch (error) {
      console.error('Exam help could not load:', error);
      if (launcher) launcher.hidden = false;
      if (status) status.textContent = 'Could not load help. Tap to retry.';
    } finally { loading = false; button.disabled = false; }
  }
  button?.addEventListener('click', openHelp);
  window.addEventListener('open-exam-help', openHelp);
</script>
