# Cloudflare Pages Caching & Headers

# Hashed immutable assets generated by Astro & Vite
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Service Worker must never be cached so updates propagate immediately
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# HTML and root documents: always revalidate so clients never receive outdated HTML pointing to old chunks
/*
  Cache-Control: public, max-age=0, must-revalidate

# Prevent indexing on the pages.dev preview subdomain
https://signresize.pages.dev/*
  X-Robots-Tag: noindex