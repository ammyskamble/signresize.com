# Cloudflare Pages Caching & Headers

# Hashed immutable assets generated by Astro & Vite
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Preloaded web fonts
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Service Worker must never be cached so updates propagate immediately
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# Search index JSON: cache at Cloudflare edge and in browser
/search-index.json
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800
  Access-Control-Allow-Origin: *

# HTML and root documents: enable Cloudflare edge caching (s-maxage) for ultra-fast TTFB for AI crawlers and search bots
/*
  Cache-Control: public, max-age=0, s-maxage=86400, stale-while-revalidate=604800
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff

# Prevent indexing on the pages.dev preview subdomain
https://signresize.pages.dev/*
  X-Robots-Tag: noindex